---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="te" translate="no" class="notranslate">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google" content="notranslate" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" />
  <script is:inline>
    // Runs before paint to avoid a light-mode flash on load
    (function () {
      var saved = localStorage.getItem('studyhelp-theme');
      var theme = saved === 'dark' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    :root {
      --bg: #f7f6f2;
      --card: #ffffff;
      --border: #e2e0d8;
      --text: #1c1c1a;
      --muted: #6b6a63;
      --accent: #185fa5;
      --accent-bg: #e6f1fb;
      --success-bg: #eaf3de;
      --success-text: #27500a;
    }
    html[data-theme="dark"] {
      --bg: #14161a;
      --card: #1c1f24;
      --border: #2c2f36;
      --text: #ececec;
      --muted: #9a9a9a;
      --accent: #8ec6ff;
      --accent-bg: #1c2c3a;
      --success-bg: #1e2c17;
      --success-text: #9fd67a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Noto Sans Telugu", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.8;
      font-size: 18px;
    }
    main { width: 100%; }
    :global(.content) {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 16px 64px;
    }
    a { color: var(--accent); text-decoration: none; font-size: 17px; }
    html[data-theme="dark"] a {
      color: #ffffff;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 3px;
    }
    h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; }
    p.sub { color: var(--muted); font-size: 16px; margin: 0 0 20px; }
    input[type="search"],
    input[type="email"],
    input[type="text"] {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 17px;
      font-family: inherit;
      margin-bottom: 20px;
      background: var(--card);
      color: var(--text);
    }

    /* Chapter grid: 3-column on desktop, boxed single-column list on mobile */
    :global(.chapter-grid) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    @media (max-width: 720px) {
      :global(.chapter-grid) {
        grid-template-columns: 1fr;
      }
    }

    /* Subject header: left/right split on desktop, centered stack on mobile */
    :global(.subject-header-left) {
      text-align: left;
    }
    :global(.subject-header-right) {
      text-align: right;
    }
    @media (max-width: 720px) {
      :global(.subject-header-left),
      :global(.subject-header-right) {
        text-align: center;
      }
    }

    /* Chapter card content: left-aligned on desktop, centered on mobile */
    @media (max-width: 720px) {
      :global(.chapter-card) {
        text-align: center;
      }
      :global(.chapter-card .chapter-card-number) {
        margin-left: auto;
        margin-right: auto;
      }
    }

    /* Scroll-to-top button, positioned above mobile browser nav bars */
    #scroll-top-btn {
      position: fixed;
      right: 16px;
      bottom: 24px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      border: none;
      font-size: 18px;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      z-index: 40;
    }
    #scroll-top-btn.show { display: flex; }
    @media (max-width: 720px) {
      #scroll-top-btn { bottom: 84px; }
    }
  </style>
</head>
<body>
  <main>
    <slot />
  </main>

  <button id="scroll-top-btn" aria-label="Scroll to top">&#8593;</button>

  <script is:inline>
    const scrollBtn = document.getElementById('scroll-top-btn');
    if (scrollBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          scrollBtn.classList.add('show');
        } else {
          scrollBtn.classList.remove('show');
        }
      });
      scrollBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</body>
</html>
