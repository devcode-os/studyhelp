---
import Footer from '../components/Footer.astro';
const {
  title,
  description,
  lang = 'en',
  ogImage = '/og-default.png',
} = Astro.props;

// Canonical always points at the production origin + the current path,
// with trailing slash normalized so /page and /page/ never split ranking
// signals. Astro.url.pathname already reflects the requested route.
const SITE_URL = 'https://studyhelp.fdaytalk.com';
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname === ''
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = `${SITE_URL}${path}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<!doctype html>
<html lang={lang} translate="no" class="notranslate">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ESX0VEW65Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){dataLayer.push(arguments);};
    gtag('js', new Date());
    gtag('config', 'G-ESX0VEW65Q');
    gtag('config', 'AW-18464276214');
  </script>

  <link rel="manifest" href="/manifest.json" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="google" content="notranslate" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="StudyHelp" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:locale" content={lang === 'te' ? 'te_IN' : 'en_IN'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <meta name="theme-color" content="#FFFFFF" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <!-- Both external stylesheets loaded non-render-blocking: preload fetches
       them in parallel with everything else instead of the browser
       stalling first paint on two separate third-party CDN round-trips,
       then the onload swap turns each into a real stylesheet once it's
       actually in cache. noscript fallback covers the (rare) no-JS case.
       This was measured as the dominant cause of a 6+ second mobile FCP/LCP
       on PageSpeed Insights (slow-4G throttled) — both links were plain
       blocking <link rel="stylesheet"> before. -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;500;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;500;700&display=swap" /></noscript>
  <link rel="preload" as="style" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" /></noscript>
  <!-- Meta Pixel Code -->
  <script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '28828842510056886');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=28828842510056886&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->

  <script is:inline>
    // Runs before paint to avoid a light-mode flash on load
    (function () {
      var saved = localStorage.getItem('studyhelp-theme');
      var theme = saved === 'dark' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    :root {
      --bg: #faf9f6;
      --card: #ffffff;
      --border: #e2e0d8;
      --text: #1c1c1a;
      --muted: #6b6a63;
      --accent: #185fa5;
      --accent-bg: #e6f1fb;
      --success-bg: #eaf3de;
      --success-text: #27500a;
      --amber-bg: #faeeda;
      --amber-text: #854f0b;
      --amber-text-strong: #412402;
      --teal-bg: #e1f5ee;
      --teal-text: #0f6e56;
      --teal-text-strong: #04342c;
      /* Height reserved for the fixed mobile tab bar, used by padding/offset
         calculations below. Kept as a var so it's defined once. */
      --tabbar-h: 58px;
    }
    html[data-theme="dark"] {
      --bg: #14161a;
      --card: #1c1f24;
      --border: #2c2f36;
      --text: #ececec;
      --muted: #9a9a9a;
      --accent: #8ec6ff;
      --accent-bg: #1c2c3a;
      --success-bg: #1e2c17;
      --success-text: #9fd67a;
      --amber-bg: #3a2a10;
      --amber-text: #f0c07a;
      --amber-text-strong: #ffe0b0;
      --teal-bg: #133026;
      --teal-text: #7fd9bd;
      --teal-text-strong: #b0eedb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Noto Sans Telugu", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.8;
      font-size: 18px;
    }
    main { width: 100%; }
    :global(.content) {
      max-width: 720px;
      margin: 0 auto;
      padding: 24px 16px 64px;
    }
    a { color: var(--accent); text-decoration: none; font-size: 17px; }
    html[data-theme="dark"] a {
      color: #ffffff;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 3px;
    }
    h1 { font-size: 28px; font-weight: 700; margin: 0 0 4px; }
    p.sub { color: var(--muted); font-size: 16px; margin: 0 0 20px; }
    :global(input[type="search"]),
    :global(input[type="email"]),
    :global(input[type="text"]),
    :global(input[type="tel"]) {
      width: 100%;
      padding: 13px 16px;
      /* Filled style instead of a plain bordered box — transparent border
         by default (so it doesn't look outdated/boxy), accent border and
         glow only appear on focus. Applies site-wide, desktop and mobile. */
      border: 1px solid transparent;
      border-radius: 12px;
      font-size: 17px;
      font-family: inherit;
      margin-bottom: 20px;
      background: var(--bg);
      color: var(--text);
      transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }
    :global(input[type="search"]:focus),
    :global(input[type="email"]:focus),
    :global(input[type="text"]:focus),
    :global(input[type="tel"]:focus) {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-bg);
      background: var(--card);
    }
    /* Chrome/Edge force their own yellow/blue autofill background on
       fields they've filled in (name, email, phone), which fights our
       filled-input design and looks visually broken next to it. This
       trick uses a huge inset box-shadow the same color as our normal
       input background to paint over the browser's autofill color,
       while keeping the delayed background-color transition so Chrome's
       own autofill animation never gets a chance to flash yellow first. */
    :global(input:-webkit-autofill),
    :global(input:-webkit-autofill:hover),
    :global(input:-webkit-autofill:focus) {
      -webkit-box-shadow: 0 0 0 1000px var(--bg) inset !important;
      -webkit-text-fill-color: var(--text) !important;
      caret-color: var(--text);
      transition: background-color 5000s ease-in-out 0s;
    }
    :global(input:-webkit-autofill:focus) {
      -webkit-box-shadow: 0 0 0 1000px var(--card) inset !important;
    }

    /* Chapter grid: 4-column on desktop, boxed single-column list on mobile */
    :global(.chapter-grid) {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    @media (max-width: 900px) {
      :global(.chapter-grid) {
        grid-template-columns: 1fr;
      }
    }

    :global(.stat-pill-row) {
      justify-content: flex-start;
    }

    /* Subject header: left/right split on desktop, centered stack on mobile */
    :global(.subject-header-left) {
      text-align: left;
    }
    :global(.subject-header-right) {
      text-align: right;
    }
    @media (max-width: 900px) {
      :global(.subject-header-left),
      :global(.subject-header-right) {
        text-align: center;
      }
      :global(.stat-pill-row) {
        justify-content: center;
      }
    }

    /* Chapter card content: left-aligned on desktop, centered on mobile */
    @media (max-width: 900px) {
      :global(.chapter-card) {
        text-align: center;
      }
      :global(.chapter-card .chapter-card-number) {
        margin-left: auto;
        margin-right: auto;
      }
    }

    /* Reserve space at the bottom of scrollable pages on mobile so the last
       card/element isn't hidden behind the fixed tab bar. Chapter pages use
       the compact header (no tab bar) so they don't need this, but applying
       it globally is harmless there too since they simply won't have a bar
       to clear. */
    @media (max-width: 900px) {
      :global(.content) {
        padding-bottom: calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    /* Belt-and-suspenders for the status bar gap: the JS StatusBar.
       setOverlaysWebView(false) call below is async (dynamically
       imported), so there's a brief window on first paint before it
       takes effect. This CSS applies immediately, no JS wait, and
       pushes the header's own content down WITHIN its own colored
       background — so the gap appears in the header's color, not a
       mismatched body-background gap above it. Harmless on the web
       (env() safe-area vars default to 0px there).
       Only ever matters inside the native app (window.Capacitor) —
       this rule is a no-op everywhere else since the var defaults to 0. */
    :global(.site-header),
    :global(.chapter-header) {
      padding-top: env(safe-area-inset-top, 0px);
    }

    /* ---------- Smart app install banner. Shown only to Android visitors
       browsing in a regular tab (not already inside the installed TWA),
       who haven't dismissed it before. Sits at the very top of the page,
       above everything else including the header, since it's the first
       thing to decide before anything else loads. */
    /* ---------- Smart app install banner. Shown only to Android visitors
       browsing in a regular tab (not already inside the installed TWA),
       who haven't dismissed it before. Fixed to the bottom of the screen,
       above the mobile tab bar (same --tabbar-h offset pattern used by
       .verify-toast on subject pages) — bottom placement reads as a
       familiar native "install this app" prompt and doesn't push page
       content down the way a top banner would. */
    .app-install-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--card);
      border-top: 1px solid var(--border);
      box-shadow: 0 -6px 20px rgba(0,0,0,0.12);
      padding: 12px 14px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
    }
    @media (max-width: 900px) {
      .app-install-banner {
        bottom: calc(var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }
    @media (min-width: 901px) {
      .app-install-banner {
        bottom: env(safe-area-inset-bottom, 0px);
      }
    }
    .app-install-banner-icon img {
      display: block;
      border-radius: 8px;
    }
    .app-install-banner-text {
      flex: 1;
      min-width: 0;
    }
    .app-install-banner-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.3;
    }
    .app-install-banner-sub {
      font-size: 11.5px;
      color: var(--muted);
      line-height: 1.3;
    }
    .app-install-banner-actions {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }
    .app-install-banner-install {
      font-size: 12.5px;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 999px;
      background: linear-gradient(90deg, #ff9a3c, #ffb35c);
      color: #2a1400;
      text-decoration: none;
      white-space: nowrap;
    }
    .app-install-banner-dismiss {
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .app-install-banner-dismiss:hover { color: var(--text); }

    /* Sticky "Current Affairs" floating icon. Hidden by default — shown
       only via JS detection (see script near bottom), which checks the
       page's own DOM for markers unique to home/listing pages. Sits in
       the same bottom-right slot the old scroll-to-top button used. */
    #ca-fab {
      position: fixed;
      right: 16px;
      bottom: 24px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 40;
      text-decoration: none;

      background: #ffffff;
      box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.5);
      transition: transform 0.2s ease;
    }
    #ca-fab.show { display: flex; }
    #ca-fab:hover { transform: scale(1.06); }
    #ca-fab svg {
      width: 24px;
      height: 24px;
      stroke: #185fa5;
      fill: none;
      stroke-width: 2;
    }
    /* Attention hint — a gentle bounce, only until the icon is clicked
       once, ever (tracked in localStorage below, permanent per browser,
       same pattern as the purchases-icon badge). */
    #ca-fab.show.ca-fab-hint {
      animation: ca-fab-bounce 1.6s ease-in-out infinite,
                 ca-fab-glow 1.6s ease-in-out infinite;
    }
    @keyframes ca-fab-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    @keyframes ca-fab-glow {
      0%, 100% { box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.5), 0 0 0 0 rgba(24, 95, 165, 0.5); }
      50% { box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.5), 0 0 16px 6px rgba(24, 95, 165, 0.5); }
    }
    @media (max-width: 900px) {
      #ca-fab {
        bottom: calc(16px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    /* ---------- Skeleton loading shimmer, used to replace plain
       "Loading..." text on the chapter answer reveal. Shape mimics the
       answer capsule so there's no layout jump when the real answer swaps in. ---------- */
    :global(.skeleton-answer) {
      background: var(--card);
      border-radius: 8px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    :global(.skeleton-line) {
      height: 14px;
      border-radius: 4px;
      background: linear-gradient(90deg, var(--border) 25%, var(--bg) 50%, var(--border) 75%);
      background-size: 200% 100%;
      animation: skeleton-shimmer 1.3s ease-in-out infinite;
    }
    :global(.skeleton-line.w-70) { width: 70%; }
    :global(.skeleton-line.w-50) { width: 50%; }
    :global(.skeleton-line.w-90) { width: 90%; }
    @keyframes skeleton-shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* ---------- Toast/snackbar, replaces alert() on error states such as
       failed payments (Plans page). Purely presentational — the JS that
       calls showToast() still gets the exact same error string it used to
       pass to alert(). ---------- */
    #toast-container {
      position: fixed;
      left: 50%;
      bottom: calc(20px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      z-index: 60;
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: calc(100% - 32px);
      max-width: 420px;
      pointer-events: none;
    }
    @media (min-width: 901px) {
      #toast-container {
        bottom: 24px;
      }
    }
    .toast {
      pointer-events: auto;
      background: var(--text);
      color: var(--bg);
      font-size: 14px;
      padding: 12px 16px;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.18);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .toast.toast-show {
      opacity: 1;
      transform: translateY(0);
    }
    .toast.toast-error {
      background: #b8341c;
      color: #fff;
    }

    /* ---------- Instant tap/press feedback, site-wide ----------
       Real page navigation (not an SPA) has a brief gap between tap and
       the new page appearing, with nothing to confirm the tap itself
       registered — easy to tap again, thinking it didn't work. Rather
       than a separate loading indicator, the tapped element itself
       presses/dims instantly, exactly like a native app button. Applies
       to any link, button, or explicitly marked pressable card. */
    a:active,
    button:active,
    .subject-card:active,
    .plan-card:active,
    .mock-card:active,
    [role="button"]:active {
      opacity: 0.65;
      transform: scale(0.97);
      transition: opacity 0.05s ease, transform 0.05s ease;
    }

    /* ---------- Global navigation blur overlay ----------
       Site-wide navigation feedback, separate from per-button loading
       spinners. This covers PAGE-TO-PAGE navigation — clicking a link, a
       form submit, or a script doing window.location.href = ... — none
       of which a button-local spinner can cover once the browser actually
       starts leaving the page. Button spinners remain the right tool for
       in-place async actions (Buy Now opening Razorpay on the same page,
       login, OTP) — this overlay is only for actual navigations. Both
       together, not one replacing the other. */
    #sh-nav-overlay {
      position: fixed; inset: 0;
      background: rgba(255,255,255,0.55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 99999;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity 0.18s ease;
    }
    [data-theme="dark"] #sh-nav-overlay {
      background: rgba(20,20,30,0.55);
    }
    #sh-nav-overlay.sh-nav-overlay-active {
      opacity: 1; pointer-events: all;
    }
    .sh-nav-dots {
      display: flex; align-items: center; gap: 6px;
    }
    .sh-nav-dots span {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--accent);
      animation: sh-nav-dot-bounce 1.1s ease-in-out infinite;
    }
    .sh-nav-dots span:nth-child(2) { animation-delay: 0.15s; }
    .sh-nav-dots span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes sh-nav-dot-bounce {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.6; }
      30% { transform: translateY(-8px); opacity: 1; }
    }
  </style>
</head>
<body>
  <div id="sh-nav-overlay"><div class="sh-nav-dots"><span></span><span></span><span></span></div></div>
  <script is:inline>
    // ---------- Global navigation blur overlay ----------
    // Starts on: same-origin link clicks, form submits, and the
    // beforeunload event (a catch-all that also covers programmatic
    // window.location.href redirects anywhere on the site, with no
    // per-page wiring needed). Overlay is left showing on purpose when
    // navigation actually happens — the page unloading removes it, no
    // explicit "finish" step required. If a click turns out NOT to
    // navigate (e.g. preventDefault'd by other JS, or opens a modal),
    // the overlay quietly hides itself after a short timeout so it never
    // gets stuck blocking the page.
    (function () {
      if (window.__shNavOverlayInit) return;
      window.__shNavOverlayInit = true;
      var overlay = document.getElementById('sh-nav-overlay');
      if (!overlay) return;
      var showTimer = null;
      var hideTimer = null;
      // Don't show the overlay at all for navigations faster than this —
      // avoids a flash-of-blur on fast/local/cached page loads, where the
      // browser has already left this page before the delay even elapses
      // (page unload destroys this timer along with everything else, so
      // nothing needs to explicitly cancel it in that case).
      var SHOW_DELAY = 1500;
      // If a click never actually results in navigation (prevented by
      // other JS, opens a modal, etc.), don't leave the overlay stuck.
      var SAFETY_TIMEOUT = 6000;

      function start() {
        clearTimeout(showTimer);
        clearTimeout(hideTimer);
        showTimer = setTimeout(function () {
          overlay.classList.add('sh-nav-overlay-active');
        }, SHOW_DELAY);
        hideTimer = setTimeout(function () {
          clearTimeout(showTimer);
          overlay.classList.remove('sh-nav-overlay-active');
        }, SAFETY_TIMEOUT);
      }
      window.__shStartTopLoading = start;

      document.addEventListener('click', function (e) {
        var a = e.target.closest('a[href]');
        if (!a) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var url;
        try { url = new URL(a.href, window.location.href); } catch (err) { return; }
        if (url.origin !== window.location.origin) return;
        // Same-page anchor / hash link — not a real navigation.
        if (url.pathname === window.location.pathname && url.search === window.location.search) return;
        start();
      });

      document.addEventListener('submit', function (e) {
        if (e.defaultPrevented) return;
        start();
      });

      window.addEventListener('beforeunload', start);
    })();
  </script>
  <div id="app-install-banner" class="app-install-banner" style="display:none;">
    <div class="app-install-banner-icon">
      <img src="/apple-touch-icon.png" alt="" width="36" height="36" />
    </div>
    <div class="app-install-banner-text">
      <div class="app-install-banner-title">StudyHelp App</div>
      <div class="app-install-banner-sub">Faster, user-friendly access</div>
    </div>
    <div class="app-install-banner-actions">
      <a href="https://play.google.com/store/apps/details?id=com.fdaytalk.studyhelp" id="app-install-btn" class="app-install-banner-install">Install</a>
      <button type="button" id="app-install-dismiss" class="app-install-banner-dismiss" aria-label="Continue in browser">
        <i class="ti ti-x" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <Footer />

  <a id="ca-fab" href="/current-affairs/" title="Current Affairs" aria-label="Current Affairs">
    <svg viewBox="0 0 24 24">
      <path d="M4 4h16v13H7l-3 3V4z" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8 9h8M8 13h5" stroke-linecap="round"/>
    </svg>
  </a>

  <div id="toast-container" aria-live="polite"></div>

  <script is:inline>
    // ---------- Smart app install banner ----------
    // Shows only when BOTH of these are true:
    //  - Android device (this is an Android TWA app, no iOS build exists)
    //  - NOT already running inside the installed TWA itself — a TWA launch
    //    sets document.referrer to "android-app://<package>/..." and also
    //    matches the standalone display-mode media query, either of which
    //    reliably distinguishes "opened from the installed app" from
    //    "opened as a normal browser tab", without needing any native
    //    bridge or install-detection API (which doesn't reliably exist).
    // Dismissing (X) only hides it for the current page view — no
    // localStorage/sessionStorage memory, so it shows again fresh on the
    // next page navigation, back button, or reload. Intentional: this is
    // a full page reload site (not an SPA), so "per page" is the natural
    // unit here rather than "once ever".
    (function initAppInstallBanner() {
      try {
        const isAndroid = /Android/i.test(navigator.userAgent);
        if (!isAndroid) return;

        const isAlreadyInApp = window.Capacitor
          || document.referrer.startsWith('android-app://')
          || window.matchMedia('(display-mode: standalone)').matches;
        if (isAlreadyInApp) return;

        const banner = document.getElementById('app-install-banner');
        if (!banner) return;
        banner.style.display = 'flex';

        const dismissBtn = document.getElementById('app-install-dismiss');
        if (dismissBtn) {
          dismissBtn.addEventListener('click', () => {
            banner.style.display = 'none';
          });
        }
      } catch (err) {
        // Any unexpected error here (e.g. matchMedia unsupported) should
        // never break the rest of the page — banner just stays hidden.
      }
    })();

    // CA floating icon visibility — self-contained, no page passes any
    // prop for this. Shown on: homepage, /subjects/, and any page
    // rendering a .chapter-grid/.subject-header-left/-right element
    // (both existing classes used only by subject listing pages).
    // Hidden everywhere else by default (reading/MCQ pages, mock test,
    // CA pages themselves, login/signup, Plans, etc.)
    //
    // Wherever the fab shows, the install banner is force-hidden instead
    // of the two competing for the same bottom-right space — simpler than
    // repositioning, and these are exactly the pages where funnelling
    // toward CA matters more than the install nudge.
    (function () {
      const caFab = document.getElementById('ca-fab');
      if (!caFab) return;

      // Same deliberate-fresh-entry reasoning as the Header's "Current
      // Affairs" nav links: clicking this icon should always land on the
      // default CA view, not wherever the tab state happened to be left
      // from an earlier visit. Browser Back never runs this handler, so
      // it still restores correctly on its own.
      caFab.addEventListener('click', () => {
        try {
          sessionStorage.removeItem('ca_last_hero_tab');
          sessionStorage.removeItem('ca_last_pdf_mode');
          sessionStorage.removeItem('ca_last_format_bundle3');
          sessionStorage.removeItem('ca_last_format_bundle6');
          localStorage.setItem('ca_fab_hint_seen', '1');
        } catch (err) {}
        caFab.classList.remove('ca-fab-hint');
      });

      const isHome = window.location.pathname === '/';
      const isSubjectsPage = window.location.pathname === '/subjects/'
        || window.location.pathname === '/subjects';
      const isListingPage = !!document.querySelector(
        '.chapter-grid, .subject-header-left, .subject-header-right'
      );

      if (isHome || isSubjectsPage || isListingPage) {
        caFab.classList.add('show');
        let hintSeen = false;
        try {
          hintSeen = localStorage.getItem('ca_fab_hint_seen') === '1';
        } catch (err) {}
        if (!hintSeen) caFab.classList.add('ca-fab-hint');
        const banner = document.getElementById('app-install-banner');
        if (banner) banner.style.display = 'none';
      }

      // CA pages themselves don't show the fab (by design — it links TO
      // these pages, showing it here would be pointless), but the banner
      // still needs to stay off here: it was covering the "Continue to
      // Read" button at the bottom of the CA picker/read pages.
      const isCaPage = window.location.pathname.startsWith('/current-affairs');
      if (isCaPage) {
        const banner = document.getElementById('app-install-banner');
        if (banner) banner.style.display = 'none';
      }

      // Signup ("Create your account") page: the banner sits right above
      // the bottom nav and crowds the form/CTA here, so keep it off on
      // this page regardless of device/state.
      const isSignupPage = window.location.pathname === '/signup'
        || window.location.pathname === '/signup/';
      if (isSignupPage) {
        const banner = document.getElementById('app-install-banner');
        if (banner) banner.style.display = 'none';
      }
    })();

    // Global toast helper — replaces alert() calls site-wide. Usage:
    //   showToast('Payment failed. Please try again.', 'error')
    // Kept as a plain global so existing inline <script> blocks (e.g. Plans
    // page Razorpay handler) can call it with a one-line swap from alert(...).
    //
    // Container position/appearance is set via inline styles here (not just
    // the .toast/#toast-container CSS classes) as a defense against any
    // scoped-style/cascade issue — inline styles always apply regardless,
    // so the toast can never silently render as unstyled plain text.
    window.showToast = function (message, type = 'default', duration = 3500) {
      let container = document.getElementById('toast-container');
      if (!container) return;

      container.style.position = 'fixed';
      container.style.left = '50%';
      container.style.bottom = 'calc(20px + env(safe-area-inset-bottom, 0px) + 64px)';
      container.style.transform = 'translateX(-50%)';
      container.style.zIndex = '2147483000';
      container.style.display = 'flex';
      container.style.flexDirection = 'column';
      container.style.gap = '8px';
      container.style.width = 'calc(100% - 32px)';
      container.style.maxWidth = '420px';
      container.style.pointerEvents = 'none';

      const el = document.createElement('div');
      el.className = 'toast' + (type === 'error' ? ' toast-error' : '');
      el.textContent = message;
      el.style.pointerEvents = 'auto';
      el.style.background = type === 'error' ? '#b8341c' : '#1c1c1a';
      el.style.color = '#fff';
      el.style.fontSize = '14px';
      el.style.padding = '12px 16px';
      el.style.borderRadius = '10px';
      el.style.boxShadow = '0 4px 14px rgba(0,0,0,0.25)';
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      el.style.transition = 'opacity 0.2s ease, transform 0.2s ease';

      container.appendChild(el);
      requestAnimationFrame(() => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(8px)';
        setTimeout(() => el.remove(), 220);
      }, duration);
    };
  </script>

  <script>
    // ---------- Capacitor hardware/gesture back-button handling ----------
    // TWA delegated this to Chrome automatically; Capacitor does not, so
    // without this, Android's back gesture/button can exit the app
    // unexpectedly instead of navigating back within it.
    // `window.Capacitor` only exists when this page is running inside the
    // native app shell — never in a normal browser tab — so this whole
    // block is a no-op on studyhelp.fdaytalk.com itself and never affects
    // web users. The dynamic import() means @capacitor/app is only ever
    // fetched on that native-app code path too, not bundled into the
    // regular web page load.
    if (typeof window !== 'undefined' && window.Capacitor) {
      import('@capacitor/app').then(({ App }) => {
        App.addListener('backButton', ({ canGoBack }) => {
          // Close mock-test drawer/overlay first if open, else navigate
          // history, else exit.
          const mtDrawerOverlay = document.getElementById('mt-drawer-overlay');
          if (mtDrawerOverlay && mtDrawerOverlay.style.display === 'flex') {
            mtDrawerOverlay.style.display = 'none';
            return;
          }
          const mtOverlay = document.getElementById('mt-overlay');
          if (mtOverlay && mtOverlay.classList.contains('active')) {
            document.getElementById('mt-exit-btn')?.click();
            return;
          }
          // Explicit root-path check as a safety net: on some Astro
          // view-transition navigations, window.history.length/canGoBack
          // can desync from Android's native WebView history, which would
          // otherwise leave the back button stuck doing nothing at the
          // root page instead of exiting cleanly.
          if (window.location.pathname === '/' || window.location.pathname === '') {
            App.exitApp();
          } else if (canGoBack) {
            window.history.back();
          } else {
            App.exitApp();
          }
        });
      });
    }

    // ---------- Capacitor native status bar ----------
    // The web `theme-color` meta tag above has zero effect inside
    // Capacitor's native WebView — the status bar only follows it in a
    // real mobile browser tab. Left unset here, Capacitor defaults to a
    // color that can clash with the app's actual light/dark background
    // (this exact mismatch is what started this whole migration thread).
    // Reads the same data-theme attribute the inline theme script at the
    // top of <head> already set before paint, so this stays in sync with
    // whatever the user last chose.
    if (typeof window !== 'undefined' && window.Capacitor) {
      import('@capacitor/status-bar').then(({ StatusBar, Style }) => {
        // overlaysWebView(false) is the critical part here: by default
        // Capacitor draws the status bar ON TOP of the page content
        // (transparent overlay) rather than pushing content down below
        // it — that's what causes the header to sit flush against the
        // very top of the screen with no gap. Setting this false makes
        // the WebView's content start below the status bar instead.
        StatusBar.setOverlaysWebView({ overlay: false });
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        StatusBar.setBackgroundColor({ color: isDark ? '#14161a' : '#14102B' });
        StatusBar.setStyle({ style: isDark ? Style.Dark : Style.Light });
      });
    }
  </script>
</body>
</html>
