---
// Shared header, used on every page via <Header />
// Highlights the current page's nav link if `active` prop is passed (e.g. active="home")
const { active = '' } = Astro.props;
---
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo">StudyHelp</a>

    <nav class="nav-desktop">
      <a href="/" class:list={{ active: active === 'home' }}>Home</a>
      <a href="/subjects/" class:list={{ active: active === 'subjects' }}>Subjects</a>
      <a href="/plans/" class:list={{ active: active === 'plans' }}>Plans</a>
      <a href="/about/" class:list={{ active: active === 'about' }}>About</a>
    </nav>

    <div class="header-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
        <span class="icon-light">&#9728;</span>
        <span class="icon-dark">&#9789;</span>
      </button>
      <a href="/login/" id="login-link" class="btn btn-outline nav-desktop-only">
        <span id="login-link-text">Login</span><span id="verify-badge-desktop" class="verify-badge" style="display:none;">!</span>
      </a>
      <a href="/plans/" class="btn btn-accent nav-desktop-only">Go premium</a>
      <button id="menu-toggle" class="menu-toggle" aria-label="Open menu">&#9776;</button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu">
    <a href="/">Home</a>
    <a href="/subjects/">Subjects</a>
    <a href="/plans/">Plans</a>
    <a href="/about/">About</a>
    <a href="/login/" id="login-link-mobile">
      <span id="login-link-mobile-text">Login</span><span id="verify-badge-mobile" class="verify-badge" style="display:none;">!</span>
    </a>
    <a href="/plans/" class="btn btn-accent" style="text-align:center;">Go premium</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  .site-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .logo {
    font-weight: 700;
    font-size: 24px;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }
  .nav-desktop {
    display: flex;
    gap: 24px;
    font-size: 16px;
  }
  .nav-desktop a {
    text-decoration: none;
    color: var(--muted);
  }
  .nav-desktop a.active {
    color: var(--text);
    font-weight: 600;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .btn {
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--border);
    color: var(--text);
    background: transparent;
    cursor: pointer;
  }
  .btn-accent {
    border-color: var(--accent);
    background: var(--accent-bg);
    color: var(--accent);
  }
  #login-link, #login-link-mobile {
    position: relative;
  }
  .verify-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #d33;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    margin-left: 6px;
    vertical-align: middle;
    flex-shrink: 0;
  }
  html[data-theme="dark"] .verify-badge {
    background: #ff6b6b;
    color: #1a1a1a;
  }
  .theme-toggle {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icon-dark { display: none; }
  html[data-theme="dark"] .icon-light { display: none; }
  html[data-theme="dark"] .icon-dark { display: inline; }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 20px;
    cursor: pointer;
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--border);
  }
  .mobile-menu a {
    padding: 10px 8px;
    text-decoration: none;
    color: var(--text);
    font-size: 16px;
    border-radius: 6px;
  }
  .mobile-menu.open {
    display: flex;
  }

  @media (max-width: 720px) {
    .nav-desktop-only { display: none; }
    .nav-desktop { display: none; }
    .menu-toggle { display: block; }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
    });
  }

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('studyhelp-theme', next);
    });
  }

  // Real session check via cookie-backed /me endpoint (replaces old localStorage email check).
  // Cached in sessionStorage (5 min TTL) so we're not hitting the Worker on every
  // single page load — login state rarely changes mid-session.
  const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
  const SESSION_CACHE_KEY = 'sh_session_cache';
  const SESSION_CACHE_TTL = 5 * 60 * 1000; // 5 minutes

  function getCachedSession() {
    try {
      const raw = sessionStorage.getItem(SESSION_CACHE_KEY);
      if (!raw) return null;
      const cached = JSON.parse(raw);
      if (Date.now() - cached.ts > SESSION_CACHE_TTL) return null;
      // Never trust a cached "logged out" result - always re-check fresh in that case,
      // since it likely means we cached the state from BEFORE a login happened.
      return cached.data.logged_in ? cached.data : null;
    } catch (err) {
      return null;
    }
  }

  function setCachedSession(data) {
    try {
      sessionStorage.setItem(SESSION_CACHE_KEY, JSON.stringify({ data, ts: Date.now() }));
    } catch (err) {
      // sessionStorage unavailable (private mode edge cases) — just skip caching
    }
  }

  function getSession() {
    const cached = getCachedSession();
    if (cached) return Promise.resolve(cached);

    return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
      .then((res) => res.json())
      .then((data) => {
        setCachedSession(data);
        return data;
      })
      .catch(() => ({ logged_in: false }));
  }

  const loginLink = document.getElementById('login-link');
  const loginLinkMobile = document.getElementById('login-link-mobile');
  const loginLinkText = document.getElementById('login-link-text');
  const loginLinkMobileText = document.getElementById('login-link-mobile-text');
  const verifyBadgeDesktop = document.getElementById('verify-badge-desktop');
  const verifyBadgeMobile = document.getElementById('verify-badge-mobile');

  getSession().then((data) => {
      if (!data.logged_in) return;

      [loginLink, loginLinkMobile].forEach((el) => {
        if (!el) return;
        el.href = '/account/';
      });
      if (loginLinkText) loginLinkText.textContent = 'Account';
      if (loginLinkMobileText) loginLinkMobileText.textContent = 'Account';

      // Persistent reminder badge: stays visible on every page (not just /account/)
      // until the recovery email is actually verified.
      if (!data.email_verified && data.recovery_email) {
        if (verifyBadgeDesktop) verifyBadgeDesktop.style.display = 'inline-flex';
        if (verifyBadgeMobile) verifyBadgeMobile.style.display = 'inline-flex';
      }

      // Check if all currently live subjects are owned — if so, show "Premium" instead of "Go premium".
      // NOTE: this list needs updating whenever a new subject goes live (available: true elsewhere).
      const LIVE_SUBJECTS = ['telangana-history-te', 'telangana-economy-en'];

      Promise.all(
        LIVE_SUBJECTS.map((subject_id) =>
          fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(data.user_id)}&subject_id=${encodeURIComponent(subject_id)}`)
            .then((res) => res.json())
            .then((d) => d.unlocked)
            .catch(() => false)
        )
      ).then((results) => {
        const allOwned = results.every(Boolean);
        if (allOwned) {
          document.querySelectorAll('a[href="/plans/"].btn-accent').forEach((el) => {
            el.textContent = '★ Premium';
            el.style.cursor = 'default';
            el.removeAttribute('href');
          });
        }
      });
    })
    .catch(() => {});
</script>
