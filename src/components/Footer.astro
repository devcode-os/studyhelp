---
// Shared footer, used on every page via <Footer />
// On mobile (<=720px) this is hidden entirely — its links move into a
// header "more" menu instead (see Header.astro), since a full footer
// competing with the fixed tab bar was awkward UX. Desktop unchanged.
//
// `premium`: passed by Layout.astro when the current route is a -v2
// page, so the footer picks up the indigo/lavender redesign palette
// instead of the old dark-navy theme, and every link below points at
// its -v2 equivalent instead of the classic-theme page.
const { premium = false } = Astro.props;
const year = new Date().getFullYear();
const forgotPasscodeHref = premium ? '/forgot-passcode/' : '/forgot-passcode/';
const contactHref = premium ? '/contact/' : '/contact/';
const supportHref = premium ? '/support/' : '/support/';
const termsHref = premium ? '/terms/' : '/terms/';
const refundHref = premium ? '/refund-policy/' : '/refund-policy/';
const privacyHref = premium ? '/privacy-policy/' : '/privacy-policy/';
---
<footer class:list={['site-footer', { 'sh2-theme': premium }]}>
  <div class="site-footer-inner">
    <div class="footer-col">
      <div class="footer-logo">StudyHelp</div>
      <p class="footer-tagline">Exam prep FAQs for TSPSC &amp; Telangana state exams.</p>
    </div>

    <div class="footer-col">
      <div class="footer-heading">Help &amp; Support</div>
      <a href={contactHref}>Contact Us</a>
      <a href={supportHref}>Support</a>
      <a href={forgotPasscodeHref}>Forgot Passcode</a>
    </div>

    <div class="footer-col">
      <div class="footer-heading">Legal</div>
      <a href={termsHref}>Terms &amp; Conditions</a>
      <a href={refundHref}>Refund Policy</a>
      <a href={privacyHref}>Privacy Policy</a>
    </div>
  </div>

  <div class="footer-bottom">
    &copy; {year} StudyHelp, operated by fdaytalk. All rights reserved.
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(160deg, #14102b 0%, #241a4d 100%);
    border-top: 1px solid rgba(255,255,255,0.08);
    margin-top: 40px;
  }
  .site-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 24px 24px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 24px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-logo {
    font-weight: 700;
    font-size: 18px;
    color: #ffffff;
  }
  .footer-tagline {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    margin: 4px 0 0;
    max-width: 280px;
  }
  .footer-heading {
    font-size: 13px;
    font-weight: 700;
    color: #ffcb8a;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .footer-col a {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
  }
  .footer-col a:hover {
    color: #ff9a3c;
    text-decoration: underline;
  }
  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 12px;
    color: rgba(255,255,255,0.5);
  }
  @media (max-width: 900px) {
    .site-footer {
      display: none;
    }
  }

  /* ---------- Premium theme (sh2-theme) — used only on -v2 pages via
     the `premium` prop. A fixed dark indigo block (not affected by the
     light/dark toggle), matching the visual weight of the old dark-navy
     footer instead of a light background. ---------- */
  .site-footer.sh2-theme {
    background: linear-gradient(160deg, #2E2570 0%, #4B3FA0 100%);
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .site-footer.sh2-theme .footer-logo { color: #ffffff; }
  .site-footer.sh2-theme .footer-tagline { color: rgba(255,255,255,0.65); }
  .site-footer.sh2-theme .footer-heading { color: #D8CBFF; }
  .site-footer.sh2-theme .footer-col a { color: rgba(255,255,255,0.7); }
  .site-footer.sh2-theme .footer-col a:hover { color: #ffffff; }
  .site-footer.sh2-theme .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.55);
  }
</style>
