---
// Shared footer, used on every page via <Footer />
// On mobile (<=720px) this is hidden entirely — its links move into a
// header "more" menu instead (see Header.astro), since a full footer
// competing with the fixed tab bar was awkward UX. Desktop unchanged.
//
// `premium`: passed by Layout.astro when the current route is a -v2
// page, so the footer picks up the indigo/lavender redesign palette
// instead of the old dark-navy theme, and Forgot Passcode points at
// its -v2 equivalent. Contact/Support/Terms/Refund/Privacy have no
// -v2 twin (out of scope for this redesign), so they always link to
// the one page that exists either way.
const { premium = false } = Astro.props;
const year = new Date().getFullYear();
const forgotPasscodeHref = premium ? '/forgot-passcode-v2/' : '/forgot-passcode/';
---
<footer class:list={['site-footer', { 'sh2-theme': premium }]}>
  <div class="site-footer-inner">
    <div class="footer-col">
      <div class="footer-logo">StudyHelp</div>
      <p class="footer-tagline">Exam prep FAQs for TSPSC &amp; Telangana state exams.</p>
    </div>

    <div class="footer-col">
      <div class="footer-heading">Help &amp; Support</div>
      <a href="/contact/">Contact Us</a>
      <a href="/support/">Support</a>
      <a href={forgotPasscodeHref}>Forgot Passcode</a>
    </div>

    <div class="footer-col">
      <div class="footer-heading">Legal</div>
      <a href="/terms/">Terms &amp; Conditions</a>
      <a href="/refund-policy/">Refund Policy</a>
      <a href="/privacy-policy/">Privacy Policy</a>
    </div>
  </div>

  <div class="footer-bottom">
    &copy; {year} StudyHelp, operated by fdaytalk. All rights reserved.
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(160deg, #14102b 0%, #241a4d 100%);
    border-top: 1px solid rgba(255,255,255,0.08);
    margin-top: 40px;
  }
  .site-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 24px 24px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 24px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-logo {
    font-weight: 700;
    font-size: 18px;
    color: #ffffff;
  }
  .footer-tagline {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    margin: 4px 0 0;
    max-width: 280px;
  }
  .footer-heading {
    font-size: 13px;
    font-weight: 700;
    color: #ffcb8a;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .footer-col a {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
  }
  .footer-col a:hover {
    color: #ff9a3c;
    text-decoration: underline;
  }
  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 12px;
    color: rgba(255,255,255,0.5);
  }
  @media (max-width: 900px) {
    .site-footer {
      display: none;
    }
  }

  /* ---------- Premium theme (sh2-theme, same palette as Header.astro's
     sh2-theme) — used only on -v2 pages via the `premium` prop. ---------- */
  .site-footer.sh2-theme {
    background: #EEEDF6;
    border-top: 1px solid #E7E4F5;
  }
  html[data-theme="dark"] .site-footer.sh2-theme {
    background: #121120;
    border-top: 1px solid #302C4E;
  }
  .site-footer.sh2-theme .footer-logo { color: #1C1A38; }
  html[data-theme="dark"] .site-footer.sh2-theme .footer-logo { color: #F3F1FC; }
  .site-footer.sh2-theme .footer-tagline { color: #726F92; }
  html[data-theme="dark"] .site-footer.sh2-theme .footer-tagline { color: #9C97BE; }
  .site-footer.sh2-theme .footer-heading { color: #4B3FA0; }
  html[data-theme="dark"] .site-footer.sh2-theme .footer-heading { color: #A594F5; }
  .site-footer.sh2-theme .footer-col a { color: #726F92; }
  html[data-theme="dark"] .site-footer.sh2-theme .footer-col a { color: #9C97BE; }
  .site-footer.sh2-theme .footer-col a:hover { color: #4B3FA0; }
  html[data-theme="dark"] .site-footer.sh2-theme .footer-col a:hover { color: #A594F5; }
  .site-footer.sh2-theme .footer-bottom {
    border-top: 1px solid #E7E4F5;
    color: #726F92;
  }
  html[data-theme="dark"] .site-footer.sh2-theme .footer-bottom {
    border-top: 1px solid #302C4E;
    color: #9C97BE;
  }
</style>
