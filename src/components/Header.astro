---
// Shared header, used on every page via <Header />
// Highlights the current page's nav link if `active` prop is passed (e.g. active="home")
const { active = '' } = Astro.props;
---
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo">StudyHelp</a>

    <nav class="nav-desktop">
      <a href="/" class:list={{ active: active === 'home' }}>Home</a>
      <a href="/subjects/" class:list={{ active: active === 'subjects' }}>Subjects</a>
      <a href="/plans/" class:list={{ active: active === 'plans' }}>Plans</a>
      <a href="/about/" class:list={{ active: active === 'about' }}>About</a>
    </nav>

    <div class="header-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode">
        <span class="icon-light">&#9728;</span>
        <span class="icon-dark">&#9789;</span>
      </button>
      <a href="/login/" id="login-link" class="btn btn-outline nav-desktop-only">Login</a>
      <a href="/plans/" class="btn btn-accent nav-desktop-only">Go premium</a>
      <button id="menu-toggle" class="menu-toggle" aria-label="Open menu">&#9776;</button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu">
    <a href="/">Home</a>
    <a href="/subjects/">Subjects</a>
    <a href="/plans/">Plans</a>
    <a href="/about/">About</a>
    <a href="/login/" id="login-link-mobile">Login</a>
    <a href="/plans/" class="btn btn-accent" style="text-align:center;">Go premium</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  .site-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .logo {
    font-weight: 700;
    font-size: 24px;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }
  .nav-desktop {
    display: flex;
    gap: 24px;
    font-size: 16px;
  }
  .nav-desktop a {
    text-decoration: none;
    color: var(--muted);
  }
  .nav-desktop a.active {
    color: var(--text);
    font-weight: 600;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .btn {
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--border);
    color: var(--text);
    background: transparent;
    cursor: pointer;
  }
  .btn-accent {
    border-color: var(--accent);
    background: var(--accent-bg);
    color: var(--accent);
  }
  .theme-toggle {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icon-dark { display: none; }
  html[data-theme="dark"] .icon-light { display: none; }
  html[data-theme="dark"] .icon-dark { display: inline; }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 20px;
    cursor: pointer;
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--border);
  }
  .mobile-menu a {
    padding: 10px 8px;
    text-decoration: none;
    color: var(--text);
    font-size: 16px;
    border-radius: 6px;
  }
  .mobile-menu.open {
    display: flex;
  }

  @media (max-width: 720px) {
    .nav-desktop-only { display: none; }
    .nav-desktop { display: none; }
    .menu-toggle { display: block; }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
    });
  }

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('studyhelp-theme', next);
    });
  }

  // TEMP: reflects stored email as "logged in" state, since real OTP login/session
  // isn't built yet. Once OTP login exists, replace this check with the real session check.
  const storedEmail = localStorage.getItem('studyhelp_email');
  const loginLink = document.getElementById('login-link');
  const loginLinkMobile = document.getElementById('login-link-mobile');

  if (storedEmail) {
    [loginLink, loginLinkMobile].forEach((el) => {
      if (!el) return;
      el.textContent = 'Logout';
      el.href = '#';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        if (confirm('Log out of StudyHelp on this device?')) {
          localStorage.removeItem('studyhelp_email');
          window.location.href = '/';
        }
      });
    });

    // Check if all currently live subjects are owned — if so, show "Premium" instead of "Go premium".
    // NOTE: this list needs updating whenever a new subject goes live (available: true elsewhere).
    const LIVE_SUBJECTS = ['telangana-history-te', 'telangana-economy-en'];
    const WORKER_URL = 'https://studyhelp-payments.fdaytalk.workers.dev';

    Promise.all(
      LIVE_SUBJECTS.map((subject_id) =>
        fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(storedEmail)}&subject_id=${encodeURIComponent(subject_id)}`)
          .then((res) => res.json())
          .then((data) => data.unlocked)
          .catch(() => false)
      )
    ).then((results) => {
      const allOwned = results.every(Boolean);
      if (allOwned) {
        document.querySelectorAll('a[href="/plans/"].btn-accent').forEach((el) => {
          el.textContent = '★ Premium';
          el.style.cursor = 'default';
          el.removeAttribute('href');
        });
      }
    });
  }
</script>
