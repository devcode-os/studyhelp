---
// Shared header, used on every page via <Header />
// Highlights the current page's nav link if `active` prop is passed (e.g. active="home")
// `compact` prop: when true, renders the reading-mode header (back arrow + title + progress)
// used only on the chapter page. Desktop nav and mobile tab bar are both suppressed in compact mode.
const { active = '', compact = false, backHref = '/', title = '', progress = '' } = Astro.props;
---

{compact ? (
  <header class="chapter-header">
    <a href={backHref} class="chapter-back" aria-label="Back">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </a>
    <span class="chapter-title">{title}</span>
    {progress && <span class="chapter-progress">{progress}</span>}
    <button type="button" class="theme-toggle chapter-theme-toggle js-theme-toggle" aria-label="Toggle dark mode">
      <i class="ti ti-sun icon-light" aria-hidden="true"></i>
      <i class="ti ti-moon icon-dark" aria-hidden="true"></i>
    </button>
  </header>
) : (
  <>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="logo">StudyHelp</a>

        <nav class="nav-desktop">
          <a href="/" class:list={{ active: active === 'home' }}>Home</a>
          <a href="/subjects/" class:list={{ active: active === 'subjects' }}>Subjects</a>
          <a href="/papers/" class:list={{ active: active === 'papers' }}>Papers</a>
          <a href="/plans/" class:list={{ active: active === 'plans' }}>Plans</a>
          <a href="/about/" class:list={{ active: active === 'about' }}>About</a>
        </nav>

        <div class="header-actions">
          <button class="theme-toggle js-theme-toggle" aria-label="Toggle dark mode">
            <i class="ti ti-sun icon-light" aria-hidden="true"></i>
            <i class="ti ti-moon icon-dark" aria-hidden="true"></i>
          </button>

          <div class="bell-wrap" style="display:none;">
            <button id="bell-btn" class="theme-toggle bell-btn" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
              <i class="ti ti-bell" aria-hidden="true"></i>
              <span id="bell-badge" class="bell-badge" style="display:none;"></span>
            </button>
            <div id="bell-dropdown" class="more-menu-dropdown bell-dropdown" role="menu">
              <div class="bell-dropdown-header">
                <span>Notifications</span>
                <button type="button" id="bell-clear-all" class="bell-clear-all">Clear all</button>
              </div>
              <div id="bell-list" class="bell-list">
                <div class="bell-empty">No notifications</div>
              </div>
            </div>
          </div>

          <div class="more-menu-wrap">
            <button id="more-menu-btn" class="theme-toggle more-menu-btn" aria-label="More" aria-haspopup="true" aria-expanded="false">
              <i class="ti ti-dots-vertical" aria-hidden="true"></i>
            </button>
            <div id="more-menu-dropdown" class="more-menu-dropdown" role="menu">
              <a href="/papers/" role="menuitem">Previous Papers</a>
              <a href="/contact/" role="menuitem">Contact us</a>
              <a href="/support/" role="menuitem">Support</a>
              <a href="/forgot-passcode/" role="menuitem">Forgot passcode</a>
              <div class="more-menu-divider"></div>
              <a href="/terms/" role="menuitem">Terms &amp; conditions</a>
              <a href="/refund-policy/" role="menuitem">Refund policy</a>
              <a href="/privacy-policy/" role="menuitem">Privacy policy</a>
            </div>
          </div>

          <a href="/login/" id="login-link" class="btn btn-outline nav-desktop-only">
            <span id="login-link-text">Login</span><span id="verify-badge-desktop" class="verify-badge" style="display:none;">!</span>
          </a>
          <a href="/plans/" class="btn btn-accent nav-desktop-only">Go premium</a>
        </div>
      </div>
    </header>

    <!-- Mobile bottom tab bar. Only rendered/visible under the 720px breakpoint via CSS.
         Home dropped — the "StudyHelp" logo (visible on every page, already
         linked to "/") serves as the way back to Home instead, freeing up
         the tab bar for 3 clear destinations. -->
    <nav class="mobile-tabbar" aria-label="Primary">
      <a href="/subjects/" class:list={{ 'tab-active': active === 'subjects' }}>
        <i class="ti ti-books" aria-hidden="true"></i>
        <span>Subjects</span>
      </a>
      <a href="/plans/" class:list={{ 'tab-active': active === 'plans' }}>
        <i class="ti ti-shopping-cart" aria-hidden="true"></i>
        <span>Plans</span>
      </a>
      <a href="/login/" id="login-link-mobile" class:list={{ 'tab-active': active === 'account' }}>
        <span class="tab-icon-wrap">
          <i class="ti ti-user" aria-hidden="true"></i>
          <span id="verify-badge-mobile" class="verify-dot" style="display:none;"></span>
        </span>
        <span id="login-link-mobile-text">Login</span>
      </a>
    </nav>
  </>
)}

<style>
  .site-header {
    background: linear-gradient(160deg, #14102b 0%, #241a4d 100%);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .site-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .logo {
    font-weight: 700;
    font-size: 24px;
    text-decoration: none;
    color: #ffffff;
    flex-shrink: 0;
  }
  .nav-desktop {
    display: flex;
    gap: 24px;
    font-size: 16px;
  }
  .nav-desktop a {
    text-decoration: none;
    color: rgba(255,255,255,0.6);
  }
  .nav-desktop a.active {
    color: #ffffff;
    font-weight: 600;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .btn {
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.2);
    color: #ffffff;
    background: transparent;
    cursor: pointer;
  }
  .btn-accent {
    border: none;
    background: linear-gradient(90deg, #ff9a3c, #ffb35c);
    color: #2a1400;
    font-weight: 700;
  }
  #login-link {
    position: relative;
  }
  .verify-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #ff6b6b;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 700;
    margin-left: 6px;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .theme-toggle {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.06);
    color: #ffffff;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- Notification bell — logged-in users only, JS toggles
     .bell-wrap's display from none to flex once /me confirms a session.
     Reuses .more-menu-dropdown's positioning/shadow/border so it feels
     like one consistent dropdown language, not a new visual pattern. ---------- */
  .bell-wrap {
    position: relative;
  }
  .bell-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 9px;
    height: 9px;
    background: #ff6b6b;
    border-radius: 50%;
    border: 1.5px solid #1a1438;
  }
  .bell-dropdown {
    width: 320px;
    max-height: 420px;
    display: none;
    flex-direction: column;
    padding: 0;
  }
  .bell-dropdown.open {
    display: flex;
  }
  .bell-dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
  }
  .bell-clear-all {
    background: none;
    border: none;
    color: #ffb35c;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
  }
  .bell-list {
    overflow-y: auto;
    max-height: 360px;
    padding: 6px;
  }
  /* .bell-item, .bell-item-title, .bell-item-body, .bell-empty are injected
     at RUNTIME via innerHTML in renderBell() below — Astro can only scope
     elements present in this file's own static template, so these classes
     are declared again in a separate <style is:global> block further down,
     not here. Leaving them in this scoped block would silently never apply,
     which is exactly what caused the huge/near-invisible default-black text
     bug — Astro's scoping attribute never reached these JS-created nodes. */
  .icon-dark { display: none; }
  html[data-theme="dark"] .icon-light { display: none; }
  html[data-theme="dark"] .icon-dark { display: inline; }

  /* ---------- "More" menu — mobile only. Holds the links that used to
     live in the footer (Contact, Support, Forgot passcode, Terms,
     Refund, Privacy), since the footer is hidden on mobile and these
     still need to be reachable somewhere. Desktop keeps using the
     footer for these, so this button stays hidden there entirely. ---------- */
  .more-menu-wrap {
    display: none;
    position: relative;
  }
  .more-menu-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    padding: 6px;
    z-index: 60;
  }
  .more-menu-dropdown.open {
    display: block;
  }
  .more-menu-dropdown a {
    display: block;
    padding: 10px 12px;
    font-size: 14px;
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
  }
  .more-menu-dropdown a:active {
    background: rgba(255,255,255,0.08);
  }
  .more-menu-divider {
    height: 1px;
    background: rgba(255,255,255,0.1);
    margin: 6px 4px;
  }

  @media (max-width: 900px) {
    .more-menu-wrap { display: block; }
  }

  /* ---------- Bell dropdown on narrow screens — the fixed 320px width
     plus `right: 0` anchoring overflows off the left edge on phones (the
     header itself is only ~360-400px wide), cutting off "Notifications"
     and the message text. Below 480px, switch to a viewport-relative width
     anchored so it never runs past either screen edge, instead of a fixed
     px width positioned only relative to the bell icon. ---------- */
  @media (max-width: 480px) {
    .bell-dropdown {
      position: fixed;
      top: 64px;
      left: 12px;
      right: 12px;
      width: auto;
      max-width: none;
    }
  }

  /* ---------- Mobile bottom tab bar ---------- */
  .mobile-tabbar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: linear-gradient(160deg, #14102b 0%, #241a4d 100%);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .mobile-tabbar {
    display: none;
    justify-content: space-around;
    align-items: stretch;
  }
  .mobile-tabbar a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 8px 4px 7px;
    text-decoration: none;
    color: rgba(255,255,255,0.75);
    font-size: 11px;
    transition: color 0.18s ease;
  }
  .mobile-tabbar a i {
    font-size: 21px;
    transition: transform 0.18s ease, color 0.18s ease;
  }
  .mobile-tabbar a.tab-active {
    color: #ff9a3c;
  }
  .mobile-tabbar a.tab-active i {
    transform: translateY(-1px);
  }
  .mobile-tabbar a:active {
    transform: scale(0.96);
  }
  .tab-icon-wrap {
    position: relative;
    display: inline-flex;
  }
  .verify-dot {
    position: absolute;
    top: -1px;
    right: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6b6b;
    border: 1.5px solid #1a1438;
  }

  /* ---------- Compact chapter-reading header ---------- */
  .chapter-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(160deg, #14102b 0%, #241a4d 100%);
    color: #ffffff;
    padding: 13px 16px;
  }
  .chapter-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #ffffff;
    flex-shrink: 0;
  }
  .chapter-back i {
    font-size: 20px;
  }
  .chapter-title {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chapter-progress {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    flex-shrink: 0;
  }
  .chapter-theme-toggle {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.08);
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .nav-desktop-only { display: none; }
    .nav-desktop { display: none; }
    .mobile-tabbar { display: flex; }
  }
</style>

<style is:global>
  /* ---------- Notification bell — runtime-injected content ----------
     These elements are created via innerHTML inside renderBell() in the
     script below, at runtime in the browser, not at Astro build time.
     Astro's scoped <style> above only reaches elements physically written
     in this file's own template, so anything JS creates later needs its
     styling declared here instead, in a global (unscoped) block, or the
     rules above silently never match and the browser falls back to
     unstyled defaults — oversized, near-black text, exactly what showed
     up before this fix. */
  .bell-item {
    padding: 10px 8px;
    border-radius: 8px;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .bell-item:last-child {
    border-bottom: none;
  }
  .bell-item:hover {
    background: rgba(255,255,255,0.06);
  }
  .bell-item.unread {
    background: rgba(255,107,107,0.08);
  }
  .bell-item-title {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 3px;
    line-height: 1.35;
  }
  .bell-item-body {
    font-size: 13px;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
  }
  .bell-empty {
    padding: 22px 14px;
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-size: 13px;
  }
</style>

<script is:inline>
  // WORKER_URL hoisted to top-of-script scope (was previously declared inside
  // the window.__shSessionInit block below, out of reach for initBell() which
  // is defined earlier in this same script — that scoping bug meant every
  // announcements fetch silently threw ReferenceError inside its try/catch,
  // so the bell rendered fine but never actually loaded data. Declared with
  // `var` (not const) so re-running this script block on chapter pages'
  // second Header instance doesn't throw "already declared" in the same scope.
  if (typeof window.__shWorkerUrl === 'undefined') {
    window.__shWorkerUrl = 'https://api.studyhelp.fdaytalk.com';
  }
  var WORKER_URL = window.__shWorkerUrl;

  // Chapter pages mount BOTH Header instances (compact + full desktop) at once —
  // CSS only hides one visually, both still exist in the DOM and this script
  // block runs once per instance. Binding a click listener directly to each
  // button would attach it twice, so a single tap fires both listeners and the
  // theme flips twice in a row (visually: nothing happens). A single delegated
  // listener, guarded so it's only ever attached once regardless of how many
  // times this script block runs, avoids that entirely.
  if (!window.__shThemeToggleBound) {
    window.__shThemeToggleBound = true;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.js-theme-toggle');
      if (!btn) return;
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('studyhelp-theme', next);
    });
  }

  const moreMenuBtn = document.getElementById('more-menu-btn');
  const moreMenuDropdown = document.getElementById('more-menu-dropdown');
  if (moreMenuBtn && moreMenuDropdown) {
    moreMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = moreMenuDropdown.classList.toggle('open');
      moreMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if (!moreMenuDropdown.contains(e.target) && e.target !== moreMenuBtn) {
        moreMenuDropdown.classList.remove('open');
        moreMenuBtn.setAttribute('aria-expanded', 'false');
      }
    });
    moreMenuDropdown.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        moreMenuDropdown.classList.remove('open');
        moreMenuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // ---------- Notification bell — logged-in users only. Bell markup stays
  // display:none (set inline in the HTML above) until the session check
  // below confirms a real login; a logged-out visitor never sees the icon
  // render, and this function is never even called for them. ----------
  // GUARD: like the theme-toggle listener above, chapter pages mount TWO
  // Header instances at once, so this needs the same once-only binding
  // pattern — attaching per-instance would double-fire dropdown toggles.
  let bellAnnouncements = [];

  function initBell() {
    if (window.__shBellBound) return;
    window.__shBellBound = true;

    const bellBtn = document.getElementById('bell-btn');
    const bellDropdown = document.getElementById('bell-dropdown');
    const bellBadge = document.getElementById('bell-badge');
    const bellList = document.getElementById('bell-list');
    const bellClearAll = document.getElementById('bell-clear-all');
    if (!bellBtn || !bellDropdown) return;

    function renderBell() {
      const unreadCount = bellAnnouncements.filter((a) => a.is_new).length;
      if (bellBadge) bellBadge.style.display = unreadCount > 0 ? 'block' : 'none';

      if (bellAnnouncements.length === 0) {
        bellList.innerHTML = '<div class="bell-empty">No notifications</div>';
        return;
      }

      bellList.innerHTML = bellAnnouncements.map((a) => `
        <div class="bell-item ${a.is_new ? 'unread' : ''}" data-id="${a.id}" data-link="${a.link_url || ''}">
          <div class="bell-item-title">${a.title}</div>
          <div class="bell-item-body">${a.body}</div>
        </div>
      `).join('');

      bellList.querySelectorAll('.bell-item').forEach((item) => {
        item.addEventListener('click', () => {
          const link = item.getAttribute('data-link');
          if (link) window.location.href = link;
        });
      });
    }

    async function loadBellAnnouncements() {
      try {
        const res = await fetch(`${WORKER_URL}/announcements/list`, { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        bellAnnouncements = data.announcements || [];
        renderBell();
      } catch (err) {
        // fail silently — notifications are non-critical
      }
    }

    bellBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = bellDropdown.classList.toggle('open');
      bellBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

      // Marks whatever is currently unread as seen the moment the dropdown
      // opens — clears the red flag for those, but anything added to the
      // list AFTER this point stays flagged red until opened again.
      if (isOpen) {
        const unseenIds = bellAnnouncements.filter((a) => a.is_new).map((a) => a.id);
        if (unseenIds.length > 0) {
          if (bellBadge) bellBadge.style.display = 'none';
          bellAnnouncements.forEach((a) => { a.is_new = false; });
          fetch(`${WORKER_URL}/announcements/mark-seen`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: unseenIds }),
          }).catch(() => {});
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (!bellDropdown.contains(e.target) && e.target !== bellBtn) {
        bellDropdown.classList.remove('open');
        bellBtn.setAttribute('aria-expanded', 'false');
      }
    });

    if (bellClearAll) {
      bellClearAll.addEventListener('click', (e) => {
        e.stopPropagation();
        bellAnnouncements = [];
        renderBell();
        fetch(`${WORKER_URL}/announcements/clear`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ all: true }),
        }).catch(() => {});
      });
    }

    loadBellAnnouncements();
  }

  // Real session check via cookie-backed /me endpoint. UNCHANGED from previous version —
  // same Worker URL, same caching, same entitlement check. Only the DOM targets are
  // extended to also update the new mobile tab bar's Account tab.
  //
  // GUARD: chapter pages ([slug].astro) render TWO <Header> instances on the same
  // page (one full desktop header, one compact mobile header — CSS toggles which
  // is VISIBLE, but both still MOUNT and both still run this script). Without this
  // guard, /me and /check-access fire twice per page load. window.__shSessionInit
  // ensures the actual session-check network calls below only ever run once per
  // page, regardless of how many Header instances are present in the DOM.
  if (!window.__shSessionInit) {
    window.__shSessionInit = true;

  // WORKER_URL now comes from the hoisted `var` at the top of this script
  // (see comment there) — no longer re-declared here, since a second
  // `const WORKER_URL` in the same script scope would throw on chapter
  // pages' second Header instance.
  const SESSION_CACHE_KEY = 'sh_session_cache';
  const SESSION_CACHE_TTL = 5 * 60 * 1000; // 5 minutes

  function getCachedSession() {
    try {
      const raw = sessionStorage.getItem(SESSION_CACHE_KEY);
      if (!raw) return null;
      const cached = JSON.parse(raw);
      if (Date.now() - cached.ts > SESSION_CACHE_TTL) return null;
      return cached.data.logged_in ? cached.data : null;
    } catch (err) {
      return null;
    }
  }

  function setCachedSession(data) {
    try {
      sessionStorage.setItem(SESSION_CACHE_KEY, JSON.stringify({ data, ts: Date.now() }));
    } catch (err) {
      // sessionStorage unavailable (private mode edge cases) — just skip caching
    }
  }

  function getSession() {
    const cached = getCachedSession();
    if (cached) return Promise.resolve(cached);

    return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
      .then((res) => res.json())
      .then((data) => {
        setCachedSession(data);
        return data;
      })
      .catch(() => ({ logged_in: false }));
  }

  const loginLink = document.getElementById('login-link');
  const loginLinkMobile = document.getElementById('login-link-mobile');
  const loginLinkText = document.getElementById('login-link-text');
  const loginLinkMobileText = document.getElementById('login-link-mobile-text');
  const verifyBadgeDesktop = document.getElementById('verify-badge-desktop');
  const verifyBadgeMobile = document.getElementById('verify-badge-mobile');

  // Exposed globally so other page-level scripts (e.g. [subject]/index.astro's
  // unlock-status check) can await this SAME request/result instead of firing
  // their own independent /me call. This is the single source of truth for
  // session state on any given page load — do not call getSession() again
  // from another script; use window.__shSessionPromise instead.
  window.__shSessionPromise = getSession();

  window.__shSessionPromise.then((data) => {
      if (!data.logged_in) return;

      // Bell only shown once a real session is confirmed — a guest never
      // sees the icon appear, not just an empty dropdown behind it.
      document.querySelectorAll('.bell-wrap').forEach((el) => {
        el.style.display = 'flex';
      });
      initBell();

      [loginLink, loginLinkMobile].forEach((el) => {
        if (!el) return;
        el.href = '/account/';
      });
      if (loginLinkText) loginLinkText.textContent = 'Account';
      if (loginLinkMobileText) loginLinkMobileText.textContent = 'Account';

      if (!data.email_verified && data.recovery_email) {
        if (verifyBadgeDesktop) verifyBadgeDesktop.style.display = 'inline-flex';
        if (verifyBadgeMobile) verifyBadgeMobile.style.display = 'inline-block';
      }

      // Fetched from the same public endpoint /plans/ uses, instead of a
      // hardcoded slug list — a newly-launched subject is picked up here
      // automatically without needing a Header.astro edit + redeploy.
      fetch(`${WORKER_URL}/subjects/public`)
        .then((res) => res.json())
        .then((subjData) => {
          const LIVE_SUBJECTS = (subjData.subjects || []).map((s) => s.id);
          if (LIVE_SUBJECTS.length === 0) return;

          Promise.all(
            LIVE_SUBJECTS.map((subject_id) =>
              fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(data.user_id)}&subject_id=${encodeURIComponent(subject_id)}`)
                .then((res) => res.json())
                .then((d) => d.unlocked)
                .catch(() => false)
            )
          ).then((results) => {
            const allOwned = results.every(Boolean);
            if (allOwned) {
              document.querySelectorAll('a[href="/plans/"].btn-accent').forEach((el) => {
                el.textContent = '★ Premium';
                el.style.cursor = 'default';
                el.removeAttribute('href');
              });
            }
          });
        })
        .catch(() => {});
    })
    .catch(() => {});
  } // end window.__shSessionInit guard
</script>
