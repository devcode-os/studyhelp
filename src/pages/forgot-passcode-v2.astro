---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="Forgot Passcode - StudyHelp" description="Reset your StudyHelp passcode using your registered recovery email.">
  <Header active="login" theme="premium" />

  <div class="page-wide auth-page">
    <div class="auth-card">

      <div id="step-1">
        <div class="auth-icon"><i class="ti ti-key"></i></div>
        <h1>Forgot passcode</h1>
        <p class="sub">We'll send a reset code to your registered recovery email.</p>

        <form id="send-otp-form">
          <label for="phone">Phone number</label>
          <div class="phone-input">
            <span class="phone-prefix">+91</span>
            <input type="tel" id="phone" name="phone" required inputmode="numeric" maxlength="10" autocomplete="tel" placeholder="10-digit mobile number" />
          </div>

          <div id="error-msg-1" class="error-msg" style="display:none;">
            <i class="ti ti-alert-circle"></i><span id="error-text-1"></span>
          </div>

          <button type="submit" class="btn-block" id="send-otp-btn">
            <span class="btn-label">Send reset code</span>
            <i class="ti ti-loader-2 btn-spinner" style="display:none;"></i>
          </button>
        </form>

        <p class="alt-action">Can't access your recovery email? <a href="/support/">Contact Support</a></p>
      </div>

      <div id="step-2" style="display:none;">
        <div class="auth-icon"><i class="ti ti-mail-opened"></i></div>
        <h1>Enter reset code</h1>
        <p class="sub" id="step-2-sub">Check your recovery email for a 6-digit code. It expires in 10 minutes.</p>

        <form id="reset-form">
          <label for="otp">Reset code</label>
          <input type="text" id="otp" name="otp" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

          <label for="new_passcode">New 6-digit passcode</label>
          <input type="text" id="new_passcode" name="new_passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

          <label for="confirm_new_passcode">Confirm new passcode</label>
          <input type="text" id="confirm_new_passcode" name="confirm_new_passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

          <div id="error-msg-2" class="error-msg" style="display:none;">
            <i class="ti ti-alert-circle"></i><span id="error-text-2"></span>
          </div>
          <div id="success-msg" class="success-msg" style="display:none;">
            <i class="ti ti-circle-check"></i><span id="success-text"></span>
          </div>

          <button type="submit" class="btn-block" id="reset-btn">
            <span class="btn-label">Reset passcode</span>
            <i class="ti ti-loader-2 btn-spinner" style="display:none;"></i>
          </button>
        </form>

        <p class="alt-action">
          Didn't get the code? <button type="button" id="resend-btn" class="link-btn">Send again</button>
        </p>
      </div>

    </div>
  </div>

  <style is:global>
    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-green: #26946A;
      --sh2-text: #211F38;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    @media (min-width: 1200px) {
      .page-wide {
        max-width: 800px;
      }
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-green: #5FCB9B;
      --sh2-text: #EFEDFB;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&display=swap');

    .auth-page { max-width: 440px !important; }
    @media (max-width: 900px) {
      .auth-page {
        padding: 16px 16px calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }

    .auth-card {
      width: 100%;
      background: var(--sh2-surface);
      border: 1px solid var(--sh2-line);
      border-radius: 20px;
      padding: 32px 28px;
      box-shadow: var(--sh2-shadow);
      animation: card-in 0.35s ease-out;
      color: var(--sh2-ink);
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .auth-icon {
      width: 48px; height: 48px; border-radius: 14px;
      background: linear-gradient(135deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 16px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
    }
    .auth-card h1 {
      font-family: 'Manrope', sans-serif;
      font-size: 1.4rem; margin-bottom: 4px; color: var(--sh2-ink); font-weight: 800;
    }
    .auth-card .sub { margin-bottom: 22px; color: var(--sh2-text-soft); font-size: 0.86rem; }
    .auth-card label {
      display: block; font-size: 0.78rem; font-weight: 700;
      color: var(--sh2-text-soft); margin: 16px 0 6px;
    }
    .auth-card input {
      margin-bottom: 0; width: 100%; box-sizing: border-box;
      padding: 11px 14px; border-radius: 12px; font-size: 0.95rem;
      background: var(--sh2-surface-2);
      border: 1.5px solid var(--sh2-line);
      color: var(--sh2-ink);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .auth-card input::placeholder { color: var(--sh2-text-soft); opacity: 0.7; }
    .auth-card input:focus {
      outline: none;
      border-color: var(--sh2-indigo);
      box-shadow: 0 0 0 3px rgba(75,63,160,0.15);
      background: var(--sh2-surface);
    }
    .phone-input {
      display: flex; align-items: stretch;
      border: 1.5px solid var(--sh2-line);
      border-radius: 12px; overflow: hidden;
      background: var(--sh2-surface-2);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .phone-input:focus-within {
      border-color: var(--sh2-indigo);
      box-shadow: 0 0 0 3px rgba(75,63,160,0.15);
      background: var(--sh2-surface);
    }
    .phone-prefix {
      display: flex; align-items: center; padding: 0 12px;
      background: transparent; color: var(--sh2-text-soft); font-weight: 700; font-size: 0.95rem;
      border-right: 1.5px solid var(--sh2-line);
    }
    .phone-input input { border: none; border-radius: 0; background: transparent; flex: 1; }
    .phone-input input:focus { box-shadow: none; background: transparent; }
    .code-input {
      font-size: clamp(18px, 5.5vw, 24px); font-weight: 700;
      letter-spacing: clamp(4px, 2.2vw, 10px); text-align: center;
      font-family: monospace; padding-left: 8px; padding-right: 8px;
    }
    .code-input::placeholder { letter-spacing: clamp(4px, 2.2vw, 10px); }
    .error-msg, .success-msg {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 12px; border-radius: 8px; font-size: 0.82rem; margin: 16px 0 0;
    }
    .error-msg { background: rgba(198,40,40,0.08); color: #c0392b; border-left: 3px solid #c0392b; }
    html[data-theme="dark"] .error-msg { background: rgba(198,40,40,0.15); color: #ff9b93; }
    .success-msg { background: rgba(38,148,106,0.1); color: var(--sh2-green); border-left: 3px solid var(--sh2-green); }
    .btn-block {
      width: 100%; box-sizing: border-box; margin-top: 24px; padding: 13px; font-size: 0.95rem; font-weight: 700;
      border-radius: 12px; border: none;
      background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
      transition: transform 0.1s, opacity 0.15s;
    }
    .btn-block:hover:not(:disabled) { transform: translateY(-1px); }
    .btn-block:active:not(:disabled) { transform: translateY(0); }
    .btn-block:disabled { opacity: 0.65; cursor: not-allowed; }
    .btn-spinner { animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .alt-action { text-align: center; margin-top: 18px; font-size: 0.8rem; color: var(--sh2-text-soft); }
    .alt-action a { color: var(--sh2-indigo); font-weight: 700; text-decoration: underline; }
    .link-btn {
      background: none; border: none; color: var(--sh2-indigo); font-weight: 700;
      font-size: 0.8rem; cursor: pointer; padding: 0; text-decoration: underline;
    }
    .link-btn:disabled { color: var(--sh2-text-soft); cursor: not-allowed; text-decoration: none; }

    @media (max-width: 720px) {
      .auth-card { padding: 22px 18px; border-radius: 18px; }
      .auth-icon { display: none; }
      .auth-card h1 { font-size: 1.15rem; margin-bottom: 2px; }
      .auth-card .sub { font-size: 0.78rem; line-height: 1.3; margin-bottom: 10px; }
      .auth-card label { margin: 10px 0 4px; font-size: 0.72rem; }
      .auth-card input:not(.code-input) { padding: 9px 12px; font-size: 0.88rem; }
      .phone-prefix { padding: 0 8px; font-size: 0.88rem; }
      .code-input { padding-top: 8px; padding-bottom: 8px; font-size: clamp(16px, 5vw, 20px) !important; }
      .btn-block { padding: 11px; font-size: 0.88rem; margin-top: 14px; }
      .alt-action { margin-top: 12px; font-size: 0.78rem; }
    }
    @media (max-width: 380px) {
      .auth-card { padding: 20px 14px; }
    }
  </style>

  <script>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    const step1 = document.getElementById('step-1');
    const step2 = document.getElementById('step-2');
    const step2Sub = document.getElementById('step-2-sub');
    const sendOtpForm = document.getElementById('send-otp-form');
    const resetForm = document.getElementById('reset-form');
    const errorMsg1 = document.getElementById('error-msg-1');
    const errorText1 = document.getElementById('error-text-1');
    const errorMsg2 = document.getElementById('error-msg-2');
    const errorText2 = document.getElementById('error-text-2');
    const successMsg = document.getElementById('success-msg');
    const successText = document.getElementById('success-text');
    const sendOtpBtn = document.getElementById('send-otp-btn');
    const resetBtn = document.getElementById('reset-btn');
    const resendBtn = document.getElementById('resend-btn');

    function setBtnLoading(btn, isLoading, labelWhenIdle) {
      const label = btn.querySelector('.btn-label');
      const spinner = btn.querySelector('.btn-spinner');
      btn.disabled = isLoading;
      if (label) label.textContent = isLoading ? 'Please wait...' : labelWhenIdle;
      if (spinner) spinner.style.display = isLoading ? 'inline-block' : 'none';
    }

    let currentPhone = '';
    let debounceTimer = null;

    // Strip non-digit characters as the user types (pattern/inputmode alone don't block typing on desktop)
    ['phone', 'otp', 'new_passcode', 'confirm_new_passcode'].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      const maxLen = id === 'phone' ? 10 : 6;
      el.addEventListener('input', () => {
        el.value = el.value.replace(/\D/g, '').slice(0, maxLen);
      });
    });

    // 60-second client-side debounce on send/resend (server also enforces its own
    // 3-per-hour rate limit independently — this is just to prevent accidental double-clicks).
    function startDebounce(btn) {
      let secondsLeft = 60;
      btn.disabled = true;
      const originalText = 'Send again';
      btn.textContent = `Send again (${secondsLeft}s)`;

      debounceTimer = setInterval(() => {
        secondsLeft -= 1;
        btn.textContent = `${originalText} (${secondsLeft}s)`;
        if (secondsLeft <= 0) {
          clearInterval(debounceTimer);
          btn.disabled = false;
          btn.textContent = originalText;
        }
      }, 1000);
    }

    async function sendOtp(phone, errorEl, errorTextEl) {
      errorEl.style.display = 'none';
      try {
        const res = await fetch(`${WORKER_URL}/forgot-passcode/send-otp`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone }),
        });
        const data = await res.json();

        if (!res.ok) {
          errorTextEl.textContent = data.error || 'Something went wrong. Please try again.';
          errorEl.style.display = 'flex';
          return { ok: false };
        }

        // Backend returns a pre-masked email (e.g. "f***@gmail.com") — never
        // the full address, since this response is visible in devtools/
        // network tab on any device, including shared/public ones.
        return { ok: true, maskedEmail: data.masked_email || null };
      } catch (err) {
        errorTextEl.textContent = 'Network error. Please check your connection and try again.';
        errorEl.style.display = 'flex';
        return { ok: false };
      }
    }

    sendOtpForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const phone = sendOtpForm.phone.value.trim();
      setBtnLoading(sendOtpBtn, true, 'Send reset code');

      const result = await sendOtp(phone, errorMsg1, errorText1);

      if (result.ok) {
        currentPhone = phone;
        if (result.maskedEmail) {
          step2Sub.textContent = `Enter the 6-digit code sent to ${result.maskedEmail}`;
        }
        step1.style.display = 'none';
        step2.style.display = 'block';
        startDebounce(resendBtn);
      } else {
        setBtnLoading(sendOtpBtn, false, 'Send reset code');
      }
    });

    resendBtn.addEventListener('click', async () => {
      resendBtn.disabled = true;
      const result = await sendOtp(currentPhone, errorMsg2, errorText2);
      if (result.ok) {
        errorMsg2.style.display = 'none';
        successText.textContent = 'A new code has been sent.';
        successMsg.style.display = 'flex';
      }
      startDebounce(resendBtn);
    });

    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg2.style.display = 'none';
      successMsg.style.display = 'none';
      setBtnLoading(resetBtn, true, 'Reset passcode');

      const payload = {
        phone: currentPhone,
        otp: resetForm.otp.value.trim(),
        new_passcode: resetForm.new_passcode.value.trim(),
        confirm_new_passcode: resetForm.confirm_new_passcode.value.trim(),
      };

      try {
        const res = await fetch(`${WORKER_URL}/forgot-passcode/reset`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          errorText2.textContent = data.error || 'Something went wrong. Please try again.';
          errorMsg2.style.display = 'flex';
          setBtnLoading(resetBtn, false, 'Reset passcode');
          return;
        }

        successText.textContent = 'Passcode reset successfully. Redirecting to login...';
        successMsg.style.display = 'flex';
        setTimeout(() => { window.location.href = '/login-v2/'; }, 1500);
      } catch (err) {
        errorText2.textContent = 'Network error. Please check your connection and try again.';
        errorMsg2.style.display = 'flex';
        setBtnLoading(resetBtn, false, 'Reset passcode');
      }
    });
  </script>

  <script is:inline>
    document.body.classList.add('sh2-page');
  </script>
</Layout>
