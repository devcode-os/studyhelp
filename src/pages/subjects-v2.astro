---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getSubjectMeta } from '../data/subjectsMeta.js';
import { getFullDataset } from '../lib/currentAffairs.js';

// ============================================================
// Total question count per CA section, across ALL months (not just
// whatever months a given guest/user happened to have selected in
// sessionStorage on the read page) — gives the CA recap card a stable
// "X of Y questions" denominator, same shape as a subject's chapterCount.
// Same section-name aliasing as current-affairs-read-v2.astro so counts
// merge correctly regardless of which name a given month's file used.
// ============================================================
const CA_SECTION_ALIASES = { 'Static Takeaways': 'General Awareness' };
const caSectionTotals = {};
const caMonthLabels = {};
for (const m of getFullDataset()) {
  for (const [rawName, items] of Object.entries(m.sections)) {
    const sectionName = CA_SECTION_ALIASES[rawName] || rawName;
    caSectionTotals[sectionName] = (caSectionTotals[sectionName] || 0) + items.length;
  }
  caMonthLabels[m.slug] = `${m.month} ${m.year}`;
}

// ============================================================
// UNCHANGED FROM subjects/index.astro — same real-data logic.
// Chapter/question counts are derived from real data files, so a
// subject can NEVER show as "Available" here unless it actually
// has chapters. Same for Question Papers below.
// ============================================================
const chapterFiles = import.meta.glob('../data/*/*.json', { eager: true });
const countsBySubject = {};
const questionCountsBySubject = {};
for (const [path, mod] of Object.entries(chapterFiles)) {
  const subjectKey = path.split('/').slice(-2, -1)[0];
  const items = Array.isArray(mod.default) ? mod.default : [mod.default];
  const valid = items.filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber);
  countsBySubject[subjectKey] = (countsBySubject[subjectKey] || 0) + valid.length;
  const questionsInFile = valid.reduce((sum, ch) => sum + ch.faqs.length, 0);
  questionCountsBySubject[subjectKey] = (questionCountsBySubject[subjectKey] || 0) + questionsInFile;
}

// Same PUBLIC_SUBJECTS list as the real page, with `category` added
// (display-only, same grouping used on index-v2's homepage) so both
// pages read as one consistent app.
const PUBLIC_SUBJECTS = [
  { slug: 'telangana-history-en', icon: 'book', category: 'History' },
  { slug: 'telangana-history-te', icon: 'book', category: 'History' },
  { slug: 'indian-history-en', icon: 'book', category: 'History' },
  { slug: 'telangana-economy-en', icon: 'chart', category: 'Economy' },
  { slug: 'telangana-economy-te', icon: 'chart', category: 'Economy' },
  { slug: 'andhra-pradesh-economy', icon: 'chart', category: 'Economy' },
  { slug: 'indian-polity-en', icon: 'gavel', category: 'Polity' },
  { slug: 'indian-polity-te', icon: 'gavel', category: 'Polity' },
];

const ENGLISH_NAME = {
  'telangana-history-te': 'Telugu Version',
  'telangana-economy-en': 'English Version',
  'telangana-history-en': 'English Version',
  'telangana-economy-te': 'Telugu Version',
  'andhra-pradesh-economy': 'English Version',
  'indian-history-en': 'English Version',
  'indian-polity-en': 'English Version',
  'indian-polity-te': 'Telugu Version',
};

function splitTitleParts(title) {
  const idx = title.indexOf(' (');
  if (idx === -1) return [title];
  return [title.slice(0, idx), title.slice(idx + 1)];
}

const subjects = PUBLIC_SUBJECTS.map(({ slug, icon, category }) => {
  const meta = getSubjectMeta(slug);
  const chapterCount = countsBySubject[slug] || 0;
  const questionCount = questionCountsBySubject[slug] || 0;
  return {
    titleNative: meta.heading,
    titleParts: splitTitleParts(meta.heading),
    titleEnglish: ENGLISH_NAME[slug] || 'English',
    slug,
    lang: slug.endsWith('-te') ? 'TE' : 'EN',
    category,
    chapterCount,
    questionCount,
    icon,
    available: chapterCount > 0,
  };
});

const categoryOrder = [...new Set(subjects.map((s) => s.category))];
const groupedSubjects = categoryOrder.map((cat) => ({
  category: cat,
  items: subjects.filter((s) => s.category === cat),
}));

const iconMap = {
  book: 'ti-book',
  chart: 'ti-chart-bar',
  gavel: 'ti-gavel',
  file: 'ti-file-text',
};
const categoryColor = {
  History: 'amber',
  Economy: 'green',
  Polity: 'indigo',
  Papers: 'blue',
};

// ============================================================
// UNCHANGED FROM subjects/index.astro — same Question Papers
// source (PUBLIC_PAPERS + subjectsMeta.js + the same
// countsBySubject glob above). Real counts, never hardcoded.
// ============================================================
const PUBLIC_PAPERS = [
  { slug: 'ts-constable-previous-papers-en', icon: 'file' },
  { slug: 'ts-constable-previous-papers-te', icon: 'file' },
];
const PAPERS_ENGLISH_NAME = {
  'ts-constable-previous-papers-en': 'Previous Question Papers',
  'ts-constable-previous-papers-te': 'Previous Question Papers (Telugu)',
};
const papers = PUBLIC_PAPERS.map(({ slug, icon }) => {
  const meta = getSubjectMeta(slug);
  const chapterCount = countsBySubject[slug] || 0;
  return {
    titleNative: meta.heading,
    titleParts: splitTitleParts(meta.heading),
    titleEnglish: PAPERS_ENGLISH_NAME[slug] || 'Previous Question Papers',
    slug,
    lang: slug.endsWith('-te') ? 'TE' : 'EN',
    chapterCount,
    icon,
    available: chapterCount > 0,
  };
});

const totalChapters = subjects.reduce((sum, s) => sum + s.chapterCount, 0);
const totalQuestions = subjects.reduce((sum, s) => sum + s.questionCount, 0);
---
<Layout title="Subjects - StudyHelp" description="All subjects available on StudyHelp for TSPSC and TS exam preparation.">

  <Header active="subjects" theme="premium" />

  <div class="page-wide">

    <div class="subjects-head">
      <h1 class="subjects-h1">All Subjects</h1>
      <p class="subjects-sub">{subjects.length} subjects &middot; {totalChapters}+ chapters &middot; {totalQuestions.toLocaleString('en-IN')} MCQs</p>
    </div>

    <a href="/plans/?mode=bundle" class="bundle-card">
      <div class="bundle-top">
        <div class="bundle-icon">
          <i class="ti ti-stack-2" aria-hidden="true"></i>
        </div>
        <div class="bundle-body">
          <div class="bundle-tag">BEST VALUE</div>
          <h2>Pick any 3 subjects</h2>
          <p>Full access for 90 days</p>
        </div>
        <div class="bundle-price">&#8377;399<small> /3mo</small></div>
      </div>
      <span class="get-bundle-btn" aria-hidden="true">
        Get Bundle <i class="ti ti-arrow-right" aria-hidden="true"></i>
      </span>
    </a>

    <div class="recap-row" id="recap-row" hidden></div>

    <a href="/current-affairs/" class="ca-card">
      <div class="ca-icon">
        <i class="ti ti-news" aria-hidden="true"></i>
      </div>
      <div class="ca-text">
        <b>Current Affairs 2026</b>
        <span>Free to read &middot; PDF available</span>
      </div>
      <i class="ti ti-chevron-right ca-chev" aria-hidden="true"></i>
    </a>

    <div class="subject-list">
      {groupedSubjects.map((group) => (
        <div class="subject-group">
          <div class="group-tag"><i class={`tag-dot tag-dot-${categoryColor[group.category] || 'indigo'}`}></i>{group.category}</div>
          <div class="pair-row">
            {group.items.map((s) => (
              s.available ? (
                <a href={`/subject-v2/${s.slug}/`} class="subj-card subj-card-live" data-subject-slug={s.slug}>
                  <span class="owned-ribbon" data-pill hidden aria-label="Purchased">
                    <i class="ti ti-check" aria-hidden="true"></i>OWNED
                  </span>
                  <div class="subj-top">
                    <div class={`subj-icon subj-icon-${categoryColor[group.category] || 'indigo'}`}>
                      <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
                    </div>
                    <span class="lang-flag">{s.lang}</span>
                  </div>
                  <div>
                    <div class="subj-name">
                      {s.titleParts.length === 2
                        ? <>{s.titleParts[0]}<br />{s.titleParts[1]}</>
                        : s.titleNative}
                    </div>
                    <div class="subj-meta">
                      {s.chapterCount} ch
                      {s.questionCount > 0 && <> &middot; {s.questionCount.toLocaleString('en-IN')} MCQs</>}
                    </div>
                  </div>
                  <div class="subj-foot">
                    <span class="price-tag" data-price-tag>&#8377;199</span>
                    <span class="expiry-tag" data-expiry-tag hidden></span>
                  </div>
                </a>
              ) : (
                <div class="subj-card subj-card-soon">
                  <div class="subj-top">
                    <div class={`subj-icon subj-icon-${categoryColor[group.category] || 'indigo'} subj-icon-muted`}>
                      <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
                    </div>
                    <span class="lang-flag">{s.lang}</span>
                  </div>
                  <div>
                    <div class="subj-name">
                      {s.titleParts.length === 2
                        ? <>{s.titleParts[0]}<br />{s.titleParts[1]}</>
                        : s.titleNative}
                    </div>
                    <div class="subj-meta">Coming soon</div>
                  </div>
                  <div class="subj-foot">
                    <span class="soon-tag">Coming soon</span>
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      ))}
    </div>

    {papers.some((p) => p.available) && (
      <div class="papers-section">
        <div class="section-head">
          <h3>Question Papers <span class="free-badge">Free</span></h3>
        </div>
        <div class="subject-list">
          <div class="pair-row">
            {papers.map((p) => (
              p.available ? (
                <a href={`/subject-v2/${p.slug}/`} class="subj-card subj-card-live" data-subject-slug={p.slug}>
                  <div class="subj-top">
                    <div class="subj-icon subj-icon-blue">
                      <i class={`ti ${iconMap[p.icon]}`} aria-hidden="true"></i>
                    </div>
                    <span class="lang-flag">{p.lang}</span>
                  </div>
                  <div>
                    <div class="subj-name">
                      {p.titleParts.length === 2
                        ? <>{p.titleParts[0]}<br />{p.titleParts[1]}</>
                        : p.titleNative}
                    </div>
                    <div class="subj-meta">{p.chapterCount} {p.chapterCount === 1 ? 'paper' : 'papers'}</div>
                  </div>
                  <div class="subj-foot">
                    <span class="free-tag">Free</span>
                  </div>
                </a>
              ) : (
                <div class="subj-card subj-card-soon">
                  <div class="subj-top">
                    <div class="subj-icon subj-icon-blue subj-icon-muted">
                      <i class={`ti ${iconMap[p.icon]}`} aria-hidden="true"></i>
                    </div>
                    <span class="lang-flag">{p.lang}</span>
                  </div>
                  <div>
                    <div class="subj-name">
                      {p.titleParts.length === 2
                        ? <>{p.titleParts[0]}<br />{p.titleParts[1]}</>
                        : p.titleNative}
                    </div>
                    <div class="subj-meta">Coming soon</div>
                  </div>
                  <div class="subj-foot">
                    <span class="soon-tag">Coming soon</span>
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      </div>
    )}

  </div>

  <style is:global>
    .page-wide {
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h, 56px) + env(safe-area-inset-bottom, 0px));
      }
    }

    /* Opts out of Layout.astro's cream body background in favor of the
       redesign's lavender tint — scoped to a body class, page-only. */
    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    /* ---------- Redesign tokens (identical to index-v2.astro, kept in
       sync so both pages share one design system) ---------- */
    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-amber: #E8963A;
      --sh2-amber-soft: #FBEDD9;
      --sh2-green: #26946A;
      --sh2-green-soft: #DFF3EA;
      --sh2-blue: #2F7DD6;
      --sh2-blue-soft: #E1EDFB;
      --sh2-text: #211F38;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-gold: #D8A94E;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-amber: #F0B45E;
      --sh2-amber-soft: #3B2C15;
      --sh2-green: #5FCB9B;
      --sh2-green-soft: #183328;
      --sh2-blue: #6FA8EC;
      --sh2-blue-soft: #1B2A40;
      --sh2-text: #EFEDFB;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }

    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&display=swap');
    .page-wide h1, .page-wide h2, .page-wide h3,
    .page-wide .subj-name, .page-wide .bundle-price {
      font-family: 'Manrope', sans-serif;
    }

    /* ---------- Page head (replaces the hero card here — this is a
       catalogue page, not the homepage) ---------- */
    .subjects-head { margin-bottom: 16px; }
    .subjects-h1 { font-size: 1.4rem; font-weight: 800; color: var(--sh2-ink); margin: 0 0 4px; }
    .subjects-sub { font-size: 0.82rem; color: var(--sh2-text-soft); margin: 0; }

    /* ---------- Bundle (same as index-v2) ---------- */
    .bundle-card {
      background: var(--sh2-surface);
      border-radius: 20px;
      padding: 18px;
      margin-bottom: 14px;
      box-shadow: var(--sh2-shadow);
      border: 1px solid var(--sh2-line);
      display: block;
      text-decoration: none;
      overflow: hidden;
      box-sizing: border-box;
    }
    .bundle-top { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
    .bundle-icon {
      width: 52px; height: 52px; border-radius: 15px;
      background: linear-gradient(150deg, var(--sh2-amber), var(--sh2-gold));
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      box-shadow: 0 10px 18px -8px rgba(216,169,78,0.6);
    }
    .bundle-icon i { font-size: 22px; color: #fff; }
    .bundle-body { flex: 1; min-width: 0; }
    .bundle-tag { font-size: 0.68rem; font-weight: 700; color: var(--sh2-amber); margin-bottom: 2px; }
    .bundle-card h2 { font-size: 1rem; font-weight: 800; color: var(--sh2-ink); margin: 0 0 3px; }
    .bundle-card p { font-size: 0.8rem; color: var(--sh2-text-soft); margin: 0; }
    .bundle-price { font-weight: 800; font-size: 1.15rem; color: var(--sh2-ink); flex-shrink: 0; text-align: right; }
    .bundle-price small { display: block; font-size: 0.65rem; font-weight: 500; color: var(--sh2-text-soft); }
    .get-bundle-btn {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      width: 100%; box-sizing: border-box;
      font-size: 0.8rem; font-weight: 700; color: #fff;
      background: linear-gradient(150deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      padding: 9px; border-radius: 10px;
      box-shadow: 0 8px 14px -8px rgba(75,63,160,0.5);
    }
    .get-bundle-btn i { font-size: 0.78rem; }

    /* ---------- Continue-reading recap cards ---------- */
    .recap-row {
      display: flex; gap: 10px; overflow-x: auto; margin-bottom: 14px;
      padding-bottom: 2px; scrollbar-width: none;
    }
    .recap-row::-webkit-scrollbar { display: none; }
    .recap-row[hidden] { display: none; }
    .recap-card {
      position: relative; overflow: hidden; flex: 0 0 250px;
      background: linear-gradient(155deg, var(--sh2-indigo-deep) 0%, #5A4CC4 55%, #7C63DE 100%);
      border-radius: 16px; padding: 14px 16px 16px; color: #fff;
      text-decoration: none; box-shadow: 0 10px 22px -12px rgba(46,37,112,0.45);
    }
    .recap-card::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(circle at 85% 15%, rgba(255,255,255,0.14), transparent 45%);
    }
    .recap-tag {
      position: relative; z-index: 1;
      font-size: 0.62rem; font-weight: 800; letter-spacing: 0.04em;
      color: rgba(255,255,255,0.75); margin-bottom: 4px;
    }
    .recap-title {
      position: relative; z-index: 1;
      font-size: 0.95rem; font-weight: 800; margin-bottom: 2px;
    }
    .recap-sub {
      position: relative; z-index: 1;
      font-size: 0.74rem; color: rgba(255,255,255,0.85); margin-bottom: 10px;
    }
    .recap-bar-track {
      position: relative; z-index: 1;
      height: 5px; border-radius: 999px; background: rgba(255,255,255,0.25);
      margin-bottom: 10px; overflow: hidden;
    }
    .recap-bar-fill {
      height: 100%; border-radius: 999px;
      background: linear-gradient(90deg, #FFD27A, #FFB35C);
    }
    .recap-foot {
      position: relative; z-index: 1;
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .recap-count { font-size: 0.7rem; color: rgba(255,255,255,0.75); }
    .recap-resume-btn {
      font-size: 0.72rem; font-weight: 700; color: var(--sh2-indigo-deep);
      background: #fff; padding: 6px 12px; border-radius: 999px;
    }

    /* ---------- Current Affairs (same as index-v2) ---------- */
    .ca-card {
      display: flex; align-items: center; gap: 13px;
      background: var(--sh2-green-soft);
      border-radius: 18px; padding: 14px 16px; margin-bottom: 26px;
      border: 1px solid rgba(38,148,106,0.15);
      text-decoration: none;
    }
    .ca-icon {
      width: 40px; height: 40px; border-radius: 12px; background: var(--sh2-surface);
      color: var(--sh2-green); display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; box-shadow: var(--sh2-shadow); font-size: 18px;
    }
    .ca-text { flex: 1; }
    .ca-text b { font-size: 0.9rem; display: block; color: var(--sh2-ink); }
    .ca-text span { font-size: 0.76rem; color: var(--sh2-green); font-weight: 600; }
    .ca-chev { color: var(--sh2-green); flex-shrink: 0; }

    /* ---------- Section head ---------- */
    .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
    .section-head h3 { font-size: 1.08rem; font-weight: 800; margin: 0; color: var(--sh2-ink); display: flex; align-items: center; gap: 8px; }

    .papers-section {
      margin-top: 22px;
      padding-top: 22px;
      border-top: 1px dashed var(--sh2-line);
    }
    .free-badge {
      font-size: 0.62rem; font-weight: 800; color: var(--sh2-blue);
      background: var(--sh2-blue-soft); padding: 3px 8px; border-radius: 999px;
      vertical-align: middle;
    }

    /* ---------- Subject groups (same card system as index-v2) ---------- */
    .subject-group { margin-bottom: 16px; }
    .group-tag {
      display: flex; align-items: center; gap: 8px;
      font-size: 0.72rem; font-weight: 700; color: var(--sh2-text-soft);
      margin-bottom: 9px; padding-inline: 2px;
    }
    .tag-dot { width: 14px; height: 14px; border-radius: 4px; display: inline-block; }
    .tag-dot-amber { background: var(--sh2-amber); }
    .tag-dot-green { background: var(--sh2-green); }
    .tag-dot-indigo { background: var(--sh2-indigo); }
    .tag-dot-blue { background: var(--sh2-blue); }

    .pair-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
    }
    @media (min-width: 640px) {
      .pair-row { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
    }

    .subj-card {
      position: relative;
      background: var(--sh2-surface);
      border-radius: 18px;
      padding: 16px 14px;
      box-shadow: var(--sh2-shadow);
      border: 1px solid var(--sh2-line);
      display: flex; flex-direction: column; gap: 10px;
      text-decoration: none;
      overflow: hidden;
      transition: transform 0.12s ease;
    }
    .subj-card-live:active { transform: scale(0.98); }
    .subj-card-live.has-pill {
      border: 1px solid rgba(38,148,106,0.35);
      box-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(38,148,106,0.35);
    }
    .subj-card-soon { opacity: 0.6; }

    .owned-ribbon {
      position: absolute; top: 0; right: 0;
      background: var(--sh2-green); color: #fff;
      font-size: 0.6rem; font-weight: 800;
      padding: 4px 10px 4px 12px;
      border-bottom-left-radius: 10px;
      display: flex; align-items: center; gap: 4px;
    }
    .owned-ribbon i { font-size: 10px; }
    .owned-ribbon[hidden] { display: none; }

    .subj-top { display: flex; align-items: center; gap: 10px; }
    .subj-icon {
      width: 38px; height: 38px; border-radius: 11px;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .subj-icon i { font-size: 18px; }
    .subj-icon-amber { background: var(--sh2-amber-soft); color: var(--sh2-amber); }
    .subj-icon-green { background: var(--sh2-green-soft); color: var(--sh2-green); }
    .subj-icon-indigo { background: var(--sh2-indigo-soft); color: var(--sh2-indigo); }
    .subj-icon-blue { background: var(--sh2-blue-soft); color: var(--sh2-blue); }
    .subj-icon-muted { opacity: 0.6; }

    .lang-flag {
      font-size: 0.63rem; font-weight: 800; color: var(--sh2-text-soft);
      background: var(--sh2-surface-2); padding: 2px 7px; border-radius: 6px; flex-shrink: 0;
    }

    .subj-name { font-size: 0.9rem; font-weight: 700; color: var(--sh2-ink); line-height: 1.25; min-height: 2.5em; }
    .subj-meta { font-size: 0.73rem; color: var(--sh2-text-soft); margin-top: 3px; }

    .subj-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 2px; }
    .price-tag {
      font-size: 0.72rem; font-weight: 700; color: var(--sh2-indigo);
      background: var(--sh2-indigo-soft); padding: 4px 9px; border-radius: 7px;
    }
    .soon-tag {
      font-size: 0.7rem; font-weight: 600; color: var(--sh2-text-soft);
      border: 1px dashed var(--sh2-line); padding: 4px 9px; border-radius: 7px;
    }
    .free-tag {
      font-size: 0.72rem; font-weight: 700; color: var(--sh2-blue);
      background: var(--sh2-blue-soft); padding: 4px 9px; border-radius: 7px;
    }
    .expiry-tag {
      font-size: 0.68rem; font-weight: 700; color: var(--sh2-green);
      background: var(--sh2-green-soft); padding: 4px 9px; border-radius: 7px;
      display: flex; align-items: center; gap: 4px;
    }
    .expiry-tag[hidden] { display: none; }
    .expiry-tag.expiry-soon { color: #b45c0a; background: var(--sh2-amber-soft); }
  </style>

  <script define:vars={{ subjects, caSectionTotals, caMonthLabels }}>
    // ============================================================
    // UNCHANGED FROM subjects/index.astro — same Worker URL, same
    // bundle-success toast logic, same session/ownership check and
    // purchased-reorder logic. Only the DOM selectors match the new
    // card markup (data-subject-slug, [data-pill], .has-pill), and
    // reordering happens within each category's own pair-row instead
    // of one shared grid — same adaptation used on index-v2.
    //
    // Also fetches /reading-progress for each owned subject (real D1
    // data, same table chapter-v2/[slug].astro writes to) and renders
    // "Continue reading" recap cards for subjects the user has actually
    // opened a chapter in — logged-in users only, per subject.
    // ============================================================
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    let bundleLoadingToast = null;
    let bundleToastShownAt = null;
    const BUNDLE_TOAST_MIN_VISIBLE_MS = 2500;
    const params = new URLSearchParams(window.location.search);
    const showedBundleToast = params.get('bundle_success') === '1';

    function removeBundleToastAfterMinDelay() {
      if (!bundleLoadingToast) return;
      const elapsed = Date.now() - bundleToastShownAt;
      const remaining = Math.max(0, BUNDLE_TOAST_MIN_VISIBLE_MS - elapsed);
      setTimeout(() => {
        if (bundleLoadingToast) bundleLoadingToast.remove();
      }, remaining);
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (!showedBundleToast) return;
      const message = 'Bundle purchased successfully — loading your subjects…';
      const container = document.getElementById('toast-container');
      if (container) {
        bundleLoadingToast = document.createElement('div');
        bundleLoadingToast.textContent = message;
        bundleLoadingToast.style.cssText = `
          background: linear-gradient(90deg, #2fbf71, #3fd88a);
          color: #063a1e; font-weight: 700; font-size: 13px;
          padding: 12px 18px; border-radius: 10px;
          box-shadow: 0 8px 20px -6px rgba(0,0,0,0.4);
          max-width: 360px; text-align: center;
        `;
        container.appendChild(bundleLoadingToast);
        bundleToastShownAt = Date.now();
      }
      window.history.replaceState({}, '', '/subjects-v2/');
      setTimeout(() => { if (bundleLoadingToast) bundleLoadingToast.remove(); }, 8000);
    });

    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    // Real expires_at from /check-access — never a fabricated reading-progress
    // number (see the "21 of 34 chapters" question this replaced: that data
    // doesn't exist in the backend yet, expiry does).
    function formatExpiryLabel(expiresAtSeconds) {
      if (!expiresAtSeconds) return null;
      const msLeft = expiresAtSeconds * 1000 - Date.now();
      const daysLeft = Math.ceil(msLeft / (24 * 60 * 60 * 1000));
      if (daysLeft <= 0) return { text: 'Expires today', soon: true };
      if (daysLeft === 1) return { text: '1 day left', soon: true };
      return { text: `${daysLeft} days left`, soon: daysLeft <= 7 };
    }

    getSession().then(async (session) => {
      if (!session.logged_in) {
        removeBundleToastAfterMinDelay();
        return;
      }

      const available = subjects.filter((s) => s.available);
      const ownedSlugs = [];
      const progressBySlug = {};

      await Promise.all(
        available.map((s) =>
          fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(s.slug)}`)
            .then((res) => res.json())
            .then(async (d) => {
              if (!d.unlocked) return;
              ownedSlugs.push(s.slug);
              const card = document.querySelector(`[data-subject-slug="${s.slug}"]`);
              const pill = card && card.querySelector('[data-pill]');
              if (pill) {
                pill.hidden = false;
                card.classList.add('has-pill');
              }
              const priceTag = card && card.querySelector('[data-price-tag]');
              const expiryTag = card && card.querySelector('[data-expiry-tag]');
              const expiry = formatExpiryLabel(d.expires_at);
              if (expiryTag && expiry) {
                expiryTag.innerHTML = `<i class="ti ti-clock" aria-hidden="true"></i>${expiry.text}`;
                expiryTag.hidden = false;
                expiryTag.classList.toggle('expiry-soon', expiry.soon);
                if (priceTag) priceTag.hidden = true;
              }

              try {
                const res = await fetch(`${WORKER_URL}/reading-progress?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(s.slug)}`);
                const prog = await res.json();
                if (prog.has_progress) progressBySlug[s.slug] = { ...prog, subject: s };
              } catch (err) {}
            })
            .catch(() => {})
        )
      );

      ownedSlugs.slice().reverse().forEach((slug) => {
        const card = document.querySelector(`[data-subject-slug="${slug}"]`);
        if (card && card.parentElement) card.parentElement.prepend(card);
      });

     // updated_at is a raw Unix-seconds integer (not an ISO string, not
// milliseconds) — sort numerically, don't route it through Date().
const recapEntries = Object.values(progressBySlug).sort(
  (a, b) => b.updated_at - a.updated_at
);
      // Current Affairs reading progress — separate endpoint, no
      // ownership/ check-access gate (CA reading is free), so this fetch
      // runs once for the logged-in user regardless of which subjects
      // they own. Backend only keeps the single most-recent section, so
      // at most one CA recap card is added.
      let caProgress = null;
      try {
        const caRes = await fetch(`${WORKER_URL}/ca-reading-progress?user_id=${encodeURIComponent(session.user_id)}`);
        const caData = await caRes.json();
        if (caData.has_progress) caProgress = caData;
      } catch (err) {}

      // Normalizes both timestamp shapes to a millisecond epoch number so
      // they can be compared directly:
      //  - reading_progress.updated_at (subjects) is a raw Unix-SECONDS
      //    integer, e.g. 1790123456
      //  - ca_reading_progress.updated_at (CA) is a SQLite datetime() TEXT
      //    string, e.g. "2026-09-27 10:24:41" (UTC, space-separated)
      // Without this, `b.updated_at - a.updated_at` is NaN whenever one
      // side is the CA string, and the sort silently leaves that card at
      // the end instead of placing it by actual recency.
      function toEpochMs(updatedAt) {
        if (typeof updatedAt === 'number') return updatedAt * 1000;
        return new Date(String(updatedAt).replace(' ', 'T') + 'Z').getTime();
      }

      if (recapEntries.length || caProgress) {
        const row = document.getElementById('recap-row');

        // Build every card as {ts, el} first, subject cards and the CA
        // card alike, then sort ALL of them together by recency — so
        // whichever was actually read most recently (a chapter or a CA
        // section) shows first, not subjects-always-before-CA.
        const cards = [];

        recapEntries.forEach((p) => {
          const total = p.subject.chapterCount || 0;
          const done = Math.min(p.last_chapter_number || 0, total);
          const pct = total ? Math.round((done / total) * 100) : 0;
          const a = document.createElement('a');
          a.className = 'recap-card';
          a.href = `/chapter-v2/${p.last_chapter_slug}/`;
          a.innerHTML = `
            <div class="recap-tag">CONTINUE</div>
            <div class="recap-title">${p.subject.titleNative}</div>
            <div class="recap-sub">Ch. ${p.last_chapter_number} &middot; ${p.last_chapter_title}</div>
            <div class="recap-bar-track"><div class="recap-bar-fill" style="width:${pct}%"></div></div>
            <div class="recap-foot">
              <span class="recap-count">${done} of ${total} chapters</span>
              <span class="recap-resume-btn">Resume</span>
            </div>
          `;
          cards.push({ ts: toEpochMs(p.updated_at), el: a });
        });

        if (caProgress) {
          const caTotal = caSectionTotals[caProgress.section_name] || 0;
          const caDone = Math.min(caProgress.questions_read_count || 0, caTotal || caProgress.questions_read_count || 0);
          const caPct = caTotal ? Math.round((caDone / caTotal) * 100) : 0;

          // Best-effort plan label from this tab's own sessionStorage (the
          // same place current-affairs-read-v2.astro reads/writes it) —
          // "Monthly · January 2026", "Last 3 Months", etc. Only reliable
          // within the same browser tab that did the reading; falls back to
          // no plan label (just the section name) on a fresh tab/device,
          // same as everywhere else this session state is used.
          let caPlanLabel = '';
          try {
            const plan = sessionStorage.getItem('ca_selected_plan') || '';
            const months = JSON.parse(sessionStorage.getItem('ca_selected_months') || '[]');
            const PLAN_NAMES = { monthly: 'Monthly', last3: 'Last 3 Months', last6: 'Last 6 Months' };
            if (plan === 'monthly' && months.length === 1 && caMonthLabels[months[0]]) {
              caPlanLabel = `Monthly · ${caMonthLabels[months[0]]}`;
            } else if (PLAN_NAMES[plan]) {
              caPlanLabel = PLAN_NAMES[plan];
            }
          } catch (err) {}

          const caCard = document.createElement('a');
          caCard.className = 'recap-card';
          caCard.href = `/current-affairs-read-v2/?section=${encodeURIComponent(caProgress.section_name)}`;
          caCard.innerHTML = `
            <div class="recap-tag">CONTINUE</div>
            <div class="recap-title">${caProgress.section_name}</div>
            <div class="recap-sub">${caPlanLabel || 'Current Affairs'}</div>
            <div class="recap-bar-track"><div class="recap-bar-fill" style="width:${caPct}%"></div></div>
            <div class="recap-foot">
              <span class="recap-count">${caTotal ? `${caDone} of ${caTotal} questions` : `${caDone} questions read`}</span>
              <span class="recap-resume-btn">Resume</span>
            </div>
          `;
          cards.push({ ts: toEpochMs(caProgress.updated_at), el: caCard });
        }

        cards
          .sort((a, b) => b.ts - a.ts)
          .forEach((c) => row.appendChild(c.el));

        row.hidden = false;
      }

      removeBundleToastAfterMinDelay();
    });
  </script>

  <script is:inline>
    document.body.classList.add('sh2-page');
  </script>
</Layout>
