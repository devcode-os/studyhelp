---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---
<Layout title="Log In - StudyHelp" description="Log in to StudyHelp with your phone number and passcode.">
  <Header active="login" />

  <div class="content auth-content">
    <div class="auth-card">
      <div class="auth-icon"><i class="ti ti-lock"></i></div>
      <h1>Log in</h1>
      <p class="sub">Mobile number + 6-digit passcode.</p>

      <form id="login-form">
        <label for="phone">Phone number</label>
        <div class="phone-input">
          <span class="phone-prefix">+91</span>
          <input type="tel" id="phone" name="phone" required inputmode="numeric" maxlength="10" autocomplete="tel" placeholder="10-digit mobile number" />
        </div>

        <label for="passcode">Passcode</label>
        <input type="text" id="passcode" name="passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

        <div id="error-msg" class="error-msg" style="display:none;">
          <i class="ti ti-alert-circle"></i><span id="error-text"></span>
        </div>

        <button type="submit" class="btn-block" id="submit-btn">
          <span class="btn-label">Log in</span>
          <i class="ti ti-loader-2 btn-spinner" style="display:none;"></i>
        </button>
      </form>

      <p class="alt-action"><a href="/forgot-passcode/">Forgot passcode?</a></p>
      <p class="alt-action">New here? <a href="/signup/">Create an account</a></p>
    </div>
  </div>

  <style>
    .auth-content {
      max-width: 440px;
    }
    .auth-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 36px 32px;
      box-shadow: 0 4px 28px rgba(0,0,0,0.06);
      animation: card-in 0.45s ease-out;
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    html[data-theme="dark"] .auth-card {
      box-shadow: 0 4px 28px rgba(0,0,0,0.3);
    }
    .auth-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: var(--accent-bg);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 16px;
    }
    .auth-card h1 {
      font-size: 24px;
      margin-bottom: 4px;
    }
    .auth-card .sub {
      margin-bottom: 24px;
    }
    .auth-card label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      margin: 18px 0 6px;
    }
    .auth-card input {
      margin-bottom: 0;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .auth-card input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-bg);
    }
    .phone-input {
      display: flex;
      align-items: stretch;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      background: var(--card);
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .phone-input:focus-within {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-bg);
    }
    .phone-prefix {
      display: flex;
      align-items: center;
      padding: 0 12px;
      background: var(--bg);
      color: var(--muted);
      font-weight: 600;
      font-size: 17px;
      border-right: 1px solid var(--border);
    }
    .phone-input input {
      border: none;
      border-radius: 0;
      flex: 1;
    }
    .phone-input input:focus {
      box-shadow: none;
    }
    .code-input {
      box-sizing: border-box;
      width: 100%;
      font-size: clamp(18px, 5.5vw, 24px);
      font-weight: 700;
      letter-spacing: clamp(4px, 2.2vw, 10px);
      text-align: center;
      font-family: monospace;
      padding-left: 8px;
      padding-right: 8px;
    }
    .code-input::placeholder {
      letter-spacing: clamp(4px, 2.2vw, 10px);
      color: var(--border);
    }
    .error-msg {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #fdecec;
      color: #b3261e;
      border-left: 3px solid #d33;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 14px;
      margin: 18px 0 0;
    }
    html[data-theme="dark"] .error-msg {
      background: #3a1c1c;
      color: #ff9b93;
    }
    .btn-block {
      width: 100%;
      margin-top: 26px;
      padding: 13px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 10px;
      border: 1px solid var(--accent);
      background: var(--accent-bg);
      color: var(--accent);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.1s, opacity 0.15s;
    }
    .btn-block:hover:not(:disabled) {
      transform: translateY(-1px);
    }
    .btn-block:active:not(:disabled) {
      transform: translateY(0);
    }
    .btn-block:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .btn-success {
      border-color: var(--success-text) !important;
      background: var(--success-bg) !important;
      color: var(--success-text) !important;
      opacity: 1 !important;
    }
    .btn-spinner {
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .alt-action {
      text-align: center;
      margin-top: 14px;
      font-size: 14px;
      color: var(--muted);
    }
  </style>

  <script>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
    const form = document.getElementById('login-form');
    const errorMsg = document.getElementById('error-msg');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn');
    const btnLabel = submitBtn.querySelector('.btn-label');
    const btnSpinner = submitBtn.querySelector('.btn-spinner');

    // Strip non-digit characters as the user types (pattern/inputmode alone don't block typing on desktop)
    ['phone', 'passcode'].forEach((id) => {
      const el = document.getElementById(id);
      const maxLen = id === 'phone' ? 10 : 6;
      el.addEventListener('input', () => {
        el.value = el.value.replace(/\D/g, '').slice(0, maxLen);
      });
    });

    function setLoading(isLoading, labelWhenIdle) {
      submitBtn.disabled = isLoading;
      btnLabel.textContent = isLoading ? 'Logging in...' : labelWhenIdle;
      btnSpinner.style.display = isLoading ? 'inline-block' : 'none';
    }

    function showError(msg) {
      errorText.textContent = msg;
      errorMsg.style.display = 'flex';
    }

    const params = new URLSearchParams(window.location.search);
    const nextUrl = params.get('next') || '/';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.style.display = 'none';
      setLoading(true, 'Log in');

      const payload = {
        phone: form.phone.value.trim(),
        passcode: form.passcode.value.trim(),
      };

      try {
        const res = await fetch(`${WORKER_URL}/login`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          showError(data.error || 'Invalid phone number or passcode.');
          setLoading(false, 'Log in');
          return;
        }

        btnLabel.textContent = 'Logged in!';
        btnSpinner.style.display = 'none';
        submitBtn.classList.add('btn-success');
        // Clear any stale cached session so the destination page re-checks fresh
        try { sessionStorage.removeItem('sh_session_cache'); } catch (err) {}
        setTimeout(() => { window.location.href = nextUrl; }, 700);
      } catch (err) {
        showError('Network error. Please check your connection and try again.');
        setLoading(false, 'Log in');
      }
    });
  </script>

<style>
  @media (max-width: 380px) {
    .auth-card {
      padding: 28px 20px;
    }
  }
</style>
