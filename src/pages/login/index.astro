---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---
<Layout title="Log In - StudyHelp" description="Log in to StudyHelp with your phone number and passcode.">
  <Header active="login" theme="premium" />

  <div class="page-wide auth-page">
    <div class="auth-card">
      <div class="auth-icon"><i class="ti ti-lock"></i></div>
      <h1>Log in</h1>

      <!-- Google sign-in: hidden until /google-auth.js confirms it can run here
           (browser, or an app build that includes the native plugin). -->
      <div id="google-auth" class="shg-wrap" style="display:none;">
        <div data-trial-slot="auth-note" data-variant="login"></div>
        <div id="google-auth-slot"></div>
        <div id="google-auth-error" class="error-msg" style="display:none; margin-top:10px;">
          <i class="ti ti-alert-circle"></i><span id="google-auth-error-text"></span>
        </div>
        <div class="shg-or"><span>or log in with your phone number</span></div>
      </div>

      <form id="login-form">
        <label for="phone">Phone number</label>
        <div class="phone-input">
          <span class="phone-prefix">+91</span>
          <input type="tel" id="phone" name="phone" required inputmode="numeric" maxlength="10" autocomplete="tel" placeholder="10-digit mobile number" />
        </div>

        <label for="passcode">Passcode</label>
        <input type="text" id="passcode" name="passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

        <div id="error-msg" class="error-msg" style="display:none;">
          <i class="ti ti-alert-circle"></i><span id="error-text"></span>
        </div>

        <button type="submit" class="btn-block" id="submit-btn">
          <span class="btn-label">Log in</span>
          <i class="ti ti-loader-2 btn-spinner" style="display:none;"></i>
        </button>
      </form>

      <p class="alt-action"><a href="/forgot-passcode/">Forgot passcode?</a></p>
      <p class="alt-action">New here? <a href="/signup/" id="signup-link">Create an account</a></p>
    </div>
  </div>

  <style is:global>
    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-green: #26946A;
      --sh2-text: #211F38;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    @media (min-width: 1200px) {
      .page-wide {
        max-width: 800px;
      }
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-green: #5FCB9B;
      --sh2-text: #EFEDFB;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&display=swap');

    .auth-page {
      display: flex; align-items: center; justify-content: center;
      min-height: calc(100vh - 200px);
      max-width: 440px !important;
    }
    @media (max-width: 900px) {
      .auth-page {
        padding: 16px 16px calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }

    .auth-card {
      width: 100%;
      box-sizing: border-box;
      background: var(--sh2-surface);
      border: 1px solid var(--sh2-line);
      border-radius: 20px;
      padding: 32px 28px;
      box-shadow: var(--sh2-shadow);
      animation: card-in 0.35s ease-out;
      color: var(--sh2-ink);
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .auth-icon {
      width: 48px; height: 48px; border-radius: 14px;
      background: linear-gradient(135deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 16px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
    }
    .auth-card h1 {
      font-family: 'Manrope', sans-serif;
      font-size: 1.4rem; margin-bottom: 20px; color: var(--sh2-ink); font-weight: 800;
    }
    .auth-card .sub { margin-bottom: 22px; color: var(--sh2-text-soft); font-size: 0.86rem; }
    .auth-card label {
      display: block; font-size: 0.78rem; font-weight: 700;
      color: var(--sh2-text-soft); margin: 16px 0 6px;
    }
    .auth-card input {
      margin-bottom: 0; width: 100%; box-sizing: border-box;
      padding: 11px 14px; border-radius: 12px; font-size: 0.95rem;
      background: var(--sh2-surface-2);
      border: 1.5px solid var(--sh2-line);
      color: var(--sh2-ink);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .auth-card input::placeholder { color: var(--sh2-text-soft); opacity: 0.7; }
    .auth-card input:focus {
      outline: none;
      border-color: var(--sh2-indigo);
      box-shadow: 0 0 0 3px rgba(75,63,160,0.15);
      background: var(--sh2-surface);
    }
    .phone-input {
      display: flex; align-items: stretch;
      border: 1.5px solid var(--sh2-line);
      border-radius: 12px; overflow: hidden;
      background: var(--sh2-surface-2);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .phone-input:focus-within {
      border-color: var(--sh2-indigo);
      box-shadow: 0 0 0 3px rgba(75,63,160,0.15);
      background: var(--sh2-surface);
    }
    .phone-prefix {
      display: flex; align-items: center; padding: 0 12px;
      background: transparent; color: var(--sh2-text-soft); font-weight: 700; font-size: 0.95rem;
      border-right: 1.5px solid var(--sh2-line);
    }
    .phone-input input { border: none; border-radius: 0; background: transparent; flex: 1; }
    .phone-input input:focus { box-shadow: none; background: transparent; }
    .code-input {
      font-size: clamp(18px, 5.5vw, 24px); font-weight: 700;
      letter-spacing: clamp(4px, 2.2vw, 10px); text-align: center;
      font-family: monospace; padding-left: 8px; padding-right: 8px;
    }
    .code-input::placeholder { letter-spacing: clamp(4px, 2.2vw, 10px); }
    .error-msg {
      display: flex; align-items: center; gap: 8px;
      background: rgba(198,40,40,0.08); color: #c0392b;
      border-left: 3px solid #c0392b; padding: 10px 12px; border-radius: 8px;
      font-size: 0.82rem; margin: 16px 0 0;
    }
    html[data-theme="dark"] .error-msg { background: rgba(198,40,40,0.15); color: #ff9b93; }
    .btn-block {
      width: 100%; box-sizing: border-box; margin-top: 24px; padding: 13px; font-size: 0.95rem; font-weight: 700;
      border-radius: 12px; border: none;
      background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
      transition: transform 0.1s, opacity 0.15s;
    }
    .btn-block:hover:not(:disabled) { transform: translateY(-1px); }
    .btn-block:active:not(:disabled) { transform: translateY(0); }
    .btn-block:disabled { opacity: 0.65; cursor: not-allowed; }
    .btn-success { background: var(--sh2-green) !important; opacity: 1 !important; }
    .btn-spinner { animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .alt-action { text-align: center; margin-top: 14px; font-size: 0.82rem; color: var(--sh2-text-soft); }
    .alt-action a { color: var(--sh2-indigo); font-weight: 700; text-decoration: underline; }

    @media (max-width: 720px) {
      .auth-card { padding: 22px 18px; border-radius: 18px; }
    }
  </style>

  <script>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
    const form = document.getElementById('login-form');
    const errorMsg = document.getElementById('error-msg');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn');
    const btnLabel = submitBtn.querySelector('.btn-label');
    const btnSpinner = submitBtn.querySelector('.btn-spinner');

    // Strip non-digit characters as the user types (pattern/inputmode alone don't block typing on desktop)
    ['phone', 'passcode'].forEach((id) => {
      const el = document.getElementById(id);
      const maxLen = id === 'phone' ? 10 : 6;
      el.addEventListener('input', () => {
        el.value = el.value.replace(/\D/g, '').slice(0, maxLen);

        if (id === 'phone' && el.value.length === maxLen) {
          // Phone number complete — jump straight to passcode instead of
          // making the person tap it manually.
          document.getElementById('passcode').focus();
        }

        if (id === 'passcode' && el.value.length === maxLen) {
          // Passcode complete — submit automatically rather than requiring
          // an extra tap on the Log in button. requestSubmit() (not
          // .submit()) so the normal submit event listener still fires.
          form.requestSubmit();
        }
      });
    });

    function setLoading(isLoading, labelWhenIdle) {
      submitBtn.disabled = isLoading;
      btnLabel.textContent = isLoading ? 'Logging in...' : labelWhenIdle;
      btnSpinner.style.display = isLoading ? 'inline-block' : 'none';
    }

    function showError(msg) {
      errorText.textContent = msg;
      errorMsg.style.display = 'flex';
    }

    const params = new URLSearchParams(window.location.search);
    const nextUrl = params.get('next') || '/';

    // Same reasoning as the mirrored fix on the signup page: someone
    // arriving here mid-purchase who doesn't actually have an account yet
    // might click "Create an account" — without this, that click drops
    // the ?next= redirect and they'd have to start the purchase over.
    const signupLink = document.getElementById('signup-link');
    if (signupLink && params.get('next')) {
      signupLink.href = `/signup/?next=${encodeURIComponent(params.get('next'))}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.style.display = 'none';
      setLoading(true, 'Log in');

      const payload = {
        phone: form.phone.value.trim(),
        passcode: form.passcode.value.trim(),
      };

      try {
        const res = await fetch(`${WORKER_URL}/login`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          showError(data.error || 'Invalid phone number or passcode.');
          setLoading(false, 'Log in');
          return;
        }

        btnLabel.textContent = 'Logged in!';
        btnSpinner.style.display = 'none';
        submitBtn.classList.add('btn-success');
        // Clear any stale cached session so the destination page re-checks fresh
        try { sessionStorage.removeItem('sh_session_cache'); } catch (err) {}
        setTimeout(() => { window.location.href = nextUrl; }, 700);
      } catch (err) {
        showError('Network error. Please check your connection and try again.');
        setLoading(false, 'Log in');
      }
    });
  </script>

  <script is:inline src="/google-auth.js" defer></script>
  <script is:inline src="/trial.js" defer></script>

  <script is:inline>
    document.body.classList.add('sh2-page');
  </script>
</Layout>
