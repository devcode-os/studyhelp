---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---
<Layout title="Log In - StudyHelp" description="Log in to StudyHelp with your phone number and passcode.">
  <Header active="login" />

  <div class="content auth-content">
    <div class="auth-card">
      <div class="auth-icon"><i class="ti ti-lock"></i></div>
      <h1>Log in</h1>
      <p class="sub">Mobile number + 6-digit passcode.</p>

      <form id="login-form">
        <label for="phone">Phone number</label>
        <div class="phone-input">
          <span class="phone-prefix">+91</span>
          <input type="tel" id="phone" name="phone" required inputmode="numeric" maxlength="10" autocomplete="tel" placeholder="10-digit mobile number" />
        </div>

        <label for="passcode">Passcode</label>
        <input type="text" id="passcode" name="passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

        <div id="error-msg" class="error-msg" style="display:none;">
          <i class="ti ti-alert-circle"></i><span id="error-text"></span>
        </div>

        <button type="submit" class="btn-block" id="submit-btn">
          <span class="btn-label">Log in</span>
          <i class="ti ti-loader-2 btn-spinner" style="display:none;"></i>
        </button>
      </form>

      <p class="alt-action"><a href="/forgot-passcode/">Forgot passcode?</a></p>
      <p class="alt-action">New here? <a href="/signup/" id="signup-link">Create an account</a></p>
    </div>
  </div>

  <style>
    .auth-content {
      max-width: 440px !important;
      margin: 0 auto !important;
    }
    .auth-card {
      background: linear-gradient(160deg, #14102b 0%, #241a4d 45%, #3d2374 100%);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 36px 32px;
      box-shadow: 0 12px 30px -12px rgba(20, 16, 43, 0.5);
      animation: card-in 0.45s ease-out;
      color: #ffffff;
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .auth-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: rgba(255, 154, 60, 0.15);
      color: #ff9a3c;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 16px;
    }
    .auth-card h1 {
      font-size: 24px;
      margin-bottom: 4px;
      color: #ffffff;
    }
    .auth-card .sub {
      margin-bottom: 24px;
      color: rgba(255,255,255,0.65);
    }
    .auth-card label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      color: rgba(255,255,255,0.85);
      margin: 18px 0 6px;
    }
    .auth-card input {
      margin-bottom: 0;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.15);
      color: #ffffff;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .auth-card input::placeholder {
      color: rgba(255,255,255,0.35);
    }
    .auth-card input:focus {
      outline: none;
      border-color: #ff9a3c;
      box-shadow: 0 0 0 3px rgba(255, 154, 60, 0.2);
    }
    .phone-input {
      display: flex;
      align-items: stretch;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 12px;
      overflow: hidden;
      background: rgba(255,255,255,0.06);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .phone-input:focus-within {
      border-color: #ff9a3c;
      box-shadow: 0 0 0 3px rgba(255, 154, 60, 0.2);
      background: rgba(255,255,255,0.08);
    }
    .phone-prefix {
      display: flex;
      align-items: center;
      padding: 0 12px;
      background: transparent;
      color: rgba(255,255,255,0.6);
      font-weight: 600;
      font-size: 17px;
      border-right: 1px solid rgba(255,255,255,0.15);
    }
    .phone-input input {
      border: none;
      border-radius: 0;
      background: transparent;
      flex: 1;
    }
    .phone-input input:focus {
      box-shadow: none;
      background: transparent;
    }
    .code-input {
      box-sizing: border-box;
      width: 100%;
      font-size: clamp(18px, 5.5vw, 24px);
      font-weight: 700;
      letter-spacing: clamp(4px, 2.2vw, 10px);
      text-align: center;
      font-family: monospace;
      padding-left: 8px;
      padding-right: 8px;
    }
    .code-input::placeholder {
      letter-spacing: clamp(4px, 2.2vw, 10px);
      color: rgba(255,255,255,0.25);
    }
    .error-msg {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #3a1c1c;
      color: #ff9b93;
      border-left: 3px solid #d33;
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 14px;
      margin: 18px 0 0;
    }
    .btn-block {
      width: 100%;
      margin-top: 26px;
      padding: 13px;
      font-size: 16px;
      font-weight: 700;
      border-radius: 10px;
      border: none;
      background: linear-gradient(90deg, #ff9a3c, #ffb35c);
      color: #2a1400;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.1s, opacity 0.15s;
    }
    .btn-block:hover:not(:disabled) {
      transform: translateY(-1px);
    }
    .btn-block:active:not(:disabled) {
      transform: translateY(0);
    }
    .btn-block:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .btn-success {
      background: rgba(93, 224, 192, 0.9) !important;
      color: #04342c !important;
      opacity: 1 !important;
    }
    .btn-spinner {
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .alt-action {
      text-align: center;
      margin-top: 14px;
      font-size: 14px;
      color: rgba(255,255,255,0.6);
    }
    .alt-action a {
      color: #ffcb8a;
    }
  </style>

  <script>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
    const form = document.getElementById('login-form');
    const errorMsg = document.getElementById('error-msg');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn');
    const btnLabel = submitBtn.querySelector('.btn-label');
    const btnSpinner = submitBtn.querySelector('.btn-spinner');

    // Strip non-digit characters as the user types (pattern/inputmode alone don't block typing on desktop)
    ['phone', 'passcode'].forEach((id) => {
      const el = document.getElementById(id);
      const maxLen = id === 'phone' ? 10 : 6;
      el.addEventListener('input', () => {
        el.value = el.value.replace(/\D/g, '').slice(0, maxLen);

        if (id === 'phone' && el.value.length === maxLen) {
          // Phone number complete — jump straight to passcode instead of
          // making the person tap it manually.
          document.getElementById('passcode').focus();
        }

        if (id === 'passcode' && el.value.length === maxLen) {
          // Passcode complete — submit automatically rather than requiring
          // an extra tap on the Log in button. requestSubmit() (not
          // .submit()) so the normal submit event listener still fires.
          form.requestSubmit();
        }
      });
    });

    function setLoading(isLoading, labelWhenIdle) {
      submitBtn.disabled = isLoading;
      btnLabel.textContent = isLoading ? 'Logging in...' : labelWhenIdle;
      btnSpinner.style.display = isLoading ? 'inline-block' : 'none';
    }

    function showError(msg) {
      errorText.textContent = msg;
      errorMsg.style.display = 'flex';
    }

    const params = new URLSearchParams(window.location.search);
    const nextUrl = params.get('next') || '/';

    // Same reasoning as the mirrored fix on the signup page: someone
    // arriving here mid-purchase who doesn't actually have an account yet
    // might click "Create an account" — without this, that click drops
    // the ?next= redirect and they'd have to start the purchase over.
    const signupLink = document.getElementById('signup-link');
    if (signupLink && params.get('next')) {
      signupLink.href = `/signup/?next=${encodeURIComponent(params.get('next'))}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.style.display = 'none';
      setLoading(true, 'Log in');

      const payload = {
        phone: form.phone.value.trim(),
        passcode: form.passcode.value.trim(),
      };

      try {
        const res = await fetch(`${WORKER_URL}/login`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          showError(data.error || 'Invalid phone number or passcode.');
          setLoading(false, 'Log in');
          return;
        }

        btnLabel.textContent = 'Logged in!';
        btnSpinner.style.display = 'none';
        submitBtn.classList.add('btn-success');
        // Clear any stale cached session so the destination page re-checks fresh
        try { sessionStorage.removeItem('sh_session_cache'); } catch (err) {}
        setTimeout(() => { window.location.href = nextUrl; }, 700);
      } catch (err) {
        showError('Network error. Please check your connection and try again.');
        setLoading(false, 'Log in');
      }
    });
  </script>

<style>
  @media (max-width: 720px) {
    .auth-content {
      max-width: 100%;
    }
    .auth-card {
      padding: 14px 16px;
      border-radius: 18px;
    }
    .auth-icon {
      display: none;
    }
    .auth-card h1 {
      font-size: 17px;
      margin-bottom: 2px;
    }
    .auth-card .sub {
      font-size: 12px;
      line-height: 1.3;
      margin-bottom: 8px;
    }
    .auth-card label {
      margin: 6px 0 3px;
      font-size: 11px;
    }
    .auth-card input:not(.code-input) {
      padding: 8px 12px;
      font-size: 14px;
    }
    .phone-prefix {
      padding: 0 8px;
      font-size: 14px;
    }
    .code-input {
      padding-top: 7px;
      padding-bottom: 7px;
      font-size: clamp(16px, 5vw, 20px) !important;
    }
    .btn-block {
      padding: 10px;
      font-size: 14px;
      margin-top: 10px;
    }
    .alt-action {
      margin-top: 10px;
      font-size: 12px;
    }
  }
  @media (max-width: 380px) {
    .auth-card {
      padding: 12px 12px;
    }
  }
</style>
