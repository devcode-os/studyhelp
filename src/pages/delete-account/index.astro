---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="Delete Account - StudyHelp" description="Permanently delete your StudyHelp account and all associated data.">

  <Header active="account" />

  <div class="page-wide">

    <div class="delete-card">
      <h1 class="delete-h1">Delete your account</h1>
      <p class="delete-sub">This permanently removes your account, purchase history, and unlocked subject access. This cannot be undone.</p>

      <div id="logged-out-notice" class="notice" style="display:none;">
        <p>You need to be logged in to delete your account.</p>
        <a href="/login/?next=/delete-account/" class="btn-outline">Log in</a>
      </div>

      <form id="delete-form" style="display:none;">
        <label for="passcode">Enter your passcode to confirm</label>
        <input type="password" id="passcode" inputmode="numeric" maxlength="6" placeholder="6-digit passcode" autocomplete="current-password" />

        <div class="warning-box">
          <p><strong>This will permanently delete:</strong></p>
          <ul>
            <li>Your account and login access</li>
            <li>All purchase and payment history</li>
            <li>Any active or expired subject access</li>
          </ul>
          <p>Any subject access you've already unlocked will be lost. This action cannot be reversed.</p>
        </div>

        <label class="confirm-checkbox">
          <input type="checkbox" id="confirm-checkbox" />
          I understand this is permanent and cannot be undone
        </label>

        <p class="err" id="delete-err"></p>

        <button type="submit" id="delete-btn" class="btn-danger" disabled>Delete my account</button>
      </form>

      <div id="success-notice" class="notice success" style="display:none;">
        <p>Your account and all associated data have been deleted.</p>
        <a href="/" class="btn-outline">Return to home</a>
      </div>
    </div>

  </div>

  <style>
    .page-wide {
      max-width: 560px;
      margin: 0 auto;
      padding: 24px;
    }
    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }
    .delete-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.75rem;
    }
    .delete-h1 {
      font-size: 21px;
      margin: 0 0 8px;
    }
    .delete-sub {
      color: var(--muted);
      font-size: 14px;
      margin: 0 0 24px;
      line-height: 1.6;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
    }
    input[type="password"] {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 16px;
      font-family: inherit;
      background: var(--bg);
      color: var(--text);
      margin-bottom: 18px;
      letter-spacing: 2px;
    }
    input[type="password"]:focus {
      outline: none;
      border-color: var(--accent);
    }
    .warning-box {
      background: var(--amber-bg, #faeeda);
      border: 1px solid #e8c876;
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 18px;
      font-size: 13px;
      line-height: 1.6;
    }
    .warning-box p { margin: 0 0 8px; }
    .warning-box ul { margin: 0 0 8px; padding-left: 20px; }
    .warning-box p:last-child { margin-bottom: 0; }
    html[data-theme="dark"] .warning-box {
      background: #3a2a10;
      border-color: #6b5a2a;
    }
    .confirm-checkbox {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 13px;
      font-weight: 400;
      margin-bottom: 18px;
      cursor: pointer;
    }
    .confirm-checkbox input {
      margin-top: 2px;
      flex-shrink: 0;
    }
    .btn-danger {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      background: #b8341c;
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-danger:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .btn-outline {
      display: inline-block;
      margin-top: 10px;
      padding: 10px 20px;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      text-decoration: none;
      font-size: 14px;
    }
    .notice {
      text-align: center;
      padding: 20px 0;
    }
    .notice.success p {
      color: var(--success-text, #27500a);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .err {
      color: #b8341c;
      font-size: 13px;
      margin: -8px 0 14px;
    }
  </style>

  <script is:inline>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    getSession().then((session) => {
      if (!session.logged_in) {
        document.getElementById('logged-out-notice').style.display = 'block';
        return;
      }
      document.getElementById('delete-form').style.display = 'block';
    });

    const checkbox = document.getElementById('confirm-checkbox');
    const deleteBtn = document.getElementById('delete-btn');
    if (checkbox && deleteBtn) {
      checkbox.addEventListener('change', () => {
        deleteBtn.disabled = !checkbox.checked;
      });
    }

    const form = document.getElementById('delete-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const errEl = document.getElementById('delete-err');
        errEl.textContent = '';

        const passcode = document.getElementById('passcode').value.trim();
        if (!/^\d{6}$/.test(passcode)) {
          errEl.textContent = 'Enter your 6-digit passcode.';
          return;
        }

        deleteBtn.disabled = true;
        deleteBtn.textContent = 'Deleting...';

        fetch(`${WORKER_URL}/account/delete`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ passcode }),
        })
          .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
          .then(({ ok, data }) => {
            if (!ok) {
              errEl.textContent = data.error || 'Could not delete account.';
              deleteBtn.disabled = false;
              deleteBtn.textContent = 'Delete my account';
              return;
            }
            form.style.display = 'none';
            document.getElementById('success-notice').style.display = 'block';
          })
          .catch(() => {
            errEl.textContent = 'Network error. Please try again.';
            deleteBtn.disabled = false;
            deleteBtn.textContent = 'Delete my account';
          });
      });
    }
  </script>
</Layout>
