---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const subjects = [
  {
    titleNative: 'తెలంగాణ చరిత్ర',
    titleEnglish: 'Telangana history',
    slug: 'telangana-history-te',
    price: 199,
    popular: true,
    available: true,
  },
  {
    titleNative: 'Telangana economy',
    titleEnglish: 'English',
    slug: 'telangana-economy-en',
    price: 199,
    popular: false,
    available: true,
  },
  {
    titleNative: 'Telangana history',
    titleEnglish: 'English',
    slug: 'telangana-history-en',
    price: 199,
    popular: false,
    available: false,
  },
  {
    titleNative: 'తెలంగాణ ఆర్థిక వ్యవస్థ',
    titleEnglish: 'Telangana economy',
    slug: 'telangana-economy-te',
    price: 199,
    popular: false,
    available: false,
  },
];
---
<Layout title="Plans - StudyHelp" description="Unlock unlimited access to StudyHelp subjects. One-time payment, no subscription.">

  <Header active="plans" />

  <div style="max-width:1100px; margin:0 auto; padding:24px;">

    <div style="text-align:center; margin-bottom:1.5rem;">
      <h1 style="margin:0 0 6px;">Unlock unlimited access</h1>
      <p style="color:var(--muted); font-size:14px; margin:0;">One-time payment per subject. No subscription, no expiry.</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:1.5rem;">
      {subjects.map((s) => (
        <div style={`background:var(--card); border:${s.popular ? '2px solid var(--accent)' : '1px solid var(--border)'}; border-radius:12px; padding:1.25rem; ${s.available ? '' : 'opacity:0.6;'}`}>
          {s.popular && (
            <span style="font-size:12px; background:var(--accent-bg); color:var(--accent); padding:2px 10px; border-radius:6px;">most popular</span>
          )}
          <div style={`font-weight:700; font-size:15px; ${s.popular ? 'margin-top:10px;' : 'margin-top:26px;'}`}>{s.titleNative}</div>
          <div style="font-size:13px; color:var(--muted); margin:2px 0 12px;">{s.titleEnglish}</div>
          <div style="font-size:22px; font-weight:700; margin-bottom:12px;">Rs. {s.price}</div>
          {s.available ? (
            <button
              data-subject={s.slug}
              data-price={s.price}
              class="buy-btn"
              style="width:100%; font-size:13px; padding:8px; border:1px solid var(--accent); border-radius:8px; background:var(--accent-bg); color:var(--accent); cursor:pointer;"
            >
              Buy now
            </button>
          ) : (
            <button disabled style="width:100%; font-size:13px; padding:8px; border:1px solid var(--border); border-radius:8px; background:var(--bg); color:var(--muted); cursor:not-allowed;">
              Coming soon
            </button>
          )}
        </div>
      ))}
    </div>

    <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.25rem;">
      <div style="font-size:14px; font-weight:600; margin-bottom:12px;">What you get</div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:16px;">
        <div>
          <div style="font-size:13px; font-weight:600;">Unlimited reading</div>
          <div style="font-size:12px; color:var(--muted);">All chapters, all FAQs</div>
        </div>
        <div>
          <div style="font-size:13px; font-weight:600;">Up to 3 devices</div>
          <div style="font-size:12px; color:var(--muted);">Manage and switch anytime</div>
        </div>
        <div>
          <div style="font-size:13px; font-weight:600;">No expiry</div>
          <div style="font-size:12px; color:var(--muted);">One-time payment, forever access</div>
        </div>
      </div>
    </div>

  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const WORKER_URL = 'https://studyhelp-payments.sasi-488.workers.dev';

    // TEMP identity: email captured via simple prompt, no OTP verification yet.
    // Once OTP login is built, replace getUserEmail() with the verified session email —
    // same field, so existing entitlements keep working unchanged.
    function getUserEmail() {
      let email = localStorage.getItem('studyhelp_email');
      if (!email) {
        email = promptForEmail();
      }
      return email;
    }

    function promptForEmail() {
      let email = null;
      while (!email) {
        const input = prompt('Enter your email to continue with purchase:');
        if (input === null) return null; // user cancelled
        const trimmed = input.trim();
        if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed)) {
          email = trimmed.toLowerCase();
          localStorage.setItem('studyhelp_email', email);
        } else {
          alert('Please enter a valid email address.');
        }
      }
      return email;
    }

    // On page load: check ownership for every available subject, swap button to "Open" if owned
    async function checkOwnershipForAllSubjects() {
      const storedEmail = localStorage.getItem('studyhelp_email');
      if (!storedEmail) return; // no identity yet, nothing to check — all buttons stay "Buy now"

      const buttons = document.querySelectorAll('.buy-btn');
      for (const btn of buttons) {
        const subject_id = btn.getAttribute('data-subject');
        try {
          const res = await fetch(
            `${WORKER_URL}/check-access?user_id=${encodeURIComponent(storedEmail)}&subject_id=${encodeURIComponent(subject_id)}`
          );
          const data = await res.json();
          if (data.unlocked) {
            setButtonToOpen(btn, subject_id);
          }
        } catch (err) {
          // silently skip on network error — button stays as "Buy now", user can retry
        }
      }
    }

    function setButtonToOpen(btn, subject_id) {
      // Clone the node to strip any previously attached addEventListener
      // handlers (the buy-flow listener below), so this button can never
      // have both a "buy" listener and an "open" handler firing on the
      // same click.
      const freshBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(freshBtn, btn);

      freshBtn.disabled = false;
      freshBtn.textContent = 'Open — Unlimited access';
      freshBtn.classList.remove('buy-btn');
      freshBtn.style.background = 'var(--accent)';
      freshBtn.style.color = '#fff';
      freshBtn.onclick = () => {
        window.location.href = `/${subject_id}/`;
      };
      return freshBtn;
    }

    document.querySelectorAll('.buy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const subject_id = btn.getAttribute('data-subject'); // works for any available subject, not hardcoded

        const user_id = getUserEmail();
        if (!user_id) return; // user cancelled email prompt

        btn.disabled = true;
        btn.textContent = 'Loading...';

        try {
          const res = await fetch(`${WORKER_URL}/create-order`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id, subject_id }),
          });
          const order = await res.json();

          if (!res.ok) {
            if (order.error === 'Already purchased') {
              setButtonToOpen(btn, subject_id); // btn is cloned+replaced internally; safe even though this listener is on the old node
              return;
            }
            alert(order.error || 'Could not start payment');
            btn.disabled = false;
            btn.textContent = 'Buy now';
            return;
          }

          const rzp = new Razorpay({
            key: order.key_id,
            amount: order.amount,
            currency: order.currency,
            order_id: order.order_id,
            name: 'StudyHelp',
            description: subject_id,
            prefill: { email: user_id },
            handler: function () {
              // Don't unlock here — redirect to processing page which waits for webhook confirmation
              window.location.href =
                `/payment-processing/?user_id=${encodeURIComponent(user_id)}&subject_id=${encodeURIComponent(subject_id)}`;
            },
            modal: {
              ondismiss: function () {
                btn.disabled = false;
                btn.textContent = 'Buy now';
              },
            },
          });

          rzp.on('payment.failed', function () {
            alert('Payment failed. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Buy now';
          });

          rzp.open();
        } catch (err) {
          alert('Error: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'Buy now';
        }
      });
    });

    checkOwnershipForAllSubjects();
  </script>
</Layout>
