---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

// Real, purchasable subjects are no longer hardcoded here — they're fetched
// client-side from GET /subjects/public (Worker → D1 `subjects` table) so
// price/title changes made in the master-access Pricing tab show up here
// immediately, with no code edit or redeploy needed.
//
// This list is ONLY for subjects that don't exist yet (no content, no D1
// row) but are worth teasing as "Coming soon". Once a subject is actually
// launched, remove it from here — it'll start appearing automatically from
// the live list once its D1 row exists.
const comingSoonSubjects = [
  {
    titleNative: 'Telangana History',
    titleEnglish: 'English Version',
    slug: 'telangana-history-en',
  },
  {
    titleNative: 'తెలంగాణ ఆర్థిక వ్యవస్థ',
    titleEnglish: 'Telugu Version',
    slug: 'telangana-economy-te',
  },
  {
    titleNative: 'Indian Polity',
    titleEnglish: 'English Version',
    slug: 'indian-polity-en',
  },
  {
    titleNative: 'భారత రాజ్యాంగం',
    titleEnglish: 'Telugu Version',
    slug: 'indian-polity-te',
  },
];
---
<Layout title="Plans - StudyHelp" description="Unlock 45 days of unlimited access to StudyHelp subjects. One-time payment.">

  <Header active="plans" />

  <div class="page-wide">

    <div style="text-align:center; margin-bottom:1.5rem; position:relative; overflow:hidden; border-radius:20px; padding:2rem 1.25rem; background:linear-gradient(160deg, #14102b 0%, #241a4d 45%, #3d2374 100%); box-shadow:0 12px 30px -12px rgba(20, 16, 43, 0.5);" class="plans-intro">
      <h1 style="margin:0 0 6px; color:#ffffff; position:relative;" class="plans-h1">45 Days Unlimited Access</h1>
      <p style="color:rgba(255,255,255,0.72); font-size:14px; margin:0; position:relative;" class="plans-sub">One-time payment per subject. No subscription.</p>
    </div>

    <div id="active-subjects-section" style="display:none; margin-bottom:1.5rem;">
      <div style="font-size:14px; font-weight:700; margin-bottom:10px; display:flex; align-items:center; gap:6px;">
        <i class="ti ti-circle-check" style="color:var(--success-text, #065f46);"></i> Your Active Subjects
      </div>
      <div id="active-subjects-list" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:12px;"></div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 280px)); gap:12px; margin-bottom:1.5rem; justify-content:start;" class="plan-grid" id="real-plan-grid">
      <div class="plan-skeleton" style="grid-column:1/-1; text-align:center; padding:2rem; color:var(--muted); font-size:13px;">Loading subjects...</div>
    </div>

    {comingSoonSubjects.length > 0 && (
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:1.5rem;" class="plan-grid">
        {comingSoonSubjects.map((s) => (
          <div class="plan-card" style="background:linear-gradient(160deg, #1a1438 0%, #241a4d 100%); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:1.25rem; opacity:0.55; color:#ffffff;">
            <div class="card-title" style="font-weight:700; font-size:15px; margin-top:26px; color:#ffffff;">{s.titleNative}</div>
            <div style="font-size:13px; color:rgba(255,255,255,0.6); margin:2px 0 12px;">{s.titleEnglish}</div>
            <button disabled class="soon-btn" style="width:100%; font-size:13px; padding:8px; border:1px solid rgba(255,255,255,0.15); border-radius:8px; background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.5); cursor:not-allowed;">
              Coming soon
            </button>
          </div>
        ))}
      </div>
    )}

    <div style="background:linear-gradient(160deg, #1a1438 0%, #241a4d 100%); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:1.25rem; color:#ffffff;" class="whatyouget-card">
      <div style="font-size:14px; font-weight:600; margin-bottom:12px; color:#ffffff;">What you get</div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:16px;">
        <div>
          <div style="font-size:13px; font-weight:600; color:#ffffff;">Unlimited reading</div>
          <div style="font-size:12px; color:rgba(255,255,255,0.6);">All chapters, all FAQs</div>
        </div>
        <div>
          <div style="font-size:13px; font-weight:600; color:#ffffff;">Log in anywhere</div>
          <div style="font-size:12px; color:rgba(255,255,255,0.6);">Switch devices anytime, no limit</div>
        </div>
        <div>
          <div style="font-size:13px; font-weight:600; color:#ffffff;">45 days unlimited</div>
          <div style="font-size:12px; color:rgba(255,255,255,0.6);">One-time payment, full 45-day access</div>
        </div>
      </div>
    </div>

  </div>

  <style>
    /* Mobile-only addition: reserves space at the bottom so content isn't
       hidden behind the fixed tab bar. Desktop max-width/padding matches
       the original inline style exactly (1100px / 24px) — nothing else
       on this page was changed. */
    .page-wide {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }
    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }

    /* ---------- Mobile-only capsule redesign. Every rule below uses
       !important because the desktop markup styles each element with
       inline style="" attributes, which otherwise always win over a
       stylesheet rule regardless of media query. No inline style itself
       was edited — desktop renders exactly as before at any width above
       720px, since these rules simply don't apply there. ---------- */
    @media (max-width: 720px) {
      .plans-intro { margin-bottom: 1rem !important; }
      .plans-h1 { font-size: 22px !important; }
      .plans-sub { font-size: 13px !important; }

      #active-subjects-list {
        grid-template-columns: 1fr !important;
        gap: 10px !important;
      }

      .plan-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 10px !important;
      }
      .plan-card {
        border-radius: 16px !important;
        padding: 0.9rem !important;
      }
      .badge-popular,
      .badge-yours {
        font-size: 10px !important;
        padding: 2px 8px !important;
      }
      .card-title {
        font-size: 13px !important;
        line-height: 1.3 !important;
      }
      .plan-price {
        font-size: 17px !important;
        margin-bottom: 8px !important;
      }
      .buy-btn,
      .soon-btn {
        font-size: 12px !important;
        padding: 8px !important;
        border-radius: 10px !important;
      }

      .whatyouget-card {
        border-radius: 16px !important;
        padding: 1rem !important;
        margin-bottom: 12px !important;
      }
      .whatyouget-card > div[style*="grid-template-columns"] {
        grid-template-columns: 1fr !important;
        gap: 12px !important;
      }
    }
  </style>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    let currentUser = null; // { user_id, name } once resolved, else null
    let subjectMeta = []; // populated by loadRealSubjects() before anything else runs

    // "12 days left" / "Last day" / "Expires today" — human-friendly countdown
    // from a unix-seconds expires_at timestamp.
    function formatDaysLeft(expiresAtSeconds) {
      const msLeft = expiresAtSeconds * 1000 - Date.now();
      const daysLeft = Math.ceil(msLeft / (24 * 60 * 60 * 1000));
      if (daysLeft <= 0) return 'Expires today';
      if (daysLeft === 1) return '1 day left';
      return `${daysLeft} days left`;
    }

    function formatExpiryDate(expiresAtSeconds) {
      return new Date(expiresAtSeconds * 1000).toLocaleDateString('en-IN', {
        day: 'numeric', month: 'short', year: 'numeric',
      });
    }

    // Session is fetched ONCE per page by Header.astro (runs synchronously
    // inline, before this script) and exposed on window.__shSessionPromise.
    // Reusing it here avoids a duplicate /me call on every Plans page load.
    // Preserves this page's original contract: resolves to the session data
    // object if logged in, or null if not (callers below check for null).
    async function getSession() {
      const source = window.__shSessionPromise
        || fetch(`${WORKER_URL}/me`, { credentials: 'include' })
            .then((res) => res.json())
            .catch(() => ({ logged_in: false }));

      const data = await source;
      return data.logged_in ? data : null;
    }

    // On page load: check ownership for every available subject, swap button to
    // "Open" if owned, and build the prominent "Your Active Subjects" section
    // so a purchased subject isn't just a relabeled button buried in the
    // pricing grid — easy to miss there.
    async function checkOwnershipForAllSubjects() {
      if (!currentUser) return; // not logged in — every button stays "Buy now"

      const activeList = document.getElementById('active-subjects-list');
      const activeSection = document.getElementById('active-subjects-section');
      let anyActive = false;

      const buttons = document.querySelectorAll('.buy-btn');
      for (const btn of buttons) {
        const subject_id = btn.getAttribute('data-subject');
        try {
          const res = await fetch(
            `${WORKER_URL}/check-access?user_id=${encodeURIComponent(currentUser.user_id)}&subject_id=${encodeURIComponent(subject_id)}`
          );
          const data = await res.json();
          if (data.unlocked) {
            setButtonToOpen(btn, subject_id, data.expires_at);
            anyActive = true;

            const meta = subjectMeta.find((s) => s.slug === subject_id);
            const card = document.createElement('div');

            const graceBannerHtml = data.is_grace_grant ? `
              <div style="width:100%; margin-top:10px; padding:10px 12px; border-radius:8px; background:#fff4e0; border:1px solid #e8c876; color:#6b4a00; font-size:12px; line-height:1.5;">
                We haven't yet confirmed your payment. You've been given ${data.grace_days_remaining ?? ''} day${data.grace_days_remaining === 1 ? '' : 's'} of temporary access while we check — this won't continue automatically. If you believe this is a mistake or have already paid, please <a href="/support/" style="color:#6b4a00; font-weight:600;">contact us</a>.
              </div>
            ` : '';

            card.style.cssText = `background:var(--success-bg, #d1fae5); border:1px solid var(--success-text, #065f46); border-radius:12px; padding:1rem 1.25rem; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px;`;
            card.innerHTML = `
              <div>
                <div style="font-weight:700; font-size:14px; color:var(--success-text, #065f46);">${meta ? meta.titleNative : subject_id}</div>
                <div style="font-size:12px; color:var(--muted);">${data.expires_at ? formatDaysLeft(data.expires_at) + ' &middot; until ' + formatExpiryDate(data.expires_at) : 'Active'}</div>
              </div>
              <a href="/${subject_id}/" style="font-size:13px; font-weight:600; padding:8px 16px; border-radius:8px; background:var(--success-text, #065f46); color:#fff; text-decoration:none; flex-shrink:0;">Open</a>
              ${graceBannerHtml}
            `;
            activeList.appendChild(card);
          }
        } catch (err) {
          // silently skip on network error — button stays as "Buy now", user can retry
        }
      }

      if (anyActive) {
        activeSection.style.display = 'block';
      }
    }

    function setButtonToOpen(btn, subject_id, expiresAt) {
      // Clone the node to strip any previously attached addEventListener
      // handlers (the buy-flow listener below), so this button can never
      // have both a "buy" listener and an "open" handler firing on the
      // same click.
      const freshBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(freshBtn, btn);

      freshBtn.disabled = false;
      // On mobile, the "Your Active Subjects" banner above already shows
      // the days-left countdown for this exact subject — repeating it on
      // the narrow 2-column card button caused "Open — 43 days left" to
      // wrap to 2 lines. Mobile gets a short "Open" label instead; desktop
      // keeps the full text since there's room and no banner duplication.
      const isMobile = window.matchMedia('(max-width: 720px)').matches;
      freshBtn.textContent = expiresAt && !isMobile
        ? `Open — ${formatDaysLeft(expiresAt)}`
        : 'Open';
      freshBtn.title = expiresAt ? `Access until ${formatExpiryDate(expiresAt)}` : '';
      // Keep the buy-btn class (only override its color inline below) so
      // this button keeps the same consistent padding/border-radius/width
      // sizing as every other card button — removing the class entirely
      // was causing it to fall back to unstyled browser defaults.
      freshBtn.style.background = 'linear-gradient(90deg, #ff9a3c, #ffb35c)';
      freshBtn.style.color = '#2a1400';
      freshBtn.style.borderColor = 'transparent';
      freshBtn.onclick = () => {
        window.location.href = `/${subject_id}/`;
      };
      return freshBtn;
    }

    function renderPlanCard(s) {
      // s: { slug, titleNative, titleEnglish, price, popular }
      const popularBadge = s.popular
        ? `<span class="badge-popular" style="font-size:12px; background:linear-gradient(90deg, #ff9a3c, #ffb35c); color:#2a1400; font-weight:700; padding:2px 10px; border-radius:6px; display:inline-block;">most popular</span>`
        : `<span class="badge-popular" style="font-size:12px; background:linear-gradient(90deg, #ff9a3c, #ffb35c); color:#2a1400; font-weight:700; padding:2px 10px; border-radius:6px; display:none;">most popular</span>`;
      return `
        <div id="plan-card-${s.slug}" data-slug="${s.slug}" data-popular="${s.popular ? 'true' : 'false'}" class="plan-card" style="background:linear-gradient(160deg, #1a1438 0%, #241a4d 100%); border:${s.popular ? '2px solid #ff9a3c' : '1px solid rgba(255,255,255,0.08)'}; border-radius:12px; padding:1.25rem; color:#ffffff; transition:box-shadow 0.2s, border-color 0.2s;">
          ${popularBadge}
          <span class="badge-yours" style="font-size:12px; background:rgba(93, 224, 192, 0.15); color:#5ce0c0; font-weight:700; padding:2px 10px; border-radius:6px; display:none;">&#10003; your subject</span>
          <div class="card-title" style="font-weight:700; font-size:15px; color:#ffffff; ${s.popular ? 'margin-top:10px;' : 'margin-top:26px;'}">${s.titleNative}</div>
          <div style="font-size:13px; color:rgba(255,255,255,0.6); margin:2px 0 12px;">${s.titleEnglish || ''}</div>
          <div style="font-size:22px; font-weight:700; margin-bottom:12px; color:#ffcb8a;" class="plan-price">Rs. ${s.price}</div>
          <button data-subject="${s.slug}" data-price="${s.price}" class="buy-btn" style="width:100%; font-size:13px; font-weight:700; padding:8px; border:none; border-radius:8px; background:linear-gradient(90deg, #ff9a3c, #ffb35c); color:#2a1400; cursor:pointer;">
            Buy now
          </button>
        </div>
      `;
    }

    // Fetches live subjects+prices from D1 (via the Worker's public endpoint)
    // and renders the real plan cards. Must complete before ownership checks,
    // the buy-button click flow, or ?highlight=/?buy= handling run, since
    // all of those depend on these cards already being in the DOM. Buy-button
    // click handlers are attached here too, since the old static ones (below)
    // no longer exist at page-load time for these dynamically-created cards.
    async function loadRealSubjects() {
      const grid = document.getElementById('real-plan-grid');
      try {
        const res = await fetch(`${WORKER_URL}/subjects/public`);
        const data = await res.json();
        const subjects = (data.subjects || []).map((s) => ({
          slug: s.id,
          titleNative: s.title_native || s.name,
          titleEnglish: s.title_english || '',
          price: s.price_paise / 100,
          popular: !!s.popular,
        }));

        subjectMeta = subjects;

        if (subjects.length === 0) {
          grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:2rem; color:var(--muted); font-size:13px;">No subjects available right now.</div>`;
          return;
        }

        grid.innerHTML = subjects.map(renderPlanCard).join('');

        document.querySelectorAll('.buy-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const subject_id = btn.getAttribute('data-subject');
            if (!currentUser) {
              const returnTo = `/plans/?buy=${encodeURIComponent(subject_id)}`;
              // The signup page now shows its own persistent purchase-context
              // banner (subject name + "you'll be sent straight to payment"),
              // which explains this better than a timed toast ever could —
              // so no toast needed here anymore, just a direct redirect.
              window.location.href = `/signup/?next=${encodeURIComponent(returnTo)}`;
              return;
            }
            startPurchase(btn, subject_id);
          });
        });
      } catch (err) {
        grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:2rem; color:var(--muted); font-size:13px;">Couldn't load subjects. Please refresh the page.</div>`;
      }
    }

    function startPurchase(btn, subject_id) {
      btn.disabled = true;
      btn.textContent = 'Loading...';

      fetch(`${WORKER_URL}/create-order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: currentUser.user_id, subject_id }),
      })
        .then((res) => res.json().then((order) => ({ res, order })))
        .then(({ res, order }) => {
          if (!res.ok) {
            if (order.error === 'Already purchased') {
              // Don't just relabel and wait for a second click — that leaves
              // the user unsure whether anything happened. Show a clear
              // confirmation and auto-redirect straight to their content.
              btn.disabled = true;
              btn.textContent = '✓ Already purchased — opening...';
              btn.style.background = 'linear-gradient(90deg, #ff9a3c, #ffb35c)';
              btn.style.color = '#fff';
              setTimeout(() => {
                window.location.href = `/${subject_id}/`;
              }, 800);
              return;
            }
            alert(order.error || 'Could not start payment');
            btn.disabled = false;
            btn.textContent = 'Buy now';
            return;
          }

          const rzp = new Razorpay({
            key: order.key_id,
            amount: order.amount,
            currency: order.currency,
            order_id: order.order_id,
            name: 'StudyHelp',
            description: subject_id,
            prefill: { name: currentUser.name },
            handler: function () {
              // Don't unlock here — redirect to processing page which waits for webhook confirmation
              window.location.href =
                `/payment-processing/?user_id=${encodeURIComponent(currentUser.user_id)}&subject_id=${encodeURIComponent(subject_id)}`;
            },
            modal: {
              ondismiss: function () {
                btn.disabled = false;
                btn.textContent = 'Buy now';
              },
            },
          });

          rzp.on('payment.failed', function () {
            alert('Payment failed. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Buy now';
          });

          rzp.open();
        })
        .catch((err) => {
          alert('Error: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'Buy now';
        });
    }

    // Highlight the specific subject someone came here to buy (from a
    // subject page's "Unlock unlimited" button), so it's unmistakable which
    // card to click — instead of the generic "most popular" badge misleading
    // them into buying a different subject by habit. Now called explicitly
    // from boot, after loadRealSubjects() has put the cards in the DOM —
    // it used to run as an immediately-invoked function against
    // server-rendered cards that existed at parse time; those cards are
    // fetched client-side now, so this can no longer run immediately.
    function highlightIntendedSubject() {
      const params = new URLSearchParams(window.location.search);
      const highlightSlug = params.get('highlight');
      if (!highlightSlug) return; // no specific intent — leave default "most popular" styling as-is

      const targetCard = document.getElementById(`plan-card-${highlightSlug}`);
      if (!targetCard) return;

      // Demote the generic "most popular" badge/border on every card —
      // it's misleading once the person has a specific subject in mind.
      document.querySelectorAll('[id^="plan-card-"]').forEach((card) => {
        card.style.border = '1px solid rgba(255,255,255,0.08)';
        const popularBadge = card.querySelector('.badge-popular');
        if (popularBadge) popularBadge.style.display = 'none';
        const title = card.querySelector('.card-title');
        if (title) title.style.marginTop = '26px';
      });

      // Mark the correct card clearly.
      targetCard.style.border = '2px solid #ff9a3c';
      targetCard.style.boxShadow = '0 0 0 4px rgba(255, 154, 60, 0.18)';
      const yoursBadge = targetCard.querySelector('.badge-yours');
      if (yoursBadge) yoursBadge.style.display = 'inline-block';
      const targetTitle = targetCard.querySelector('.card-title');
      if (targetTitle) targetTitle.style.marginTop = '10px';

      targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Boot: load the real subject cards first (they must exist in the DOM
    // before anything below can query them), then resolve session, check
    // ownership, apply the highlight, and auto-resume a purchase if we
    // arrived here via the ?buy= redirect after login/signup.
    loadRealSubjects().then(() => {
      getSession().then((session) => {
        currentUser = session;
        checkOwnershipForAllSubjects().then(() => {
          highlightIntendedSubject();
          const params = new URLSearchParams(window.location.search);
          const buySubject = params.get('buy');
          if (buySubject && currentUser) {
            const btn = document.querySelector(`.buy-btn[data-subject="${CSS.escape(buySubject)}"]`);
            if (btn) startPurchase(btn, buySubject);
            // Clean the URL so a page refresh doesn't re-trigger the purchase
            window.history.replaceState({}, '', '/plans/');
          }
        });
      });
    });
  </script>
</Layout>
