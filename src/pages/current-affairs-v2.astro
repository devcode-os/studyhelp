---
// src/pages/current-affairs-v2.astro
// Picker: Monthly / Last 3 / Last 6 -> straight to the read page (no
// separate sections page). Read page owns the section dropdown itself.
//
// UNCHANGED FROM current-affairs/index.astro — same real listAvailableMonths()
// data, same D1 + Razorpay purchase flow, same Purchases panel. Only visual
// restyle (indigo/white premium theme, same tokens as plans-v2/subjects-v2)
// plus self-referential URLs updated to the -v2 versions.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { listAvailableMonths } from '../lib/currentAffairs.js';
// Download PDF is now the default landing state for this page (was Read
// for Free) — rendered server-side so it's correct from the first byte,
// no flash, no JS dependency. ?tab=free is the only way to land on the
// Read for Free picker instead; any other/no param (including the old
// ad-traffic ?tab=pdf, now redundant but harmless) shows PDF.
const initialTab = Astro.url.searchParams.get('tab') === 'free' ? 'free' : 'pdf';

const months = listAvailableMonths(); // newest-first
const bundle3 = months.slice(0, 3);
const bundle6 = months.slice(0, 6);
const PRICE_MONTHLY = 99;
const PRICE_BUNDLE3 = 199;
const PRICE_BUNDLE6 = 299;

// Backend item_id is always the R2 filename minus ".pdf" (see caCatalog.js
// on the Worker). m.slug SHOULD already equal that exact id — normalized
// defensively here in case it doesn't carry the "current-affairs-" prefix.
function toBackendId(slug) {
  return slug.startsWith('current-affairs-') ? slug : `current-affairs-${slug}`;
}

// Combined-bundle backend id must exactly match the real R2 filename the
// pdf_ca_month.py tool generated: current-affairs-last<N>-<months oldest
// to newest>-<year>.pdf. months[] here is newest-first, so reverse for
// chronological (oldest-to-newest) order to match.
function combinedBundleId(bundleMonths) {
  const chronological = [...bundleMonths].reverse();
  const abbrevs = chronological.map((m) => m.label.slice(0, 3).toLowerCase());
  const year = chronological[chronological.length - 1].label.split(' ')[1];
  return `current-affairs-last${bundleMonths.length}-${abbrevs.join('-')}-${year}`;
}

const bundle3CombinedId = bundle3.length === 3 ? combinedBundleId(bundle3) : null;
const bundle6CombinedId = bundle6.length === 6 ? combinedBundleId(bundle6) : null;
const bundle3IndividualIds = bundle3.map((m) => toBackendId(m.slug));
const bundle6IndividualIds = bundle6.map((m) => toBackendId(m.slug));
---
<Layout title="Current Affairs" description="Read Current Affairs free, or download a PDF — pick a month, last 3, or last 6 months.">
  <Header active="current-affairs" theme="premium" />

  <div class="page-wide ca-wrap">
    <div class="ca-header-card">
      <button
        type="button"
        id="ca-purchases-icon"
        class="ca-purchases-icon"
        style="display:none"
        aria-label="Your purchases"
        title="Your purchases"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 5 5v15a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5l-1-3z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span id="ca-purchases-badge" class="ca-purchases-badge" style="display:none"></span>
      </button>

      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/subjects-v2/">Subjects</a> / Current Affairs
      </div>
      <h1>Current Affairs</h1>
      <div class="ca-hero-tabs" role="tablist">
        <button type="button" class:list={["ca-hero-tab", { active: initialTab === 'pdf' }]} id="ca-hero-tab-pdf" role="tab" aria-selected={initialTab === 'pdf' ? 'true' : 'false'}>Download PDF</button>
        <button type="button" class:list={["ca-hero-tab", { active: initialTab === 'free' }]} id="ca-hero-tab-free" role="tab" aria-selected={initialTab === 'free' ? 'true' : 'false'}>Read for Free</button>
      </div>
    </div>

    <!-- ============ READ FOR FREE (existing picker, unchanged) ============ -->
    <div id="ca-panel-free" style={initialTab === 'pdf' ? 'display:none' : ''}>
      <div class="ca-picker-tabs" role="tablist">
        <button type="button" class="ca-tab" data-mode="1">Monthly</button>
        <button type="button" class="ca-tab active" data-mode="3">Last 3 months</button>
        <button type="button" class="ca-tab" data-mode="6">Last 6 months</button>
      </div>

      <p class="ca-hint" id="ca-hint">Pick up to 3 months.</p>

      <div class="ca-month-grid" id="ca-month-grid">
        {months.map((m) => (
          <label class="ca-month-card">
            <input type="checkbox" class="ca-month-checkbox" value={m.slug} data-label={m.label} />
            <span class="ca-month-text">
              <span class="ca-month-label">{m.label}</span>
              <span class="ca-month-meta">{m.questionCount} MCQs</span>
            </span>
          </label>
        ))}
      </div>

      {months.length === 0 && (
        <div class="ca-empty"><p>Current Affairs content is coming soon.</p></div>
      )}

      <button type="button" id="ca-continue-btn" class="ca-continue-btn" disabled>
        Select a month
      </button>
    </div>

    <!-- ============ DOWNLOAD PDF ============ -->
    <div id="ca-panel-pdf" style={initialTab === 'pdf' ? '' : 'display:none'}>
      <div class="ca-picker-tabs" role="tablist">
        <button type="button" class="ca-tab" data-pdf-mode="1">Monthly · ₹{PRICE_MONTHLY}</button>
        <button type="button" class="ca-tab active" data-pdf-mode="3">Last 3 months · ₹{PRICE_BUNDLE3}</button>
        <button type="button" class="ca-tab" data-pdf-mode="6">Last 6 months · ₹{PRICE_BUNDLE6}</button>
      </div>

      <!-- Monthly: multi-select — pick any months, price scales with count -->
      <div id="ca-pdf-monthly-section" style="display:none">
        <p class="ca-hint">Pick any months.</p>
        <div class="ca-month-grid" id="ca-pdf-month-grid">
          {months.map((m) => (
            <label class="ca-month-card">
              <input
                type="checkbox"
                class="ca-pdf-month-checkbox"
                value={m.slug}
                data-label={m.label}
                data-item-id={m.slug.startsWith("current-affairs-") ? m.slug : `current-affairs-${m.slug}`}
              />
              <span class="ca-month-text">
                <span class="ca-month-label">{m.label}</span>
                <span class="ca-month-meta">{m.questionCount} MCQs</span>
              </span>
            </label>
          ))}
        </div>
        <button
          type="button"
          id="ca-pdf-monthly-btn"
          class="ca-continue-btn ca-buy-btn"
          data-price={PRICE_MONTHLY}
          disabled
        >
          Select a month
        </button>
      </div>

      <!-- Last 3 / Last 6: no picker — always the current rolling window,
           shown plainly since there's nothing to choose. -->
      <div id="ca-pdf-bundle3-section">
        {bundle3.length < 3 ? (
          <div class="ca-empty"><p>Need 3 published months for this bundle — check back soon.</p></div>
        ) : (
          <>
            <div class="ca-bundle-card ca-bundle-card-best">
              <div class="ca-bundle-icon"><i class="ti ti-gift" aria-hidden="true"></i></div>
              <div class="ca-bundle-body">
                <span class="ca-bundle-best-badge">★ Best Value</span>
                <div class="ca-bundle-range">
                  {bundle3.slice().reverse().map((m) => m.label.replace(' 2026', '')).join(' · ')} {bundle3[0].label.split(' ')[1]}
                </div>
                <div class="ca-bundle-foot">
                  <div class="ca-bundle-total-badge" id="ca-bundle3-badge" data-default-text={`${bundle3.reduce((sum, m) => sum + m.questionCount, 0)} MCQs`}>{bundle3.reduce((sum, m) => sum + m.questionCount, 0)} MCQs</div>
                  <div class="ca-bundle-includes">Includes Explanations &amp; Key Points</div>
                </div>
              </div>
            </div>

            <div class="ca-format-toggle" role="tablist" data-bundle="3">
              <button type="button" class="ca-format-btn active" data-format="combined">Combined</button>
              <button type="button" class="ca-format-btn" data-format="individual">Individual</button>
            </div>
            <p class="ca-format-hint" data-bundle-hint="3">
              One merged PDF, sections combined across months.
            </p>

            <button
              type="button"
              class="ca-continue-btn ca-buy-btn"
              data-bundle="3"
              data-item-ids-individual={JSON.stringify(bundle3IndividualIds)}
              data-kind-individual="individual_bundle"
              data-item-ids-combined={JSON.stringify(bundle3CombinedId ? [bundle3CombinedId] : [])}
              data-kind-combined="items"
              data-price={PRICE_BUNDLE3}
            >
              Buy Now — ₹{PRICE_BUNDLE3}
            </button>
          </>
        )}
      </div>

      <div id="ca-pdf-bundle6-section" style="display:none">
        {bundle6.length < 6 ? (
          <div class="ca-empty"><p>Need 6 published months for this bundle — check back soon.</p></div>
        ) : (
          <>
            <div class="ca-bundle-card ca-bundle-card-max">
              <div class="ca-bundle-icon"><i class="ti ti-flame" aria-hidden="true"></i></div>
              <div class="ca-bundle-body">
                <span class="ca-bundle-max-badge">🔥 Max Savings</span>
                <div class="ca-bundle-range">
                  {bundle6.slice().reverse().map((m) => m.label.replace(' 2026', '')).join(' · ')} {bundle6[0].label.split(' ')[1]}
                </div>
                <div class="ca-bundle-foot">
                  <div class="ca-bundle-total-badge" id="ca-bundle6-badge" data-default-text={`${bundle6.reduce((sum, m) => sum + m.questionCount, 0)} MCQs`}>{bundle6.reduce((sum, m) => sum + m.questionCount, 0)} MCQs</div>
                  <div class="ca-bundle-includes">Includes Explanations &amp; Key Points</div>
                </div>
              </div>
            </div>

            <div class="ca-format-toggle" role="tablist" data-bundle="6">
              <button type="button" class="ca-format-btn active" data-format="combined">Combined</button>
              <button type="button" class="ca-format-btn" data-format="individual">Individual</button>
            </div>
            <p class="ca-format-hint" data-bundle-hint="6">
              One merged PDF, sections combined across months.
            </p>

            <button
              type="button"
              class="ca-continue-btn ca-buy-btn"
              data-bundle="6"
              data-item-ids-individual={JSON.stringify(bundle6IndividualIds)}
              data-kind-individual="individual_bundle"
              data-item-ids-combined={JSON.stringify(bundle6CombinedId ? [bundle6CombinedId] : [])}
              data-kind-combined="items"
              data-price={PRICE_BUNDLE6}
            >
              Buy Now — ₹{PRICE_BUNDLE6}
            </button>
          </>
        )}
      </div>

      <div class="ca-whatyouget-wrap">
        <div class="ca-whatyouget-card">
          <div class="ca-whatyouget-title">What you get</div>
          <div class="ca-whatyouget-grid">
            <div>
              <div class="ca-whatyouget-item-title">Exam-focused MCQs</div>
              <div class="ca-whatyouget-item-sub">Current affairs questions with answers, explanations, and key points for the selected period</div>
            </div>
            <div>
              <div class="ca-whatyouget-item-title">Study offline</div>
              <div class="ca-whatyouget-item-sub">Download PDF — study offline, anytime</div>
            </div>
            <div>
              <div class="ca-whatyouget-item-title">Simple pricing</div>
              <div class="ca-whatyouget-item-sub">Pay per month, or save with a 3- or 6-month bundle</div>
            </div>
          </div>
        </div>
      </div>

      <div class="whatyouget-card plans-faq-card">
        <div class="whatyouget-title">Before you buy</div>
        <details class="plans-faq-item" open>
          <summary>How do I buy?</summary>
          <div class="plans-faq-body">
            Pick a month (or Last 3 / Last 6 for the bundle) and tap Buy Now — you'll
            create a quick account if you don't have one, then pay via UPI, card, or
            netbanking. Your purchase appears instantly in the Purchases panel, ready
            to download.
          </div>
        </details>
        <details class="plans-faq-item">
          <summary>How do I download my PDF?</summary>
          <div class="plans-faq-body">
            After payment, you're taken straight to your Purchases panel with the new
            item listed. Tap Download PDF anytime — no waiting, no separate email link.
          </div>
        </details>
        <details class="plans-faq-item">
          <summary>Can I re-download later?</summary>
          <div class="plans-faq-body">
            Yes. Every PDF you've bought stays listed in your Purchases panel
            permanently — click the purchases icon at any time to download again, no
            repurchase needed.
          </div>
        </details>
        <details class="plans-faq-item">
          <summary>Combined vs Individual for bundles?</summary>
          <div class="plans-faq-body">
            Combined gives you one merged PDF with all months' sections together.
            Individual gives you separate PDFs, one per month. Pick whichever fits how
            you study.
          </div>
        </details>
        <details class="plans-faq-item">
          <summary>Paid but don't see it in Purchases?</summary>
          <div class="plans-faq-body">
            This is very rare — most payments sync within seconds. Try refreshing the
            page first. If it's still missing after a minute,
            <a href="https://studyhelp.fdaytalk.com/contact/">contact us</a> with your
            Razorpay payment ID and the month/bundle you bought. We'll verify the
            payment and, once confirmed, send the PDF directly to your registered
            email — no need to worry, your purchase is never lost.
          </div>
        </details>
      </div>
    </div>

    <!-- ============ PURCHASES ============ -->
    <div id="ca-panel-purchases" style="display:none">
      <div class="ca-purchases-head">
        <h2>Your Purchases</h2>
      </div>
      <div id="ca-purchases-list"></div>
      <div id="ca-purchases-empty" class="ca-empty" style="display:none">
        <p>No purchases yet — grab your first pack below.</p>
        <button type="button" id="ca-purchases-empty-btn" class="ca-continue-btn" style="position:static; width:auto; padding:10px 20px;">
          Browse Download PDF
        </button>
      </div>
    </div>
  </div>

  <style is:global>
    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-amber: #E8963A;
      --sh2-amber-soft: #FBEDD9;
      --sh2-green: #26946A;
      --sh2-green-soft: #DFF3EA;
      --sh2-blue: #2F7DD6;
      --sh2-blue-soft: #E1EDFB;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px;

      /* Most of this page's original CSS reads var(--accent)/var(--card)/
         var(--border)/var(--text)/var(--muted) already (same theme-var
         pattern as the live Account page) — remap those to the indigo
         palette here instead of rewriting every rule that uses them. */
      --card: var(--sh2-surface);
      --border: var(--sh2-line);
      --accent: var(--sh2-indigo);
      --accent-bg: var(--sh2-indigo-soft);
      --text: var(--sh2-ink);
      --muted: var(--sh2-text-soft);
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-amber: #F0B45E;
      --sh2-amber-soft: #3B2C15;
      --sh2-green: #5FCB9B;
      --sh2-green-soft: #183328;
      --sh2-blue: #6FA8EC;
      --sh2-blue-soft: #1B2A40;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&display=swap');
    .page-wide h1, .page-wide h2 { font-family: 'Manrope', sans-serif; }

    .ca-wrap { max-width: 900px; margin: 0 auto; }
    @media (min-width: 1200px) {
      .page-wide, .ca-wrap {
        max-width: 900px;
      }
    }
    @media (max-width: 900px) {
      .ca-wrap {
        padding-bottom: calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }

    /* ---------- Hero card: indigo gradient (same as chapter-v2's reading
       toolbar / hero cards elsewhere), replacing the dark-navy/orange one ---------- */
    .ca-header-card {
      position: relative; overflow: hidden;
      background: linear-gradient(155deg, var(--sh2-indigo-deep) 0%, #5A4CC4 55%, #7C63DE 100%);
      border-radius: 18px; padding: 18px 22px; margin-bottom: 20px;
      box-shadow: 0 14px 28px -16px rgba(46,37,112,0.5);
    }
    .ca-header-card::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(circle at 85% 15%, rgba(255,255,255,0.14), transparent 45%);
    }
    .ca-header-card .breadcrumb, .ca-header-card h1, .ca-header-card .ca-hero-tabs {
      position: relative; z-index: 1;
    }
    .breadcrumb { font-size: 12px; color: rgba(255,255,255,0.6); margin-bottom: 8px; }
    .breadcrumb a { color: rgba(255,255,255,0.6); text-decoration: none; }
    @media (max-width: 900px) { .breadcrumb { display: none; } }
    .ca-header-card h1 { font-size: 22px; margin: 0 0 10px; color: #fff; font-weight: 800; }

    .ca-hero-tabs { display: flex; gap: 6px; }
    .ca-hero-tab {
      padding: 9px 16px; border-radius: 999px; border: 1.5px solid rgba(255,255,255,0.3);
      background: transparent; color: rgba(255,255,255,0.8); font-weight: 700; font-size: 13.5px;
      cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .ca-hero-tab.active { background: #fff; color: var(--sh2-indigo-deep); border-color: #fff; }

    .ca-purchases-icon {
      position: absolute; top: 16px; right: 16px; z-index: 2;
      width: 34px; height: 34px; border-radius: 50%;
      background: rgba(255,255,255,0.15); border: 1.5px solid rgba(255,255,255,0.35);
      color: #fff; display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: background 0.15s;
    }
    .ca-purchases-icon:hover { background: rgba(255,255,255,0.25); }
    .ca-purchases-badge {
      position: absolute; top: -2px; right: -2px;
      width: 11px; height: 11px; border-radius: 50%;
      background: #e5484d; border: 2px solid var(--sh2-indigo-deep);
    }
    .ca-purchases-badge::after {
      content: ""; position: absolute; inset: -3px; border-radius: 50%;
      border: 1.5px solid rgba(229,72,77,0.5);
      animation: ca-purchases-badge-pulse 2s ease-out infinite;
    }
    @keyframes ca-purchases-badge-pulse {
      0%   { transform: scale(0.8); opacity: 0.8; }
      100% { transform: scale(1.6); opacity: 0; }
    }

    .ca-purchases-head { margin-bottom: 14px; }
    .ca-purchases-head h2 { margin: 0; font-size: 17px; color: var(--sh2-ink); }

    .ca-purchase-card {
      border: 1.5px solid var(--border); border-radius: 14px; padding: 14px 16px; margin-bottom: 10px;
      background: var(--card); box-shadow: var(--sh2-shadow);
    }
    .ca-purchase-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 6px; }
    .ca-purchase-range { font-weight: 800; font-size: 14.5px; color: var(--text); }
    .ca-purchase-badge {
      flex-shrink: 0; font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px;
      background: var(--accent-bg); color: var(--accent); text-transform: capitalize;
    }
    .ca-purchase-meta { color: var(--muted); font-size: 12px; margin-bottom: 2px; }
    .ca-purchase-date { color: var(--muted); font-size: 11px; margin-bottom: 10px; }
    .ca-purchase-dl-btn {
      width: 100%; padding: 10px; border-radius: 10px; border: none;
      background: var(--sh2-green); color: #fff; font-weight: 700; font-size: 13px; cursor: pointer;
    }

    .ca-month-card.ca-month-owned {
      cursor: default; border-color: var(--sh2-green); background: var(--sh2-green-soft);
    }
    .ca-month-owned-badge { font-size: 10.5px; font-weight: 700; color: var(--sh2-green); }

    .ca-picker-tabs { display: flex; gap: 8px; margin-bottom: 26px; }
    .ca-tab {
      padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--border);
      background: var(--card); color: var(--text); font-weight: 700; font-size: 13px;
      cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .ca-tab:hover { border-color: var(--accent); }
    .ca-tab.active { background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep)); color: #fff; border-color: transparent; }

    .ca-hint { color: var(--muted); font-size: 12px; margin: 0 0 14px; }

    .ca-month-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      margin-bottom: 90px;
    }
    .ca-month-card {
      display: block; position: relative;
      border: 1.5px solid var(--border); border-radius: 12px; padding: 9px 11px;
      cursor: pointer; background: var(--card);
      transition: border-color 0.15s, background 0.15s;
      box-shadow: var(--sh2-shadow);
    }
    .ca-month-card:hover { border-color: var(--sh2-indigo); }
    .ca-month-card:has(.ca-month-checkbox:checked),
    .ca-month-card:has(.ca-pdf-month-checkbox:checked) {
      border-color: var(--sh2-indigo-deep);
      background: linear-gradient(150deg, var(--sh2-indigo-deep), var(--sh2-indigo));
    }
    .ca-month-card:has(.ca-month-checkbox:checked) .ca-month-label,
    .ca-month-card:has(.ca-pdf-month-checkbox:checked) .ca-month-label {
      color: #ffffff;
    }
    .ca-month-card:has(.ca-month-checkbox:checked) .ca-month-meta,
    .ca-month-card:has(.ca-pdf-month-checkbox:checked) .ca-month-meta {
      color: rgba(255,255,255,0.75);
    }

    .ca-month-checkbox, .ca-pdf-month-checkbox {
      appearance: none; -webkit-appearance: none;
      position: absolute; top: 8px; right: 8px;
      width: 15px; height: 15px; border-radius: 50%; border: 1.5px solid var(--border);
