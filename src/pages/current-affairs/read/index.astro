---
// src/pages/current-affairs-read-v2.astro
//
// UNCHANGED FROM current-affairs/read/index.astro — same real getFullDataset()
// data, same section-merge/pagination/MCQ-vs-Quick-Revision logic, same guest
// 5-minute reading-limit popup. Only visual restyle (indigo/white premium
// theme, same tokens as current-affairs-v2/plans-v2) plus self-referential
// URLs updated to the -v2 versions.
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { getFullDataset } from '../../../lib/currentAffairs.js';

const dataset = getFullDataset(); // every month, every section, every question
---
<Layout title="Current Affairs" description="Read Current Affairs MCQs by section, free.">
  <Header active="subjects" theme="premium" />

  <div class="page-wide ca-wrap">
    <div class="ca-header-card">
      <div class="ca-header-top">
        <div class="ca-header-left">
          <div class="breadcrumb">
            <a href="/">Home</a> / <a href="/current-affairs/">CA</a> / <span id="ca-crumb-section">Appointments</span>
          </div>
          <h1 id="ca-title">Current Affairs</h1>
        </div>
        <div class="ca-mode-toggle" id="ca-mode-toggle" role="tablist" aria-label="View mode">
          <button type="button" class="ca-mode-btn active" data-mode="mcqs" role="tab" aria-selected="true">MCQs</button>
          <button type="button" class="ca-mode-btn" data-mode="revision" role="tab" aria-selected="false">Quick Revision</button>
        </div>
        <a href="/current-affairs/" class="ca-icon-btn" aria-label="Change months" title="Change months" hidden>
          <i class="ti ti-calendar" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ca-header-controls">
        <div class="ca-section-pill">
          <i class="ti ti-list" aria-hidden="true"></i>
          <select id="ca-section-select" class="ca-section-select"></select>
          <i class="ti ti-chevron-down ca-section-chevron" aria-hidden="true"></i>
        </div>
      </div>
    </div>

    <span class="ca-sub" id="ca-sub" hidden>Loading…</span>

    <div id="ca-limit-overlay" class="ca-limit-overlay" style="display:none">
      <div class="ca-limit-card">
        <h2>Free reading limit reached</h2>
        <p>You've been reading for 5 minutes. Create a free account to keep reading — it takes a few seconds, no OTP needed.</p>
        <button type="button" id="ca-limit-signup-btn" class="ca-limit-btn">Create free account to continue</button>
        <a href="/current-affairs/" class="ca-limit-link">Back to Current Affairs</a>
      </div>
    </div>

    <div id="ca-question-list"></div>

    <div class="ca-pagination" id="ca-pagination">
      <button type="button" id="ca-prev-btn" class="ca-page-btn">Previous</button>
      <div id="ca-page-numbers" class="ca-page-numbers"></div>
      <button type="button" id="ca-next-btn" class="ca-page-btn">Next</button>
    </div>

    <div class="ca-empty" id="ca-empty" style="display:none;">
      <p>No months selected yet.</p>
      <a href="/current-affairs/" class="ca-change-link">Pick months to start</a>
    </div>
  </div>

  <script type="application/json" id="ca-dataset" set:html={JSON.stringify(dataset)} />

  <style is:global>
    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-amber: #E8963A;
      --sh2-amber-soft: #FBEDD9;
      --sh2-green: #26946A;
      --sh2-green-soft: #DFF3EA;
      --sh2-blue: #2F7DD6;
      --sh2-blue-soft: #E1EDFB;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px;

      /* This page's card/option/pagination CSS already reads var(--accent)/
         var(--card)/var(--border)/var(--text)/var(--muted)/var(--bg)/
         var(--accent-bg) — remap those to the indigo palette here rather
         than rewriting every rule (same pattern as account-v2 / current-affairs-v2). */
      --card: var(--sh2-surface);
      --border: var(--sh2-line);
      --accent: var(--sh2-indigo);
      --accent-bg: var(--sh2-indigo-soft);
      --bg: var(--sh2-surface-2);
      --text: var(--sh2-ink);
      --muted: var(--sh2-text-soft);
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-amber: #F0B45E;
      --sh2-amber-soft: #3B2C15;
      --sh2-green: #5FCB9B;
      --sh2-green-soft: #183328;
      --sh2-blue: #6FA8EC;
      --sh2-blue-soft: #1B2A40;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }

    .ca-wrap { max-width: 800px; margin: 0 auto; }
    @media (min-width: 1200px) {
      .page-wide { max-width: 1000px; }
      .ca-wrap { max-width: 820px; }
    }

    /* Header card: same indigo hero gradient as current-affairs-v2, replacing
       the dark-navy/orange one. */
    .ca-header-card {
      position: relative; overflow: hidden;
      background: linear-gradient(155deg, var(--sh2-indigo-deep) 0%, #5A4CC4 55%, #7C63DE 100%);
      border-radius: 14px; padding: 12px 14px 14px; margin-bottom: 14px;
      box-shadow: 0 10px 22px -12px rgba(46,37,112,0.45);
    }
    .ca-header-card::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(circle at 85% 15%, rgba(255,255,255,0.14), transparent 45%);
    }
    .ca-header-top {
      position: relative; z-index: 1;
      display: flex; justify-content: space-between; align-items: center;
      gap: 8px; margin-bottom: 8px;
    }
    .ca-header-left { min-width: 0; flex: 1; }
    .breadcrumb {
      font-size: 11px; color: rgba(255,255,255,0.6); margin-bottom: 2px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .breadcrumb a { color: rgba(255,255,255,0.6); text-decoration: none; }
    @media (max-width: 900px) {
      .breadcrumb { display: none; }
    }
    .ca-header-left h1 {
      font-size: 15px; margin: 0; color: #fff; font-weight: 700; letter-spacing: -0.2px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    .ca-icon-btn {
      flex-shrink: 0; width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.14); color: #fff; text-decoration: none;
      transition: background 0.15s;
    }
    .ca-icon-btn:hover { background: rgba(255,255,255,0.24); }
    .ca-icon-btn i { font-size: 14px; }
    .ca-icon-btn[hidden] { display: none; }

    .ca-header-controls {
      position: relative; z-index: 1; display: flex; gap: 6px;
    }
    .ca-mode-toggle {
      flex-shrink: 0; display: flex; align-items: center; padding: 2px;
      border-radius: 8px; background: rgba(255,255,255,0.12);
    }
    .ca-mode-btn {
      padding: 5px 9px; border-radius: 6px;
      border: none; background: transparent; color: rgba(255,255,255,0.75);
      font-size: 11px; font-weight: 600; cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s, color 0.15s;
    }
    .ca-mode-btn.active { background: #ffffff; color: var(--sh2-indigo-deep); font-weight: 700; }

    .ca-section-pill {
      flex: 1; display: flex; align-items: center; gap: 5px;
      padding: 7px 9px; border-radius: 9px; background: rgba(255,255,255,0.1);
      min-width: 0; position: relative;
    }
    .ca-section-pill i.ti-list { color: #fff; font-size: 13px; flex-shrink: 0; opacity: 0.85; }
    .ca-section-chevron { color: rgba(255,255,255,0.7); font-size: 11px; flex-shrink: 0; pointer-events: none; }
    .ca-section-select {
      flex: 1; min-width: 0; border: none; background: transparent; color: #fff;
      font-size: 12.5px; font-weight: 600; cursor: pointer; appearance: none;
      padding: 0; margin: 0;
    }
    .ca-section-select option { color: #111; }

    .ca-q-card {
      border: 1px solid var(--border); border-radius: 14px; padding: 18px;
      margin-bottom: 14px; background: var(--card); box-shadow: var(--sh2-shadow);
    }
    .ca-q-tag {
      display: inline-block; font-size: 11px; font-weight: 700; color: var(--sh2-indigo);
      background: var(--sh2-indigo-soft);
      padding: 2px 8px; border-radius: 999px; margin-bottom: 10px;
    }
    .ca-q-text { font-weight: 700; font-size: 15px; margin: 0 0 14px; line-height: 1.4; color: var(--text); }

    .ca-opt-row { display: flex; flex-direction: column; gap: 8px; margin-bottom: 4px; }
    .ca-opt-btn {
      display: flex; gap: 8px; align-items: flex-start; text-align: left; padding: 11px 14px;
      border-radius: 10px; border: 1px solid var(--border); background: var(--bg);
      color: var(--text); cursor: pointer; font-size: 14px; line-height: 1.35;
      transition: border-color 0.15s, background 0.15s; width: 100%;
    }
    .ca-opt-btn:hover:not(:disabled) { border-color: var(--sh2-indigo); }
    .ca-opt-letter {
      display: inline-flex; align-items: center; justify-content: center;
      width: 24px; height: 24px; border-radius: 50%; flex-shrink: 0;
      background: var(--accent-bg); color: var(--sh2-indigo);
      font-weight: 700; font-size: 13px;
    }
    .ca-opt-btn.correct { border-color: #2e7d32; background: rgba(46,125,50,0.12); }
    .ca-opt-btn.correct .ca-opt-letter { background: #2e7d32; color: #fff; }
    .ca-opt-btn.wrong { border-color: #c62828; background: rgba(198,40,40,0.12); }
    .ca-opt-btn.wrong .ca-opt-letter { background: #c62828; color: #fff; }
    .ca-opt-btn:disabled { cursor: default; }

    .ca-revision-answer {
      display: flex; align-items: center; gap: 6px; margin: 0 0 4px;
      font-size: 14px; font-weight: 700; color: #1b7a3d;
    }
    .ca-revision-answer::after { content: '✓'; font-weight: 800; }

    .ca-explain-toggle {
      display: none; align-items: center; gap: 4px; background: none; border: none;
      color: var(--sh2-indigo); font-weight: 700; font-size: 13px; cursor: pointer;
      padding: 8px 0 0; margin: 0;
    }
    .ca-explain-toggle:hover { text-decoration: underline; }

    .ca-explanation {
      display: none; border-top: 1px dashed var(--border); padding-top: 14px; margin-top: 14px;
    }
    .ca-explanation.shown { display: block; }
    .ca-explanation-text {
      font-size: 14px; color: var(--text); line-height: 1.6; margin: 0 0 12px;
    }
    .ca-keypoints-label {
      font-size: 12px; font-weight: 800; color: var(--sh2-indigo);
      text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 8px;
    }
    .ca-keypoints-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .ca-keypoints-list li {
      font-size: 14px; color: var(--text); line-height: 1.5; padding-left: 16px; position: relative;
    }
    .ca-keypoints-list li::before {
      content: '•'; position: absolute; left: 0; color: var(--sh2-indigo); font-weight: 800;
    }

    .ca-pagination {
      display: flex; align-items: center; justify-content: center; gap: 8px; margin: 24px 0 40px;
      flex-wrap: wrap;
    }
    .ca-page-btn {
      padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--card); color: var(--text); font-weight: 600; cursor: pointer;
    }
    .ca-page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .ca-page-numbers { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
    .ca-page-num-btn {
      width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--card); color: var(--text); font-weight: 600; cursor: pointer;
    }
    .ca-page-num-btn.active {
      border-color: var(--sh2-indigo); color: var(--sh2-indigo);
    }

    .ca-empty { text-align: center; padding: 40px; color: var(--muted); }

    /* Guest reading-limit popup — blocks interaction with the page
       underneath (no dismiss button) until the person either signs up or
       navigates away, since the whole point is to require an account to
       continue past the free preview window. */
    .ca-limit-overlay {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(28, 26, 56, 0.55);
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }
    .ca-limit-card {
      background: var(--card); border-radius: 16px; padding: 28px 24px;
      max-width: 360px; width: 100%; text-align: center;
      box-shadow: var(--sh2-shadow);
    }
    .ca-limit-card h2 { font-size: 18px; margin: 0 0 10px; color: var(--text); }
    .ca-limit-card p { font-size: 14px; color: var(--muted); line-height: 1.5; margin: 0 0 20px; }
    .ca-limit-btn {
      width: 100%; padding: 13px; border-radius: 10px; border: none;
      background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep)); color: #fff;
      font-weight: 700; font-size: 14.5px;
      cursor: pointer; margin-bottom: 12px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
    }
    .ca-limit-link { font-size: 13px; color: var(--muted); text-decoration: none; }
    .ca-limit-link:hover { text-decoration: underline; }

    @media (max-width: 380px) {
      .ca-header-top { flex-wrap: wrap; }
      .ca-mode-toggle { order: 3; width: 100%; }
      .ca-mode-btn { flex: 1; text-align: center; }
    }
  </style>

  <script>
    const dataset = JSON.parse(document.getElementById('ca-dataset').textContent);
    const PER_PAGE = 20;
    const LETTER_LABEL = { a: 'A', b: 'B', c: 'C', d: 'D', e: 'E', f: 'F' };

    // A ?section= param means we got here from the "Continue reading" recap
    // card on subjects-v2, not necessarily fresh. If this tab still has a
    // real month selection saved (the person picked Monthly/Jan 2026,
    // read a bit, hit Back), that selection is the one to honor — Back
    // only re-shows the picker page, it doesn't clear sessionStorage, so
    // this is still "where they left off". Only when there's truly
    // nothing saved (new tab, another device, cleared storage) does the
    // card fall back to loading every month, so the section still has
    // *something* to show rather than landing empty.
    const resumingFromRecapCard = !!new URLSearchParams(window.location.search).get('section');

    let selectedMonthSlugs = [];
    try {
      selectedMonthSlugs = JSON.parse(sessionStorage.getItem('ca_selected_months') || '[]');
    } catch (e) { selectedMonthSlugs = []; }

    const emptyEl = document.getElementById('ca-empty');
    if (resumingFromRecapCard && !selectedMonthSlugs.length && dataset.length) {
      selectedMonthSlugs = dataset.map((m) => m.slug);
      try {
        sessionStorage.setItem('ca_selected_months', JSON.stringify(selectedMonthSlugs));
        sessionStorage.setItem('ca_selected_plan', 'last6');
      } catch (e) {}
    } else if (!selectedMonthSlugs.length) {
      if (!dataset.length) {
        emptyEl.style.display = 'block';
      } else {
        // Fallback: no selection stored (e.g. direct link) -> most recent month.
        selectedMonthSlugs = [dataset[0].slug];
      }
    }

    const selectedMonths = dataset.filter((m) => selectedMonthSlugs.includes(m.slug));

    // Title reflects the plan actually picked on the previous page
    // (stored there as ca_selected_plan), not guessed from month count —
    // a student can pick fewer than a tab's cap (e.g. 2 months while on
    // "Last 3 months"), so count alone isn't reliable.
    let selectedPlan = '';
    try {
      selectedPlan = sessionStorage.getItem('ca_selected_plan') || '';
    } catch (e) { selectedPlan = ''; }

    const PLAN_TITLES = {
      monthly: 'Monthly Current Affairs',
      last3: 'Last 3 Months',
      last6: 'Last 6 Months',
    };
    document.getElementById('ca-title').textContent = PLAN_TITLES[selectedPlan] || 'Current Affairs';

    const subEl = document.getElementById('ca-sub');

    // Build "August, July, June 2026" style label: only show the year when
    // it differs from the next month in the list (or on the last month),
    // instead of repeating it after every month. Still handles selections
    // that cross a year boundary, e.g. "December 2026, January, February 2027".
    function formatMonthRange(months) {
      if (!months.length) return '';
      return months
        .map((m, i) => {
          const isLast = i === months.length - 1;
          const nextYearDiffers = !isLast && months[i + 1].year !== m.year;
          const showYear = isLast || nextYearDiffers;
          return showYear ? `${m.month} ${m.year}` : m.month;
        })
        .join(', ');
    }

    subEl.textContent = selectedMonths.length
      ? formatMonthRange(selectedMonths)
      : 'No data available yet.';

    // Fixed display order for the section dropdown, tuned for exam prep
    // priority (highest MCQ-frequency topics first, reference/static
    // material near the bottom, Miscellaneous always last). Section names
    // not in this list fall back to just before Miscellaneous.
    const SECTION_ORDER = [
      'Appointments & Resignations',
      'Awards',
      'Summits, Events & Conference',
      "MoU's & Agreements",
      'Govt Schemes',
      'Defence',
      'Science & Technology',
      'Sports',
      'Banking, Economy, Business & Finance',
      'National News',
      'International Affairs',
      'Index & Ranks',
      'Obituary',
      'Books & Authors',
      'General Awareness',
      'Important Days',
      'Miscellaneous',
    ];

    // Old JSON files still use the old section name in places; treat it as
    // the same section as the renamed one so counts/questions merge
    // correctly regardless of which name a given month's file used.
    const SECTION_ALIASES = { 'Static Takeaways': 'General Awareness' };

    // Merge section -> question list across selected months.
    const sectionMap = new Map();
    selectedMonths.forEach((m) => {
      Object.entries(m.sections).forEach(([rawName, items]) => {
        const sectionName = SECTION_ALIASES[rawName] || rawName;
        if (!sectionMap.has(sectionName)) sectionMap.set(sectionName, []);
        sectionMap.get(sectionName).push(...items.map((it) => ({ ...it, _month: m.month, _year: m.year })));
      });
    });

    const sectionNames = Array.from(sectionMap.keys()).sort((a, b) => {
      const rankOf = (name) => {
        const idx = SECTION_ORDER.indexOf(name);
        if (idx !== -1) return idx;
        // Unknown section: sit just before Miscellaneous rather than at
        // a random spot from file order.
        const miscIdx = SECTION_ORDER.indexOf('Miscellaneous');
        return miscIdx === -1 ? SECTION_ORDER.length : miscIdx;
      };
      return rankOf(a) - rankOf(b);
    });
    const select = document.getElementById('ca-section-select');
    sectionNames.forEach((name) => {
      const opt = document.createElement('option');
      opt.value = name;
      opt.textContent = `${name} (${sectionMap.get(name).length})`;
      select.appendChild(opt);
    });

    // Default to "Appointments" if present, else the first section.
    const defaultSection = sectionNames.includes('Appointments') ? 'Appointments' : sectionNames[0];
    if (defaultSection) select.value = defaultSection;

    // A ?section= query param (used by the "Continue reading" CA recap card
    // on subjects-v2) wins over the default — lets that card resume the
    // reader straight into the section they were last on, even from a
    // fresh tab where sessionStorage's resume state isn't set yet.
    const urlSection = new URLSearchParams(window.location.search).get('section');
    if (urlSection && sectionNames.includes(urlSection)) select.value = urlSection;

    let currentPage = 1;
    let currentMode = 'mcqs';

    // Resume exactly where a guest left off after being sent to sign up
    // (5-min limit popup) — restored once on load, saved on every change.
    // Survives the redirect naturally since it's the same browser tab.
    try {
      const savedState = JSON.parse(sessionStorage.getItem('ca_read_state') || 'null');
      if (!urlSection && savedState && sectionNames.includes(savedState.section)) {
        select.value = savedState.section;
        currentPage = savedState.page || 1;
        if (savedState.mode === 'mcqs' || savedState.mode === 'revision') currentMode = savedState.mode;
      }
    } catch (err) {}

    function saveReadState() {
      try {
        sessionStorage.setItem('ca_read_state', JSON.stringify({ section: select.value, page: currentPage, mode: currentMode }));
      } catch (err) {}
    }

    // Fire-and-forget: logs "user read this CA section" for a future
    // recap/continue-reading feature, same pattern as chapter-v2's
    // reading-progress call. Only fires once per section change (not on
    // every page-turn within a section) to avoid spamming the endpoint.
    // Never blocks rendering, never shown to the reader.
    let lastLoggedCaSection = null;
    function logCaReadingProgress(sectionName) {
      if (!sectionName || sectionName === lastLoggedCaSection) return;
      lastLoggedCaSection = sectionName;
      const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
      const session = window.__shSessionPromise
        ? window.__shSessionPromise
        : fetch(`${WORKER_URL}/me`, { credentials: 'include' })
            .then((res) => res.json())
            .catch(() => ({ logged_in: false }));

      session.then((data) => {
        if (!data.logged_in) return;
        fetch(`${WORKER_URL}/ca-reading-progress`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: data.user_id, section_name: sectionName }),
        }).catch(() => {});
      });
    }

    function render() {
      const sectionName = select.value;
      const questions = sectionMap.get(sectionName) || [];
      const totalPages = Math.max(1, Math.ceil(questions.length / PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;

      document.getElementById('ca-crumb-section').textContent = sectionName || '';
      logCaReadingProgress(sectionName);

      const start = (currentPage - 1) * PER_PAGE;
      const pageItems = questions.slice(start, start + PER_PAGE);

      const listEl = document.getElementById('ca-question-list');
      listEl.innerHTML = '';

      pageItems.forEach((item, idx) => {
        const card = document.createElement('div');
        card.className = 'ca-q-card';

        const tag = document.createElement('span');
        tag.className = 'ca-q-tag';
        tag.textContent = `${item._month || ''} ${item._year || ''}`.trim();
        card.appendChild(tag);

        const qText = document.createElement('p');
        qText.className = 'ca-q-text';
        qText.textContent = `${start + idx + 1}. ${item.q}`;
        card.appendChild(qText);

        const rawExplanation = item.e || '';
        const splitIdx = rawExplanation.indexOf('Key Points:');
        const mainText = (splitIdx >= 0 ? rawExplanation.slice(0, splitIdx) : rawExplanation).trim();
        const keyPointsBlock = splitIdx >= 0 ? rawExplanation.slice(splitIdx + 'Key Points:'.length).trim() : '';
        const keyPoints = keyPointsBlock
          ? keyPointsBlock.split('\n').map((l) => l.replace(/^•\s*/, '').trim()).filter(Boolean)
          : [];

        if (currentMode === 'revision') {
          // Quick Revision: answer + explanation shown straight away, no
          // options list and no click-to-reveal — built for fast re-skim
          // rather than self-testing.
          const answerLine = document.createElement('p');
          answerLine.className = 'ca-revision-answer';
          answerLine.innerHTML = item.a || '';
          card.appendChild(answerLine);

          if (mainText || keyPoints.length) {
            const explanationEl = document.createElement('div');
            explanationEl.className = 'ca-explanation shown';
            if (mainText) {
              const p = document.createElement('p');
              p.className = 'ca-explanation-text';
              p.textContent = mainText;
              explanationEl.appendChild(p);
            }
            if (keyPoints.length) {
              const label = document.createElement('div');
              label.className = 'ca-keypoints-label';
              label.textContent = 'Key Points';
              explanationEl.appendChild(label);

              const ul = document.createElement('ul');
              ul.className = 'ca-keypoints-list';
              keyPoints.forEach((kp) => {
                const li = document.createElement('li');
                li.textContent = kp;
                ul.appendChild(li);
              });
              explanationEl.appendChild(ul);
            }
            card.appendChild(explanationEl);
          }

          listEl.appendChild(card);
          return;
        }

        // MCQs mode: options list, click-to-reveal, explanation behind a
        // separate toggle — unchanged from before.
        const optRow = document.createElement('div');
        optRow.className = 'ca-opt-row';

        const explanationEl = document.createElement('div');
        explanationEl.className = 'ca-explanation';

        if (mainText) {
          const p = document.createElement('p');
          p.className = 'ca-explanation-text';
          p.textContent = mainText;
          explanationEl.appendChild(p);
        }
        if (keyPoints.length) {
          const label = document.createElement('div');
          label.className = 'ca-keypoints-label';
          label.textContent = 'Key Points';
          explanationEl.appendChild(label);

          const ul = document.createElement('ul');
          ul.className = 'ca-keypoints-list';
          keyPoints.forEach((kp) => {
            const li = document.createElement('li');
            li.textContent = kp;
            ul.appendChild(li);
          });
          explanationEl.appendChild(ul);
        }

        // Explanation toggle — hidden until the student explicitly asks for
        // it, even after answering. Answering a question just reveals
        // which option was correct/wrong; the explanation is a separate,
        // deliberate action so it isn't skimmed past unintentionally.
        const explainToggle = document.createElement('button');
        explainToggle.type = 'button';
        explainToggle.className = 'ca-explain-toggle';
        explainToggle.textContent = 'Show explanation ▾';
        explainToggle.style.display = 'none';
        explainToggle.addEventListener('click', () => {
          const isShown = explanationEl.classList.toggle('shown');
          explainToggle.textContent = isShown ? 'Hide explanation ▴' : 'Show explanation ▾';
        });

        const options = item.options || {};
        Object.entries(options).forEach(([letter, text]) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'ca-opt-btn';
          btn.innerHTML = `<span class="ca-opt-letter">${letter}</span> <span>${text}</span>`;
          btn.addEventListener('click', () => {
            optRow.querySelectorAll('.ca-opt-btn').forEach((b, i) => {
              b.disabled = true;
              const bLetter = Object.keys(options)[i];
              if (bLetter === item.answer) b.classList.add('correct');
            });
            if (letter !== item.answer) btn.classList.add('wrong');
            explainToggle.style.display = 'inline-flex';
          });
          optRow.appendChild(btn);
        });

        card.appendChild(optRow);
        card.appendChild(explainToggle);
        card.appendChild(explanationEl);
        listEl.appendChild(card);
      });

      const pageNumbers = document.getElementById('ca-page-numbers');
      pageNumbers.innerHTML = '';
      for (let p = 1; p <= totalPages; p++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ca-page-num-btn' + (p === currentPage ? ' active' : '');
        btn.textContent = String(p);
        btn.addEventListener('click', () => {
          currentPage = p;
          saveReadState();
          render();
        });
        pageNumbers.appendChild(btn);
      }

      document.getElementById('ca-prev-btn').disabled = currentPage <= 1;
      document.getElementById('ca-next-btn').disabled = currentPage >= totalPages;
      document.getElementById('ca-pagination').style.display = questions.length > PER_PAGE ? 'flex' : 'none';

      window.scrollTo({ top: 0, behavior: 'instant' });
    }

    select.addEventListener('change', () => { currentPage = 1; saveReadState(); render(); });
    document.getElementById('ca-prev-btn').addEventListener('click', () => { currentPage--; saveReadState(); render(); });
    document.getElementById('ca-next-btn').addEventListener('click', () => { currentPage++; saveReadState(); render(); });

    // MCQs / Quick Revision toggle — switches currentMode and re-renders.
    // Page resets to 1 on switch since the two modes can fit a different
    // number of items comfortably, and starting back at the top avoids
    // landing mid-list in the new view.
    document.querySelectorAll('.ca-mode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode === 'revision' ? 'revision' : 'mcqs';
        if (mode === currentMode) return;
        currentMode = mode;
        currentPage = 1;
        document.querySelectorAll('.ca-mode-btn').forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', String(isActive));
        });
        saveReadState();
        render();
      });
    });

    // Reflect a mode restored from sessionStorage (e.g. after Back) in the
    // toggle's visual state before the first render.
    document.querySelectorAll('.ca-mode-btn').forEach((b) => {
      const isActive = b.dataset.mode === currentMode;
      b.classList.toggle('active', isActive);
      b.setAttribute('aria-selected', String(isActive));
    });

    if (sectionNames.length) render();

    // ============================================================
    // Guest 5-minute reading limit.
    //
    // Logged-in users: unaffected, no timer runs at all.
    // Guests: after 5 minutes total of being on this page (accumulated
    // across visits, not reset each time they navigate away and back —
    // see LIMIT_KEY below), a full-screen popup blocks further reading
    // and explains why (free limit reached) and what to do (create a
    // free, OTP-free account to continue). Section + page were already
    // being saved above, so after signup they land right back on this
    // exact question, not the top of the page.
    // ============================================================
    (async function initGuestReadingLimit() {
      let loggedIn = false;
      try {
        const res = await fetch('https://api.studyhelp.fdaytalk.com/me', { credentials: 'include' });
        loggedIn = res.ok;
      } catch (err) {
        loggedIn = false; // network hiccup — fail open to guest limit, safer default
      }
      if (loggedIn) return;

      const overlay = document.getElementById('ca-limit-overlay');
      const signupBtn = document.getElementById('ca-limit-signup-btn');

      function blockReading() {
        saveReadState();
        overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden'; // block scrolling the page behind the popup
      }

      // Persisted in localStorage (survives navigating away and back, new
      // tabs, reloads — NOT just sessionStorage, which a "Back to Current
      // Affairs then Continue to Read again" loop would otherwise reset
      // every time, letting a guest read indefinitely). Once this flag is
      // set, every future visit blocks immediately — no new 5-minute
      // window is ever granted again on this browser until they log in.
      const LIMIT_KEY = 'ca_guest_limit_reached';
      let alreadyReached = false;
      try {
        alreadyReached = localStorage.getItem(LIMIT_KEY) === '1';
      } catch (err) {}

      if (alreadyReached) {
        blockReading();
      } else {
        // Testing shortcut only: ?ca_test_limit=10 (seconds) shortens the
        // wait for manual QA without touching the real 5-minute default.
        const testLimitSeconds = Number(new URLSearchParams(window.location.search).get('ca_test_limit'));
        const FREE_READING_MS = testLimitSeconds > 0
          ? testLimitSeconds * 1000
          : 5 * 60 * 1000;

        setTimeout(() => {
          try {
            localStorage.setItem(LIMIT_KEY, '1');
          } catch (err) {}
          blockReading();
        }, FREE_READING_MS);
      }

      signupBtn.addEventListener('click', () => {
        const next = encodeURIComponent('/current-affairs/read/');
        window.location.href = `/signup/?next=${next}`;
      });
    })();
  </script>

  <script is:inline>
    document.body.classList.add('sh2-page');
  </script>
</Layout>
