---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

export function getStaticPaths() {
  // Matches src/data/<any-subject-folder>/*.json - no subject names hardcoded.
  const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });

  const chapters = Object.entries(chapterFiles).flatMap(([path, mod]) => {
    const subject = path.split('/').slice(-2, -1)[0];
    const items = Array.isArray(mod.default) ? mod.default : [mod.default];

    return items
      .filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber)
      .map((ch) => ({ ...ch, subject }));
  });

  return chapters.map((ch) => ({
    params: { slug: ch.slug },
    // SECURITY: only question text (ch.faqs[].q) is passed as props.
    // Answer text, explanations, and tables are NEVER included here —
    // they live only in D1's chapter_content table, served by the Worker
    // after a real session + entitlement check. Do not add f.a, f.e, or
    // f.table to this props object.
    props: {
      chapterSlug: ch.slug,
      subject: ch.subject,
      chapterNumber: ch.chapterNumber,
      title: ch.title,
      questions: ch.faqs.map((f) => f.q),
    },
  }));
}

const { chapterSlug, subject, chapterNumber, title, questions } = Astro.props;
const meta = getSubjectMeta(subject);
const isTelugu = meta.lang === 'te';

const backLabel = isTelugu ? 'అధ్యాయాలు' : 'Chapters';
const questionsLabel = isTelugu ? 'ప్రశ్నలు' : 'questions';
const prevLabel = isTelugu ? 'మునుపటి' : 'Previous';
const nextLabel = isTelugu ? 'తర్వాత' : 'Next';

const PER_PAGE = 20;
const totalPages = Math.ceil(questions.length / PER_PAGE);
---
<Layout title={`${title} FAQs`} description={`${title} - ${questions.length} FAQs`}>

  <Header />

  <div class="content">
    <a href={`/${subject}/`} style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--muted); text-decoration:none; border:1px solid var(--border); border-radius:20px; padding:5px 12px 5px 8px; margin-bottom:14px;">&larr; {backLabel}</a>
    <div style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;">
      <h1 style="margin:0;">{chapterNumber}. {title}</h1>
      <span style="font-size:14px; font-weight:700; color:var(--text);">{questions.length} {questionsLabel}</span>
    </div>

    <div id="lock-banner" style="display:none; background:var(--amber-bg); border:1px solid var(--border); border-radius:8px; padding:14px 16px; margin-top:16px; font-size:14px; color:var(--amber-text-strong);">
      <span id="lock-message">Log in and purchase this subject to view answers.</span>
      <a id="lock-action" href="/login/" style="margin-left:8px; font-weight:700; color:var(--accent); text-decoration:underline;">Log in</a>
    </div>

    <div id="faq-list" style="display:flex; flex-direction:column; gap:8px; margin-top:20px;">
      {questions.map((q, i) => (
        <div class="faq-item" data-i={i} data-page={Math.floor(i / PER_PAGE) + 1} style={`border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--card); ${i >= PER_PAGE ? 'display:none;' : ''}`}>
          <div class="q-row" data-i={i} style="cursor:pointer; padding:16px 18px; display:flex; justify-content:space-between; gap:10px;">
            <span style="font-size:18px; line-height:1.6;">{i + 1}. {q}</span>
            <span style="color:var(--muted); flex-shrink:0; font-size:18px;">&darr;</span>
          </div>
          <div class="a-row" data-i={i} style="display:none; padding:0 18px 18px;"></div>
        </div>
      ))}
    </div>

    <div id="pagination" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:20px;"></div>
  </div>

  <script define:vars={{ chapterSlug, perPage: PER_PAGE, prevLabel, nextLabel }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    let currentPage = 1;
    const revealedAnswers = {}; // index -> answer object, cached once revealed this page view
    let purchased = false; // true once we learn this subject is fully unlocked (stops further limit checks)

    const list = document.getElementById('faq-list');
    const lockBanner = document.getElementById('lock-banner');
    const lockMessage = document.getElementById('lock-message');
    const lockAction = document.getElementById('lock-action');
    const totalItems = list.querySelectorAll('.faq-item').length;
    const totalPages = Math.ceil(totalItems / perPage);

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    function renderTable(table) {
      const headerHtml = table.headers.map((h) => `<th style="border:1px solid var(--border); padding:6px 10px; text-align:left; background:var(--card); font-weight:700;">${escapeHtml(h)}</th>`).join('');
      const rowsHtml = table.rows.map((row, idx) => `
        <tr style="${idx % 2 === 1 ? 'background:rgba(0,0,0,0.02);' : ''}">
          ${row.map((cell) => `<td style="border:1px solid var(--border); padding:6px 10px;">${escapeHtml(cell)}</td>`).join('')}
        </tr>
      `).join('');
      return `
        <div style="margin-top:12px; overflow-x:auto;">
          ${table.unit ? `<p style="margin:0 0 6px; font-size:13px; color:var(--muted);">${escapeHtml(table.unit)}</p>` : ''}
          <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead><tr>${headerHtml}</tr></thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        </div>
      `;
    }

    function renderAnswerHtml(f) {
      const tableHtml = f.table ? renderTable(f.table) : '';
      return `
        <div style="background:var(--success-bg); border-radius:8px; padding:14px 16px;">
          <p style="margin:0; font-weight:700; color:var(--success-text); font-size:19px;">${f.a}</p>
          ${f.e ? `<p style="margin:8px 0 0; font-size:15px; color:var(--muted);">${f.e}</p>` : ''}
          ${tableHtml}
        </div>
      `;
    }

    function showPage(page) {
      currentPage = page;
      list.querySelectorAll('.faq-item').forEach((item) => {
        const itemPage = parseInt(item.getAttribute('data-page'));
        item.style.display = itemPage === page ? 'block' : 'none';
      });
      renderPagination();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderPagination() {
      const pag = document.getElementById('pagination');
      if (totalPages <= 1) { pag.innerHTML = ''; return; }
      const btnStyle = 'min-width:36px; height:36px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:var(--card); color:var(--text); font-size:14px; cursor:pointer;';
      let html = `<button ${currentPage === 1 ? 'disabled' : ''} id="prev-btn" style="${btnStyle}">${prevLabel}</button>`;
      for (let p = 1; p <= totalPages; p++) {
        html += `<button data-page="${p}" style="${btnStyle} ${p === currentPage ? 'border-color:var(--accent); color:var(--accent); font-weight:700;' : ''}">${p}</button>`;
      }
      html += `<button ${currentPage === totalPages ? 'disabled' : ''} id="next-btn" style="${btnStyle}">${nextLabel}</button>`;
      pag.innerHTML = html;

      pag.querySelectorAll('button[data-page]').forEach((btn) => {
        btn.addEventListener('click', () => showPage(parseInt(btn.getAttribute('data-page'))));
      });
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      if (prevBtn) prevBtn.addEventListener('click', () => showPage(currentPage - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => showPage(currentPage + 1));
    }

    function showLimitReached(message) {
      lockBanner.style.display = 'block';
      lockMessage.textContent = message;
      lockAction.textContent = 'View plans';
      lockAction.href = '/plans/';
    }

    function showRemainingHint(remaining, dailyLimit) {
      if (remaining <= 3) {
        lockBanner.style.display = 'block';
        lockMessage.textContent = `${remaining} of ${dailyLimit} free answers left for this subject today. Resets tomorrow.`;
        lockAction.textContent = 'View plans';
        lockAction.href = '/plans/';
      }
    }

    list.querySelectorAll('.q-row').forEach((row) => {
      row.addEventListener('click', async () => {
        const i = parseInt(row.getAttribute('data-i'));
        const aRow = list.querySelector(`.a-row[data-i="${i}"]`);
        const isOpen = aRow.style.display === 'block';

        list.querySelectorAll('.a-row').forEach((el) => el.style.display = 'none');
        if (isOpen) return;

        // Already revealed earlier in this page view — just re-show, no server call needed.
        if (revealedAnswers[i]) {
          aRow.innerHTML = renderAnswerHtml(revealedAnswers[i]);
          aRow.style.display = 'block';
          return;
        }

        aRow.innerHTML = '<p style="margin:0; color:var(--muted); font-size:14px;">Loading...</p>';
        aRow.style.display = 'block';

        try {
          const res = await fetch(
            `${WORKER_URL}/content/answer?chapter_slug=${encodeURIComponent(chapterSlug)}&index=${i}`,
            { credentials: 'include' }
          );
          const data = await res.json();

          if (!res.ok) {
            aRow.style.display = 'none';
            showLimitReached(data.error || 'Please log in or purchase to continue.');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }

          revealedAnswers[i] = data.answer;
          aRow.innerHTML = renderAnswerHtml(data.answer);
          aRow.style.display = 'block';

          if (data.unlimited) {
            purchased = true;
            lockBanner.style.display = 'none';
          } else if (typeof data.remaining === 'number') {
            showRemainingHint(data.remaining, data.dailyLimit);
          }
        } catch (err) {
          aRow.style.display = 'none';
          showLimitReached('Network error. Please check your connection and try again.');
        }
      });
    });

    renderPagination();
  </script>
</Layout>
