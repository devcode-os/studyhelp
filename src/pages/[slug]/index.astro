  </style>

  {isReference && (
    <script define:vars={{ articles, amendments, articlesSearchPlaceholder, amendmentsSearchPlaceholder }}>
      // Fix #1: same casual copy/paste deterrent as the FAQ/MCQ view.
      const refContentArea = document.querySelector('.content');
      if (refContentArea) {
        ['copy', 'cut', 'contextmenu', 'selectstart'].forEach((evt) => {
          refContentArea.addEventListener(evt, (e) => e.preventDefault());
        });
      }

      let currentTab = 'articles';
      const container = document.getElementById('refListContainer');
      const searchInput = document.getElementById('refSearchInput');
      const resultCount = document.getElementById('refResultCount');

      document.querySelectorAll('.ref-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.ref-tab').forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          currentTab = tab.getAttribute('data-tab');
          searchInput.value = '';
          searchInput.placeholder = currentTab === 'articles' ? articlesSearchPlaceholder : amendmentsSearchPlaceholder;
          render();
        });
      });
      searchInput.addEventListener('input', render);

      function render() {
        const q = searchInput.value.trim().toLowerCase();
        container.innerHTML = '';

        if (currentTab === 'articles') {
          const items = articles.filter(
            (a) => a.number.toLowerCase().includes(q) || a.title.toLowerCase().includes(q)
          );
          resultCount.textContent = `${items.length} article${items.length !== 1 ? 's' : ''}`;
          if (items.length === 0) {
            container.innerHTML = '<div class="ref-empty">No articles match your search.</div>';
            return;
          }
          const grouped = {};
          items.forEach((a) => { (grouped[a.part] ||= []).push(a); });
          Object.keys(grouped).forEach((part) => {
            const label = document.createElement('div');
            label.className = 'ref-group-label';
            label.textContent = part;
            container.appendChild(label);

            const list = document.createElement('div');
            list.className = 'ref-entry-list';
            grouped[part].forEach((a) => {
              const entry = document.createElement('div');
              entry.className = 'ref-entry';
              entry.innerHTML = `
                <div class="ref-badge">${a.number}</div>
                <div class="ref-entry-body">
                  <div class="ref-entry-title ${a.repealed ? 'repealed' : ''}">${a.title}${a.repealed ? '<span class="ref-repealed-tag">Repealed</span>' : ''}</div>
                </div>
              `;
              list.appendChild(entry);
            });
            container.appendChild(list);
          });
        } else {
          const items = amendments.filter(
            (a) =>
              a.number.toLowerCase().includes(q) ||
              a.year.includes(q) ||
              a.title.toLowerCase().includes(q) ||
              a.articlesAffected.join(',').toLowerCase().includes(q)
          );
          resultCount.textContent = `${items.length} amendment${items.length !== 1 ? 's' : ''}`;
          if (items.length === 0) {
            container.innerHTML = '<div class="ref-empty">No amendments match your search.</div>';
            return;
          }
          items.sort((a, b) => parseInt(a.year) - parseInt(b.year));

          const label = document.createElement('div');
          label.className = 'ref-group-label';
          label.textContent = 'Chronological';
          container.appendChild(label);

          const list = document.createElement('div');
          list.className = 'ref-entry-list';
          items.forEach((a) => {
            const entry = document.createElement('div');
            entry.className = 'ref-entry';
            entry.innerHTML = `
              <div class="ref-badge">${a.number}</div>
              <div class="ref-entry-body">
                <div class="ref-entry-title">${a.title}</div>
                <div class="ref-entry-meta">${a.year} &middot; Affects: ${a.articlesAffected.join(', ')}</div>
              </div>
            `;
            list.appendChild(entry);
          });
          container.appendChild(list);
        }
      }

      render();
    </script>
  )}

  {!isReference && (
  <script define:vars={{ chapterSlug, subject, perPage: PER_PAGE, prevLabel, nextLabel, questions, weightage, isPapersSubject: meta.category === 'papers' }}>
    const PLANS_URL = `/plans/?highlight=${encodeURIComponent(subject)}`;
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Device fingerprint for the free-click counter: a hash of stable
    // device/browser properties (not stored state), so it survives private/
    // incognito browsing where cookies get wiped on close. UNCHANGED.
    let fingerprintPromise = null;
    async function getFingerprint() {
      if (fingerprintPromise) return fingerprintPromise;
      fingerprintPromise = (async () => {
        try {
          const raw = [
            navigator.userAgent,
            screen.width,
            screen.height,
            Intl.DateTimeFormat().resolvedOptions().timeZone,
            navigator.hardwareConcurrency || '',
          ].join('|');
          const enc = new TextEncoder().encode(raw);
          const digest = await crypto.subtle.digest('SHA-256', enc);
          return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
        } catch (err) {
          return null;
        }
      })();
      return fingerprintPromise;
    }
    getFingerprint();

    // ---------- Fix #1: casual copy/paste deterrent ----------
    // Blocks copy/cut/right-click/text-selection-start on the content area.
    // Deterrent-level only, as agreed — doesn't stop view-source/devtools.
    const contentArea = document.querySelector('.content');
    if (contentArea) {
      ['copy', 'cut', 'contextmenu', 'selectstart'].forEach((evt) => {
        contentArea.addEventListener(evt, (e) => e.preventDefault());
      });
    }

    let currentPage = 1;
    const revealedAnswers = {};

    // ---------- Fix #2: Q+options open by default (no accordion tap) ----------
    // Public, ungated /content/questions endpoint returns only type+options
    // (no answer/explanation) for every MCQ in the chapter. Rendered
    // immediately under each question for ALL users, all pages. Tapping a
    // preview option is what actually triggers the same gated
    // /content/answer fetch as before (via preselect) — so free-click
    // counting, page-2+ restriction, and the paywall are all unchanged;
    // only the number of taps needed to START that flow has dropped from
    // two (open + reveal) to one (tap an option).
    async function loadAndRenderPublicOptions() {
      try {
        const res = await fetch(
          `${WORKER_URL}/content/questions?chapter_slug=${encodeURIComponent(chapterSlug)}`
        );
        if (!res.ok) return;
        const data = await res.json();
        const qs = data.questions || {};
        Object.keys(qs).forEach((key) => {
          const i = parseInt(key);
          const f = qs[i];
          if (!f || f.type !== 'mcq' || !f.options) return;
          renderMcqPreview(i, f);
        });
      } catch (err) {
        // Silent fail — falls back to old accordion-tap behavior for
        // whichever questions didn't get a preview rendered.
      }
    }

    function renderMcqPreview(i, f) {
      const previewEl = list.querySelector(`.mcq-preview[data-i="${i}"]`);
      const chev = list.querySelector(`.q-row[data-i="${i}"] .q-chev`);
      if (!previewEl) return;
      if (revealedAnswers[i]) return; // already answered/revealed, nothing to preview

      if (chev) chev.style.display = 'none'; // no accordion needed for MCQ anymore

      const optionRows = Object.keys(f.options).map((letter) => `
        <div class="opt-row opt-clickable mcq-preview-opt" data-letter="${letter}">
          <span class="opt-badge">${letter.toLowerCase()}</span>
          <span class="opt-text">${escapeHtml(formatMath(f.options[letter]))}</span>
        </div>
      `).join('');

      previewEl.innerHTML = `<div class="opt-list" style="display:flex; flex-direction:column; gap:6px; margin-top:6px;">${optionRows}</div>`;
      previewEl.style.display = 'block';

      previewEl.querySelectorAll('.mcq-preview-opt').forEach((optEl) => {
        optEl.addEventListener('pointerdown', () => prefetchAnswer(i));
        optEl.addEventListener('click', (e) => {
          e.stopPropagation();
          const letter = optEl.getAttribute('data-letter');
          openAnswerFor(i, { preselect: letter });
        });
      });
    }
    let purchased = false;
    // Default by subject type until a real /check-access call confirms the
    // subject's actual access_days: 365 for question-papers subjects,
    // 45 for all other (regular chapter) subjects. Only used for CTA
    // copy — the real entitlement duration always comes from the
    // Worker/D1, this is display text only.
    let subjectAccessDays = isPapersSubject ? 365 : 45;

    // ---------- Lazy entitlement check for premium toolbar features ----------
    // Only called when the student actually taps a premium feature (Reveal
    // all, Check my score, Filter, Jump) — NOT on page load. Reuses the
    // session Header.astro already fetched once per page load
    // (window.__shSessionPromise) instead of calling /me again — a guest
    // (not logged in) can never have purchased anything, so we skip the
    // /check-access call entirely for guests and answer instantly. Only
    // logged-in users trigger the real /check-access call, and that's
    // cached after the first check so it never re-fires for the rest of
    // the visit.
    let entitlementChecked = false;
    let entitlementCheckPromise = null;

    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    async function ensureEntitlementChecked() {
      if (purchased) return true; // already confirmed via an answer fetch
      if (entitlementChecked) return purchased;
      if (entitlementCheckPromise) return entitlementCheckPromise;

      entitlementCheckPromise = (async () => {
        try {
          const session = await getSession();
          if (!session.logged_in) {
            // Guest — can never have purchased anything. No /check-access
            // call needed at all.
            entitlementChecked = true;
            entitlementCheckPromise = null;
            return false;
          }
          const accessRes = await fetch(
            `${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(subject)}`
          );
          const accessData = await accessRes.json();
          purchased = Boolean(accessData.unlocked);
          if (accessData.total_access_days) subjectAccessDays = accessData.total_access_days;
          entitlementChecked = true;
        } catch (err) {
          // Network error — don't cache as "checked", so the next premium
          // click retries instead of being permanently stuck as locked.
        }
        entitlementCheckPromise = null;
        return purchased;
      })();

      return entitlementCheckPromise;
    }

    // ---------- Button loading feedback ----------
    // Gives instant visual response to a tap even while the entitlement
    // check is in flight, so the button never feels unresponsive on a
    // slower connection. Restores the button's original content after.
    function withButtonLoading(btn, task) {
      if (!btn) return task();
      // Hide the button's existing children (don't destroy/recreate them —
      // overwriting innerHTML would detach any cached references to them,
      // like the Reveal-all label/icon, silently breaking later updates).
      // Insert a temporary spinner alongside instead, then just toggle
      // visibility back.
      const children = Array.from(btn.childNodes);
      children.forEach((node) => {
        if (node.nodeType === 1) node.style.display = 'none';
      });
      const spinner = document.createElement('span');
      spinner.className = 'rt-btn-loading-spinner';
      spinner.innerHTML = '<i class="ti ti-loader-2 rt-spin" aria-hidden="true"></i> Checking&hellip;';
      btn.appendChild(spinner);
      btn.disabled = true;

      return Promise.resolve(task()).finally(() => {
        btn.disabled = false;
        spinner.remove();
        children.forEach((node) => {
          if (node.nodeType === 1) node.style.display = '';
        });
      });
    }
    // ---------- Fix #4: subject-wide, day-cached free-click limit ----------
    // Once the daily 15-free-answer limit is hit for this subject, every
    // subsequent block (any chapter, any page) shows the SAME message as
    // the first time — no repeat server calls, no separate generic popup.
    // Cached in localStorage per subject+date so it also survives
    // navigating to a different chapter within the same subject.
    function todayKey() {
      const d = new Date();
      return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
    }
    const LIMIT_STORAGE_KEY = `sh_limit_${subject}_${todayKey()}`;
    let limitReached = localStorage.getItem(LIMIT_STORAGE_KEY) === '1';
    const DAILY_LIMIT_MESSAGE = `You've reached today's 15 free answers for this subject. Purchase for ${isPapersSubject ? 365 : 45} days of unlimited access, or come back tomorrow.`;

    function setLimitReached() {
      limitReached = true;
      try { localStorage.setItem(LIMIT_STORAGE_KEY, '1'); } catch (err) {}
    }

    let bulkAnswers = null;

    async function fetchAllAnswersInBackground() {
      try {
        const res = await fetch(
          `${WORKER_URL}/content/chapter-answers?chapter_slug=${encodeURIComponent(chapterSlug)}`,
          { credentials: 'include' }
        );
        if (!res.ok) return;
        const data = await res.json();
        bulkAnswers = data.answers;
      } catch (err) {
        // silently ignore — per-answer fetching still works fine as a fallback
      }
    }

    const list = document.getElementById('faq-list');
    const lockBanner = document.getElementById('lock-banner');
    const lockMessage = document.getElementById('lock-message');
    const lockAction = document.getElementById('lock-action');
    const lockClose = document.getElementById('lock-close');

    if (lockClose) {
      lockClose.addEventListener('click', () => {
        lockBanner.style.display = 'none';
      });
    }
    if (lockBanner) {
      // Click on the dimmed backdrop (outside the modal card) also closes it.
      lockBanner.addEventListener('click', (e) => {
        if (e.target === lockBanner) lockBanner.style.display = 'none';
      });
    }
    const totalItems = list.querySelectorAll('.faq-item').length;
    const totalPages = Math.ceil(totalItems / perPage);

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    function renderTable(table) {
      const headerHtml = table.headers.map((h) => `<th style="border:1px solid var(--border); padding:6px 10px; text-align:left; background:var(--card); font-weight:700;">${escapeHtml(h)}</th>`).join('');
      const rowsHtml = table.rows.map((row, idx) => `
        <tr style="${idx % 2 === 1 ? 'background:rgba(0,0,0,0.02);' : ''}">
          ${row.map((cell) => `<td style="border:1px solid var(--border); padding:6px 10px;">${escapeHtml(cell)}</td>`).join('')}
        </tr>
      `).join('');
      return `
        <div style="margin-top:12px; overflow-x:auto;">
          ${table.unit ? `<p style="margin:0 0 6px; font-size:13px; color:var(--muted);">${escapeHtml(table.unit)}</p>` : ''}
          <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead><tr>${headerHtml}</tr></thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        </div>
      `;
    }

    const SUP_MAP = { '0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','-':'⁻','+':'⁺' };
    function formatMath(str) {
      return String(str).replace(/\^(-?\d+)/g, (_, exp) =>
        exp.split('').map((ch) => SUP_MAP[ch] || ch).join('')
      );
    }

    const userSelections = {};

    function renderExplanationParagraphs(text) {
      const paragraphs = String(text).split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
      return paragraphs.map((p, idx) => {
        const withBreaks = escapeHtml(formatMath(p)).replace(/\n/g, '<br>');
        const marginBottom = idx < paragraphs.length - 1 ? '10px' : '0';
        return `<p class="expl-text" style="margin:0 0 ${marginBottom}; font-size:15px; line-height:1.5; color:color-mix(in srgb, var(--text) 55%, var(--muted) 45%);">${withBreaks}</p>`;
      }).join('');
    }

    function renderExplanationInline(f) {
      if (!f.e) return '';
      return `<div style="margin-top:8px;">${renderExplanationParagraphs(f.e)}</div>`;
    }

    function renderExplanationToggle(f, i) {
      const tableHtml = f.table ? renderTable(f.table) : '';
      // Neither explanation text nor a table to show — nothing to toggle.
      if (!f.e && !tableHtml) return '';
      const explId = `expl-${i}`;
      // Table lives inside the SAME hidden div as the explanation text so
      // both hide/show together as one unit under a single toggle button.
      return `
        <button type="button" class="expl-toggle" data-target="${explId}" style="margin-top:10px; background:none; border:1px solid var(--border); border-radius:6px; padding:5px 10px; font-size:13px; color:var(--accent); cursor:pointer;">Show explanation</button>
        <div id="${explId}" style="display:none; margin-top:8px;">
          ${f.e ? renderExplanationParagraphs(f.e) : ''}
          ${tableHtml}
        </div>
      `;
    }

    function renderMcqBox(f, i, peek = false) {
      const selected = peek ? null : (userSelections[i] || null);
      const letters = Object.keys(f.options);

      const optionRows = letters.map((letter) => {
        const isCorrect = letter === f.answer;
        const isWrongPick = selected && letter === selected && !isCorrect;
        const isRightPick = selected && isCorrect;
        // Peek mode (Reveal-all): just highlight the correct option green,
        // no wrong/right verdict since the user never actually picked.
        const isPeekCorrect = peek && isCorrect;

        let rowClass = 'opt-row';
        let badgeClass = 'opt-badge';
        let icon = '';
        if (isRightPick || isPeekCorrect) {
          rowClass += ' opt-row-correct';
          badgeClass += ' opt-badge-correct';
          icon = '<span class="opt-icon opt-icon-correct"><i class="ti ti-check" aria-hidden="true"></i></span>';
        } else if (isWrongPick) {
          rowClass += ' opt-row-wrong';
          badgeClass += ' opt-badge-wrong';
          icon = '<span class="opt-icon opt-icon-wrong"><i class="ti ti-x" aria-hidden="true"></i></span>';
        }
        if (!selected && !peek) rowClass += ' opt-clickable';

        return `
          <div class="${rowClass}" data-letter="${letter}">
            <span class="${badgeClass}">${letter.toLowerCase()}</span>
            <span class="opt-text">${escapeHtml(formatMath(f.options[letter]))}</span>
            ${icon}
          </div>
        `;
      }).join('');

      const feedbackHtml = (selected || peek) ? `
        <p class="answer-text" style="margin:12px 0 0; font-weight:600; font-size:14px; color:var(--success-text);">
          Correct Answer: ${formatMath(f.a)}
        </p>
        ${renderExplanationToggle(f, i)}
      ` : `
        <p style="margin:10px 0 0; font-size:13px; color:var(--muted);">Tap an option to check your answer</p>
      `;

      return `
        <div class="opt-list" style="display:flex; flex-direction:column; gap:6px;">${optionRows}</div>
        ${feedbackHtml}
      `;
    }

    function renderFaqBox(f) {
      const tableHtml = f.table ? renderTable(f.table) : '';
      const explHtml = renderExplanationInline(f);
      return `
        <p class="answer-text" style="margin:0; font-weight:600; color:var(--success-text); font-size:15px; background:var(--success-bg); border-radius:8px; padding:10px 12px;">${formatMath(f.a)}</p>
        ${explHtml}
        ${tableHtml}
      `;
    }

    function renderAnswerHtml(f, i, peek = false) {
      return f && f.type === 'mcq' && f.options ? renderMcqBox(f, i, peek) : renderFaqBox(f);
    }

    // ---------- Skeleton loading, replaces plain "Loading..." text.
    // Shape mimics the eventual answer capsule so there's no layout jump.
    function renderSkeleton() {
      return `
        <div class="skeleton-answer">
          <div class="skeleton-line w-90"></div>
          <div class="skeleton-line w-70"></div>
          <div class="skeleton-line w-50"></div>
        </div>
      `;
    }

    function attachMcqHandlers(aRow, f, i) {
      if (!f || f.type !== 'mcq' || !f.options) return;

      aRow.querySelectorAll('.opt-clickable').forEach((optEl) => {
        optEl.addEventListener('click', (e) => {
          e.stopPropagation();
          userSelections[i] = optEl.getAttribute('data-letter');
          aRow.innerHTML = renderAnswerHtml(f, i);
          attachMcqHandlers(aRow, f, i);
          markAnswered(i);
        });
      });

      const toggleBtn = aRow.querySelector('.expl-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = document.getElementById(toggleBtn.getAttribute('data-target'));
          const nowOpen = target.style.display === 'block';
          target.style.display = nowOpen ? 'none' : 'block';
          toggleBtn.textContent = nowOpen ? 'Show explanation' : 'Hide explanation';
        });
      }
    }

    function showPage(page) {
      currentPage = page;
      list.querySelectorAll('.faq-item').forEach((item) => {
        const itemPage = parseInt(item.getAttribute('data-page'));
        item.style.display = itemPage === page ? 'block' : 'none';
      });
      renderPagination();
      closeOptionsPanel();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderPagination() {
      const pag = document.getElementById('pagination');
      if (totalPages <= 1) { pag.innerHTML = ''; return; }
      const btnStyle = 'min-width:36px; height:36px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:var(--card); color:var(--text); font-size:14px; cursor:pointer;';
      let html = `<button ${currentPage === 1 ? 'disabled' : ''} id="prev-btn" style="${btnStyle}">${prevLabel}</button>`;
      for (let p = 1; p <= totalPages; p++) {
        html += `<button data-page="${p}" style="${btnStyle} ${p === currentPage ? 'border-color:var(--accent); color:var(--accent); font-weight:700;' : ''}">${p}</button>`;
      }
      html += `<button ${currentPage === totalPages ? 'disabled' : ''} id="next-btn" style="${btnStyle}">${nextLabel}</button>`;
      pag.innerHTML = html;

      pag.querySelectorAll('button[data-page]').forEach((btn) => {
        btn.addEventListener('click', () => showPage(parseInt(btn.getAttribute('data-page'))));
      });
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      if (prevBtn) prevBtn.addEventListener('click', () => showPage(currentPage - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => showPage(currentPage + 1));
    }

    function showLimitReached(message) {
      lockBanner.style.display = 'flex';
      lockMessage.textContent = message;
      lockAction.textContent = 'View plans';
      lockAction.href = PLANS_URL;
    }

    function showRemainingHint(remaining, dailyLimit) {
      if (remaining <= 3) {
        lockBanner.style.display = 'flex';
        lockMessage.textContent = `${remaining} of ${dailyLimit} free answers left for this subject today. Resets tomorrow.`;
        lockAction.textContent = 'View plans';
        lockAction.href = PLANS_URL;
      }
    }

    // ---------- Prefetch on pointerdown, not click. Starts the network
    // request the instant a finger/mouse touches the row (pointerdown fires
    // ~100-200ms before the full click gesture completes), so by the time
    // click actually fires, the fetch is often already in flight or done.
    // Same endpoint, same free-click/entitlement checks server-side —
    // this only shaves perceived latency, it changes nothing about what
    // gets checked or when access is granted. ----------
    const inFlightFetches = {};

    function prefetchAnswer(i) {
      if (revealedAnswers[i]) return null;
      if (bulkAnswers && bulkAnswers[i]) return null;
      if (limitReached) return null;
      if (inFlightFetches[i]) return inFlightFetches[i];

      inFlightFetches[i] = (async () => {
        try {
          const fp = await getFingerprint();
          const fpParam = fp ? `&fp=${encodeURIComponent(fp)}` : '';
          const res = await fetch(
            `${WORKER_URL}/content/answer?chapter_slug=${encodeURIComponent(chapterSlug)}&index=${i}${fpParam}`,
            { credentials: 'include' }
          );
          const data = await res.json();
          return { ok: res.ok, data };
        } catch (err) {
          return { ok: false, networkError: true };
        }
      })();

      return inFlightFetches[i];
    }

    // ---------- Reading-experience state ----------
    const answeredSet = new Set(); // indices genuinely answered: FAQ reveal, or MCQ option pick
    const totalQuestions = totalItems;

    function updateProgress() {
      const fill = document.getElementById('rt-progress-fill');
      const text = document.getElementById('rt-progress-text');
      const stickyFill = document.getElementById('rt-sticky-fill');
      const pct = totalQuestions ? Math.round((answeredSet.size / totalQuestions) * 100) : 0;
      if (fill) fill.style.width = pct + '%';
      if (stickyFill) stickyFill.style.width = pct + '%';
      if (text) text.textContent = `${answeredSet.size} of ${totalQuestions} answered`;
    }

    function markAnswered(i) {
      answeredSet.add(i);
      updateProgress();
    }

    // ---------- openAnswerFor: single entry point for revealing a question,
    // used by both individual taps and Reveal-all. Every reveal — including
    // ones triggered by Reveal-all — goes through the SAME real fetch/
    // entitlement path as a manual click. Nothing bypasses the paywall:
    // guests and unpurchased users hit the exact same lock-banner/daily-
    // limit response Reveal-all just surfaces it via the same popup.
    // Returns true if revealed successfully, false if blocked (limit/error)
    // — Reveal-all uses this to know when to stop.
    async function openAnswerFor(i, { scroll = true, peek = false, preselect = null } = {}) {
      const row = list.querySelector(`.q-row[data-i="${i}"]`);
      if (!row) return true;
      const faqItem = row.closest('.faq-item');
      const aRow = list.querySelector(`.a-row[data-i="${i}"]`);
      if (preselect) userSelections[i] = preselect;
      const previewEl = list.querySelector(`.mcq-preview[data-i="${i}"]`);

      // Already revealed (fetched earlier) — just re-render, no new fetch.
      // Peek always force-re-renders in pure-answer-key style, even if the
      // question was already open from the student's own tap.
      if (revealedAnswers[i]) {
        if (aRow.style.display === 'block' && !peek) return true;
        faqItem.classList.add('open');
        aRow.innerHTML = renderAnswerHtml(revealedAnswers[i], i, peek);
        aRow.style.display = 'block';
        if (previewEl) previewEl.style.display = 'none';
        attachMcqHandlers(aRow, revealedAnswers[i], i);
        return true;
      }

      if (aRow.style.display === 'block' && !peek) return true;

      if (bulkAnswers && bulkAnswers[i]) {
        revealedAnswers[i] = bulkAnswers[i];
        faqItem.classList.add('open');
        aRow.innerHTML = renderAnswerHtml(bulkAnswers[i], i, peek);
        if (previewEl) previewEl.style.display = 'none';
        aRow.style.display = 'block';
        attachMcqHandlers(aRow, bulkAnswers[i], i);
        return true;
      }

      if (limitReached) {
        // Bug fix: a locally-cached limitReached (from before login/purchase,
        // same subject+day) must not block a NOW-purchased user. Verify
        // real entitlement before trusting the cached flag; if purchased,
        // clear the stale cache and fall through to a normal fetch.
        const isPurchasedNow = await ensureEntitlementChecked();
        if (isPurchasedNow) {
          limitReached = false;
          try { localStorage.removeItem(LIMIT_STORAGE_KEY); } catch (err) {}
        } else {
          aRow.style.display = 'none';
          faqItem.classList.remove('open');
          showLimitReached(DAILY_LIMIT_MESSAGE);
          return false;
        }
      }

      // ---------- Fix #2: free clicks apply only to page 1 (first 20) ----------
      // Free-click allowance not yet exhausted, but user is browsing page 2+
      // and isn't a purchased subject holder — reveal is always paywalled
      // here regardless of remaining free clicks. Purchased users pass
      // straight through (their bulkAnswers branch above already returns
      // before reaching this point in practice, but this stays as a
      // correct fallback).
      if (currentPage > 1) {
        const isPurchased = await ensureEntitlementChecked();
        if (!isPurchased) {
          aRow.style.display = 'none';
          faqItem.classList.remove('open');
          showLimitReached('Free clicks are only available on the first 20 questions. Purchase this subject for full access.');
          return false;
        }
      }

      faqItem.classList.add('open');
      if (!peek) {
        aRow.innerHTML = renderSkeleton();
        aRow.style.display = 'block';
      }

      const pending = prefetchAnswer(i) || (async () => {
        try {
          const fp = await getFingerprint();
          const fpParam = fp ? `&fp=${encodeURIComponent(fp)}` : '';
          const res = await fetch(
            `${WORKER_URL}/content/answer?chapter_slug=${encodeURIComponent(chapterSlug)}&index=${i}${fpParam}`,
            { credentials: 'include' }
          );
          const data = await res.json();
          return { ok: res.ok, data };
        } catch (err) {
          return { ok: false, networkError: true };
        }
      })();

      const result = await pending;
      delete inFlightFetches[i];

      if (result.networkError) {
        aRow.style.display = 'none';
        faqItem.classList.remove('open');
        if (window.showToast) {
          window.showToast('Network error. Please check your connection and try again.', 'error');
        } else {
          showLimitReached('Network error. Please check your connection and try again.');
        }
        return false;
      }

      const { ok, data } = result;

      if (!ok) {
        aRow.style.display = 'none';
        faqItem.classList.remove('open');
        if (data.limitReached) {
          setLimitReached();
          showLimitReached(DAILY_LIMIT_MESSAGE);
        } else {
          showLimitReached(data.error || DAILY_LIMIT_MESSAGE);
        }
        return false;
      }

      revealedAnswers[i] = data.answer;
      if (previewEl) previewEl.style.display = 'none';
      aRow.innerHTML = renderAnswerHtml(data.answer, i, peek);
      aRow.style.display = 'block';
      attachMcqHandlers(aRow, data.answer, i);

      // Reveal-all (peek) never touches the progress/answered count — it's
      // a lookup action, not practice. FAQ reveals via a real tap count
      // immediately; MCQ only counts once the user picks an option (see
      // attachMcqHandlers).
      const isMcq = data.answer && data.answer.type === 'mcq' && data.answer.options;
      if (!peek && !isMcq) markAnswered(i);

      if (data.unlimited) {
        purchased = true;
        lockBanner.style.display = 'none';
        if (!bulkAnswers) fetchAllAnswersInBackground();
      } else if (typeof data.remaining === 'number') {
        knownRemainingClicks = data.remaining;
        showRemainingHint(data.remaining, data.dailyLimit);
      }

      if (scroll) {
        setTimeout(() => {
          const rect = faqItem.getBoundingClientRect();
          if (rect.bottom > window.innerHeight || rect.top < 0) {
            // Fix #5: answer-reveal auto-scroll disabled per request.
            // Jump-to-question and score-summary scrolls are unaffected.
          }
        }, 50);
      }

      return true;
    }

    list.querySelectorAll('.q-row').forEach((row) => {
      const i = parseInt(row.getAttribute('data-i'));

      // Fire as early as the gesture starts. touchstart/mousedown-equivalent
      // via pointerdown covers both touch and mouse in one listener.
      row.addEventListener('pointerdown', () => {
        prefetchAnswer(i);
      });

      row.addEventListener('click', () => {
        openAnswerFor(i);
      });
    });

    // ---------- Confirm modal helper (Reveal all + Check my score) ----------
    function showConfirm(message, okLabel, onConfirm) {
      const overlay = document.getElementById('rt-confirm-overlay');
      const msgEl = document.getElementById('rt-confirm-message');
      const okBtn = document.getElementById('rt-confirm-ok');
      const cancelBtn = document.getElementById('rt-confirm-cancel');
      if (!overlay || !msgEl || !okBtn || !cancelBtn) { onConfirm(); return; }

      msgEl.textContent = message;
      okBtn.textContent = okLabel;
      overlay.style.display = 'flex';

      function cleanup() {
        overlay.style.display = 'none';
        okBtn.removeEventListener('click', handleOk);
        cancelBtn.removeEventListener('click', handleCancel);
      }
      function handleOk() { cleanup(); onConfirm(); }
      function handleCancel() { cleanup(); }

      okBtn.addEventListener('click', handleOk);
      cancelBtn.addEventListener('click', handleCancel);
    }

    // ---------- Toast helper (filter/jump notices) ----------
    let toastTimer = null;
    function showLocalToast(message) {
      const toast = document.getElementById('rt-toast');
      if (!toast) return;
      toast.textContent = message;
      toast.style.display = 'block';
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toast.style.display = 'none'; }, 2500);
    }

    // ---------- Reveal all / Hide all (toggle) ----------
    // Every question Reveal-all opens goes through the exact same fetch/
    // entitlement check as a manual click (see openAnswerFor above) — a
    // guest or unpurchased user hits the same lock popup partway through,
    // exactly as if they'd been clicking one by one. Sequential (not
    // parallel) fetches, so the daily-limit check stays accurate.
    const revealAllBtn = document.getElementById('rt-reveal-all');
    const revealAllLabel = document.getElementById('rt-reveal-all-label');
    const revealAllIcon = revealAllBtn ? revealAllBtn.querySelector('.ti-eye, .ti-eye-off') : null;
    let allRevealed = false;

    async function doRevealAll() {
      let revealedCount = 0;
      for (let i = 0; i < totalQuestions; i++) {
        const success = await openAnswerFor(i, { scroll: false, peek: true });
        if (!success) break; // blocked by paywall/limit — stop right here
        revealedCount++;
      }
      // Update the button state if ANYTHING got revealed, even if the loop
      // stopped early partway through — "Hide all" just hides whatever is
      // currently open, which is still correct and useful for a partial
      // reveal. Only leave the button as "Reveal all" if nothing opened
      // at all (e.g. blocked immediately on the very first question).
      if (revealedCount > 0) {
        if (revealAllLabel) revealAllLabel.textContent = 'Hide All';
        if (revealAllIcon) { revealAllIcon.classList.remove('ti-eye'); revealAllIcon.classList.add('ti-eye-off'); }
        allRevealed = true;
      }
    }

    if (revealAllBtn) {
      revealAllBtn.addEventListener('click', async () => {
        if (!allRevealed) {
          const ok = await withButtonLoading(revealAllBtn, () => ensureEntitlementChecked());
          if (!ok) {
            showLimitReached('Reveal all is a premium feature. Purchase this subject to unlock it.');
            return;
          }
          if (answeredSet.size > 0 && answeredSet.size < totalQuestions) {
            showConfirm(
              `You've answered ${answeredSet.size} of ${totalQuestions} questions. Revealing all will show every answer, including ones you haven't tried yet.`,
              'Reveal anyway',
              doRevealAll
            );
          } else {
            doRevealAll();
          }
        } else {
          // Bug fix: "Hide All" must only undo the REVEAL-ALL peek — it
          // should never touch a question the user genuinely answered
          // themselves (tracked via userSelections). Those stay exactly as
          // they are: answer/verdict visible, nothing collapses. Only
          // peeked-but-not-actually-answered questions get hidden back to
          // their open-options preview state.
          list.querySelectorAll('.faq-item').forEach((item) => {
            const qRow = item.querySelector('.q-row[data-i]');
            if (!qRow) return;
            const i = parseInt(qRow.getAttribute('data-i'));
            if (answeredSet.has(i)) return; // leave genuinely-answered questions untouched (covers both MCQ picks and real FAQ reveals)

            const aRow = item.querySelector('.a-row');
            if (aRow) aRow.style.display = 'none';
            item.classList.remove('open');

            const previewEl = item.querySelector('.mcq-preview');
            if (previewEl) previewEl.style.display = 'block';
          });
          if (revealAllLabel) revealAllLabel.textContent = 'Reveal All Answers';
          if (revealAllIcon) { revealAllIcon.classList.remove('ti-eye-off'); revealAllIcon.classList.add('ti-eye'); }
          allRevealed = false;
        }
      });
    }

    // ---------- Fix #3: Mock Test mode (paid subject holders only) ----------
    // One question at a time, persistent timer, shuffled question order per
    // attempt (original data `index` preserved for answer lookup — only the
    // DISPLAY order is shuffled, numbering shown to the user is always
    // sequential 1..N regardless of shuffle). Retakes are unrestricted and
    // unlimited — no attempt is stored/remembered between visits.
    const mtOverlay = document.getElementById('mt-overlay');
    const mtBody = document.getElementById('mt-body');
    const mtTimerText = document.getElementById('mt-timer-text');
    const mtProgressText = document.getElementById('mt-progress-text');
    const mtPrevBtn = document.getElementById('mt-prev-btn');
    const mtNextBtn = document.getElementById('mt-next-btn');
    const mtSubmitBtn = document.getElementById('mt-submit-btn');
    const mtExitBtn = document.getElementById('mt-exit-btn');
    const mtExitOverlay = document.getElementById('mt-exit-overlay');
    const mtExitCancel = document.getElementById('mt-exit-cancel');
    const mtExitConfirm = document.getElementById('mt-exit-confirm');
    const startMockTestBtn = document.getElementById('rt-start-mocktest');

    const SECONDS_PER_QUESTION = 60;
    let mtOrder = [];         // shuffled array of original question indices
    let mtAnswers = {};       // original index -> full answer object (from chapter-answers)
    let mtSelections = {};    // original index -> selected letter
    let mtCurrentPos = 0;     // position within mtOrder
    let mtTimerInterval = null;
    let mtSecondsLeft = 0;
    let mtActive = false;
    let mtReviewMode = false; // true when navigating a finished attempt's review, not a live test
    let mtAttemptCount = 0; // within-page only, resets on reload/revisit — not persisted
    let mtTrialMode = false;   // true for guests/non-purchased — first 10 Qs, metered by free-clicks
    let mtTrialBlocked = false; // set true if free-click limit hit mid-trial
    const TRIAL_QUESTION_COUNT = 10;
    let knownRemainingClicks = null; // updated from the server's own `remaining` field on every answer fetch

    function shuffleArray(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    async function fetchAllAnswersForMockTest() {
      if (bulkAnswers) return bulkAnswers;
      const res = await fetch(
        `${WORKER_URL}/content/chapter-answers?chapter_slug=${encodeURIComponent(chapterSlug)}`,
        { credentials: 'include' }
      );
      if (!res.ok) return null;
      const data = await res.json();
      return data.answers;
    }

    // ---------- Free trial Mock Test (guests / non-purchased) ----------
    // Reuses the SAME per-question /content/answer endpoint as casual free-
    // click reveals — same 15/day quota, same D1-backed gating, nothing new
    // to trust. Answers are fetched lazily, one at a time, as the trial-taker
    // reaches each question (never all upfront), so each question genuinely
    // costs one real free click, same as normal reading mode.
    async function fetchTrialAnswer(idx) {
      const fp = await getFingerprint();
      const fpParam = fp ? `&fp=${encodeURIComponent(fp)}` : '';
      const res = await fetch(
        `${WORKER_URL}/content/answer?chapter_slug=${encodeURIComponent(chapterSlug)}&index=${idx}${fpParam}`,
        { credentials: 'include' }
      );
      const data = await res.json();
      if (typeof data.remaining === 'number') knownRemainingClicks = data.remaining;
      return { ok: res.ok, data };
    }

    function mtFormatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = Math.floor(sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    async function renderMtQuestion() {
      const idx = mtOrder[mtCurrentPos];
      const q = questions[idx];
      mtProgressText.textContent = `Question ${mtCurrentPos + 1} of ${mtOrder.length}`;

      // Trial mode: fetch this question's answer/options lazily, only when
      // the trial-taker actually reaches it — consumes one real free click,
      // same as a normal reveal tap would.
      if (mtTrialMode && !mtAnswers[idx]) {
        mtBody.innerHTML = `
          <div class="mt-q-num">Q${mtCurrentPos + 1}</div>
          <div class="mt-q-text">${escapeHtml(formatMath(q))}</div>
          <div class="skeleton-answer">
            <div class="skeleton-line w-90"></div>
            <div class="skeleton-line w-70"></div>
          </div>
        `;
        mtPrevBtn.disabled = true;
        mtNextBtn.disabled = true;
        mtSubmitBtn.disabled = true;

        const result = await fetchTrialAnswer(idx);
        if (!result.ok) {
          // Free-click limit hit mid-trial — stop here, show whatever was
          // answered so far via the normal finish flow.
          mtTrialBlocked = true;
          showLimitReached(result.data && result.data.limitReached ? DAILY_LIMIT_MESSAGE : (result.data.error || DAILY_LIMIT_MESSAGE));
          if (result.data && result.data.limitReached) setLimitReached();
          finishMockTest();
          return;
        }
        mtAnswers[idx] = result.data.answer;
      }

      const f = mtAnswers[idx];
      const isMcq = f && f.type === 'mcq' && f.options;

      let optsHtml = '';
      if (isMcq) {
        optsHtml = Object.keys(f.options).map((letter) => {
          const selected = mtSelections[idx] === letter;
          return `<div class="mt-opt-row ${selected ? 'mt-opt-selected' : ''}" data-letter="${letter}">
            <span class="opt-badge">${letter.toLowerCase()}</span>
            <span class="opt-text">${escapeHtml(formatMath(f.options[letter]))}</span>
          </div>`;
        }).join('');
      }

      mtBody.innerHTML = `
        <div class="mt-q-num">Q${mtCurrentPos + 1}</div>
        <div class="mt-q-text">${escapeHtml(formatMath(q))}</div>
        ${optsHtml}
      `;

      mtBody.querySelectorAll('.mt-opt-row').forEach((row) => {
        row.addEventListener('click', () => {
          mtSelections[idx] = row.getAttribute('data-letter');
          renderMtQuestion();
        });
      });

      mtPrevBtn.disabled = mtCurrentPos === 0;
      mtNextBtn.disabled = false;
      mtSubmitBtn.disabled = false;
      const isLast = mtCurrentPos === mtOrder.length - 1;
      mtNextBtn.style.display = isLast ? 'none' : '';
      mtSubmitBtn.style.display = isLast ? '' : 'none';
    }

    function startMtTimer(totalSeconds) {
      mtSecondsLeft = totalSeconds;
      mtTimerText.textContent = mtFormatTime(mtSecondsLeft);
      mtTimerInterval = setInterval(() => {
        mtSecondsLeft--;
        mtTimerText.textContent = mtFormatTime(Math.max(0, mtSecondsLeft));
        if (mtSecondsLeft <= 0) {
          clearInterval(mtTimerInterval);
          finishMockTest();
        }
      }, 1000);
    }

    function stopMtTimer() {
      if (mtTimerInterval) clearInterval(mtTimerInterval);
      mtTimerInterval = null;
    }

    let mtPopstateGuard = null;

    function openMockTestOverlay() {
      mtActive = true;
      mtOverlay.classList.add('active');
      // Push a history state so back-gesture/back-button triggers popstate
      // instead of navigating away; intercepted below.
      history.pushState({ mockTest: true }, '');
      mtPopstateGuard = () => {
        history.pushState({ mockTest: true }, '');
        requestMtExit();
      };
      window.addEventListener('popstate', mtPopstateGuard);
    }

    function closeMockTestOverlay() {
      mtActive = false;
      mtOverlay.classList.remove('active');
      stopMtTimer();
      if (mtPopstateGuard) {
        window.removeEventListener('popstate', mtPopstateGuard);
        mtPopstateGuard = null;
      }
    }

    function requestMtExit() {
      if (mtReviewMode) {
        // Review mode is read-only — nothing to lose, no need to interrupt
        // with a confirm popup. Just close straight back to the scorecard.
        mtReviewMode = false;
        if (mtSubmitBtn) mtSubmitBtn.textContent = 'Submit Test';
        closeMockTestOverlay();
        const summary = document.getElementById('rt-score-summary');
        if (summary) summary.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      mtExitOverlay.style.display = 'flex';
    }

    if (mtExitBtn) mtExitBtn.addEventListener('click', requestMtExit);
    if (mtExitCancel) {
      mtExitCancel.addEventListener('click', () => { mtExitOverlay.style.display = 'none'; });
    }
    if (mtExitConfirm) {
      mtExitConfirm.addEventListener('click', () => {
        mtExitOverlay.style.display = 'none';
        finishMockTest();
      });
    }
    if (mtPrevBtn) mtPrevBtn.addEventListener('click', () => {
      mtCurrentPos--;
      mtReviewMode ? renderMtReviewQuestion() : renderMtQuestion();
    });
    if (mtNextBtn) mtNextBtn.addEventListener('click', () => {
      mtCurrentPos++;
      mtReviewMode ? renderMtReviewQuestion() : renderMtQuestion();
    });
    if (mtSubmitBtn) mtSubmitBtn.addEventListener('click', () => {
      if (mtReviewMode) {
        mtReviewMode = false;
        mtSubmitBtn.textContent = 'Submit Test';
        closeMockTestOverlay();
        const summary = document.getElementById('rt-score-summary');
        if (summary) summary.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        finishMockTest();
      }
    });

    function finishMockTest() {
      closeMockTestOverlay();

      // Feed mock-test selections/answers into the SAME state the normal
      // Filter feature reads, so "Wrong answers only" works as post-test
      // review (per agreed spec).
      Object.keys(mtAnswers).forEach((key) => {
        const idx = parseInt(key);
        revealedAnswers[idx] = mtAnswers[idx];
        if (mtSelections[idx]) {
          userSelections[idx] = mtSelections[idx];
          answeredSet.add(idx);
        }
      });
      updateProgress();

      let correct = 0, wrong = 0, attempted = 0;
      mtOrder.forEach((idx) => {
        const f = mtAnswers[idx];
        const isMcq = f && f.type === 'mcq' && f.options;
        if (!isMcq) return;
        const pick = mtSelections[idx];
        if (!pick) return;
        attempted++;
        if (pick === f.answer) correct++; else wrong++;
      });
      const notAttempted = mtOrder.length - attempted;

      const summary = document.getElementById('rt-score-summary');
      const content = document.getElementById('rt-score-content');
      summary.style.display = 'block';
      content.innerHTML = `
        <p class="rt-score-title">${mtTrialMode ? 'Free Trial Mock Test Result' : `Mock Test Result - Attempt #${mtAttemptCount}`}</p>
        <div class="rt-stat-grid">
          <div class="rt-stat-box rt-stat-box-correct">
            <div class="rt-stat-num">${correct}</div>
            <div class="rt-stat-label">Correct</div>
          </div>
          <div class="rt-stat-box rt-stat-box-wrong">
            <div class="rt-stat-num">${wrong}</div>
            <div class="rt-stat-label">Wrong</div>
          </div>
          <div class="rt-stat-box rt-stat-box-notattempted">
            <div class="rt-stat-num">${notAttempted}</div>
            <div class="rt-stat-label">Not attempted</div>
          </div>
        </div>
        <button type="button" id="mt-review-btn" class="rt-btn rt-btn-accent" style="width:100%; justify-content:center; margin-top:14px;">
          <i class="ti ti-list-check" aria-hidden="true"></i> Review Mock Test
        </button>
        ${mtTrialMode ? `
          <a href="${PLANS_URL}" class="mt-trial-cta">
            That was just ${mtOrder.length} questions \u2014 unlock the full ${totalQuestions}-question Mock Test for this subject
          </a>
        ` : ''}
      `;
      summary.scrollIntoView({ behavior: 'smooth', block: 'center' });

      // ---------- Review Mock Test: re-opens the SAME full-screen mock
      // test block, one question per screen with Previous/Next, but in
      // review mode — shows your pick vs the correct answer for every
      // question from this attempt, in original test order. No category
      // filter — all questions, one pass. ----------
      const reviewBtn = document.getElementById('mt-review-btn');
      if (reviewBtn) {
        reviewBtn.addEventListener('click', () => {
          openMtReview();
        });
      }
    }

    function openMtReview() {
      mtReviewMode = true;
      mtCurrentPos = 0;
      openMockTestOverlay();
      renderMtReviewQuestion();
    }

    function renderMtReviewQuestion() {
      const idx = mtOrder[mtCurrentPos];
      const f = mtAnswers[idx];
      const pick = mtSelections[idx];
      const isMcq = f && f.type === 'mcq' && f.options;

      mtProgressText.textContent = `Reviewing ${mtCurrentPos + 1} of ${mtOrder.length}`;
      mtTimerText.textContent = 'Review';

      let bodyHtml = `
        <div class="mt-q-num">Q${mtCurrentPos + 1}</div>
        <div class="mt-q-text">${escapeHtml(formatMath(questions[idx]))}</div>
      `;

      if (isMcq) {
        const optsHtml = Object.keys(f.options).map((letter) => {
          const isCorrectLetter = letter === f.answer;
          const isPick = letter === pick;
          let cls = 'opt-row';
          let icon = '';
          if (isCorrectLetter) {
            cls += ' opt-row-correct';
            icon = '<span class="opt-icon opt-icon-correct"><i class="ti ti-check" aria-hidden="true"></i></span>';
          } else if (isPick) {
            cls += ' opt-row-wrong';
            icon = '<span class="opt-icon opt-icon-wrong"><i class="ti ti-x" aria-hidden="true"></i></span>';
          }
          return `<div class="${cls}"><span class="opt-badge">${letter.toLowerCase()}</span><span class="opt-text">${escapeHtml(formatMath(f.options[letter]))}</span>${icon}</div>`;
        }).join('');
        bodyHtml += `<div class="opt-list" style="display:flex; flex-direction:column; gap:6px;">${optsHtml}</div>`;
        if (!pick) {
          bodyHtml += `<p style="margin:10px 0 0; font-size:13px; color:var(--muted);">You did not attempt this question.</p>`;
        }
      }

      mtBody.innerHTML = bodyHtml;
      mtPrevBtn.disabled = mtCurrentPos === 0;
      mtPrevBtn.style.display = '';
      const isLast = mtCurrentPos === mtOrder.length - 1;
      mtNextBtn.style.display = isLast ? 'none' : '';
      mtSubmitBtn.style.display = isLast ? '' : 'none';
      mtSubmitBtn.textContent = 'Finish Review';
    }

    if (startMockTestBtn) {
      startMockTestBtn.addEventListener('click', async () => {
        const isPurchased = await withButtonLoading(startMockTestBtn, () => ensureEntitlementChecked());

        mtSelections = {};
        mtAnswers = {};
        mtCurrentPos = 0;
        mtTrialBlocked = false;
        mtReviewMode = false;
        if (mtSubmitBtn) mtSubmitBtn.textContent = 'Submit Test';

        if (isPurchased) {
          mtTrialMode = false;
          const answers = await fetchAllAnswersForMockTest();
          if (!answers) {
            if (window.showToast) window.showToast('Could not load mock test. Please try again.', 'error');
            return;
          }
          mtAnswers = answers;
          // Fix #3: same chapter's questions, reordered randomly per attempt.
          mtOrder = shuffleArray(Object.keys(answers).map(Number));
        } else {
          // Fix: free trial mock test for guests/non-purchased users — first
          // 10 questions only, shuffled, each answer metered by the same
          // free-click quota as normal reading (no bulk fetch, no bypass).
          //
          // Bug fix: if the person already used some free clicks reading
          // casually before starting the trial, promising a fixed 10
          // questions would silently die mid-test once the real daily
          // quota ran out. Clamp the trial size to whatever's ACTUALLY
          // left (from the server's own `remaining` count) so what's shown
          // upfront is honest and the test never ends unexpectedly.
          mtTrialMode = true;

          if (limitReached || knownRemainingClicks === 0) {
            showLimitReached(DAILY_LIMIT_MESSAGE);
            return;
          }

          const availableClicks = knownRemainingClicks === null ? TRIAL_QUESTION_COUNT : knownRemainingClicks;
          const trialCount = Math.min(TRIAL_QUESTION_COUNT, totalQuestions, availableClicks);

          if (trialCount <= 0) {
            showLimitReached(DAILY_LIMIT_MESSAGE);
            return;
          }

          mtOrder = shuffleArray(
            Array.from({ length: trialCount }, (_, i) => i)
          );
        }

        const totalSeconds = mtOrder.length * SECONDS_PER_QUESTION;

        // Brief starting transition — gives the mode-switch a moment to
        // register instead of jumping straight into a running timer.
        const startingOverlay = document.getElementById('mt-starting-overlay');
        const startingTitle = document.querySelector('.mt-starting-title');
        const startingSub = document.getElementById('mt-starting-sub');
        mtAttemptCount++;
        if (startingTitle) {
          startingTitle.textContent = mtTrialMode
            ? 'Free Trial Mock Test Starting\u2026'
            : (mtAttemptCount > 1 ? `Ready for Attempt #${mtAttemptCount}\u2026` : 'Mock Test Starting\u2026');
        }
        if (startingSub) {
          startingSub.textContent = mtTrialMode
            ? `${mtOrder.length} questions \u00b7 uses your free-click quota \u00b7 ${mtFormatTime(totalSeconds)} on the clock`
            : `${mtOrder.length} questions \u00b7 ${mtFormatTime(totalSeconds)} on the clock`;
        }
        if (startingOverlay) startingOverlay.classList.add('active');

        setTimeout(() => {
          if (startingOverlay) startingOverlay.classList.remove('active');
          openMockTestOverlay();
          renderMtQuestion();
          startMtTimer(totalSeconds);
        }, 1200);
      });
    }

    const scoreCloseBtn = document.getElementById('rt-score-close');
    if (scoreCloseBtn) {
      scoreCloseBtn.addEventListener('click', () => {
        const summary = document.getElementById('rt-score-summary');
        if (summary) summary.style.display = 'none';
      });
    }

    // ---------- Question Paper Pattern & Weightage accordion: opens for
    // everyone on click (teaser), but the actual numbers (question counts,
    // percentages) are blurred for non-purchased users — subject/topic
    // names stay fully readable as a hook, only the figures themselves
    // are gated behind purchase. Inline accordion, not a popup, so it
    // doesn't visually compete with the reading toolbar right below it.
    const pwToggle = document.getElementById('pw-accordion-toggle');
    const pwBody = document.getElementById('pw-accordion-body');
    const pwChevron = pwToggle ? pwToggle.querySelector('.pw-accordion-chevron') : null;
    let pwLoaded = false;

    if (pwToggle && pwBody && Array.isArray(weightage) && weightage.length > 0) {
      pwToggle.addEventListener('click', async () => {
        const isOpen = pwBody.style.display === 'block';
        if (isOpen) {
          pwBody.style.display = 'none';
          pwToggle.setAttribute('aria-expanded', 'false');
          if (pwChevron) pwChevron.style.transform = '';
          return;
        }

        pwBody.style.display = 'block';
        pwToggle.setAttribute('aria-expanded', 'true');
        if (pwChevron) pwChevron.style.transform = 'rotate(180deg)';

        if (!pwLoaded) {
          await renderPatternWeightage();
          pwLoaded = true;
        }
      });
    }

    async function renderPatternWeightage() {
      const content = document.getElementById('pw-accordion-content');
      if (!content) return;

      const unlocked = await ensureEntitlementChecked();
      const numClass = unlocked ? 'rt-weightage-num' : 'rt-weightage-num rt-weightage-num-blurred';

      const rows = weightage.map((w) => {
        const breakdownHtml = Array.isArray(w.breakdown) && w.breakdown.length > 0
          ? `<div class="rt-weightage-breakdown">${w.breakdown.map((b) =>
              `<div class="rt-weightage-breakdown-row"><span>${b.name}</span><span class="${numClass}">${b.questions}</span></div>`
            ).join('')}</div>`
          : '';
        return `
          <div class="rt-weightage-row">
            <div class="rt-weightage-row-head">
              <span class="rt-weightage-subject">${w.subject}</span>
              <span class="rt-weightage-count ${numClass}">${w.questions} Qs &middot; ${w.percentage}%</span>
            </div>
            ${breakdownHtml}
          </div>
        `;
      }).join('');

      const unlockCta = unlocked ? '' : `
        <div class="rt-weightage-unlock">
          <p>Unlock exact question counts and percentage weightage for every subject</p>
          <a href="/plans/?highlight=${encodeURIComponent(subject)}" class="rt-btn rt-btn-accent">Unlock ${subjectAccessDays} days, Rs. 199</a>
        </div>
      `;

      content.innerHTML = `${rows}${unlockCta}`;
    }

    function showScoreSummary() {
      const summary = document.getElementById('rt-score-summary');
      const content = document.getElementById('rt-score-content');
      if (!summary || !content) return;

      let correct = 0, wrong = 0, mcqRevealed = 0;
      Object.keys(revealedAnswers).forEach((key) => {
        const idx = parseInt(key);
        const f = revealedAnswers[idx];
        const isMcq = f && f.type === 'mcq' && f.options;
        if (!isMcq) return;
        mcqRevealed++;
        const pick = userSelections[idx];
        if (!pick) return;
        if (pick === f.answer) correct++; else wrong++;
      });

      if (mcqRevealed === 0) {
        summary.style.display = 'block';
        content.innerHTML = `
          <p class="rt-score-title">Your progress</p>
          <div style="text-align:center;">
            <div class="rt-score-num">${answeredSet.size}/${totalQuestions}</div>
            <div class="rt-score-label">questions reviewed</div>
          </div>
        `;
        return;
      }

      const notAttempted = mcqRevealed - correct - wrong;
      summary.style.display = 'block';
      content.innerHTML = `
        <p class="rt-score-title">Your score (revealed questions)</p>
        <div class="rt-stat-grid">
          <div class="rt-stat-box rt-stat-box-correct">
            <div class="rt-stat-num">${correct}</div>
            <div class="rt-stat-label">Correct</div>
          </div>
          <div class="rt-stat-box rt-stat-box-wrong">
            <div class="rt-stat-num">${wrong}</div>
            <div class="rt-stat-label">Wrong</div>
          </div>
          <div class="rt-stat-box rt-stat-box-notattempted">
            <div class="rt-stat-num">${notAttempted}</div>
            <div class="rt-stat-label">Not attempted</div>
          </div>
        </div>
      `;
    }

    // ---------- Filter: all / unanswered / wrong ----------
    // "Wrong" can only check questions that have actually been revealed
    // (we have no local answer key for unrevealed ones).
    async function applyFilter() {
      const filterSelect = document.getElementById('rt-filter');
      const mode = filterSelect ? filterSelect.value : 'all';
      const pag = document.getElementById('pagination');

      if (mode !== 'all') {
        filterSelect.disabled = true;
        const ok = await ensureEntitlementChecked();
        filterSelect.disabled = false;
        if (!ok) {
          filterSelect.value = 'all';
          showLimitReached('Filtering by unanswered/wrong is a premium feature. Purchase this subject to unlock it.');
          return;
        }
      }

      if (mode === 'all') {
        if (pag) pag.style.display = '';
        list.querySelectorAll('.faq-item').forEach((item) => {
          item.classList.remove('rt-hidden');
        });
        showPage(currentPage);
        return;
      }

      if (pag) pag.style.display = 'none';
      let matchCount = 0;
      list.querySelectorAll('.faq-item').forEach((item) => {
        const i = parseInt(item.getAttribute('data-i'));
        let show = true;
        if (mode === 'unanswered') show = !answeredSet.has(i);
        else if (mode === 'wrong') {
          const f = revealedAnswers[i];
          const isMcq = f && f.type === 'mcq' && f.options;
          show = isMcq && userSelections[i] && userSelections[i] !== f.answer;
        }
        item.style.display = show ? 'block' : 'none';
        item.classList.toggle('rt-hidden', !show);
        if (show) matchCount++;
      });

      const modeLabel = mode === 'unanswered' ? 'unanswered' : 'wrong-answer';
      showLocalToast(`Showing ${matchCount} ${modeLabel} question${matchCount === 1 ? '' : 's'}`);
    }
    const filterSelect = document.getElementById('rt-filter');
    if (filterSelect) filterSelect.addEventListener('change', applyFilter);

    // ---------- Jump to question ----------
    const jumpInput = document.getElementById('rt-jump-input');
    const jumpBtn = document.getElementById('rt-jump-btn');
    async function jumpToQuestion() {
      const n = parseInt(jumpInput.value);
      if (!n || n < 1 || n > totalQuestions) return;

      const ok = await withButtonLoading(jumpBtn, () => ensureEntitlementChecked());
      if (!ok) {
        showLimitReached('Jump to question is a premium feature. Purchase this subject to unlock it.');
        return;
      }

      if (filterSelect && filterSelect.value !== 'all') {
        filterSelect.value = 'all';
        applyFilter();
        showLocalToast(`Filter cleared to jump to Q${n}`);
      }

      const targetIndex = n - 1;
      const targetPage = Math.floor(targetIndex / perPage) + 1;
      if (targetPage !== currentPage) showPage(targetPage);
      setTimeout(() => {
        const item = list.querySelector(`.faq-item[data-i="${targetIndex}"]`);
        if (item) {
          item.scrollIntoView({ behavior: 'smooth', block: 'center' });
          item.style.transition = 'box-shadow 0.3s ease';
          item.style.boxShadow = '0 0 0 2px var(--accent)';
          setTimeout(() => { item.style.boxShadow = ''; }, 1200);
        }
      }, 100);
    }
    if (jumpBtn) jumpBtn.addEventListener('click', jumpToQuestion);
    if (jumpInput) jumpInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') jumpToQuestion(); });

    // ---------- Options toggle (collapsed by default) ----------
    // Only auto-closes when moving to a different page (see showPage) —
    // stays open through filter/text-size/jump selections and clicks
    // elsewhere on the page.
    const optionsToggle = document.getElementById('rt-options-toggle');
    const controlsSection = document.getElementById('rt-controls-section');

    function closeOptionsPanel() {
      if (!controlsSection || !optionsToggle) return;
      controlsSection.style.display = 'none';
      optionsToggle.setAttribute('aria-expanded', 'false');
    }

    if (optionsToggle && controlsSection) {
      optionsToggle.addEventListener('click', () => {
        const isOpen = controlsSection.style.display === 'flex';
        controlsSection.style.display = isOpen ? 'none' : 'flex';
        optionsToggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    // ---------- Font size control ----------
    // UX TOGGLE: set to false to disable auto-scroll on reveal, reverting
    // to plain in-place opening — single flag, no other code changes.
    const contentEl = document.querySelector('.content');
    document.querySelectorAll('.rt-font-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.rt-font-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (contentEl) contentEl.setAttribute('data-font-size', btn.getAttribute('data-size'));
      });
    });

    updateProgress();
    renderPagination();
    loadAndRenderPublicOptions();
  </script>
  )}
</Layout>
