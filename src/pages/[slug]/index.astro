---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

export function getStaticPaths() {
  // Matches src/data/<any-subject-folder>/*.json - no subject names hardcoded.
  const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });

  const chapters = Object.entries(chapterFiles).flatMap(([path, mod]) => {
    const subject = path.split('/').slice(-2, -1)[0];
    const items = Array.isArray(mod.default) ? mod.default : [mod.default];

    return items
      .filter(
        (ch) =>
          ch &&
          ch.slug &&
          ch.chapterNumber &&
          (Array.isArray(ch.faqs) || (ch.type === 'reference' && Array.isArray(ch.articles)))
      )
      .map((ch) => ({ ...ch, subject }));
  });

  return chapters.map((ch) => {
    const isReference = ch.type === 'reference';

    if (isReference) {
      // Reference chapters (e.g. Polity Articles & Amendments quick-lookup)
      // are always free to browse — no paywall, no D1/Worker call, no
      // login required. Articles/amendments are static lookup data, not
      // graded answers, so there is nothing here that needs gating.
      return {
        params: { slug: ch.slug },
        props: {
          chapterSlug: ch.slug,
          subject: ch.subject,
          chapterNumber: ch.chapterNumber,
          title: ch.title,
          isReference: true,
          articles: ch.articles || [],
          amendments: ch.amendments || [],
          questions: [],
          // Per-tab search placeholders. Each chapter JSON can override
          // either or both explicitly; unset ones fall back to a sensible
          // generic default here so Articles and Amendments never share
          // the same hint text.
          articlesSearchPlaceholder: ch.articlesSearchPlaceholder || 'Search by article number or word',
          amendmentsSearchPlaceholder: ch.amendmentsSearchPlaceholder || 'Search by amendment number, year, or word',
        },
      };
    }

    return {
      params: { slug: ch.slug },
      // SECURITY: only question text (ch.faqs[].q) is passed as props.
      // Answer text, explanations, and tables are NEVER included here —
      // they live only in D1's chapter_content table, served by the Worker
      // after a real session + entitlement check. Do not add f.a, f.e, or
      // f.table to this props object.
      props: {
        chapterSlug: ch.slug,
        subject: ch.subject,
        chapterNumber: ch.chapterNumber,
        title: ch.title,
        isReference: false,
        articles: [],
        amendments: [],
        questions: ch.faqs.map((f) => f.q),
        // Subject-wise weightage breakdown for previous-papers chapters.
        // Not sensitive like answers — it's aggregate stats, not a graded
        // response — but display is still gated to purchased users only
        // via ensureEntitlementChecked(), zero free clicks.
        weightage: ch.weightage || [],
      },
    };
  });
}

const { chapterSlug, subject, chapterNumber, title, questions, isReference, articles, amendments, articlesSearchPlaceholder, amendmentsSearchPlaceholder, weightage } = Astro.props;
const meta = getSubjectMeta(subject);
const isTelugu = meta.lang === 'te';

const backLabel = meta.category === 'papers' ? (isTelugu ? 'ప్రశ్నపత్రాలు' : 'Papers') : (isTelugu ? 'అధ్యాయాలు' : 'Chapters');
const questionsLabel = isTelugu ? 'ప్రశ్నలు' : 'questions';
const prevLabel = isTelugu ? 'మునుపటి' : 'Previous';
const nextLabel = isTelugu ? 'తర్వాత' : 'Next';

const PER_PAGE = 20;
const totalPages = Math.ceil(questions.length / PER_PAGE);

// Converts caret notation (17^203, x^2) into proper Unicode superscripts
// so questions typed/pasted with ^ still render as math, not literal text.
// Display-only — no effect on props shape or security.
const SUP_MAP = { '0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','-':'⁻','+':'⁺' };
function formatMath(str) {
  return String(str).replace(/\^(-?\d+)/g, (_, exp) =>
    exp.split('').map((ch) => SUP_MAP[ch] || ch).join('')
  );
}
---
<Layout title={isReference ? `${title} Reference` : `${title} FAQs`} description={isReference ? `${title} - ${articles.length} articles, ${amendments.length} amendments` : `${title} - ${questions.length} FAQs`}>

  <!-- Desktop keeps the full site header (nav, login, theme toggle) exactly as before.
       Mobile gets the compact reading-mode header — back arrow, chapter title, progress —
       with no bottom tab bar at all while inside a chapter. Both are the SAME <Header />
       component; `compact` is only applied visually under the 720px breakpoint via CSS
       (see .header-desktop-only / .header-compact-only below), so no duplicate session
       logic and no extra network calls. -->
  <div class="header-desktop-only">
    <Header active="subjects" />
  </div>
  <div class="header-compact-only">
    <Header compact={true} backHref={`/${subject}/`} title={`${chapterNumber}. ${title}`} progress={isReference ? `${articles.length} articles, ${amendments.length} amendments` : `${questions.length} ${questionsLabel}`} />
  </div>

  <div class={isTelugu ? 'lang-te content' : 'lang-en content'}>
    <a href={`/${subject}/`} class="back-pill desktop-back-pill">&larr; {backLabel}</a>
    <div class="desktop-title-block" style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;">
      <h1 style="margin:0;">{chapterNumber}. {title}</h1>
      <span style="font-size:14px; font-weight:700; color:var(--text);">{isReference ? `${articles.length} articles, ${amendments.length} amendments` : `${questions.length} ${questionsLabel}`}</span>
    </div>

    {isReference ? (
      <Fragment>
        <p style="font-size:13px; color:var(--muted); margin:6px 0 0;">Quick reference &middot; Always free to browse</p>

        <div class="ref-tabs">
          <div class="ref-tab active" data-tab="articles">Articles</div>
          <div class="ref-tab" data-tab="amendments">Amendments</div>
        </div>

        <div class="ref-search">
          <input type="text" id="refSearchInput" placeholder={articlesSearchPlaceholder} style="border:none; outline:none; background:transparent; font-size:14px; color:var(--text); width:100%; font-family:inherit;" />
        </div>
        <p class="ref-count" id="refResultCount" style="font-size:12px; color:var(--muted); margin:8px 0 0 2px;"></p>

        <div id="refListContainer"></div>
      </Fragment>
    ) : (
      <Fragment>
        {weightage && weightage.length > 0 && (
          <div id="pattern-weightage-accordion" class="pw-accordion">
            <button type="button" id="pw-accordion-toggle" class="pw-accordion-toggle" aria-expanded="false">
              <span class="pw-accordion-label">
                <i class="ti ti-chart-pie" aria-hidden="true"></i>
                Question Paper Pattern &amp; Subject Weightage
              </span>
              <i class="ti ti-chevron-down pw-accordion-chevron" aria-hidden="true"></i>
            </button>
            <div id="pw-accordion-body" class="pw-accordion-body" style="display:none;">
              <div id="pw-accordion-content"></div>
            </div>
          </div>
        )}

        <div id="reading-toolbar" class="reading-toolbar">
          <div class="rt-progress-section">
            <div class="rt-progress-wrap">
              <div class="rt-progress-track"><div id="rt-progress-fill" class="rt-progress-fill"></div></div>
              <span id="rt-progress-text" class="rt-progress-text">0 of {questions.length} answered</span>
            </div>
            <div class="rt-action-group">
              <button type="button" id="rt-reveal-all" class="rt-btn rt-btn-accent">
                <i class="ti ti-eye" aria-hidden="true"></i> <span id="rt-reveal-all-label">Reveal All Answers</span>
              </button>
              {meta.category !== 'papers' && (
                <button type="button" id="rt-start-mocktest" class="rt-btn rt-btn-ghost">
                  <i class="ti ti-clock-play" aria-hidden="true"></i> Mock Test
                </button>
              )}
            </div>
          </div>

          <button type="button" id="rt-options-toggle" class="rt-options-toggle" aria-expanded="false">
            <span><i class="ti ti-adjustments-horizontal" aria-hidden="true"></i> Text size, filter &amp; jump</span>
            <i class="ti ti-chevron-down rt-options-chevron" aria-hidden="true"></i>
          </button>

          <div class="rt-controls-section" id="rt-controls-section" style="display:none;">
            <div class="rt-control-item">
              <span class="rt-control-label"><i class="ti ti-text-size" aria-hidden="true"></i> Text size</span>
              <div class="rt-font-group">
                <button type="button" class="rt-font-btn" data-size="small">A</button>
                <button type="button" class="rt-font-btn active" data-size="medium">A</button>
                <button type="button" class="rt-font-btn" data-size="large">A</button>
              </div>
            </div>

            <div class="rt-control-item">
              <span class="rt-control-label"><i class="ti ti-filter" aria-hidden="true"></i> Filter</span>
              <select id="rt-filter" class="rt-select">
                <option value="all">Show all</option>
                <option value="unanswered">Unanswered only</option>
                <option value="wrong">Wrong answers only</option>
              </select>
            </div>

            <div class="rt-control-item">
              <span class="rt-control-label"><i class="ti ti-map-pin" aria-hidden="true"></i> Jump to</span>
              <div class="rt-jump-group">
                <input type="number" id="rt-jump-input" class="rt-jump-input" placeholder="Q#" min="1" max={questions.length} />
                <button type="button" id="rt-jump-btn" class="rt-btn rt-btn-ghost rt-btn-small">Go</button>
              </div>
            </div>
          </div>
        </div>

        <div id="rt-score-summary" class="rt-score-summary" style="display:none;">
          <button type="button" id="rt-score-close" class="rt-score-close" aria-label="Close score summary">
            <i class="ti ti-x" aria-hidden="true"></i>
          </button>
          <div id="rt-score-content"></div>
        </div>

        <div class="rt-sticky-bar"><div id="rt-sticky-fill" class="rt-sticky-fill"></div></div>

        <div id="rt-confirm-overlay" class="rt-confirm-overlay" style="display:none;">
          <div class="rt-confirm-box">
            <p id="rt-confirm-message" class="rt-confirm-message"></p>
            <div class="rt-confirm-actions">
              <button type="button" id="rt-confirm-cancel" class="rt-btn">Keep practicing</button>
              <button type="button" id="rt-confirm-ok" class="rt-btn rt-btn-accent-solid"></button>
            </div>
          </div>
        </div>

        <div id="rt-toast" class="rt-toast" style="display:none;"></div>

        <!-- Daily-limit / paywall popup: real gating unchanged (same IDs,
             same showLimitReached()/showRemainingHint() logic below) — only
             the presentation changed from an inline banner to a blurred
             modal overlay, matching the confirm-popup style above. -->
        <div id="lock-banner" class="lock-overlay" style="display:none;">
          <div class="lock-modal">
            <button type="button" id="lock-close" class="lock-close" aria-label="Close">
              <i class="ti ti-x" aria-hidden="true"></i>
            </button>
            <p id="lock-message" class="lock-message">Purchase this subject for {meta.category === 'papers' ? 365 : 45} days of unlimited access.</p>
            <a id="lock-action" href="/plans/" class="rt-btn rt-btn-accent-solid lock-action">View plans</a>
          </div>
        </div>

        <div id="mt-starting-overlay" class="mt-starting-overlay">
          <i class="ti ti-clock-play mt-starting-icon" aria-hidden="true"></i>
          <div class="mt-starting-title">Mock Test Starting&hellip;</div>
          <div class="mt-starting-sub" id="mt-starting-sub"></div>
        </div>

        <!-- Mock Test: full-screen overlay, one question at a time, timer,
             paid-users only. Separate exit-confirm popup reused for both
             back-button/back-gesture and "Reveal all" tapped mid-test. -->
        <div id="mt-overlay" class="mt-overlay">
          <div class="mt-topbar">
            <div class="mt-timer"><i class="ti ti-clock" aria-hidden="true"></i> <span id="mt-timer-text">00:00</span></div>
            <div class="mt-progress" id="mt-progress-text">Question 1 of 1</div>
            <button type="button" id="mt-exit-btn" class="mt-exit-btn">Exit</button>
          </div>
          <div class="mt-body" id="mt-body"></div>
          <div class="mt-footer">
            <button type="button" id="mt-prev-btn" class="mt-nav-btn">Previous</button>
            <button type="button" id="mt-next-btn" class="mt-nav-btn">Next</button>
            <button type="button" id="mt-submit-btn" class="mt-nav-btn mt-submit-btn" style="display:none;">Submit Test</button>
          </div>
        </div>

        <div id="mt-exit-overlay" class="rt-confirm-overlay" style="display:none;">
          <div class="rt-confirm-box">
            <p class="rt-confirm-message">Exit mock test? Your progress on this attempt will be lost.</p>
            <div class="rt-confirm-actions">
              <button type="button" id="mt-exit-cancel" class="rt-btn">Keep testing</button>
              <button type="button" id="mt-exit-confirm" class="rt-btn rt-btn-accent-solid">Exit &amp; show score</button>
            </div>
          </div>
        </div>

        <div id="faq-list" class="faq-list" style="margin-top:20px;">
          {questions.map((q, i) => (
            <div class="faq-item" data-i={i} data-page={Math.floor(i / PER_PAGE) + 1} style={i >= PER_PAGE ? 'display:none;' : ''}>
              <div class="q-row" data-i={i}>
                <span class="q-num">{i + 1}.</span>
                <span class="q-text">{formatMath(q)}</span>
                <i class="ti ti-chevron-down q-chev" aria-hidden="true"></i>
              </div>
              <div class="mcq-preview" data-i={i} style="display:none; padding:0 16px 14px;"></div>
              <div class="a-row" data-i={i} style="display:none;"></div>
            </div>
          ))}
        </div>

        <div id="pagination" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:20px;"></div>
      </Fragment>
    )}
  </div>

  <style is:global>
    /* ---------- Header display split: full header on desktop,
       compact reading header on mobile. No duplicate Header instances
       execute session logic twice — CSS just decides which markup shows. ---------- */
    .header-compact-only { display: none; }
    .desktop-back-pill { display: inline-flex; }
    .desktop-title-block { display: flex; }
    @media (max-width: 720px) {
      .header-desktop-only { display: none; }
      .header-compact-only { display: block; }
      .desktop-back-pill { display: none !important; }
      .desktop-title-block { display: none !important; }
    }

    .back-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 5px 12px 5px 8px;
      margin-bottom: 14px;
    }

    /* ---------- Locked capsule card design, matched from the proofreader
       reference tool: white card, 1px border, 14px radius, red-brown
       question numbering, chevron that flips on expand. ---------- */
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .faq-item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      position: relative;
    }
    .q-row {
      cursor: pointer;
      padding: 16px 46px 16px 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      position: relative;
    }
    .q-num {
      color: #B8341C;
      font-weight: 700;
      font-size: 15px;
      min-width: 24px;
      flex-shrink: 0;
    }
    html[data-theme="dark"] .q-num {
      color: #e08a70;
    }
    .q-text {
      font-size: 16px;
      line-height: 1.5;
      flex: 1;
      margin-bottom: 4px; /* small breather below multi-line stems before the divider */
      white-space: pre-wrap; /* preserves \n line breaks in multi-line
                                 question stems, e.g. (I)/(II)/(III)
                                 statement-based questions */
    }
    .q-chev {
      position: absolute;
      right: 14px;
      top: 18px;
      font-size: 15px;
      color: var(--muted);
    }
    .faq-item.open .q-chev {
      transform: rotate(180deg);
    }
    .a-row {
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--card) 92%, var(--bg) 8%);
      padding: 14px 16px;
    }

    /* ---------- Rich MCQ option rows ---------- */
    .opt-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.1s ease;
    }
    .opt-row.opt-clickable { cursor: pointer; }
    .opt-row.opt-clickable:active { transform: scale(0.985); }
    .opt-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      color: var(--accent);
      font-weight: 700;
      font-size: 13px;
      flex-shrink: 0;
    }
    .opt-text { flex: 1; }
    .opt-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      flex-shrink: 0;
      font-size: 13px;
    }
    .opt-row-correct {
      background: var(--success-bg);
      border-color: var(--success-text);
      font-weight: 700;
    }
    .opt-row-correct .opt-badge { background: var(--success-text); color: #fff; }
    .opt-icon-correct { background: var(--success-text); color: #fff; }
    .opt-row-wrong {
      background: var(--amber-bg);
      border-color: #c0392b;
      font-weight: 700;
    }
    .opt-row-wrong .opt-badge { background: #c0392b; color: #fff; }
    .opt-icon-wrong { background: #c0392b; color: #fff; }

    /* Mobile font reduction — English chapters only. Telugu chapters
       (.lang-te) are untouched so Telugu font sizing stays exactly as-is. */
    @media (max-width: 640px) {
      .lang-en h1 { font-size: 19px !important; }
      .lang-en .q-text { font-size: 15px !important; font-weight: 400 !important; }
      .lang-en .opt-badge,
      .lang-en .opt-text { font-size: 14px !important; }
      .lang-en .answer-text { font-size: 14px !important; font-weight: 600 !important; }
      .lang-en .expl-text { font-size: 14px !important; }
      .lang-en .expl-toggle { font-size: 12px !important; }
      .lang-te .q-text { font-weight: 400 !important; }
    }

    /* No visual color change on question tap at all — only the green answer
       reveal below should show. Mobile browsers apply a default blue
       tap-highlight flash on any clickable element unless explicitly
       disabled; this removes it completely. */
    .faq-item,
    .q-row {
      -webkit-tap-highlight-color: transparent !important;
      tap-highlight-color: transparent !important;
      touch-action: manipulation;
      outline: none !important;
      -webkit-user-select: none;
      user-select: none;
    }
    .q-row:focus,
    .q-row:hover,
    .faq-item:focus {
      outline: none !important;
    }

    /* ---------- Reference chapter UI (Articles & Amendments) ----------
       Free-to-browse quick lookup, no paywall, no D1/Worker involvement.
       Ported as-is from the reference-mode build so styling matches. */
    .ref-tabs {
      display: flex;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 4px;
      gap: 4px;
      margin-top: 16px;
    }
    .ref-tab {
      flex: 1;
      text-align: center;
      padding: 10px 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--muted);
      border-radius: 9px;
      cursor: pointer;
      user-select: none;
    }
    .ref-tab.active { background: var(--accent); color: #fff; }

    .ref-search {
      display: flex;
      align-items: center;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px;
      gap: 8px;
      margin-top: 12px;
    }
    .ref-search input::placeholder { color: var(--muted); }

    .ref-group-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--accent);
      margin: 20px 2px 8px;
    }
    .ref-group-label:first-of-type { margin-top: 16px; }

    .ref-entry-list { display: flex; flex-direction: column; gap: 10px; }
    .ref-entry {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
    }
    .ref-badge {
      flex-shrink: 0;
      min-width: 38px;
      height: 28px;
      background: var(--accent-bg);
      color: var(--accent);
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12.5px;
      font-weight: 700;
      padding: 0 6px;
    }
    .ref-entry-body { flex: 1; min-width: 0; }
    .ref-entry-title { font-size: 14.5px; line-height: 1.4; color: var(--text); }
    .ref-entry-title.repealed {
      color: var(--muted);
      text-decoration: line-through;
      text-decoration-color: var(--muted);
    }
    .ref-entry-meta { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
    .ref-repealed-tag {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--muted);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 1px 6px;
      margin-left: 6px;
    }
    .ref-empty { text-align: center; padding: 50px 20px; color: var(--muted); font-size: 13px; }

    @media (min-width: 720px) {
      .ref-entry-list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .ref-group-label { grid-column: 1 / -1; }
    }
    /* ---------- Question Paper Pattern & Weightage accordion.
       Deliberately styled DIFFERENT from .reading-toolbar (light card,
       accent border, subtle icon) rather than the same dark gradient —
       two visually identical dark cards stacked back to back reads as
       one confusing block, not two distinct features. This one sits
       above the toolbar and closes itself once opened once, so there's
       no visual redundancy competing with Reveal All / Mock Test. */
    .pw-accordion {
      background: var(--card);
      border: 1px solid var(--accent);
      border-radius: 14px;
      margin-top: 16px;
      overflow: hidden;
    }
    .pw-accordion-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      background: none;
      border: none;
      padding: 14px 16px;
      cursor: pointer;
      font-family: inherit;
      text-align: left;
    }
    .pw-accordion-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
    }
    .pw-accordion-label i {
      font-size: 17px;
      color: var(--accent);
    }
    .pw-accordion-chevron {
      font-size: 16px;
      color: var(--muted);
      transition: transform 0.15s ease;
      flex-shrink: 0;
    }
    .pw-accordion-body {
      padding: 0 16px 16px;
      border-top: 1px solid var(--border);
    }
    .pw-accordion-body #pw-accordion-content {
      padding-top: 14px;
    }

