---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

export function getStaticPaths() {
  const chapterFiles = import.meta.glob('../../data/*.json', { eager: true });

  const chapters = Object.values(chapterFiles)
    .flatMap((mod) => (Array.isArray(mod.default) ? mod.default : [mod.default]))
    .filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber);

  return chapters.map((ch) => ({
    params: { slug: ch.slug },
    props: { chapter: ch }
  }));
}

const { chapter } = Astro.props;
const PER_PAGE = 20;
const totalPages = Math.ceil(chapter.faqs.length / PER_PAGE);
---
<Layout title={`${chapter.title} FAQs`} description={`${chapter.title} - తెలంగాణ చరిత్ర ప్రశ్నలు`}>

  <Header />

  <div class="content">
    <a href="/telangana-history-te/" style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--muted); text-decoration:none; border:1px solid var(--border); border-radius:20px; padding:5px 12px 5px 8px; margin-bottom:14px;">&larr; అధ్యాయాలు</a>
    <div style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;">
      <h1 style="margin:0;">{chapter.chapterNumber}. {chapter.title}</h1>
      <span style="font-size:14px; font-weight:700; color:var(--text);">{chapter.faqs.length} ప్రశ్నలు</span>
    </div>

    <div id="faq-list" style="display:flex; flex-direction:column; gap:8px; margin-top:20px;"></div>

    <div id="pagination" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:20px;"></div>
  </div>

  <script define:vars={{ faqs: chapter.faqs, perPage: PER_PAGE }}>
    let currentPage = 1;
    const totalPages = Math.ceil(faqs.length / perPage);

    function renderPage(page) {
      currentPage = page;
      const start = (page - 1) * perPage;
      const pageFaqs = faqs.slice(start, start + perPage);
      const list = document.getElementById('faq-list');

      list.innerHTML = pageFaqs.map((f, i) => `
        <div style="border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--card);">
          <div class="q-row" data-i="${start + i}" style="cursor:pointer; padding:16px 18px; display:flex; justify-content:space-between; gap:10px;">
            <span style="font-size:18px; line-height:1.6;">${start + i + 1}. ${f.q}</span>
            <span style="color:var(--muted); flex-shrink:0; font-size:18px;">&darr;</span>
          </div>
          <div class="a-row" data-i="${start + i}" style="display:none; padding:0 18px 18px;">
            <div style="background:var(--success-bg); border-radius:8px; padding:14px 16px;">
              <p style="margin:0; font-weight:700; color:var(--success-text); font-size:19px;">${f.a}</p>
              ${f.e ? `<p style="margin:8px 0 0; font-size:15px; color:var(--muted);">${f.e}</p>` : ''}
            </div>
          </div>
        </div>
      `).join('');

      list.querySelectorAll('.q-row').forEach((row) => {
        row.addEventListener('click', () => {
          const i = row.getAttribute('data-i');
          const a = list.querySelector(`.a-row[data-i="${i}"]`);
          const isOpen = a.style.display === 'block';
          list.querySelectorAll('.a-row').forEach((el) => el.style.display = 'none');
          a.style.display = isOpen ? 'none' : 'block';
        });
      });

      renderPagination();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderPagination() {
      const pag = document.getElementById('pagination');
      if (totalPages <= 1) { pag.innerHTML = ''; return; }
      const btnStyle = 'min-width:36px; height:36px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:var(--card); color:var(--text); font-size:14px; cursor:pointer;';
      let html = `<button ${currentPage === 1 ? 'disabled' : ''} id="prev-btn" style="${btnStyle}">మునుపటి</button>`;
      for (let p = 1; p <= totalPages; p++) {
        html += `<button data-page="${p}" style="${btnStyle} ${p === currentPage ? 'border-color:var(--accent); color:var(--accent); font-weight:700;' : ''}">${p}</button>`;
      }
      html += `<button ${currentPage === totalPages ? 'disabled' : ''} id="next-btn" style="${btnStyle}">తర్వాత</button>`;
      pag.innerHTML = html;

      pag.querySelectorAll('button[data-page]').forEach((btn) => {
        btn.addEventListener('click', () => renderPage(parseInt(btn.getAttribute('data-page'))));
      });
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      if (prevBtn) prevBtn.addEventListener('click', () => renderPage(currentPage - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => renderPage(currentPage + 1));
    }

    renderPage(1);
  </script>
</Layout>
