---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

export function getStaticPaths() {
  // Matches src/data/<any-subject-folder>/*.json - no subject names hardcoded.
  const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });

  const chapters = Object.entries(chapterFiles).flatMap(([path, mod]) => {
    const subject = path.split('/').slice(-2, -1)[0];
    const items = Array.isArray(mod.default) ? mod.default : [mod.default];

    return items
      .filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber)
      .map((ch) => ({ ...ch, subject }));
  });

  return chapters.map((ch) => ({
    params: { slug: ch.slug },
    // SECURITY: only question text (ch.faqs[].q) is passed as props.
    // Answer text, explanations, and tables are NEVER included here —
    // they live only in D1's chapter_content table, served by the Worker
    // after a real session + entitlement check. Do not add f.a, f.e, or
    // f.table to this props object.
    props: {
      chapterSlug: ch.slug,
      subject: ch.subject,
      chapterNumber: ch.chapterNumber,
      title: ch.title,
      questions: ch.faqs.map((f) => f.q),
    },
  }));
}

const { chapterSlug, subject, chapterNumber, title, questions } = Astro.props;
const meta = getSubjectMeta(subject);
const isTelugu = meta.lang === 'te';

const backLabel = isTelugu ? 'అధ్యాయాలు' : 'Chapters';
const questionsLabel = isTelugu ? 'ప్రశ్నలు' : 'questions';
const prevLabel = isTelugu ? 'మునుపటి' : 'Previous';
const nextLabel = isTelugu ? 'తర్వాత' : 'Next';

const PER_PAGE = 20;
const totalPages = Math.ceil(questions.length / PER_PAGE);

// Converts caret notation (17^203, x^2) into proper Unicode superscripts
// so questions typed/pasted with ^ still render as math, not literal text.
// Display-only — no effect on props shape or security.
const SUP_MAP = { '0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','-':'⁻','+':'⁺' };
function formatMath(str) {
  return String(str).replace(/\^(-?\d+)/g, (_, exp) =>
    exp.split('').map((ch) => SUP_MAP[ch] || ch).join('')
  );
}
---
<Layout title={`${title} FAQs`} description={`${title} - ${questions.length} FAQs`}>

  <!-- Desktop keeps the full site header (nav, login, theme toggle) exactly as before.
       Mobile gets the compact reading-mode header — back arrow, chapter title, progress —
       with no bottom tab bar at all while inside a chapter. Both are the SAME <Header />
       component; `compact` is only applied visually under the 720px breakpoint via CSS
       (see .header-desktop-only / .header-compact-only below), so no duplicate session
       logic and no extra network calls. -->
  <div class="header-desktop-only">
    <Header active="subjects" />
  </div>
  <div class="header-compact-only">
    <Header compact={true} backHref={`/${subject}/`} title={`${chapterNumber}. ${title}`} progress={`${questions.length} ${questionsLabel}`} />
  </div>

  <div class={isTelugu ? 'lang-te content' : 'lang-en content'}>
    <a href={`/${subject}/`} class="back-pill desktop-back-pill">&larr; {backLabel}</a>
    <div class="desktop-title-block" style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;">
      <h1 style="margin:0;">{chapterNumber}. {title}</h1>
      <span style="font-size:14px; font-weight:700; color:var(--text);">{questions.length} {questionsLabel}</span>
    </div>

    <div id="lock-banner" style="display:none; background:var(--amber-bg); border:1px solid var(--border); border-radius:8px; padding:14px 16px; margin-top:16px; font-size:14px; color:var(--amber-text-strong);">
      <span id="lock-message">Purchase this subject for 45 days of unlimited access.</span>
      <a id="lock-action" href="/plans/" style="margin-left:8px; font-weight:700; color:var(--accent); text-decoration:underline;">View plans</a>
    </div>

    <div id="faq-list" class="faq-list" style="margin-top:20px;">
      {questions.map((q, i) => (
        <div class="faq-item" data-i={i} data-page={Math.floor(i / PER_PAGE) + 1} style={i >= PER_PAGE ? 'display:none;' : ''}>
          <div class="q-row" data-i={i}>
            <span class="q-num">{i + 1}.</span>
            <span class="q-text">{formatMath(q)}</span>
            <i class="ti ti-chevron-down q-chev" aria-hidden="true"></i>
          </div>
          <div class="a-row" data-i={i} style="display:none;"></div>
        </div>
      ))}
    </div>

    <div id="pagination" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:20px;"></div>
  </div>

  <style is:global>
    /* ---------- Header display split: full header on desktop,
       compact reading header on mobile. No duplicate Header instances
       execute session logic twice — CSS just decides which markup shows. ---------- */
    .header-compact-only { display: none; }
    .desktop-back-pill { display: inline-flex; }
    .desktop-title-block { display: flex; }
    @media (max-width: 720px) {
      .header-desktop-only { display: none; }
      .header-compact-only { display: block; }
      .desktop-back-pill { display: none !important; }
      .desktop-title-block { display: none !important; }
    }

    .back-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 5px 12px 5px 8px;
      margin-bottom: 14px;
    }

    /* ---------- Locked capsule card design, matched from the proofreader
       reference tool: white card, 1px border, 14px radius, red-brown
       question numbering, chevron that flips on expand. ---------- */
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .faq-item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      position: relative;
    }
    .q-row {
      cursor: pointer;
      padding: 16px 46px 16px 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      position: relative;
    }
    .q-num {
      color: #B8341C;
      font-weight: 700;
      font-size: 15px;
      min-width: 24px;
      flex-shrink: 0;
    }
    html[data-theme="dark"] .q-num {
      color: #e08a70;
    }
    .q-text {
      font-size: 16px;
      line-height: 1.5;
      flex: 1;
    }
    .q-chev {
      position: absolute;
      right: 14px;
      top: 18px;
      font-size: 15px;
      color: var(--muted);
    }
    .faq-item.open .q-chev {
      transform: rotate(180deg);
    }
    .a-row {
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--card) 92%, var(--bg) 8%);
      padding: 14px 16px;
    }

    /* Mobile font reduction — English chapters only. Telugu chapters
       (.lang-te) are untouched so Telugu font sizing stays exactly as-is. */
    @media (max-width: 640px) {
      .lang-en h1 { font-size: 19px !important; }
      .lang-en .q-text { font-size: 15px !important; font-weight: 400 !important; }
      .lang-en .opt-letter,
      .lang-en .opt-text { font-size: 14px !important; }
      .lang-en .answer-text { font-size: 14px !important; font-weight: 600 !important; }
      .lang-en .expl-text { font-size: 14px !important; }
      .lang-en .expl-toggle { font-size: 12px !important; }
      .lang-te .q-text { font-weight: 400 !important; }
    }

    /* No visual color change on question tap at all — only the green answer
       reveal below should show. Mobile browsers apply a default blue
       tap-highlight flash on any clickable element unless explicitly
       disabled; this removes it completely. */
    .faq-item,
    .q-row {
      -webkit-tap-highlight-color: transparent !important;
      tap-highlight-color: transparent !important;
      touch-action: manipulation;
      outline: none !important;
      -webkit-user-select: none;
      user-select: none;
    }
    .q-row:focus,
    .q-row:hover,
    .faq-item:focus {
      outline: none !important;
    }
  </style>

  <script define:vars={{ chapterSlug, subject, perPage: PER_PAGE, prevLabel, nextLabel }}>
    const PLANS_URL = `/plans/?highlight=${encodeURIComponent(subject)}`;
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Device fingerprint for the free-click counter: a hash of stable
    // device/browser properties (not stored state), so it survives private/
    // incognito browsing where cookies get wiped on close. UNCHANGED.
    let fingerprintPromise = null;
    async function getFingerprint() {
      if (fingerprintPromise) return fingerprintPromise;
      fingerprintPromise = (async () => {
        try {
          const raw = [
            navigator.userAgent,
            screen.width,
            screen.height,
            Intl.DateTimeFormat().resolvedOptions().timeZone,
            navigator.hardwareConcurrency || '',
          ].join('|');
          const enc = new TextEncoder().encode(raw);
          const digest = await crypto.subtle.digest('SHA-256', enc);
          return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
        } catch (err) {
          return null;
        }
      })();
      return fingerprintPromise;
    }
    getFingerprint();

    let currentPage = 1;
    const revealedAnswers = {};
    let purchased = false;
    let limitReached = false;
    let bulkAnswers = null;

    async function fetchAllAnswersInBackground() {
      try {
        const res = await fetch(
          `${WORKER_URL}/content/chapter-answers?chapter_slug=${encodeURIComponent(chapterSlug)}`,
          { credentials: 'include' }
        );
        if (!res.ok) return;
        const data = await res.json();
        bulkAnswers = data.answers;
      } catch (err) {
        // silently ignore — per-answer fetching still works fine as a fallback
      }
    }

    const list = document.getElementById('faq-list');
    const lockBanner = document.getElementById('lock-banner');
    const lockMessage = document.getElementById('lock-message');
    const lockAction = document.getElementById('lock-action');
    const totalItems = list.querySelectorAll('.faq-item').length;
    const totalPages = Math.ceil(totalItems / perPage);

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    function renderTable(table) {
      const headerHtml = table.headers.map((h) => `<th style="border:1px solid var(--border); padding:6px 10px; text-align:left; background:var(--card); font-weight:700;">${escapeHtml(h)}</th>`).join('');
      const rowsHtml = table.rows.map((row, idx) => `
        <tr style="${idx % 2 === 1 ? 'background:rgba(0,0,0,0.02);' : ''}">
          ${row.map((cell) => `<td style="border:1px solid var(--border); padding:6px 10px;">${escapeHtml(cell)}</td>`).join('')}
        </tr>
      `).join('');
      return `
        <div style="margin-top:12px; overflow-x:auto;">
          ${table.unit ? `<p style="margin:0 0 6px; font-size:13px; color:var(--muted);">${escapeHtml(table.unit)}</p>` : ''}
          <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead><tr>${headerHtml}</tr></thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        </div>
      `;
    }

    const SUP_MAP = { '0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','-':'⁻','+':'⁺' };
    function formatMath(str) {
      return String(str).replace(/\^(-?\d+)/g, (_, exp) =>
        exp.split('').map((ch) => SUP_MAP[ch] || ch).join('')
      );
    }

    const userSelections = {};

    function renderExplanationParagraphs(text) {
      const paragraphs = String(text).split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
      return paragraphs.map((p, idx) => {
        const withBreaks = escapeHtml(formatMath(p)).replace(/\n/g, '<br>');
        const marginBottom = idx < paragraphs.length - 1 ? '10px' : '0';
        return `<p class="expl-text" style="margin:0 0 ${marginBottom}; font-size:15px; line-height:1.5; color:color-mix(in srgb, var(--text) 55%, var(--muted) 45%);">${withBreaks}</p>`;
      }).join('');
    }

    function renderExplanationInline(f) {
      if (!f.e) return '';
      return `<div style="margin-top:8px;">${renderExplanationParagraphs(f.e)}</div>`;
    }

    function renderExplanationToggle(f, i) {
      if (!f.e) return '';
      const explId = `expl-${i}`;
      return `
        <button type="button" class="expl-toggle" data-target="${explId}" style="margin-top:10px; background:none; border:1px solid var(--border); border-radius:6px; padding:5px 10px; font-size:13px; color:var(--accent); cursor:pointer;">Show explanation</button>
        <div id="${explId}" style="display:none; margin-top:8px;">
          ${renderExplanationParagraphs(f.e)}
        </div>
      `;
    }

    function renderMcqBox(f, i) {
      const selected = userSelections[i] || null;
      const letters = Object.keys(f.options);

      const optionRows = letters.map((letter) => {
        const isCorrect = letter === f.answer;
        const isWrongPick = selected && letter === selected && !isCorrect;
        const isRightPick = selected && isCorrect;

        let stateStyle = 'background:var(--card); border-color:var(--border);';
        let icon = '';
        if (isRightPick) {
          stateStyle = 'background:var(--success-bg); border-color:var(--success-text); font-weight:700;';
          icon = '<span style="margin-left:auto; color:var(--success-text);">&#10003;</span>';
        } else if (isWrongPick) {
          stateStyle = 'background:var(--amber-bg); border-color:#c0392b; font-weight:700;';
          icon = '<span style="margin-left:auto; color:#c0392b;">&#10007;</span>';
        }

        return `
          <div class="opt-row${selected ? '' : ' opt-clickable'}" data-letter="${letter}" style="display:flex; gap:8px; align-items:center; padding:10px 12px; border-radius:8px; border:1px solid var(--border); cursor:${selected ? 'default' : 'pointer'}; ${stateStyle}">
            <span class="opt-letter" style="text-transform:uppercase; color:var(--muted); flex-shrink:0;">(${letter})</span>
            <span class="opt-text">${escapeHtml(formatMath(f.options[letter]))}</span>
            ${icon}
          </div>
        `;
      }).join('');

      const feedbackHtml = selected ? `
        <p class="answer-text" style="margin:12px 0 0; font-weight:600; font-size:14px; color:${selected === f.answer ? 'var(--success-text)' : '#c0392b'};">
          ${selected === f.answer ? 'Correct!' : 'Not quite.'} Answer: ${formatMath(f.a)}
        </p>
        ${renderExplanationToggle(f, i)}
      ` : `
        <p style="margin:10px 0 0; font-size:13px; color:var(--muted);">Tap an option to check your answer</p>
      `;

      const tableHtml = f.table ? renderTable(f.table) : '';

      return `
        <div class="opt-list" style="display:flex; flex-direction:column; gap:6px;">${optionRows}</div>
        ${feedbackHtml}
        ${selected ? tableHtml : ''}
      `;
    }

    function renderFaqBox(f) {
      const tableHtml = f.table ? renderTable(f.table) : '';
      const explHtml = renderExplanationInline(f);
      return `
        <p class="answer-text" style="margin:0; font-weight:600; color:var(--success-text); font-size:15px; background:var(--success-bg); border-radius:8px; padding:10px 12px;">${formatMath(f.a)}</p>
        ${explHtml}
        ${tableHtml}
      `;
    }

    function renderAnswerHtml(f, i) {
      return f && f.type === 'mcq' && f.options ? renderMcqBox(f, i) : renderFaqBox(f);
    }

    // ---------- Skeleton loading, replaces plain "Loading..." text.
    // Shape mimics the eventual answer capsule so there's no layout jump.
    function renderSkeleton() {
      return `
        <div class="skeleton-answer">
          <div class="skeleton-line w-90"></div>
          <div class="skeleton-line w-70"></div>
          <div class="skeleton-line w-50"></div>
        </div>
      `;
    }

    function attachMcqHandlers(aRow, f, i) {
      if (!f || f.type !== 'mcq' || !f.options) return;

      aRow.querySelectorAll('.opt-clickable').forEach((optEl) => {
        optEl.addEventListener('click', (e) => {
          e.stopPropagation();
          userSelections[i] = optEl.getAttribute('data-letter');
          aRow.innerHTML = renderAnswerHtml(f, i);
          attachMcqHandlers(aRow, f, i);
        });
      });

      const toggleBtn = aRow.querySelector('.expl-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = document.getElementById(toggleBtn.getAttribute('data-target'));
          const nowOpen = target.style.display === 'block';
          target.style.display = nowOpen ? 'none' : 'block';
          toggleBtn.textContent = nowOpen ? 'Show explanation' : 'Hide explanation';
        });
      }
    }

    function showPage(page) {
      currentPage = page;
      list.querySelectorAll('.faq-item').forEach((item) => {
        const itemPage = parseInt(item.getAttribute('data-page'));
        item.style.display = itemPage === page ? 'block' : 'none';
      });
      renderPagination();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderPagination() {
      const pag = document.getElementById('pagination');
      if (totalPages <= 1) { pag.innerHTML = ''; return; }
      const btnStyle = 'min-width:36px; height:36px; padding:0 10px; border:1px solid var(--border); border-radius:8px; background:var(--card); color:var(--text); font-size:14px; cursor:pointer;';
      let html = `<button ${currentPage === 1 ? 'disabled' : ''} id="prev-btn" style="${btnStyle}">${prevLabel}</button>`;
      for (let p = 1; p <= totalPages; p++) {
        html += `<button data-page="${p}" style="${btnStyle} ${p === currentPage ? 'border-color:var(--accent); color:var(--accent); font-weight:700;' : ''}">${p}</button>`;
      }
      html += `<button ${currentPage === totalPages ? 'disabled' : ''} id="next-btn" style="${btnStyle}">${nextLabel}</button>`;
      pag.innerHTML = html;

      pag.querySelectorAll('button[data-page]').forEach((btn) => {
        btn.addEventListener('click', () => showPage(parseInt(btn.getAttribute('data-page'))));
      });
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      if (prevBtn) prevBtn.addEventListener('click', () => showPage(currentPage - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => showPage(currentPage + 1));
    }

    function showLimitReached(message) {
      lockBanner.style.display = 'block';
      lockMessage.textContent = message;
      lockAction.textContent = 'View plans';
      lockAction.href = PLANS_URL;
    }

    function showRemainingHint(remaining, dailyLimit) {
      if (remaining <= 3) {
        lockBanner.style.display = 'block';
        lockMessage.textContent = `${remaining} of ${dailyLimit} free answers left for this subject today. Resets tomorrow.`;
        lockAction.textContent = 'View plans';
        lockAction.href = PLANS_URL;
      }
    }

    // ---------- Prefetch on pointerdown, not click. Starts the network
    // request the instant a finger/mouse touches the row (pointerdown fires
    // ~100-200ms before the full click gesture completes), so by the time
    // click actually fires, the fetch is often already in flight or done.
    // Same endpoint, same free-click/entitlement checks server-side —
    // this only shaves perceived latency, it changes nothing about what
    // gets checked or when access is granted. ----------
    const inFlightFetches = {};

    function prefetchAnswer(i) {
      if (revealedAnswers[i]) return null;
      if (bulkAnswers && bulkAnswers[i]) return null;
      if (limitReached) return null;
      if (inFlightFetches[i]) return inFlightFetches[i];

      inFlightFetches[i] = (async () => {
        try {
          const fp = await getFingerprint();
          const fpParam = fp ? `&fp=${encodeURIComponent(fp)}` : '';
          const res = await fetch(
            `${WORKER_URL}/content/answer?chapter_slug=${encodeURIComponent(chapterSlug)}&index=${i}${fpParam}`,
            { credentials: 'include' }
          );
          const data = await res.json();
          return { ok: res.ok, data };
        } catch (err) {
          return { ok: false, networkError: true };
        }
      })();

      return inFlightFetches[i];
    }

    list.querySelectorAll('.q-row').forEach((row) => {
      const i = parseInt(row.getAttribute('data-i'));

      // Fire as early as the gesture starts. touchstart/mousedown-equivalent
      // via pointerdown covers both touch and mouse in one listener.
      row.addEventListener('pointerdown', () => {
        prefetchAnswer(i);
      });

      row.addEventListener('click', async () => {
        const faqItem = row.closest('.faq-item');
        const aRow = list.querySelector(`.a-row[data-i="${i}"]`);
        const isOpen = aRow.style.display === 'block';

        list.querySelectorAll('.a-row').forEach((el) => el.style.display = 'none');
        list.querySelectorAll('.faq-item').forEach((el) => el.classList.remove('open'));
        if (isOpen) return;

        faqItem.classList.add('open');

        if (revealedAnswers[i]) {
          aRow.innerHTML = renderAnswerHtml(revealedAnswers[i], i);
          aRow.style.display = 'block';
          attachMcqHandlers(aRow, revealedAnswers[i], i);
          return;
        }

        if (bulkAnswers && bulkAnswers[i]) {
          revealedAnswers[i] = bulkAnswers[i];
          aRow.innerHTML = renderAnswerHtml(bulkAnswers[i], i);
          aRow.style.display = 'block';
          attachMcqHandlers(aRow, bulkAnswers[i], i);
          return;
        }

        if (limitReached) {
          aRow.style.display = 'none';
          faqItem.classList.remove('open');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        aRow.innerHTML = renderSkeleton();
        aRow.style.display = 'block';

        // Reuse the pointerdown-started fetch if it's already in flight;
        // otherwise start one now (covers keyboard/programmatic activation
        // that never fired pointerdown).
        const pending = prefetchAnswer(i) || (async () => {
          try {
            const fp = await getFingerprint();
            const fpParam = fp ? `&fp=${encodeURIComponent(fp)}` : '';
            const res = await fetch(
              `${WORKER_URL}/content/answer?chapter_slug=${encodeURIComponent(chapterSlug)}&index=${i}${fpParam}`,
              { credentials: 'include' }
            );
            const data = await res.json();
            return { ok: res.ok, data };
          } catch (err) {
            return { ok: false, networkError: true };
          }
        })();

        const result = await pending;
        delete inFlightFetches[i];

        if (result.networkError) {
          aRow.style.display = 'none';
          faqItem.classList.remove('open');
          if (window.showToast) {
            window.showToast('Network error. Please check your connection and try again.', 'error');
          } else {
            showLimitReached('Network error. Please check your connection and try again.');
          }
          return;
        }

        const { ok, data } = result;

        if (!ok) {
          aRow.style.display = 'none';
          faqItem.classList.remove('open');
          if (data.limitReached) limitReached = true;
          showLimitReached(data.error || 'Please log in or purchase to continue.');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        revealedAnswers[i] = data.answer;
        aRow.innerHTML = renderAnswerHtml(data.answer, i);
        aRow.style.display = 'block';
        attachMcqHandlers(aRow, data.answer, i);

        if (data.unlimited) {
          purchased = true;
          lockBanner.style.display = 'none';
          if (!bulkAnswers) fetchAllAnswersInBackground();
        } else if (typeof data.remaining === 'number') {
          showRemainingHint(data.remaining, data.dailyLimit);
        }
      });
    });

    renderPagination();
  </script>
</Layout>
