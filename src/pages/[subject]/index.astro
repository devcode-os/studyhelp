---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

export function getStaticPaths() {
  const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });

  const bySubject = {};

  for (const [path, mod] of Object.entries(chapterFiles)) {
    const subject = path.split('/').slice(-2, -1)[0];
    const items = Array.isArray(mod.default) ? mod.default : [mod.default];
    const valid = items.filter(
      (ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber
    );

    if (!bySubject[subject]) bySubject[subject] = [];
    bySubject[subject].push(...valid);
  }

  return Object.entries(bySubject).map(([subject, chapters]) => ({
    params: { subject },
    props: {
      chapters: chapters.sort((a, b) => a.chapterNumber - b.chapterNumber),
    },
  }));
}

const { subject } = Astro.params;
const { chapters } = Astro.props;
const meta = getSubjectMeta(subject);

const totalQuestions = chapters.reduce((sum, ch) => sum + ch.faqs.length, 0);
---
<Layout title={meta.seoTitle} description={meta.seoDescription}>

  <Header active="subjects" />

  <div class="page-wide">

    <div class="breadcrumb">
      <a href="/">Home</a> /
      <a href="/subjects/">Subjects</a> /
      {meta.breadcrumb}
    </div>

    <div class="subject-header">
      <div class="subject-header-left">
        <h1 class="subject-h1">{meta.heading}</h1>
        <div class="stat-pill-row">
          <div class="stat-pill stat-pill-amber">
            <i class="ti ti-books" aria-hidden="true"></i>
            <div>
              <div class="stat-num">{chapters.length}</div>
              <div class="stat-label">chapters</div>
            </div>
          </div>
          <div class="stat-pill stat-pill-teal">
            <i class="ti ti-help-circle" aria-hidden="true"></i>
            <div>
              <div class="stat-num">{totalQuestions}+</div>
              <div class="stat-label">questions</div>
            </div>
          </div>
        </div>
      </div>
      <div class="subject-header-right">
        <div id="free-trial-text" class="trial-text">15 free answers/day, no login needed &middot; 45 days unlimited once purchased</div>
        <a id="unlock-btn" href={`/plans/?highlight=${subject}`} class="unlock-btn">Unlock 45 days, Rs. 199</a>
      </div>
    </div>

    <div id="grace-grant-banner" class="grace-banner" style="display:none;"></div>

    {chapters.length > 0 ? (
      <div class="chapter-grid">
        {chapters.map((ch) => (
          <a href={`/${ch.slug}/`} class="chapter-card">
            <div class="chapter-card-number">{ch.chapterNumber}</div>
            <div class="chapter-card-title">{ch.title}</div>
            <div class="chapter-card-qcount">{ch.faqs.length} questions</div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <i class="ti ti-hourglass-empty" aria-hidden="true"></i>
        <p>Chapters coming soon.</p>
      </div>
    )}

  </div>

  <div id="verify-toast" class="verify-toast" style="display:none;">
    <i class="ti ti-mail-exclamation" aria-hidden="true"></i>
    <span class="verify-toast-text">Email verification pending &mdash; <a href="/account/">verify now</a></span>
    <button type="button" id="verify-toast-close" class="verify-toast-close" aria-label="Dismiss">
      <i class="ti ti-x" aria-hidden="true"></i>
    </button>
  </div>

  <style>
    .page-wide {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }
    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    .breadcrumb {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 12px;
    }
    .breadcrumb a { color: var(--muted); text-decoration: none; font-size: 13px; }
    @media (max-width: 900px) {
      .breadcrumb { display: none; }
    }

    .subject-header {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .subject-header-left { flex: 1; min-width: 220px; }
    .subject-header-right { flex: 1; min-width: 220px; }
    .subject-h1 { margin: 0 0 10px; font-size: 21px; }
    .stat-pill-row { display: flex; gap: 10px; flex-wrap: wrap; }
    .stat-pill {
      border-radius: 8px;
      padding: 0.6rem 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .stat-pill i { font-size: 20px; }
    .stat-pill-amber { background: var(--amber-bg); }
    .stat-pill-amber i { color: var(--amber-text); }
    .stat-pill-amber .stat-num { color: var(--amber-text-strong); }
    .stat-pill-amber .stat-label { color: var(--amber-text); }
    .stat-pill-teal { background: var(--teal-bg); }
    .stat-pill-teal i { color: var(--teal-text); }
    .stat-pill-teal .stat-num { color: var(--teal-text-strong); }
    .stat-pill-teal .stat-label { color: var(--teal-text); }
    .stat-num { font-size: 17px; font-weight: 700; line-height: 1.1; text-align: left; }
    .stat-label { font-size: 11px; text-align: left; }

    .trial-text { font-size: 12px; color: var(--muted); margin-bottom: 6px; }
    .unlock-btn {
      font-size: 13px;
      padding: 8px 16px;
      border: 1px solid var(--accent);
      border-radius: 8px;
      text-decoration: none;
      background: var(--accent-bg);
      color: var(--accent);
      display: inline-block;
    }

    @media (max-width: 900px) {
      .subject-header-left, .subject-header-right { text-align: center; }
      .stat-pill-row { justify-content: center; }
    }

    .grace-banner {
      margin-bottom: 1.5rem;
      padding: 12px 16px;
      border-radius: 10px;
      background: #fff4e0;
      border: 1px solid #e8c876;
      color: #6b4a00;
      font-size: 13px;
      line-height: 1.5;
    }
    html[data-theme="dark"] .grace-banner {
      background: #3a2a10;
      border-color: #6b5a2a;
      color: #f0c07a;
    }

    /* ---------- Chapter grid & cards. Desktop: unchanged from original —
       4-column grid, small gap, compact square-ish cards. Mobile: same
       class names, restyled into full-width capsule rows with number
       circle + chevron, matching the locked reading-page design language.
       No class renaming, so nothing here can leak into or break desktop. ---------- */
    .chapter-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    .chapter-card {
      display: block;
      background: var(--card);
      border: 1px solid var(--border);
      border-bottom: 3px solid var(--success-bg);
      border-radius: 12px;
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: transform 0.12s ease;
    }
    .chapter-card:active {
      transform: scale(0.98);
    }
    .chapter-card-number {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--accent-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 12px;
    }
    .chapter-card-title {
      font-weight: 700;
      font-size: 15px;
    }
    .chapter-card-qcount {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
    }

    @media (max-width: 900px) {
      .chapter-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }
      .chapter-card {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        column-gap: 12px;
        border-radius: 14px;
        padding: 14px;
      }
      .chapter-card-number {
        margin-bottom: 0;
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        grid-row: 1 / 3;
      }
      .chapter-card-title {
        grid-column: 2;
        grid-row: 1;
      }
      .chapter-card-qcount {
        grid-column: 2;
        grid-row: 2;
        margin-top: 2px;
      }
      .chapter-card::after {
        content: '';
        width: 8px;
        height: 8px;
        border-top: 2px solid var(--muted);
        border-right: 2px solid var(--muted);
        transform: rotate(45deg);
        grid-column: 3;
        grid-row: 1 / 3;
      }
    }

    .empty-state {
      background: var(--card);
      border: 1px dashed var(--border);
      border-radius: 14px;
      padding: 2.5rem;
      text-align: center;
      color: var(--muted);
    }
    .empty-state i { font-size: 28px; display: block; margin-bottom: 8px; }
    .empty-state p { margin: 0; }

    /* Verify toast: positioned to clear the fixed mobile tab bar via the
       shared --tabbar-h var, same offset pattern used for the scroll-top
       button and global toast container in Layout.astro. */
    .verify-toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      max-width: 90vw;
      width: 420px;
      background: var(--card);
      border: 1px solid var(--accent);
      border-radius: 10px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.15);
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 55;
      animation: toast-in 0.35s ease-out;
    }
    html[data-theme="dark"] .verify-toast {
      box-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    @keyframes toast-in {
      from { opacity: 0; transform: translateX(-50%) translateY(12px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    .verify-toast i.ti-mail-exclamation {
      color: var(--accent);
      font-size: 18px;
      flex-shrink: 0;
    }
    .verify-toast-text {
      flex: 1;
      font-size: 13px;
      color: var(--text);
    }
    .verify-toast-text a {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
    }
    .verify-toast-close {
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 2px;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .verify-toast-close:hover {
      color: var(--text);
    }
    @media (max-width: 480px) {
      .verify-toast {
        bottom: calc(12px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
        width: calc(100vw - 24px);
      }
    }
  </style>

  <script define:vars={{ subject }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Session is fetched ONCE per page by Header.astro and exposed on
    // window.__shSessionPromise. Reusing it here instead of calling /me
    // again avoids a duplicate network request on every subject page load.
    // Falls back to a direct /me call only if Header hasn't set it yet
    // (shouldn't normally happen since Header renders before this script,
    // but kept as a safety net).
    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    function formatDaysLeft(expiresAtSeconds) {
      const msLeft = expiresAtSeconds * 1000 - Date.now();
      const daysLeft = Math.ceil(msLeft / (24 * 60 * 60 * 1000));
      if (daysLeft <= 0) return 'Expires today';
      if (daysLeft === 1) return '1 day left';
      return `${daysLeft} days left`;
    }

    function formatExpiryDate(expiresAtSeconds) {
      return new Date(expiresAtSeconds * 1000).toLocaleDateString('en-IN', {
        day: 'numeric', month: 'short', year: 'numeric',
      });
    }

    getSession()
      .then((session) => {
        if (!session.logged_in) return;

        return fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(subject)}`)
          .then((res) => res.json())
          .then((data) => {
            if (data.unlocked) {
              const btn = document.getElementById('unlock-btn');
              const trialText = document.getElementById('free-trial-text');
              if (trialText) trialText.style.display = 'none';
              if (btn) {
                const daysLeft = data.expires_at
                  ? formatDaysLeft(data.expires_at)
                  : 'Unlimited access unlocked';
                btn.textContent = `✓ ${daysLeft}`;
                if (data.expires_at) {
                  btn.title = `Access until ${formatExpiryDate(data.expires_at)}`;
                }
                btn.removeAttribute('href');
                btn.style.cursor = 'default';
                btn.style.background = 'var(--success-bg)';
                btn.style.color = 'var(--success-text)';
                btn.style.borderColor = 'transparent';
              }

              if (data.is_grace_grant) {
                const banner = document.getElementById('grace-grant-banner');
                if (banner) {
                  const days = data.grace_days_remaining;
                  banner.innerHTML = `We haven't yet confirmed your payment. You've been given ${days ?? ''} day${days === 1 ? '' : 's'} of temporary access while we check — this won't continue automatically. If you believe this is a mistake or have already paid, please <a href="/support/" style="color:#6b4a00; font-weight:600;">contact us</a>.`;
                  banner.style.display = 'block';
                }
              }
            }
          });
      })
      .catch(() => {
        // silently ignore — button stays as default "Unlock 45 days" on network error
      });

    // One-time post-purchase toast: flag is set by payment-processing/index.astro
    // right before redirecting here, only if the account's email was still
    // unverified at that moment. Read once, then cleared immediately.
    (function showVerifyToastIfFlagged() {
      let shouldShow = false;
      try {
        shouldShow = sessionStorage.getItem('sh_show_verify_toast') === '1';
        sessionStorage.removeItem('sh_show_verify_toast');
      } catch (err) {
        return;
      }
      if (!shouldShow) return;

      const toast = document.getElementById('verify-toast');
      const closeBtn = document.getElementById('verify-toast-close');
      if (!toast) return;

      toast.style.display = 'flex';

      const AUTO_DISMISS_MS = 25000;
      const dismissTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, AUTO_DISMISS_MS);

      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          clearTimeout(dismissTimer);
          toast.style.display = 'none';
        });
      }
    })();
  </script>
</Layout>
