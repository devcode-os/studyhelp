---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

export function getStaticPaths() {
  // Discovers every subject folder under src/data/ automatically.
  // No subject names hardcoded - add a folder, it shows up here.
  const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });

  const bySubject = {};

  for (const [path, mod] of Object.entries(chapterFiles)) {
    const subject = path.split('/').slice(-2, -1)[0];
    const items = Array.isArray(mod.default) ? mod.default : [mod.default];
    const valid = items.filter(
      (ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber
    );

    if (!bySubject[subject]) bySubject[subject] = [];
    bySubject[subject].push(...valid);
  }

  return Object.entries(bySubject).map(([subject, chapters]) => ({
    params: { subject },
    props: {
      chapters: chapters.sort((a, b) => a.chapterNumber - b.chapterNumber),
    },
  }));
}

const { subject } = Astro.params;
const { chapters } = Astro.props;
const meta = getSubjectMeta(subject);

const totalQuestions = chapters.reduce((sum, ch) => sum + ch.faqs.length, 0);
---
<Layout title={meta.seoTitle} description={meta.seoDescription}>

  <Header active="subjects" />

  <div style="max-width:1100px; margin:0 auto; padding:24px;">

    <div style="font-size:13px; color:var(--muted); margin-bottom:12px;">
      <a href="/" style="color:var(--muted); text-decoration:none;">Home</a> /
      <a href="/subjects/" style="color:var(--muted); text-decoration:none;">Subjects</a> /
      {meta.breadcrumb}
    </div>

    <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
      <div class="subject-header-left" style="flex:1; min-width:220px;">
        <h1 style="margin:0 0 10px; font-size:22px;">{meta.heading}</h1>
        <div style="display:flex; gap:10px; flex-wrap:wrap;" class="stat-pill-row">
          <div style="background:var(--amber-bg); border-radius:8px; padding:0.6rem 0.9rem; display:flex; align-items:center; gap:8px;">
            <i class="ti ti-books" style="font-size:20px; color:var(--amber-text);" aria-hidden="true"></i>
            <div style="text-align:left;">
              <div style="font-size:17px; font-weight:700; line-height:1.1; color:var(--amber-text-strong);">{chapters.length}</div>
              <div style="font-size:11px; color:var(--amber-text);">chapters</div>
            </div>
          </div>
          <div style="background:var(--teal-bg); border-radius:8px; padding:0.6rem 0.9rem; display:flex; align-items:center; gap:8px;">
            <i class="ti ti-help-circle" style="font-size:20px; color:var(--teal-text);" aria-hidden="true"></i>
            <div style="text-align:left;">
              <div style="font-size:17px; font-weight:700; line-height:1.1; color:var(--teal-text-strong);">{totalQuestions}+</div>
              <div style="font-size:11px; color:var(--teal-text);">questions</div>
            </div>
          </div>
        </div>
      </div>
      <div class="subject-header-right" style="flex:1; min-width:220px;">
        <div id="free-trial-text" style="font-size:12px; color:var(--muted); margin-bottom:6px;">15 free answers/day, no login needed &middot; unlimited once purchased</div>
        <a id="unlock-btn" href={`/plans/?highlight=${subject}`} style="font-size:13px; padding:8px 16px; border:1px solid var(--accent); border-radius:8px; text-decoration:none; background:var(--accent-bg); color:var(--accent); display:inline-block;">Unlock unlimited, Rs. 199</a>
      </div>
    </div>

    {chapters.length > 0 ? (
      <div class="chapter-grid">
        {chapters.map((ch) => (
          <a href={`/${ch.slug}/`} class="chapter-card" style="display:block; background:var(--card); border:1px solid var(--border); border-bottom:3px solid var(--success-bg); border-radius:12px; padding:1.25rem; text-decoration:none; color:inherit;">
            <div class="chapter-card-number" style="width:32px; height:32px; border-radius:50%; background:var(--accent-bg); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--accent); margin-bottom:12px;">
              {ch.chapterNumber}
            </div>
            <div style="font-weight:700; font-size:15px;">{ch.title}</div>
            <div style="font-size:12px; color:var(--muted); margin-top:4px;">{ch.faqs.length} questions</div>
          </a>
        ))}
      </div>
    ) : (
      <div style="background:var(--card); border:1px dashed var(--border); border-radius:12px; padding:2.5rem; text-align:center; color:var(--muted);">
        Chapters coming soon.
      </div>
    )}

  </div>

  <div id="verify-toast" class="verify-toast" style="display:none;">
    <i class="ti ti-mail-exclamation"></i>
    <span class="verify-toast-text">Email verification pending &mdash; <a href="/account/">verify now</a></span>
    <button type="button" id="verify-toast-close" class="verify-toast-close" aria-label="Dismiss">
      <i class="ti ti-x"></i>
    </button>
  </div>

  <style>
    .verify-toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      max-width: 90vw;
      width: 420px;
      background: var(--card);
      border: 1px solid var(--accent);
      border-radius: 10px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.15);
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 1000;
      animation: toast-in 0.35s ease-out;
    }
    html[data-theme="dark"] .verify-toast {
      box-shadow: 0 6px 24px rgba(0,0,0,0.4);
    }
    @keyframes toast-in {
      from { opacity: 0; transform: translateX(-50%) translateY(12px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    .verify-toast i.ti-mail-exclamation {
      color: var(--accent);
      font-size: 18px;
      flex-shrink: 0;
    }
    .verify-toast-text {
      flex: 1;
      font-size: 13px;
      color: var(--text);
    }
    .verify-toast-text a {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
    }
    .verify-toast-close {
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 2px;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .verify-toast-close:hover {
      color: var(--text);
    }
    @media (max-width: 480px) {
      .verify-toast {
        bottom: 12px;
        width: calc(100vw - 24px);
      }
    }
  </style>

  <script define:vars={{ subject }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
    const SESSION_CACHE_KEY = 'sh_session_cache';
    const SESSION_CACHE_TTL = 5 * 60 * 1000;

    function getCachedSession() {
      try {
        const raw = sessionStorage.getItem(SESSION_CACHE_KEY);
        if (!raw) return null;
        const cached = JSON.parse(raw);
        if (Date.now() - cached.ts > SESSION_CACHE_TTL) return null;
        // Never trust a cached "logged out" result - always re-check fresh in that case,
        // since it likely means we cached the state from BEFORE a login happened.
        return cached.data.logged_in ? cached.data : null;
      } catch (err) {
        return null;
      }
    }

    function setCachedSession(data) {
      try {
        sessionStorage.setItem(SESSION_CACHE_KEY, JSON.stringify({ data, ts: Date.now() }));
      } catch (err) {}
    }

    function getSession() {
      const cached = getCachedSession();
      if (cached) return Promise.resolve(cached);
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .then((data) => {
          setCachedSession(data);
          return data;
        })
        .catch(() => ({ logged_in: false }));
    }

    getSession()
      .then((session) => {
        if (!session.logged_in) return; // not logged in — button stays default "Unlock unlimited"

        return fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(subject)}`)
          .then((res) => res.json())
          .then((data) => {
            if (data.unlocked) {
              const btn = document.getElementById('unlock-btn');
              const trialText = document.getElementById('free-trial-text');
              if (trialText) trialText.style.display = 'none';
              if (btn) {
                btn.textContent = '✓ Unlimited access unlocked';
                btn.removeAttribute('href');
                btn.style.cursor = 'default';
                btn.style.background = 'var(--success-bg, #d1fae5)';
                btn.style.color = 'var(--success-text, #065f46)';
                btn.style.borderColor = 'transparent';
              }
            }
          });
      })
      .catch(() => {
        // silently ignore — button stays as default "Unlock unlimited" on network error
      });

    // One-time post-purchase toast: flag is set by payment-processing/index.astro
    // right before redirecting here, only if the account's email was still
    // unverified at that moment. Read once, then cleared immediately so a
    // refresh or revisit never shows it again — the header badge and
    // /account/ banner remain the persistent reminder after this.
    (function showVerifyToastIfFlagged() {
      let shouldShow = false;
      try {
        shouldShow = sessionStorage.getItem('sh_show_verify_toast') === '1';
        sessionStorage.removeItem('sh_show_verify_toast');
      } catch (err) {
        return;
      }
      if (!shouldShow) return;

      const toast = document.getElementById('verify-toast');
      const closeBtn = document.getElementById('verify-toast-close');
      if (!toast) return;

      toast.style.display = 'flex';

      const AUTO_DISMISS_MS = 25000;
      const dismissTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, AUTO_DISMISS_MS);

      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          clearTimeout(dismissTimer);
          toast.style.display = 'none';
        });
      }
    })();
  </script>
</Layout>
