---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

// Counts real chapter files per subject folder — same technique
// [subject]/index.astro already uses. No chapter counts are hardcoded here;
// they always reflect what's actually in src/data/<subject>/*.json.
// Question counts are derived the same way — summing each valid chapter's
// faqs array — so the number on the card can never drift out of sync with
// the actual content, the same guarantee the chapter count already has.
const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const countsBySubject = {};
const questionCountsBySubject = {};
for (const [path, mod] of Object.entries(chapterFiles)) {
  const subjectKey = path.split('/').slice(-2, -1)[0];
  const items = Array.isArray(mod.default) ? mod.default : [mod.default];
  const valid = items.filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber);
  countsBySubject[subjectKey] = (countsBySubject[subjectKey] || 0) + valid.length;
  const questionsInFile = valid.reduce((sum, ch) => sum + ch.faqs.length, 0);
  questionCountsBySubject[subjectKey] = (questionCountsBySubject[subjectKey] || 0) + questionsInFile;
}

// This list controls which subjects are publicly shown on this page and in
// what order/icon — separate from raw folder presence, since some data
// folders (e.g. early-stage or test content) aren't ready to list publicly
// yet. Chapter counts for whatever IS listed here are always live/automatic
// from the scan above. Add a subject here once it's ready to announce.
const PUBLIC_SUBJECTS = [
  { slug: 'telangana-history-en', icon: 'book' },
  { slug: 'telangana-history-te', icon: 'book' },
  { slug: 'telangana-economy-en', icon: 'chart' },
  { slug: 'telangana-economy-te', icon: 'chart' },
  { slug: 'indian-history-en', icon: 'book' },
  { slug: 'indian-polity-en', icon: 'gavel' },
  { slug: 'indian-polity-te', icon: 'gavel' },
];

// subjectsMeta.js only stores the native-script heading, not a separate
// English name — so English subtitles are defined here per subject.
const ENGLISH_NAME = {
  'telangana-history-te': 'Telugu Version',
  'telangana-economy-en': 'English Version',
  'telangana-history-en': 'English Version',
  'telangana-economy-te': 'Telugu Version',
  'indian-history-en': 'English Version',
  'indian-polity-en': 'English Version',
  'indian-polity-te': 'Telugu Version',
};

const subjects = PUBLIC_SUBJECTS.map(({ slug, icon }) => {
  const meta = getSubjectMeta(slug);
  const chapterCount = countsBySubject[slug] || 0;
  const questionCount = questionCountsBySubject[slug] || 0;
  return {
    titleNative: meta.heading,
    titleParts: splitTitleParts(meta.heading),
    titleEnglish: ENGLISH_NAME[slug] || 'English',
    slug,
    chapterCount,
    questionCount,
    icon,
    available: chapterCount > 0,
  };
});

const iconMap = {
  book: 'ti-book',
  chart: 'ti-chart-bar',
  gavel: 'ti-gavel',
  file: 'ti-file-text',
};

// Long titles with a parenthetical qualifier (e.g. "Indian History
// (Ancient, Medieval and Modern)") wrap awkwardly mid-phrase in the narrow
// card layout. Split right before the "(" so the template can force a
// clean line break there instead of letting the browser wrap wherever it
// likes. Returns a 1-element array unchanged (most subjects, and all
// native-script titles have no "(" at all) or a 2-element [before, after]
// pair when a break point is found.
function splitTitleParts(title) {
  const idx = title.indexOf(' (');
  if (idx === -1) return [title];
  return [title.slice(0, idx), title.slice(idx + 1)];
}

// Question Papers — same source list/pattern as /papers/index.astro, shown
// as a second section here since the app has no homepage and /subjects/ is
// the first screen people land on.
const PUBLIC_PAPERS = [
  { slug: 'ts-constable-previous-papers-en', icon: 'file' },
  { slug: 'ts-constable-previous-papers-te', icon: 'file' },
];

const PAPERS_ENGLISH_NAME = {
  'ts-constable-previous-papers-en': 'Previous Question Papers',
  'ts-constable-previous-papers-te': 'Previous Question Papers (Telugu)',
};

const papers = PUBLIC_PAPERS.map(({ slug, icon }) => {
  const meta = getSubjectMeta(slug);
  const chapterCount = countsBySubject[slug] || 0;
  return {
    titleNative: meta.heading,
    titleParts: splitTitleParts(meta.heading),
    titleEnglish: PAPERS_ENGLISH_NAME[slug] || 'Previous Question Papers',
    slug,
    chapterCount,
    icon,
    available: chapterCount > 0,
  };
});
---
<Layout title="Subjects - StudyHelp" description="All subjects available on StudyHelp for TSPSC and TS exam preparation.">

  <Header active="subjects" />

  <div class="page-wide">

    <div class="breadcrumb">
      <a href="/">Home</a> / Subjects
    </div>

    <h1 class="page-h1">Subjects</h1>

    <div class="offer-strip">
      <div class="offer-strip-text">
        <div class="offer-strip-title">Complete Competitive Exam Preparation</div>
        <div class="offer-strip-price">Pick any 3 subjects &bull; &#8377;399 for 3 months</div>
        <div class="offer-strip-features">Chapter-wise content &bull; MCQs &bull; Mock Tests</div>
      </div>
    </div>

    <a href="/current-affairs/" class="ca-banner">
      <div class="ca-banner-icon">
        <i class="ti ti-news" aria-hidden="true"></i>
      </div>
      <div class="ca-banner-text">
        <div class="ca-banner-title">Current Affairs 2026</div>
        <div class="ca-banner-sub">Free to read &middot; PDF download available</div>
      </div>
    </a>

    <div class="subject-list">
      {subjects.map((s) => (
        s.available ? (
          <a href={`/${s.slug}/`} class="subject-card subject-card-live" data-subject-slug={s.slug}>
            <span class="avail-pill" data-pill hidden aria-label="Purchased"><i class="ti ti-check" aria-hidden="true"></i></span>
            <div class="subject-card-header">
              <div class="subject-icon">
                <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
              </div>
              <div class="subject-native">
                {s.titleParts.length === 2
                  ? <>{s.titleParts[0]}<br />{s.titleParts[1]}</>
                  : s.titleNative}
              </div>
            </div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count">
              {s.chapterCount} {s.chapterCount === 1 ? 'chapter' : 'chapters'}
              {s.questionCount > 0 && <> &middot; {s.questionCount.toLocaleString('en-IN')} MCQs</>}
            </span>
          </a>
        ) : (
          <div class="subject-card subject-card-soon">
            <div class="subject-card-header">
              <div class="subject-icon subject-icon-muted">
                <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
              </div>
              <div class="subject-native">
                {s.titleParts.length === 2
                  ? <>{s.titleParts[0]}<br />{s.titleParts[1]}</>
                  : s.titleNative}
              </div>
            </div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count-muted">coming soon</span>
          </div>
        )
      ))}
    </div>

    <h2 class="page-h2">Question Papers <span class="section-pill">Free</span></h2>

    <div class="subject-list papers-list">
      {papers.map((p) => (
        p.available ? (
          <a href={`/${p.slug}/`} class="subject-card subject-card-live">
            <div class="subject-card-header">
              <div class="subject-icon">
                <i class={`ti ${iconMap[p.icon]}`} aria-hidden="true"></i>
              </div>
              <div class="subject-native">
                {p.titleParts.length === 2
                  ? <>{p.titleParts[0]}<br />{p.titleParts[1]}</>
                  : p.titleNative}
              </div>
            </div>
            <div class="subject-english">{p.titleEnglish}</div>
            <span class="subject-count">{p.chapterCount} {p.chapterCount === 1 ? 'paper' : 'papers'}</span>
          </a>
        ) : (
          <div class="subject-card subject-card-soon">
            <div class="subject-card-header">
              <div class="subject-icon subject-icon-muted">
                <i class={`ti ${iconMap[p.icon]}`} aria-hidden="true"></i>
              </div>
              <div class="subject-native">
                {p.titleParts.length === 2
                  ? <>{p.titleParts[0]}<br />{p.titleParts[1]}</>
                  : p.titleNative}
              </div>
            </div>
            <div class="subject-english">{p.titleEnglish}</div>
            <span class="subject-count-muted">coming soon</span>
          </div>
        )
      ))}
    </div>

  </div>

  <style is:global>
    .page-wide {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }
    /* Bottom clearance for the fixed mobile tabbar. This needs a wider
       breakpoint than the phone-only layout tweaks below (720px) — the
       tabbar itself stays visible up through tablet widths, so a page
       between 721px and 900px was getting no bottom padding at all,
       leaving no room to scroll the last section (Question Papers) out
       from under the fixed bar. */
    @media (max-width: 900px) {
      .page-wide {
        padding-bottom: calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }
    @media (max-width: 720px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    .breadcrumb {
      display: none; /* hidden site-wide — Subjects is a top-level page
                         already highlighted in the main nav, so the
                         breadcrumb (Home / Subjects) was just repeating
                         that with no real navigational value. */
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 12px;
    }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .page-h1 { margin: 0 0 16px; }
    .page-h2 { margin: 28px 0 16px; font-size: 20px; }
    .section-pill {
      display: inline-block;
      vertical-align: middle;
      margin-left: 8px;
      background: linear-gradient(90deg, #ff9a3c, #ffb35c);
      color: #2a1400;
      font-size: 12px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
    }

    .ca-banner {
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
      background: linear-gradient(160deg, #221c42 0%, #2b2158 100%);
      border: 1px solid rgba(92, 224, 192, 0.4);
      border-radius: 14px;
      padding: 0.9rem 1.15rem;
      text-decoration: none;
      margin-bottom: 20px;
      transition: transform 0.12s ease, border-color 0.12s ease;
    }
    .ca-banner:active {
      transform: scale(0.98);
    }
    .ca-banner-icon {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      border-radius: 11px;
      background: rgba(92, 224, 192, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .ca-banner-icon i { font-size: 20px; color: #5ce0c0; }
    .ca-banner-text { flex: 1; min-width: 0; }
    .ca-banner-title {
      font-weight: 800;
      font-size: 17px;
      color: #ffffff;
      line-height: 1.25;
    }
    .ca-banner-sub {
      font-size: 11px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.82);
      margin-top: 2px;
    }
    .ca-banner-arrow {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, 0.75);
    }
    .ca-banner-arrow i { font-size: 20px; }
    @media (min-width: 901px) {
      .ca-banner { display: none; }
    }
    @media (max-width: 720px) {
      .ca-banner { padding: 0.85rem 1rem; margin-bottom: 16px; gap: 12px; }
      .ca-banner-icon { width: 38px; height: 38px; border-radius: 10px; }
      .ca-banner-icon i { font-size: 19px; }
      .ca-banner-title { font-size: 15px; }
      .ca-banner-sub { font-size: 10.5px; }
    }

    .offer-strip {
      text-align: center;
      background: linear-gradient(135deg, #4c1d95 0%, #241a4d 100%);
      border: 2px solid #ff9a3c;
      border-radius: 16px;
      padding: 1rem 1.2rem;
      margin-bottom: 20px;
      box-shadow: 0 6px 20px -8px rgba(255, 154, 60, 0.4);
    }
    .offer-strip-title {
      font-size: 18px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.25;
      margin-bottom: 3px;
    }
    .offer-strip-price {
      font-size: 13.5px;
      font-weight: 700;
      color: #ffcb8a;
      margin-bottom: 3px;
    }
    .offer-strip-features {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.75);
    }
    @media (max-width: 720px) {
      .offer-strip { padding: 0.85rem 1rem; margin-bottom: 16px; }
      .offer-strip-title { font-size: 16px; }
      .offer-strip-price { font-size: 12px; }
      .offer-strip-features { font-size: 11px; }
    }

    @media (max-width: 720px) {
      .breadcrumb { display: none; }
      .page-h1 { display: none; }
      .page-h2 { font-size: 17px; margin: 22px 0 10px; }
      .section-pill { font-size: 10px; padding: 2px 8px; margin-left: 6px; }
    }

    .subject-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .subject-card {
      display: block;
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border-radius: 14px;
      padding: 1.25rem;
      text-decoration: none;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      transition: transform 0.12s ease;
    }
    .subject-card-live {
      border: 1px solid #ff9a3c;
    }
    .subject-card-live:active {
      transform: scale(0.98);
    }
    /* Owned subjects: swap the orange border for a soft green glow so the
       card itself reads as "yours" at a glance, not just the badge. */
    .subject-card-live.has-pill {
      border-color: #3fd88a;
      box-shadow: 0 0 0 1px rgba(63, 216, 138, 0.35), 0 0 16px rgba(63, 216, 138, 0.35);
      overflow: visible; /* lets the checkmark badge sit half outside the card edge */
    }
    .subject-card-soon {
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #ffffff;
      opacity: 0.55;
    }
    .avail-pill {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(90deg, #2fb35c, #4dd67e);
      color: #06280f;
      border-radius: 50%;
      box-shadow: 0 2px 6px -1px rgba(0,0,0,0.5);
    }
    .avail-pill i { font-size: 13px; font-weight: 700; }
    .avail-pill[hidden] { display: none; }
    .subject-card-header {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 0;
    }
    /* The Purchased checkmark badge is a small 22px corner circle now
       (not a text pill), so it no longer needs to reserve header space —
       titles wrap exactly the same as on non-owned cards. */
    .subject-icon {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: rgba(255, 154, 60, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .subject-icon i { font-size: 16px; color: #ff9a3c; }
    .subject-icon-muted { background: rgba(255, 255, 255, 0.08); }
    .subject-icon-muted i { color: rgba(255, 255, 255, 0.5); }
    .subject-native {
      flex: 1;
      min-width: 0;
      font-weight: 700;
      font-size: 15px;
      line-height: 1.25;
      color: #ffffff;
    }
    .subject-english {
      font-size: 13px;
      line-height: 1.3;
      color: rgba(255, 255, 255, 0.65);
      margin: 0 0 10px;
      padding-left: 42px; /* icon width (32px) + header gap (10px) — keeps this
                              lined up under the title text, not the icon */
    }
    .subject-count {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #ffcb8a;
      padding-left: 42px; /* icon width (32px) + header gap (10px) */
    }
    .subject-count-muted {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      padding-left: 42px;
    }

    /* Mobile: compact 2-column capsule grid, same pattern as the homepage. */
    @media (max-width: 720px) {
      .subject-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .subject-card {
        border-radius: 16px;
        padding: 0.9rem;
      }
      .avail-pill {
        top: -6px;
        right: -6px;
        width: 18px;
        height: 18px;
      }
      .avail-pill i { font-size: 11px; }
      .subject-card-header {
        gap: 8px;
        margin-bottom: 0;
      }
      .subject-icon {
        width: 26px;
        height: 26px;
        border-radius: 8px;
      }
      .subject-icon i { font-size: 13px; }
      .subject-native {
        font-size: 13px;
        line-height: 1.3;
      }
      .subject-english {
        font-size: 11px;
        line-height: 1.3;
        margin: 0 0 8px;
        padding-left: 34px; /* mobile icon (26px) + header gap (8px) */
      }
      .subject-count,
      .subject-count-muted {
        font-size: 11px;
        padding-left: 34px; /* mobile icon (26px) + header gap (8px) */
      }
    }
  </style>

  <script define:vars={{ subjects }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Show immediately (don't wait on session/ownership check) so the user
    // sees confirmation the instant the page loads, right after redirecting
    // back from a successful bundle payment. Uses the same fixed-bottom
    // #toast-container Layout.astro already uses for other messages (e.g.
    // "Payment failed") — never falls back to alert(), which is a blocking
    // native dialog and not how this app surfaces these messages anywhere
    // else. Cleaning the URL now also prevents the toast from reappearing
    // on a manual refresh of this page.
    //
    // Deferred to DOMContentLoaded deliberately: in Layout.astro, both
    // #toast-container and the <script> defining window.showToast are
    // placed AFTER <slot /> — i.e. after this page's own content in
    // source order. Since inline scripts run synchronously the instant
    // the parser reaches them, running this immediately (un-deferred)
    // meant neither window.showToast nor #toast-container existed yet at
    // that point — both checks below silently failed and nothing ever
    // appeared. Waiting for DOMContentLoaded guarantees the entire
    // document, including Layout's trailing script/markup, has already
    // been parsed and executed first.
    let bundleLoadingToast = null;
    let bundleToastShownAt = null;
    const BUNDLE_TOAST_MIN_VISIBLE_MS = 2500;
    const params = new URLSearchParams(window.location.search);
    const showedBundleToast = params.get('bundle_success') === '1';

    // Removing the instant the ownership check resolves can mean the toast
    // is only on screen for a fraction of a second if that check happens
    // to finish fast (cached session, quick network) — enforces at least
    // BUNDLE_TOAST_MIN_VISIBLE_MS of visible time regardless of how fast
    // the underlying work actually finishes.
    function removeBundleToastAfterMinDelay() {
      if (!bundleLoadingToast) return;
      const elapsed = Date.now() - bundleToastShownAt;
      const remaining = Math.max(0, BUNDLE_TOAST_MIN_VISIBLE_MS - elapsed);
      setTimeout(() => {
        if (bundleLoadingToast) bundleLoadingToast.remove();
      }, remaining);
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (!showedBundleToast) return;
      const message = 'Bundle purchased successfully — loading your subjects…';
      // Layout's shared window.showToast() only has two colors — red for
      // 'error', dark/black for everything else, including 'success'. It
      // has no green variant to call into, and this message should read
      // as a celebratory success, not a neutral black notice — so this
      // always builds its own green-styled toast directly rather than
      // deferring to the shared function.
      const container = document.getElementById('toast-container');
      if (container) {
        bundleLoadingToast = document.createElement('div');
        bundleLoadingToast.textContent = message;
        bundleLoadingToast.style.cssText = `
          background: linear-gradient(90deg, #2fbf71, #3fd88a);
          color: #063a1e; font-weight: 700; font-size: 13px;
          padding: 12px 18px; border-radius: 10px;
          box-shadow: 0 8px 20px -6px rgba(0,0,0,0.4);
          max-width: 360px; text-align: center;
        `;
        container.appendChild(bundleLoadingToast);
        bundleToastShownAt = Date.now();
      }
      window.history.replaceState({}, '', '/subjects/');
      // Safety net: remove no matter what, even if some unexpected error
      // path above never fires the removal — this is payment-confirmation
      // UX, it should never get stuck on screen.
      setTimeout(() => { if (bundleLoadingToast) bundleLoadingToast.remove(); }, 8000);
    });

    // Session is fetched ONCE per page by Header.astro (runs synchronously
    // inline, before this script) and exposed on window.__shSessionPromise.
    // Reusing it here avoids a duplicate /me call on every /subjects/ load.
    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    // Only difference for a logged-in user who owns a subject: the pill on
    // that same card swaps from "Available" to "Purchased". Layout, card
    // count, grid — everything else stays identical to the guest view.
    getSession().then(async (session) => {
      if (!session.logged_in) {
        removeBundleToastAfterMinDelay();
        return;
      }

      const available = subjects.filter((s) => s.available);
      await Promise.all(
        available.map((s) =>
          fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(s.slug)}`)
            .then((res) => res.json())
            .then((d) => {
              if (!d.unlocked) return;
              const card = document.querySelector(`[data-subject-slug="${s.slug}"]`);
              const pill = card && card.querySelector('[data-pill]');
              if (pill) {
                pill.hidden = false;
                card.classList.add('has-pill');
              }
            })
            .catch(() => {})
        )
      );

      // The 3 newly-bought subjects now show "Purchased" above — the
      // "loading…" toast has done its job, remove it (respecting the
      // minimum-visible-duration floor).
      removeBundleToastAfterMinDelay();
    });
  </script>
</Layout>
