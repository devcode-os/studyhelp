---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getSubjectMeta } from '../../data/subjectsMeta.js';

// Counts real chapter files per subject folder — same technique
// /subjects/index.astro and [subject]/index.astro already use. No chapter
// counts are hardcoded here; they always reflect what's actually in
// src/data/<subject>/*.json.
const chapterFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const countsBySubject = {};
for (const [path, mod] of Object.entries(chapterFiles)) {
  const subjectKey = path.split('/').slice(-2, -1)[0];
  const items = Array.isArray(mod.default) ? mod.default : [mod.default];
  const valid = items.filter((ch) => ch && ch.slug && ch.chapterNumber);
  countsBySubject[subjectKey] = (countsBySubject[subjectKey] || 0) + valid.length;
}

// This list controls which "previous papers" subjects are publicly shown on
// this page — separate from raw folder presence, same pattern as
// /subjects/index.astro's PUBLIC_SUBJECTS. Add a slug here once its content
// is ready to announce.
const PUBLIC_PAPERS = [
  { slug: 'ts-constable-previous-papers-en', icon: 'file' },
  { slug: 'ts-constable-previous-papers-te', icon: 'file' },
];

const ENGLISH_NAME = {
  'ts-constable-previous-papers-en': 'Previous Question Papers',
  'ts-constable-previous-papers-te': 'Previous Question Papers (Telugu)',
};

const papers = PUBLIC_PAPERS.map(({ slug, icon }) => {
  const meta = getSubjectMeta(slug);
  const chapterCount = countsBySubject[slug] || 0;
  return {
    titleNative: meta.heading,
    titleEnglish: ENGLISH_NAME[slug] || 'Previous Question Papers',
    slug,
    chapterCount,
    icon,
    available: chapterCount > 0,
  };
});

const iconMap = {
  file: 'ti-file-text',
};
---
<Layout title="Previous Papers - StudyHelp" description="All previous exam question papers available on StudyHelp for TSPSC and TS exam preparation.">

  <Header active="papers" />

  <div class="page-wide">

    <div class="breadcrumb">
      <a href="/">Home</a> / Papers
    </div>

    <h1 class="page-h1">Previous Papers</h1>

    <div class="subject-list">
      {papers.map((s) => (
        s.available ? (
          <a href={`/${s.slug}/`} class="subject-card subject-card-live" data-subject-slug={s.slug}>
            <span class="avail-pill" data-pill>Available</span>
            <div class="subject-icon">
              <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
            </div>
            <div class="subject-native">{s.titleNative}</div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count">{s.chapterCount} {s.chapterCount === 1 ? 'paper' : 'papers'}</span>
          </a>
        ) : (
          <div class="subject-card subject-card-soon">
            <div class="subject-icon subject-icon-muted">
              <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
            </div>
            <div class="subject-native">{s.titleNative}</div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count-muted">coming soon</span>
          </div>
        )
      ))}
    </div>

  </div>

  <style is:global>
    .page-wide {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }
    @media (max-width: 720px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    .breadcrumb {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 12px;
    }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .page-h1 { margin: 0 0 16px; }

    @media (max-width: 720px) {
      .breadcrumb { display: none; }
      .page-h1 { display: none; }
    }

    .subject-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .subject-card {
      display: block;
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border-radius: 14px;
      padding: 1.25rem;
      text-decoration: none;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      transition: transform 0.12s ease;
    }
    .subject-card-live {
      border: 1px solid #ff9a3c;
    }
    .subject-card-live:active {
      transform: scale(0.98);
    }
    .subject-card-soon {
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #ffffff;
      opacity: 0.55;
    }
    .avail-pill {
      position: absolute;
      top: 14px;
      right: 14px;
      background: linear-gradient(90deg, #ff9a3c, #ffb35c);
      color: #2a1400;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 20px;
    }
    .subject-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(255, 154, 60, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }
    .subject-icon i { font-size: 18px; color: #ff9a3c; }
    .subject-icon-muted { background: rgba(255, 255, 255, 0.08); }
    .subject-icon-muted i { color: rgba(255, 255, 255, 0.5); }
    .subject-native { font-weight: 700; font-size: 15px; color: #ffffff; }
    .subject-english { font-size: 13px; color: rgba(255, 255, 255, 0.65); margin: 2px 0 10px; }
    .subject-count { font-size: 12px; color: #ffcb8a; font-weight: 600; }
    .subject-count-muted { font-size: 12px; color: rgba(255, 255, 255, 0.5); }

    /* Mobile: compact 2-column capsule grid, same pattern as the homepage. */
    @media (max-width: 720px) {
      .subject-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .subject-card {
        border-radius: 16px;
        padding: 0.9rem;
      }
      .avail-pill {
        top: 10px;
        right: 10px;
        font-size: 10px;
        padding: 2px 8px;
      }
      .subject-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        margin-bottom: 8px;
      }
      .subject-icon i { font-size: 15px; }
      .subject-native {
        font-size: 13px;
        line-height: 1.3;
      }
      .subject-english {
        font-size: 11px;
        margin: 2px 0 8px;
      }
      .subject-count,
      .subject-count-muted {
        font-size: 11px;
      }
    }
  </style>

  <script define:vars={{ papers }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    getSession().then(async (session) => {
      if (!session.logged_in) return;

      const available = papers.filter((s) => s.available);
      await Promise.all(
        available.map((s) =>
          fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(s.slug)}`)
            .then((res) => res.json())
            .then((d) => {
              if (!d.unlocked) return;
              const card = document.querySelector(`[data-subject-slug="${s.slug}"]`);
              const pill = card && card.querySelector('[data-pill]');
              if (pill) pill.textContent = 'Purchased';
            })
            .catch(() => {})
        )
      );
    });
  </script>
</Layout>
