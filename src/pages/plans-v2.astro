---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// UNCHANGED FROM plans/index.astro — real subjects/prices are fetched
// client-side from GET /subjects/public (Worker → D1), same as live.
---
<Layout title="Plans - StudyHelp" description="Unlock full access to StudyHelp subjects. One-time payment, no subscription.">

  <Header active="plans" theme="premium" />

  <div class="page-wide">

    <div class="plans-intro">
      <h1 class="plans-h1">Unlock Full Access <span id="plans-duration-badge" class="plans-duration-badge">3 Months (90 Days)</span></h1>
      <p class="plans-sub">One-time payment. No subscription.</p>
    </div>

    <div id="active-subjects-section" class="active-subjects-section">
      <button type="button" id="active-subjects-toggle" class="section-label active-subjects-toggle" aria-expanded="false">
        <i class="ti ti-circle-check" style="color:#26946A;"></i>
        <span>Your Active Subjects</span>
        <span id="active-subjects-count" class="active-subjects-count"></span>
        <i class="ti ti-chevron-down active-subjects-chevron"></i>
      </button>
      <div id="active-subjects-list" class="active-subjects-list"></div>
    </div>

    <div id="catalog-sticky" class="catalog-sticky">
      <div class="mode-toggle" id="mode-toggle">
        <button id="mode-bundle-btn" class="mode-btn mode-btn-active" type="button">Buy Bundle</button>
        <button id="mode-single-btn" class="mode-btn" type="button">Buy Single</button>
      </div>
    </div>

    <div id="subjects-section" class="subjects-section">
      <div id="bundle-value-banner" class="bundle-value-banner bundle-value-visible">
        <div class="bundle-value-icon"><i class="ti ti-gift"></i></div>
        <div class="bundle-value-body">
          <span class="bundle-value-badge">Best Value</span>
          <div class="bundle-value-text">
            Buy 2 Subjects, get <span class="bundle-value-free">1 Free</span>
          </div>
        </div>
      </div>

      <div class="subject-rows bundle-mode" id="real-plan-grid">
        <div class="row-skeleton">Loading subjects...</div>
      </div>

      <div id="bundle-sticky-bar" class="bundle-sticky-bar" style="display:flex">
        <span id="bundle-counter">0 of 3 selected</span>
        <button id="bundle-buy-btn" class="bundle-buy-btn" disabled type="button">Bundle Buy — &#8377;399</button>
      </div>
    </div>

    <div class="whatyouget-card">
      <div class="whatyouget-title">What you get</div>
      <div class="whatyouget-grid">
        <div>
          <div class="whatyouget-item-title">Full reading access</div>
          <div class="whatyouget-item-sub">All chapters, all MCQs, Theory &amp; Mock tests</div>
        </div>
        <div>
          <div class="whatyouget-item-title">Log in anywhere</div>
          <div class="whatyouget-item-sub">Switch devices anytime, no limit</div>
        </div>
        <div>
          <div class="whatyouget-item-title">Full access</div>
          <div class="whatyouget-item-sub">One-time payment, duration shown on each subject</div>
        </div>
        <div>
          <div class="whatyouget-item-title">Fair refund policy</div>
          <div class="whatyouget-item-sub"><a href="/refund-policy/" class="whatyouget-link">See our refund &amp; cancellation policy</a></div>
        </div>
      </div>
    </div>

    <div class="whatyouget-card plans-faq-card">
      <div class="whatyouget-title">Before you buy</div>
      <details class="plans-faq-item" open>
        <summary>How do I buy?</summary>
        <div class="plans-faq-body">
          Pick a subject (or 3 for the bundle) and tap Buy — you'll create a quick account
          if you don't have one, then pay via UPI, card, or netbanking. Access unlocks
          immediately after payment.
        </div>
      </details>
      <details class="plans-faq-item">
        <summary>How do I know my subject is unlocked?</summary>
        <div class="plans-faq-body">
          A green checkmark ✓ appears on the subject once it's unlocked — you'll see it
          right away.
        </div>
      </details>
      <details class="plans-faq-item">
        <summary>Paid but it still shows locked?</summary>
        <div class="plans-faq-body">
          Rare, but can happen if the page loads from cache before your purchase syncs.
          Try logging out and back in, or a hard refresh. Still locked?
          <a href="https://studyhelp.fdaytalk.com/contact/">Contact us</a> with your
          Razorpay payment ID and subject name — we'll grant immediate 3-day access
          while we verify, then activate your full 90-day access counted from your
          original payment date, so you never lose time.
        </div>
      </details>
    </div>

  </div>

  <style is:global>
    #app-install-banner { display: none !important; }
    /* Active Subjects now shown on Subjects and the homepage — redundant here. */
    #active-subjects-section { display: none !important; }

    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-amber: #E8963A;
      --sh2-amber-soft: #FBEDD9;
      --sh2-green: #26946A;
      --sh2-green-soft: #DFF3EA;
      --sh2-text: #211F38;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-gold: #D8A94E;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    @media (min-width: 1200px) {
      .page-wide {
        max-width: 900px;
      }
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-amber: #F0B45E;
      --sh2-amber-soft: #3B2C15;
      --sh2-green: #5FCB9B;
      --sh2-green-soft: #183328;
      --sh2-text: #EFEDFB;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&display=swap');
    .page-wide h1, .page-wide .row-title, .page-wide .whatyouget-title { font-family: 'Manrope', sans-serif; }

    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }

    /* ================= Hero ================= */
    .plans-intro {
      text-align: left;
      margin-bottom: 12px;
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      padding: 16px 18px;
      background: linear-gradient(155deg, var(--sh2-indigo-deep) 0%, #5A4CC4 55%, #7C63DE 100%);
      box-shadow: 0 14px 28px -16px rgba(46,37,112,0.5);
    }
    .plans-h1 {
      margin: 0 0 6px; color: #ffffff; font-size: 1.15rem; font-weight: 800;
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px; row-gap: 8px;
    }
    .plans-duration-badge {
      font-size: 0.72rem; font-weight: 700; color: #ffffff; white-space: nowrap;
      background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3);
      padding: 3px 10px; border-radius: 999px;
    }
    .plans-sub { color: rgba(255,255,255,0.75); font-size: 0.78rem; margin: 0; }
    @media (min-width: 721px) {
      .plans-duration-badge {
        position: absolute; right: 1rem; top: 50%; transform: translateY(-50%);
        font-size: 0.78rem; padding: 6px 16px;
      }
    }
    @media (max-width: 720px) {
      .plans-intro { text-align: center; }
      .plans-h1 { flex-direction: column; }
    }

    /* ================= Section labels ================= */
    .section-label { font-size: 0.85rem; font-weight: 700; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; color: var(--sh2-ink); }
    .active-subjects-section { display: none; margin-bottom: 14px; }
    .active-subjects-toggle {
      width: 100%; cursor: pointer; text-align: left;
      display: flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 700;
      background: var(--sh2-surface);
      border: 1px solid rgba(38,148,106,0.3);
      border-radius: 12px; padding: 10px 12px;
      box-shadow: var(--sh2-shadow);
    }
    .active-subjects-count { font-size: 0.74rem; font-weight: 600; color: var(--sh2-text-soft); margin-left: 2px; }
    .active-subjects-chevron { margin-left: auto; transition: transform 0.15s; color: var(--sh2-text-soft); }
    .active-subjects-toggle[aria-expanded="true"] .active-subjects-chevron { transform: rotate(180deg); }
    .active-subjects-list { display: flex; flex-direction: column; gap: 10px; overflow: hidden; max-height: 0; }
    .active-subjects-section.expanded .active-subjects-list { max-height: none; margin-top: 10px; }
    .subjects-section { margin-bottom: 20px; }

    /* ================= Sticky catalog header ================= */
    .catalog-sticky {
      position: sticky; top: 0; z-index: 25;
      background: var(--sh2-bg);
      padding-top: 8px; padding-bottom: 4px; margin: 0 -16px; padding-left: 16px; padding-right: 16px;
    }

    /* ================= Mode toggle ================= */
    .mode-toggle { display: flex; gap: 8px; margin-bottom: 8px; }
    .mode-btn {
      flex: 1; padding: 10px 12px; border-radius: 10px; font-size: 0.78rem; font-weight: 700;
      cursor: pointer; white-space: nowrap;
      background: var(--sh2-surface); border: 1.5px solid var(--sh2-line); color: var(--sh2-ink);
      transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
    }
    .mode-btn-active {
      background: linear-gradient(135deg, var(--sh2-indigo), var(--sh2-indigo-deep)); color: #ffffff;
      border-color: transparent;
      box-shadow: 0 6px 14px -6px rgba(75,63,160,0.5);
    }
    @media (max-width: 400px) { .mode-btn { font-size: 0.68rem; padding: 10px 6px; } }

    /* ================= Bundle value banner ================= */
    .bundle-value-banner {
      display: none; position: relative; overflow: hidden;
      align-items: center; gap: 12px;
      background: var(--sh2-surface);
      border-radius: 14px;
      padding: 12px 14px;
      margin: 12px 0 14px;
      box-shadow: var(--sh2-shadow);
      border: 1.5px dashed var(--sh2-indigo);
    }
    .bundle-value-banner.bundle-value-visible { display: flex; }
    .bundle-value-icon {
      flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff; font-size: 18px;
      box-shadow: 0 6px 14px -6px rgba(75,63,160,0.6);
    }
    .bundle-value-body { min-width: 0; }
    .bundle-value-badge {
      display: inline-block;
      color: var(--sh2-indigo);
      font-size: 0.76rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
      margin-bottom: 2px;
    }
    .bundle-value-text { font-size: 0.86rem; font-weight: 800; color: var(--sh2-ink); line-height: 1.3; }
    .bundle-value-free { color: var(--sh2-indigo); }

    /* ================= Subject rows ================= */
    .subject-rows { display: flex; flex-direction: column; gap: 7px; }
    .row-skeleton { text-align: center; padding: 2rem; color: var(--sh2-text-soft); font-size: 0.8rem; }
    .subject-row {
      position: relative; overflow: hidden;
      display: flex; align-items: center; gap: 9px;
      background: var(--sh2-surface);
      border: 1px solid var(--sh2-line);
      border-radius: 12px;
      padding: 8px 10px;
      text-decoration: none;
      color: var(--sh2-ink);
      cursor: pointer;
      box-shadow: none;
      transition: border-color 0.12s, background 0.12s, box-shadow 0.12s;
    }
    .subject-row.row-popular { border-color: rgba(232,150,58,0.5); }
    .subject-row.row-selected {
      border-color: var(--sh2-indigo);
      background: var(--sh2-indigo-soft);
      box-shadow: 0 0 0 1px var(--sh2-indigo);
    }

    /* Circular checkbox — only shown in bundle mode */
    .row-checkbox {
      display: none; width: 20px; height: 20px; border-radius: 50%;
      border: 1.5px solid var(--sh2-line); background: var(--sh2-surface); flex-shrink: 0;
      align-items: center; justify-content: center; color: transparent; font-size: 12px; font-weight: 900;
      transition: background 0.12s, border-color 0.12s, color 0.12s;
    }
    .row-selected .row-checkbox { background: var(--sh2-indigo); border-color: var(--sh2-indigo); color: #ffffff; }

    .row-body { flex: 1; min-width: 0; }
    .row-title { font-weight: 700; font-size: 0.83rem; color: var(--sh2-ink); line-height: 1.25; }
    .row-sub { font-size: 0.68rem; color: var(--sh2-text-soft); margin-top: 1px; }

    .row-trailing { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .row-price { font-size: 0.76rem; font-weight: 700; color: var(--sh2-indigo); white-space: nowrap; }
    .row-buy-btn {
      font-size: 0.68rem; font-weight: 700; padding: 6px 12px; border: none; border-radius: 8px;
      background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep)); color: #fff; cursor: pointer; white-space: nowrap;
    }
    .row-badge-popular {
      font-size: 0.56rem; font-weight: 700; padding: 1px 6px; border-radius: 4px;
      background: var(--sh2-indigo-soft); color: var(--sh2-indigo); margin-bottom: 1px; display: inline-block;
    }
    .bundle-mode .row-badge-popular { display: none; }
    .row-badge-yours {
      font-size: 0.6rem; font-weight: 700; padding: 2px 7px; border-radius: 5px;
      background: var(--sh2-green); color: #fff; margin-bottom: 1px; display: inline-block;
    }
    .row-badge-free {
      display: none;
      position: absolute; top: 9px; right: -26px;
      width: 100px; text-align: center;
      transform: rotate(45deg);
      font-size: 0.58rem; font-weight: 800; padding: 2px 0; letter-spacing: 0.04em;
      background: linear-gradient(90deg, #1D7A54, #26946A); color: #ffffff;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      pointer-events: none;
    }
    .subject-rows.bundle-mode .row-free-badge .row-badge-free { display: block; }

    .subject-rows.bundle-mode .row-checkbox { display: flex; }
    .subject-rows.bundle-mode .row-trailing { display: none; }
    .subject-rows.bundle-mode .subject-row { padding: 9px 10px; }
    @media (max-width: 900px) { .subjects-section:has(.bundle-mode) { padding-bottom: 76px; } }

    /* ================= Sticky bundle bar ================= */
    .bundle-sticky-bar {
      display: none; gap: 6px;
      background: var(--sh2-surface);
      border: 1px solid var(--sh2-line);
      border-radius: 12px;
      padding: 4px; justify-content: space-between; align-items: center;
      box-shadow: 0 12px 28px -12px rgba(46,37,112,0.35);
      color: var(--sh2-ink); font-size: 0.78rem; font-weight: 700;
    }
    #bundle-counter {
      flex: 1; min-width: 0;
      background: var(--sh2-indigo-soft);
      color: var(--sh2-indigo);
      padding: 9px 10px;
      border-radius: 10px;
      text-align: center;
      white-space: nowrap;
    }
    @media (max-width: 900px) {
      .bundle-sticky-bar {
        position: fixed;
        left: 50%; transform: translateX(-50%);
        width: calc(100% - 64px);
        bottom: calc(6px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
        z-index: 30;
        max-width: 320px;
      }
    }
    @media (min-width: 901px) {
      .bundle-sticky-bar { position: sticky; bottom: 16px; margin: 12px auto 0; max-width: 360px; }
    }
    .bundle-buy-btn {
      flex: 1; padding: 10px 12px; border-radius: 10px; border: none; font-weight: 700; font-size: 0.78rem;
      background: var(--sh2-green); color: #ffffff; cursor: pointer; white-space: nowrap;
    }
    .bundle-buy-btn:disabled { background: var(--sh2-surface-2); color: var(--sh2-text-soft); opacity: 1; cursor: not-allowed; }

    /* ================= Active subjects (owned) card ================= */
    .active-row {
      background: var(--sh2-surface);
      border: 1px solid rgba(38,148,106,0.35);
      border-radius: 14px; padding: 12px 14px; display: flex; flex-wrap: wrap;
      justify-content: space-between; align-items: center; gap: 12px;
      box-shadow: var(--sh2-shadow);
    }
    .active-row-title { font-weight: 700; font-size: 0.88rem; color: var(--sh2-ink); }
    .active-row-sub { font-size: 0.74rem; color: var(--sh2-text-soft); margin-top: 2px; }
    .active-row-open {
      font-size: 0.78rem; font-weight: 700; padding: 8px 16px; border-radius: 10px;
      background: var(--sh2-green); color: #ffffff;
      text-decoration: none; flex-shrink: 0;
    }
    .grace-banner {
      width: 100%; margin-top: 10px; padding: 10px 12px; border-radius: 10px;
      background: var(--sh2-indigo-soft); border: 1px solid rgba(75,63,160,0.3);
      color: var(--sh2-indigo-deep); font-size: 0.72rem; line-height: 1.5;
    }
    html[data-theme="dark"] .grace-banner { color: var(--sh2-indigo); }
    .grace-banner a { color: inherit; font-weight: 700; text-decoration: underline; }

    /* ================= What you get ================= */
    .whatyouget-card {
      background: var(--sh2-surface);
      border: 1px solid var(--sh2-line); border-radius: 16px; padding: 1.1rem; color: var(--sh2-ink);
      box-shadow: var(--sh2-shadow);
    }
    .whatyouget-title { font-size: 0.78rem; font-weight: 800; margin-bottom: 12px; color: var(--sh2-indigo); text-transform: uppercase; letter-spacing: 0.04em; }
    .plans-faq-card .whatyouget-title { color: var(--sh2-indigo); }
    .whatyouget-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
    .whatyouget-item-title { font-size: 0.78rem; font-weight: 700; color: var(--sh2-ink); }
    .whatyouget-item-sub { font-size: 0.72rem; color: var(--sh2-text-soft); }
    .whatyouget-link { color: var(--sh2-indigo); text-decoration: underline; }
    @media (max-width: 720px) { .whatyouget-card { margin-bottom: 12px; } .whatyouget-grid { grid-template-columns: 1fr; gap: 12px; } }

    /* ================= FAQ ================= */
    .plans-faq-card { margin-top: 12px; }
    .plans-faq-item { border-top: 1px solid var(--sh2-line); padding: 10px 0; }
    .plans-faq-item:first-of-type { border-top: none; padding-top: 0; }
    .plans-faq-item summary {
      font-size: 0.78rem; font-weight: 700; color: var(--sh2-ink);
      cursor: pointer; list-style: none; display: flex;
      align-items: center; justify-content: space-between; gap: 8px;
    }
    .plans-faq-item summary::-webkit-details-marker { display: none; }
    .plans-faq-item summary::after { content: '+'; font-size: 16px; font-weight: 400; color: var(--sh2-text-soft); flex: 0 0 auto; }
    .plans-faq-item[open] summary::after { content: '–'; }
    .plans-faq-body { font-size: 0.74rem; line-height: 1.6; color: var(--sh2-text-soft); margin-top: 8px; }
    .plans-faq-body a { color: var(--sh2-indigo); font-weight: 700; text-decoration: underline; }
  </style>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    // ============================================================
    // UNCHANGED FROM plans/index.astro — same Worker URL, same
    // bundle selection state machine, same Razorpay/Capacitor
    // purchase flows, same ownership checks, same ?highlight=/
    // ?buy=/?subjects= URL handling. Only class names referenced
    // below (already restyled above) are unchanged, so nothing here
    // needed to change.
    // ============================================================
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    let currentUser = null;
    let subjectMeta = [];

    let bundleModeOn = true;
    let selectedBundleSlugs = [];

    function setBundleMode(on) {
      bundleModeOn = on;
      selectedBundleSlugs = [];
      document.getElementById('real-plan-grid').classList.toggle('bundle-mode', on);
      document.getElementById('bundle-sticky-bar').style.display = on ? 'flex' : 'none';
      document.getElementById('bundle-value-banner').classList.toggle('bundle-value-visible', on);
      document.getElementById('mode-single-btn').classList.toggle('mode-btn-active', !on);
      document.getElementById('mode-bundle-btn').classList.toggle('mode-btn-active', on);
      document.querySelectorAll('.subject-row').forEach((r) => r.classList.remove('row-selected'));
      const scrollTopBtn = document.getElementById('scroll-top-btn');
      if (scrollTopBtn) scrollTopBtn.style.display = on ? 'none' : '';
      updateBundleBar();
    }

    function updateBundleBar() {
      const counter = document.getElementById('bundle-counter');
      const buyBtn = document.getElementById('bundle-buy-btn');
      if (counter) counter.textContent = `${selectedBundleSlugs.length} of 3 selected`;
      if (buyBtn) buyBtn.disabled = selectedBundleSlugs.length !== 3;
      updateFreeBadge();
    }

    function updateFreeBadge() {
      document.querySelectorAll('.subject-row').forEach((r) => r.classList.remove('row-free-badge'));
      if (selectedBundleSlugs.length === 3) {
        const freeSlug = selectedBundleSlugs[2];
        const freeRow = document.getElementById(`plan-card-${freeSlug}`);
        if (freeRow) freeRow.classList.add('row-free-badge');
      }
    }

    function toggleBundleSelect(slug) {
      const row = document.getElementById(`plan-card-${slug}`);
      if (!row) return;
      const idx = selectedBundleSlugs.indexOf(slug);
      if (idx > -1) {
        selectedBundleSlugs.splice(idx, 1);
        row.classList.remove('row-selected');
      } else {
        if (selectedBundleSlugs.length >= 3) return;
        selectedBundleSlugs.push(slug);
        row.classList.add('row-selected');
      }
      updateBundleBar();
    }

    function onBuyBundleClick() {
      if (selectedBundleSlugs.length !== 3) return;

      if (!currentUser) {
        const returnTo = `/plans-v2/?mode=bundle&subjects=${encodeURIComponent(selectedBundleSlugs.join(','))}`;
        window.location.href = `/signup-v2/?next=${encodeURIComponent(returnTo)}`;
        return;
      }

      const btn = document.getElementById('bundle-buy-btn');
      const subjectIds = selectedBundleSlugs.slice();
      btn.disabled = true;
      const originalLabel = btn.textContent;
      btn.textContent = 'Loading...';

      fetch(`${WORKER_URL}/create-bundle-order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: currentUser.user_id, subject_ids: subjectIds }),
      })
        .then((res) => res.json().then((order) => ({ res, order })))
        .then(({ res, order }) => {
          if (!res.ok) {
            if (order.error === 'Already purchased') {
              if (window.showToast) {
                window.showToast('One of the selected subjects is already unlocked — pick a different one.', 'error');
              } else {
                alert('One of the selected subjects is already unlocked — pick a different one.');
              }
            } else {
              alert(order.error || 'Could not start payment');
            }
            btn.disabled = false;
            btn.textContent = originalLabel;
            return;
          }

          const isNativeApp = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());

          if (isNativeApp) {
            window.Capacitor.Plugins.RazorpayNative.open({
              key: order.key_id,
              amount: order.amount,
              currency: order.currency,
              order_id: order.order_id,
              name: 'StudyHelp',
              description: 'Bundle: 3 subjects',
              prefill: { name: currentUser.name },
            }).then((result) => {
              if (result.success) {
                window.location.href = '/subjects/?bundle_success=1';
              } else {
                if (window.showToast) {
                  window.showToast('Payment failed. Please try again.', 'error');
                } else {
                  alert('Payment failed. Please try again.');
                }
                btn.disabled = false;
                btn.textContent = originalLabel;
              }
            }).catch((err) => {
              alert('Error: ' + (err && err.message ? err.message : String(err)));
              btn.disabled = false;
              btn.textContent = originalLabel;
            });
            return;
          }

          const rzp = new Razorpay({
            key: order.key_id,
            amount: order.amount,
            currency: order.currency,
            order_id: order.order_id,
            name: 'StudyHelp',
            description: 'Bundle: 3 subjects',
            prefill: { name: currentUser.name },
            handler: function (response) {
              const goToSuccess = function () {
                window.location.href = '/subjects/?bundle_success=1';
              };
              if (window.gtag) {
                let redirected = false;
                const redirectOnce = function () {
                  if (redirected) return;
                  redirected = true;
                  goToSuccess();
                };
                gtag('event', 'conversion', {
                  send_to: 'AW-18464276214/qr_sCJXgjf8cEPb9ueRE',
                  value: order.amount / 100,
                  currency: order.currency,
                  transaction_id: response.razorpay_payment_id,
                  event_callback: redirectOnce,
                });
                setTimeout(redirectOnce, 800);
              } else {
                goToSuccess();
              }
            },
            modal: {
              ondismiss: function () {
                btn.disabled = false;
                btn.textContent = originalLabel;
              },
            },
          });

          rzp.on('payment.failed', function () {
            alert('Payment failed. Please try again.');
            btn.disabled = false;
            btn.textContent = originalLabel;
          });

          rzp.open();
        })
        .catch((err) => {
          alert('Error: ' + err.message);
          btn.disabled = false;
          btn.textContent = originalLabel;
        });
    }

    document.getElementById('mode-single-btn').addEventListener('click', () => setBundleMode(false));
    document.getElementById('mode-bundle-btn').addEventListener('click', () => setBundleMode(true));
    document.getElementById('bundle-buy-btn').addEventListener('click', onBuyBundleClick);

    document.getElementById('active-subjects-toggle').addEventListener('click', () => {
      const section = document.getElementById('active-subjects-section');
      const toggle = document.getElementById('active-subjects-toggle');
      const expanded = section.classList.toggle('expanded');
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });

    function formatDaysLeft(expiresAtSeconds) {
      const msLeft = expiresAtSeconds * 1000 - Date.now();
      const daysLeft = Math.ceil(msLeft / (24 * 60 * 60 * 1000));
      if (daysLeft <= 0) return 'Expires today';
      if (daysLeft === 1) return '1 day left';
      return `${daysLeft} days left`;
    }

    function formatExpiryDate(expiresAtSeconds) {
      return new Date(expiresAtSeconds * 1000).toLocaleDateString('en-IN', {
        day: 'numeric', month: 'short', year: 'numeric',
      });
    }

    async function getSession() {
      const source = window.__shSessionPromise
        || fetch(`${WORKER_URL}/me`, { credentials: 'include' })
            .then((res) => res.json())
            .catch(() => ({ logged_in: false }));

      const data = await source;
      return data.logged_in ? data : null;
    }

    async function checkOwnershipForAllSubjects() {
      if (!currentUser) return;

      const activeList = document.getElementById('active-subjects-list');
      const activeSection = document.getElementById('active-subjects-section');
      activeList.innerHTML = '';
      let anyActive = false;
      let activeCount = 0;

      const buttons = document.querySelectorAll('.row-buy-btn');
      for (const btn of buttons) {
        const subject_id = btn.getAttribute('data-subject');
        try {
          const res = await fetch(
            `${WORKER_URL}/check-access?user_id=${encodeURIComponent(currentUser.user_id)}&subject_id=${encodeURIComponent(subject_id)}`
          );
          const data = await res.json();
          if (data.unlocked) {
            setButtonToOpen(btn, subject_id, data.expires_at);
            anyActive = true;
            activeCount += 1;

            const meta = subjectMeta.find((s) => s.slug === subject_id);
            const row = document.createElement('div');

            const graceBannerHtml = data.is_grace_grant ? `
              <div class="grace-banner">
                We haven't yet confirmed your payment. You've been given ${data.grace_days_remaining ?? ''} day${data.grace_days_remaining === 1 ? '' : 's'} of temporary access while we check — this won't continue automatically. If you believe this is a mistake or have already paid, please <a href="/support/">contact us</a>.
              </div>
            ` : '';

            row.className = 'active-row';
            row.innerHTML = `
              <div>
                <div class="active-row-title">${meta ? meta.titleNative : subject_id}</div>
                <div class="active-row-sub">${data.expires_at ? formatDaysLeft(data.expires_at) + ' &middot; until ' + formatExpiryDate(data.expires_at) : 'Active'}</div>
              </div>
              <a href="/${subject_id}/" class="active-row-open">Open</a>
              ${graceBannerHtml}
            `;
            activeList.appendChild(row);

            const gridRow = document.getElementById(`plan-card-${subject_id}`);
            if (gridRow) gridRow.style.display = 'none';
          }
        } catch (err) {
          // silently skip on network error
        }
      }

      if (anyActive) {
        activeSection.style.display = 'block';
        const countEl = document.getElementById('active-subjects-count');
        if (countEl) countEl.textContent = `(${activeCount})`;
      }
    }

    function setButtonToOpen(btn, subject_id, expiresAt) {
      const freshBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(freshBtn, btn);

      freshBtn.disabled = false;
      const isMobile = window.matchMedia('(max-width: 720px)').matches;
      freshBtn.textContent = expiresAt && !isMobile
        ? `Open — ${formatDaysLeft(expiresAt)}`
        : 'Open';
      freshBtn.title = expiresAt ? `Access until ${formatExpiryDate(expiresAt)}` : '';
      freshBtn.onclick = (e) => {
        e.stopPropagation();
        window.location.href = `/${subject_id}/`;
      };
      return freshBtn;
    }

    function renderPlanRow(s) {
      const popularBadge = s.popular ? `<span class="row-badge-popular">most popular</span>` : '';
      const yoursLabel = '&#10003; your subject';
      return `
        <div id="plan-card-${s.slug}" data-slug="${s.slug}" class="subject-row ${s.popular ? 'row-popular' : ''}">
          <div class="row-checkbox">&#10003;</div>
          <div class="row-body">
            <span class="badge-yours-wrap" style="display:none;"><span class="row-badge-yours">${yoursLabel}</span></span>
            ${popularBadge}
            <div class="row-title">${s.titleNative}</div>
            <div class="row-sub">${s.titleEnglish || ''}</div>
          </div>
          <span class="row-badge-free">FREE</span>
          <div class="row-trailing">
            <div class="row-price">Rs. ${s.price}</div>
            <button data-subject="${s.slug}" data-price="${s.price}" class="row-buy-btn">Buy now</button>
          </div>
        </div>
      `;
    }

    async function loadRealSubjects() {
      const grid = document.getElementById('real-plan-grid');
      try {
        const res = await fetch(`${WORKER_URL}/subjects/public`);
        const data = await res.json();
        const subjects = (data.subjects || [])
          .map((s) => ({
            slug: s.id,
            titleNative: s.title_native || s.name,
            titleEnglish: s.title_english || '',
            price: s.price_paise / 100,
            popular: !!s.popular,
            accessDays: s.access_days || 90,
            category: s.category || 'subject',
          }))
          .filter((s) => s.category !== 'papers');

        subjectMeta = subjects;

        const PRIORITY_ORDER = [
          'indian-history-en',
          'indian-polity-en',
          'telangana-history-en',
          'telangana-history-te',
          'telangana-economy-en',
          'telangana-economy-te',
          'andhra-pradesh-economy',
        ];
        subjects.sort((a, b) => {
          const ai = PRIORITY_ORDER.indexOf(a.slug);
          const bi = PRIORITY_ORDER.indexOf(b.slug);
          if (ai === -1 && bi === -1) return 0;
          if (ai === -1) return 1;
          if (bi === -1) return -1;
          return ai - bi;
        });

        const combinedHtml = subjects.map(renderPlanRow).join('');
        grid.innerHTML = combinedHtml.trim().length
          ? combinedHtml
          : `<div class="row-skeleton">No subjects available right now.</div>`;

        const HIDDEN_TEST_SUBJECT_IDS = ['ads-test-conversion'];
        HIDDEN_TEST_SUBJECT_IDS.forEach((id) => {
          const row = document.getElementById(`plan-card-${id}`);
          if (row) row.style.display = 'none';
        });

        document.querySelectorAll('.row-buy-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const subject_id = btn.getAttribute('data-subject');
            if (!currentUser) {
              const returnTo = `/plans-v2/?buy=${encodeURIComponent(subject_id)}`;
              window.location.href = `/signup-v2/?next=${encodeURIComponent(returnTo)}`;
              return;
            }
            startPurchase(btn, subject_id);
          });
        });

        document.querySelectorAll('.subject-row').forEach((row) => {
          row.addEventListener('click', () => {
            if (!bundleModeOn) return;
            const slug = row.dataset.slug;
            if (!slug) return;
            toggleBundleSelect(slug);
          });
        });
      } catch (err) {
        grid.innerHTML = `<div class="row-skeleton">Couldn't load subjects. Please refresh the page.</div>`;
      }
    }

    function startPurchase(btn, subject_id) {
      if (navigator.vibrate) navigator.vibrate(30);

      btn.disabled = true;
      btn.textContent = 'Loading...';

      fetch(`${WORKER_URL}/create-order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: currentUser.user_id, subject_id }),
      })
        .then((res) => res.json().then((order) => ({ res, order })))
        .then(({ res, order }) => {
          if (!res.ok) {
            if (order.error === 'Already purchased') {
              btn.disabled = true;
              btn.textContent = '✓ Already purchased — opening...';
              setTimeout(() => {
                window.location.href = `/${subject_id}/`;
              }, 800);
              return;
            }
            alert(order.error || 'Could not start payment');
            btn.disabled = false;
            btn.textContent = 'Buy now';
            return;
          }

          const isNativeApp = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());

          if (isNativeApp) {
            window.Capacitor.Plugins.RazorpayNative.open({
              key: order.key_id,
              amount: order.amount,
              currency: order.currency,
              order_id: order.order_id,
              name: 'StudyHelp',
              description: subject_id,
              prefill: { name: currentUser.name },
            }).then((result) => {
              if (result.success) {
                window.location.href =
                  `/payment-processing/?user_id=${encodeURIComponent(currentUser.user_id)}&subject_id=${encodeURIComponent(subject_id)}`;
              } else {
                if (window.showToast) {
                  window.showToast('Payment failed. Please try again.', 'error');
                } else {
                  alert('Payment failed. Please try again.');
                }
                btn.disabled = false;
                btn.textContent = 'Buy now';
              }
            }).catch((err) => {
              alert('Error: ' + (err && err.message ? err.message : String(err)));
              btn.disabled = false;
              btn.textContent = 'Buy now';
            });
            return;
          }

          const rzp = new Razorpay({
            key: order.key_id,
            amount: order.amount,
            currency: order.currency,
            order_id: order.order_id,
            name: 'StudyHelp',
            description: subject_id,
            prefill: { name: currentUser.name },
            handler: function (response) {
              const goToProcessing = function () {
                window.location.href =
                  `/payment-processing/?user_id=${encodeURIComponent(currentUser.user_id)}&subject_id=${encodeURIComponent(subject_id)}`;
              };
              if (window.gtag) {
                let redirected = false;
                const redirectOnce = function () {
                  if (redirected) return;
                  redirected = true;
                  goToProcessing();
                };
                gtag('event', 'conversion', {
                  send_to: 'AW-18464276214/qr_sCJXgjf8cEPb9ueRE',
                  value: order.amount / 100,
                  currency: order.currency,
                  transaction_id: response.razorpay_payment_id,
                  event_callback: redirectOnce,
                });
                setTimeout(redirectOnce, 800);
              } else {
                goToProcessing();
              }
            },
            modal: {
              ondismiss: function () {
                btn.disabled = false;
                btn.textContent = 'Buy now';
              },
            },
          });

          rzp.on('payment.failed', function () {
            alert('Payment failed. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Buy now';
          });

          rzp.open();
        })
        .catch((err) => {
          alert('Error: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'Buy now';
        });
    }

    function highlightIntendedSubject() {
      const params = new URLSearchParams(window.location.search);
      const highlightSlug = params.get('highlight');
      if (!highlightSlug) return;

      const targetRow = document.getElementById(`plan-card-${highlightSlug}`);
      if (!targetRow) return;

      document.querySelectorAll('[id^="plan-card-"]').forEach((row) => {
        row.classList.remove('row-popular');
        const popularBadge = row.querySelector('.row-badge-popular');
        if (popularBadge) popularBadge.style.display = 'none';
      });

      targetRow.classList.add('row-popular');
      const yoursWrap = targetRow.querySelector('.badge-yours-wrap');
      if (yoursWrap) yoursWrap.style.display = 'inline-block';

      const parentGrid = targetRow.parentElement;
      if (parentGrid) parentGrid.prepend(targetRow);

      if (bundleModeOn) {
        toggleBundleSelect(highlightSlug);
      }
    }

    function applyRequestedMode() {
      const params = new URLSearchParams(window.location.search);
      const singleSubjectIntent = params.get('highlight') && params.get('mode') !== 'bundle';
      if (singleSubjectIntent) {
        setBundleMode(false);
      }
    }

    // Boot
    loadRealSubjects().then(() => {
      getSession().then((session) => {
        currentUser = session;
        checkOwnershipForAllSubjects().then(() => {
          applyRequestedMode();
          highlightIntendedSubject();
          const params = new URLSearchParams(window.location.search);
          const buySubject = params.get('buy');
          if (buySubject && currentUser) {
            const btn = document.querySelector(`.row-buy-btn[data-subject="${CSS.escape(buySubject)}"]`);
            if (btn) startPurchase(btn, buySubject);
            window.history.replaceState({}, '', '/plans-v2/');
          }

          const bundleSubjectsParam = params.get('subjects');
          if (bundleSubjectsParam && currentUser) {
            const slugs = bundleSubjectsParam.split(',').filter(Boolean);
            if (slugs.length === 3) {
              setBundleMode(true);
              slugs.forEach((slug) => toggleBundleSelect(slug));
              if (selectedBundleSlugs.length === 3) {
                onBuyBundleClick();
              }
            }
            window.history.replaceState({}, '', '/plans-v2/');
          }
        });
      });
    });
  </script>

  <script is:inline>
    document.body.classList.add('sh2-page');
  </script>
</Layout>
