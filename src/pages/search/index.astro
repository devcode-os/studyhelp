---
import Layout from '../../layouts/Layout.astro';
import chapters from '../../data/chapters.json';

const allFaqs = chapters.flatMap((ch) =>
  ch.faqs.map((f) => ({ ...f, chapterTitle: ch.title, chapterSlug: ch.slug }))
);
---
<Layout title="వెతకండి - తెలంగాణ చరిత్ర FAQs" description="అన్ని ప్రశ్నలలో వెతకండి">
  <a href="/">&larr; అన్ని అధ్యాయాలు</a>
  <h1 style="margin-top:12px;">వెతకండి</h1>
  <input type="search" id="search-box" placeholder="ప్రశ్న టైప్ చేయండి" />
  <div id="results" style="display:flex; flex-direction:column; gap:8px;"></div>

  <script define:vars={{ allFaqs }}>
    const box = document.getElementById('search-box');
    const results = document.getElementById('results');
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q') || '';
    box.value = initialQ;

    function runSearch(term) {
      const t = term.trim();
      if (!t) { results.innerHTML = ''; return; }
      const matches = allFaqs.filter((f) => f.q.includes(t) || f.a.includes(t));
      results.innerHTML = matches.slice(0, 50).map((f) => `
        <div style="border:1px solid var(--border); border-radius:8px; padding:12px 14px; background:var(--card);">
          <p style="margin:0 0 4px; font-size:13px; color:var(--muted);">${f.chapterTitle}</p>
          <p style="margin:0 0 6px; font-weight:700;">${f.q}</p>
          <p style="margin:0; color:var(--success-text);">${f.a}</p>
        </div>
      `).join('') || `<p style="color:var(--muted);">ఫలితాలు లేవు</p>`;
    }

    box.addEventListener('input', () => runSearch(box.value));
    if (initialQ) runSearch(initialQ);
  </script>
</Layout>
