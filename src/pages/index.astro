---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// Chapter counts are derived from real data files — same technique used on
// /subjects/index.astro — so a subject can NEVER show as "Available" here
// unless it actually has chapters. This is what prevents the earlier bug
// where a subject was manually flagged available during testing but had
// no chapters yet.
const chapterFiles = import.meta.glob('../data/*/*.json', { eager: true });
const countsBySubject = {};
const questionCountsBySubject = {};
for (const [path, mod] of Object.entries(chapterFiles)) {
  const subjectKey = path.split('/').slice(-2, -1)[0];
  const items = Array.isArray(mod.default) ? mod.default : [mod.default];
  const valid = items.filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber);
  countsBySubject[subjectKey] = (countsBySubject[subjectKey] || 0) + valid.length;
  const questionsInFile = valid.reduce((sum, ch) => sum + ch.faqs.length, 0);
  questionCountsBySubject[subjectKey] = (questionCountsBySubject[subjectKey] || 0) + questionsInFile;
}

// Design/display config only — NOT what controls live vs coming-soon.
// `popular` is still a manual editorial choice, that's fine to hardcode.
const SUBJECT_CONFIG = [
  {
    titleNative: 'Telangana History',
    titleEnglish: 'English Version',
    slug: 'telangana-history-en',
    icon: 'book',
    popular: true,
  },
  {
    titleNative: 'తెలంగాణ చరిత్ర',
    titleEnglish: 'Telugu Version',
    slug: 'telangana-history-te',
    icon: 'book',
    popular: true,
  },
  {
    titleNative: 'Telangana Economy',
    titleEnglish: 'English Version',
    slug: 'telangana-economy-en',
    icon: 'chart',
    popular: false,
  },

    {
    titleNative: 'తెలంగాణ ఆర్థిక వ్యవస్థ',
    titleEnglish: 'Telugu Version',
    slug: 'telangana-economy-te',
    icon: 'chart',
    popular: false,
  },
  {
  titleNative: 'Indian History (Ancient, Medieval and Modern)',
  titleEnglish: 'English Version',
  slug: 'indian-history-en',
  icon: 'book',
  popular: false,
},

  {
    titleNative: 'Indian Polity',
    titleEnglish: 'English Version',
    slug: 'indian-polity-en',
    icon: 'gavel',
    popular: false,
  },
  {
    titleNative: 'భారత రాజ్యాంగం',
    titleEnglish: 'Telugu Version',
    slug: 'indian-polity-te',
    icon: 'gavel',
    popular: false,
  },
];

// Long titles with a parenthetical qualifier (e.g. "Indian History
// (Ancient, Medieval and Modern)") wrap awkwardly mid-phrase in the
// narrow card layout. Split right before the "(" so the template can
// force a clean break there instead — same technique as /subjects/.
function splitTitleParts(title) {
  const idx = title.indexOf(' (');
  if (idx === -1) return [title];
  return [title.slice(0, idx), title.slice(idx + 1)];
}

const subjects = SUBJECT_CONFIG.map((s) => {
  const chapterCount = countsBySubject[s.slug] || 0;
  const questionCount = questionCountsBySubject[s.slug] || 0;
  return {
    ...s,
    chapterCount,
    questionCount,
    titleParts: splitTitleParts(s.titleNative),
    available: chapterCount > 0,
  };
}).sort((a, b) => {
  if (a.available !== b.available) return a.available ? -1 : 1;
  if (a.popular !== b.popular) return a.popular ? -1 : 1;
  return 0;
});

const iconMap = {
  book: 'ti-book',
  chart: 'ti-chart-bar',
  gavel: 'ti-gavel',
};
---
<Layout title="StudyHelp - TSPSC, APPSC and State PSC Exam Preparation" description="Study help for TSPSC, APPSC and other state PSC exams. Subject-wise MCQs, chapter by chapter.">

  <Header active="home" />

  <div class="page-wide">

    <div class="hero-card" id="hero-card">
      <h1 class="hero-title">Your shortcut to cracking <span class="hero-accent">TSPSC</span>, <span class="hero-accent">APPSC</span> and other state PSC exams</h1>
      <p class="hero-sub">Complete Exam Preparation, organized chapter by chapter</p>
      <div class="hero-hook-row">
        <span class="hero-hook-pill"><span class="hero-hook-spark">&#9889;</span>Free to start</span>
        <span class="hero-hook-pill">15000+ questions</span>
        <a href="/current-affairs/" class="hero-hook-pill hero-hook-pill-ca">Current Affairs 2026</a>
      </div>
      <a href="/papers/" class="hero-papers-btn">
        <i class="ti ti-file-text hero-papers-icon" aria-hidden="true"></i>
        <span>All Previous Question Papers</span>
      </a>
    </div>

    <p class="section-label">Subjects</p>

    <div class="subject-list">
      {subjects.map((s) => (
        s.available ? (
          <a href={`/${s.slug}/`} class="subject-card subject-card-live" data-subject-slug={s.slug}>
            <span class="avail-pill" data-pill hidden aria-label="Purchased"><i class="ti ti-check" aria-hidden="true"></i></span>
            <div class="subject-card-header">
              <div class="subject-icon">
                <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
              </div>
              <div class="subject-native">
                {s.titleParts.length === 2
                  ? <>{s.titleParts[0]}<br />{s.titleParts[1]}</>
                  : s.titleNative}
              </div>
            </div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count">
              {s.chapterCount} {s.chapterCount === 1 ? 'chapter' : 'chapters'}
              {s.questionCount > 0 && <> &middot; {s.questionCount.toLocaleString('en-IN')} MCQs</>}
            </span>
          </a>
        ) : (
          <div class="subject-card subject-card-soon">
            <div class="subject-card-header">
              <div class="subject-icon subject-icon-muted">
                <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
              </div>
              <div class="subject-native">
                {s.titleParts.length === 2
                  ? <>{s.titleParts[0]}<br />{s.titleParts[1]}</>
                  : s.titleNative}
              </div>
            </div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count-muted">coming soon</span>
          </div>
        )
      ))}
    </div>

    <div id="login-banner" class="login-banner">
      <span class="login-banner-text">Already purchased a subject? Log in to continue reading.</span>
      <a href="/login/" class="login-banner-btn">Log in</a>
    </div>

  </div>

  <style is:global>
    .page-wide {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }
    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    .hero-card {
      position: relative;
      overflow: hidden;
      border-radius: 20px;
      padding: 2.25rem 1.25rem;
      text-align: center;
      margin-bottom: 1.5rem;
      background: linear-gradient(160deg, #14102b 0%, #241a4d 45%, #3d2374 100%);
      box-shadow: 0 12px 30px -12px rgba(20, 16, 43, 0.5);
    }
    .hero-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 15% 20%, rgba(255, 154, 60, 0.18), transparent 40%),
        radial-gradient(circle at 85% 85%, rgba(139, 92, 246, 0.25), transparent 45%);
      pointer-events: none;
    }
    .hero-title {
      position: relative;
      margin: 0 0 6px;
      font-size: 21px;
      color: #ffffff;
    }
    .hero-accent {
      background: linear-gradient(90deg, #ff9a3c, #ffcb8a);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-sub {
      position: relative;
      color: rgba(255, 255, 255, 0.72);
      font-size: 14px;
      margin: 0 0 1.1rem;
    }
    .hero-hook-row {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }
    .hero-hook-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(90deg, #ff9a3c, #ffb35c);
      color: #2a1400;
      font-weight: 700;
      font-size: 12.5px;
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      white-space: nowrap;
      box-shadow: 0 8px 18px -6px rgba(255, 154, 60, 0.55);
    }
    .hero-hook-spark { font-size: 14px; line-height: 1; }

    /* Current Affairs pill: deliberately a different color from the two
       "Free to start"/"15000+ questions" pills — those are plain
       informational badges, this one is an actual link to a different
       page, so it needs to visually read as a separate, clickable thing
       rather than a third badge in the same set (especially on mobile,
       where the row wraps and a same-colored third pill blends into the
       first two as one continuous phrase). */
    .hero-hook-pill-ca {
      text-decoration: none;
      cursor: pointer;
    }

    .hero-papers-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 22px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-size: 13px;
      font-weight: 700;
      line-height: 1;
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
    }
    .hero-papers-icon {
      font-size: 15px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
    }
    .hero-papers-btn:active {
      background: rgba(255, 255, 255, 0.16);
    }

    @media (max-width: 640px) {
      .hero-card { padding: 1rem 0.9rem; border-radius: 16px; margin-bottom: 1rem; }
      .hero-title { font-size: 16px; margin-bottom: 4px; }
      .hero-sub { font-size: 12px; margin-bottom: 0.7rem; }
      .hero-hook-pill { font-size: 10.5px; padding: 0.4rem 0.7rem; gap: 4px; }
      .hero-hook-spark { font-size: 12px; }
      .hero-papers-btn { margin-top: 12px; font-size: 11.5px; padding: 8px 14px; }
      .hero-papers-icon { font-size: 13px; }
    }

    .section-label {
      font-size: 14px;
      font-weight: 600;
      margin: 0 0 10px;
    }

    .subject-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 1.5rem;
    }
    .subject-card {
      display: block;
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border-radius: 14px;
      padding: 1.25rem;
      text-decoration: none;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      transition: transform 0.12s ease;
    }
    .subject-card-live {
      border: 1px solid #ff9a3c;
    }
    .subject-card-live:active {
      transform: scale(0.98);
    }
    /* Owned subjects: swap the orange border for a soft green glow so the
       card itself reads as "yours" at a glance, not just the badge. */
    .subject-card-live.has-pill {
      border-color: #3fd88a;
      box-shadow: 0 0 0 1px rgba(63, 216, 138, 0.25), 0 0 8px rgba(63, 216, 138, 0.18);
      overflow: visible; /* lets the checkmark badge sit half outside the card edge */
    }
    .subject-card-soon {
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #ffffff;
      opacity: 0.55;
    }
    .subject-card-soon .subject-native { color: #ffffff; }
    .subject-card-soon .subject-english { color: rgba(255, 255, 255, 0.6); }
    .subject-card-soon .subject-icon-muted { background: rgba(255, 255, 255, 0.08); }
    .subject-card-soon .subject-icon-muted i { color: rgba(255, 255, 255, 0.5); }
    .subject-card-soon .subject-count-muted { color: rgba(255, 255, 255, 0.5); }
    .avail-pill {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 22px;
      height: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(90deg, #2fb35c, #4dd67e);
      color: #06280f;
      border-radius: 50%;
      box-shadow: 0 2px 6px -1px rgba(0,0,0,0.5);
    }
    .avail-pill i { font-size: 13px; font-weight: 700; }
    .avail-pill[hidden] { display: none; }
    .subject-card-header {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 0;
    }
    /* The Purchased checkmark badge is a small 22px corner circle, not a
       text pill — it no longer needs to reserve header space; titles wrap
       exactly the same as on non-owned cards. */
    .subject-icon {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: rgba(255, 154, 60, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .subject-icon i { font-size: 16px; color: #ff9a3c; }
    .subject-icon-muted { background: var(--bg); }
    .subject-icon-muted i { color: var(--muted); }
    .subject-native { flex: 1; min-width: 0; font-weight: 700; font-size: 15px; line-height: 1.25; }
    .subject-card-live .subject-native { color: #ffffff; }
    .subject-card-live .subject-english { color: rgba(255, 255, 255, 0.65); }
    .subject-english {
      font-size: 13px;
      line-height: 1.3;
      color: var(--muted);
      margin: 0 0 10px;
      padding-left: 42px; /* icon width (32px) + header gap (10px) */
    }
    .subject-count {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #ffcb8a;
      padding-left: 42px;
    }
    .subject-count-muted {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      padding-left: 42px;
    }

    /* Mobile: compact 2-column capsule cards, same class names as desktop. */
    @media (max-width: 720px) {
      .subject-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .subject-card {
        border-radius: 16px;
        padding: 0.9rem;
      }
      .avail-pill {
        top: -6px;
        right: -6px;
        width: 18px;
        height: 18px;
      }
      .avail-pill i { font-size: 11px; }
      .subject-card-header {
        gap: 8px;
        margin-bottom: 0;
      }
      .subject-icon {
        width: 26px;
        height: 26px;
        border-radius: 8px;
      }
      .subject-icon i { font-size: 13px; }
      .subject-native {
        font-size: 13px;
        line-height: 1.3;
      }
      .subject-english {
        font-size: 11px;
        line-height: 1.3;
        margin: 0 0 8px;
        padding-left: 34px; /* mobile icon (26px) + header gap (8px) */
      }
      .subject-count,
      .subject-count-muted {
        font-size: 11px;
        padding-left: 34px; /* mobile icon (26px) + header gap (8px) */
      }
    }

    .login-banner {
      position: relative;
      overflow: hidden;
      background: linear-gradient(160deg, #1a1438 0%, #241a4d 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .login-banner-text {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.72);
    }
    .login-banner-btn {
      font-size: 13px;
      font-weight: 700;
      padding: 8px 18px;
      border: none;
      border-radius: 999px;
      text-decoration: none;
      background: linear-gradient(90deg, #ff9a3c, #ffb35c);
      color: #2a1400;
      white-space: nowrap;
      box-shadow: 0 8px 18px -6px rgba(255, 154, 60, 0.45);
    }
    @media (max-width: 900px) {
      .login-banner {
        display: none !important;
      }
      body.is-logged-in #hero-card {
        display: none;
      }
    }
  </style>

  <script define:vars={{ subjects }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Session is fetched ONCE per page by Header.astro (which runs synchronously
    // inline, before this script) and exposed on window.__shSessionPromise.
    // Reusing that single promise here — instead of this page's own separate
    // getSession() — avoids duplicate /me calls. Both usages below (login
    // banner + purchased-subject reordering) now share the SAME request.
    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    getSession().then((data) => {
      if (data.logged_in) {
        const banner = document.getElementById('login-banner');
        if (banner) banner.style.display = 'none';
        document.body.classList.add('is-logged-in');
      }
    });

    // Purchased subjects jump to the very front of the grid — ahead of
    // Popular and everything else — once ownership is known. Popular-first
    // ordering among the rest is already baked into the server-rendered
    // order above, so this only needs to handle the "purchased" override.
    // Reuses the SAME getSession() promise as above — no second /me call.
    getSession().then(async (session) => {
      if (!session.logged_in) return;

      const grid = document.querySelector('.subject-list');
      const available = subjects.filter((s) => s.available);
      const ownedSlugs = [];

      await Promise.all(
        available.map((s) =>
          fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(s.slug)}`)
            .then((res) => res.json())
            .then((d) => {
              if (!d.unlocked) return;
              ownedSlugs.push(s.slug);
              const card = document.querySelector(`[data-subject-slug="${s.slug}"]`);
              const pill = card && card.querySelector('[data-pill]');
              if (pill) {
                pill.hidden = false;
                card.classList.add('has-pill');
              }
            })
            .catch(() => {})
        )
      );

      if (ownedSlugs.length > 0 && grid) {
        // Insert purchased cards at the start, in the order they were found,
        // ahead of Popular/available/coming-soon which already sit in order.
        ownedSlugs.slice().reverse().forEach((slug) => {
          const card = document.querySelector(`[data-subject-slug="${slug}"]`);
          if (card) grid.prepend(card);
        });
      }
    });
  </script>
</Layout>
