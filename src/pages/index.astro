---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// Chapter counts are derived from real data files — same technique used on
// /subjects/index.astro — so a subject can NEVER show as "Available" here
// unless it actually has chapters. This is what prevents the earlier bug
// where a subject was manually flagged available during testing but had
// no chapters yet.
const chapterFiles = import.meta.glob('../data/*/*.json', { eager: true });
const countsBySubject = {};
for (const [path, mod] of Object.entries(chapterFiles)) {
  const subjectKey = path.split('/').slice(-2, -1)[0];
  const items = Array.isArray(mod.default) ? mod.default : [mod.default];
  const valid = items.filter((ch) => ch && Array.isArray(ch.faqs) && ch.slug && ch.chapterNumber);
  countsBySubject[subjectKey] = (countsBySubject[subjectKey] || 0) + valid.length;
}

// Design/display config only — NOT what controls live vs coming-soon.
// `popular` is still a manual editorial choice, that's fine to hardcode.
const SUBJECT_CONFIG = [
  {
    titleNative: 'తెలంగాణ చరిత్ర',
    titleEnglish: 'Telugu Version',
    slug: 'telangana-history-te',
    icon: 'book',
    popular: true,
  },
  {
    titleNative: 'Telangana economy',
    titleEnglish: 'English Version',
    slug: 'telangana-economy-en',
    icon: 'chart',
    popular: false,
  },
  {
    titleNative: 'Telangana history',
    titleEnglish: 'English Version',
    slug: 'telangana-history-en',
    icon: 'book',
    popular: false,
  },
  {
    titleNative: 'తెలంగాణ ఆర్థిక వ్యవస్థ',
    titleEnglish: 'Telugu Version',
    slug: 'telangana-economy-te',
    icon: 'chart',
    popular: false,
  },
  {
    titleNative: 'Indian polity',
    titleEnglish: 'English Version',
    slug: 'indian-polity-en',
    icon: 'gavel',
    popular: false,
  },
  {
    titleNative: 'భారత రాజ్యాంగం',
    titleEnglish: 'Telugu Version',
    slug: 'indian-polity-te',
    icon: 'gavel',
    popular: false,
  },
];

const subjects = SUBJECT_CONFIG.map((s) => {
  const chapterCount = countsBySubject[s.slug] || 0;
  return { ...s, chapterCount, available: chapterCount > 0 };
}).sort((a, b) => {
  if (a.available !== b.available) return a.available ? -1 : 1;
  if (a.popular !== b.popular) return a.popular ? -1 : 1;
  return 0;
});

const iconMap = {
  book: 'ti-book',
  chart: 'ti-chart-bar',
  gavel: 'ti-gavel',
};
---
<Layout title="StudyHelp - TSPSC and TS exam preparation" description="Study help for TSPSC and TS exams. Subject-wise FAQs, chapter by chapter.">

  <Header active="home" />

  <div class="page-wide">

    <div class="hero-card" id="hero-card">
      <h1 class="hero-title">Study help for TSPSC and TS exams</h1>
      <p class="hero-sub">Pick a subject to start reading FAQs, chapter by chapter</p>
      <p class="hero-note">Free to start, no login needed</p>
    </div>

    <p class="section-label">Subjects</p>

    <div class="subject-list">
      {subjects.map((s) => (
        s.available ? (
          <a href={`/${s.slug}/`} class={`subject-card subject-card-live ${s.popular ? 'subject-card-popular' : ''}`} data-subject-slug={s.slug}>
            <span class="avail-pill" data-pill>Available</span>
            {s.popular && <span class="popular-badge">Popular</span>}
            <div class="subject-icon">
              <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
            </div>
            <div class="subject-native">{s.titleNative}</div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count">{s.chapterCount} chapters</span>
          </a>
        ) : (
          <div class="subject-card subject-card-soon">
            <div class="subject-icon subject-icon-muted">
              <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
            </div>
            <div class="subject-native">{s.titleNative}</div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count-muted">coming soon</span>
          </div>
        )
      ))}
    </div>

    <div id="login-banner" class="login-banner">
      <span class="login-banner-text">Already purchased a subject? Log in to continue reading.</span>
      <a href="/login/" class="login-banner-btn">Log in</a>
    </div>

  </div>

  <style is:global>
    .page-wide {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }
    @media (max-width: 900px) {
      .page-wide {
        padding: 16px 16px calc(64px + var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
      }
    }

    .hero-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 2.25rem 1.25rem;
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .hero-title { margin: 0 0 6px; font-size: 21px; }
    .hero-sub { color: var(--muted); font-size: 14px; margin: 0 0 4px; }
    .hero-note { color: var(--muted); font-size: 12px; margin: 0; opacity: 0.8; }

    .section-label {
      font-size: 14px;
      font-weight: 600;
      margin: 0 0 10px;
    }

    .subject-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 1.5rem;
    }
    .subject-card {
      display: block;
      background: var(--card);
      border-radius: 14px;
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      position: relative;
      transition: transform 0.12s ease;
    }
    .subject-card-live {
      border: 1px solid var(--accent);
    }
    .subject-card-live:active {
      transform: scale(0.98);
    }
    .subject-card-soon {
      border: 1px solid var(--border);
      opacity: 0.6;
    }
    .avail-pill {
      position: absolute;
      top: 14px;
      right: 14px;
      background: var(--success-bg);
      color: var(--success-text);
      font-size: 11px;
      font-weight: 500;
      padding: 3px 9px;
      border-radius: 20px;
    }
    .popular-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: var(--accent-bg);
      color: var(--accent);
      font-size: 11px;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 20px;
    }
    /* When a card has the Popular badge, the icon needs extra top clearance
       so it doesn't sit underneath the badges row. Cards without Popular
       are untouched — icon stays flush at its normal position. */
    .subject-card-popular .subject-icon {
      margin-top: 28px;
    }
    .subject-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--accent-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }
    .subject-icon i { font-size: 18px; color: var(--accent); }
    .subject-icon-muted { background: var(--bg); }
    .subject-icon-muted i { color: var(--muted); }
    .subject-native { font-weight: 700; font-size: 15px; }
    .subject-english { font-size: 13px; color: var(--muted); margin: 2px 0 10px; }
    .subject-count { font-size: 12px; color: var(--accent); font-weight: 600; }
    .subject-count-muted { font-size: 12px; color: var(--muted); }

    /* Mobile: compact 2-column capsule cards, same class names as desktop. */
    @media (max-width: 900px) {
      .subject-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .subject-card {
        border-radius: 16px;
        padding: 0.9rem;
      }
      .avail-pill {
        top: 10px;
        right: 10px;
        font-size: 10px;
        padding: 2px 8px;
      }
      .popular-badge {
        top: 10px;
        left: 10px;
        font-size: 10px;
        padding: 2px 8px;
      }
      .subject-card-popular .subject-icon {
        margin-top: 22px;
      }
      .subject-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        margin-bottom: 8px;
      }
      .subject-icon i { font-size: 15px; }
      .subject-native {
        font-size: 13px;
        line-height: 1.3;
      }
      .subject-english {
        font-size: 11px;
        margin: 2px 0 8px;
      }
      .subject-count,
      .subject-count-muted {
        font-size: 11px;
      }
    }

    .login-banner {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .login-banner-text {
      font-size: 13px;
      color: var(--muted);
    }
    .login-banner-btn {
      font-size: 13px;
      padding: 6px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      color: var(--text);
      white-space: nowrap;
    }
    @media (max-width: 900px) {
      .login-banner {
        display: none !important;
      }
      body.is-logged-in #hero-card {
        display: none;
      }
    }
  </style>

  <script define:vars={{ subjects }}>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Session is fetched ONCE per page by Header.astro (which runs synchronously
    // inline, before this script) and exposed on window.__shSessionPromise.
    // Reusing that single promise here — instead of this page's own separate
    // getSession() — avoids duplicate /me calls. Both usages below (login
    // banner + purchased-subject reordering) now share the SAME request.
    function getSession() {
      if (window.__shSessionPromise) return window.__shSessionPromise;
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    getSession().then((data) => {
      if (data.logged_in) {
        const banner = document.getElementById('login-banner');
        if (banner) banner.style.display = 'none';
        document.body.classList.add('is-logged-in');
      }
    });

    // Purchased subjects jump to the very front of the grid — ahead of
    // Popular and everything else — once ownership is known. Popular-first
    // ordering among the rest is already baked into the server-rendered
    // order above, so this only needs to handle the "purchased" override.
    // Reuses the SAME getSession() promise as above — no second /me call.
    getSession().then(async (session) => {
      if (!session.logged_in) return;

      const grid = document.querySelector('.subject-list');
      const available = subjects.filter((s) => s.available);
      const ownedSlugs = [];

      await Promise.all(
        available.map((s) =>
          fetch(`${WORKER_URL}/check-access?user_id=${encodeURIComponent(session.user_id)}&subject_id=${encodeURIComponent(s.slug)}`)
            .then((res) => res.json())
            .then((d) => {
              if (!d.unlocked) return;
              ownedSlugs.push(s.slug);
              const card = document.querySelector(`[data-subject-slug="${s.slug}"]`);
              const pill = card && card.querySelector('[data-pill]');
              if (pill) pill.textContent = 'Purchased';
            })
            .catch(() => {})
        )
      );

      if (ownedSlugs.length > 0 && grid) {
        // Insert purchased cards at the start, in the order they were found,
        // ahead of Popular/available/coming-soon which already sit in order.
        ownedSlugs.slice().reverse().forEach((slug) => {
          const card = document.querySelector(`[data-subject-slug="${slug}"]`);
          if (card) grid.prepend(card);
        });
      }
    });
  </script>
</Layout>
