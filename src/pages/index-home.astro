---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const subjects = [
  {
    titleNative: 'తెలంగాణ చరిత్ర',
    titleEnglish: 'Telangana history',
    slug: 'telangana-history-te',
    chapterCount: 31,
    icon: 'book',
    available: true,
  },
  {
    titleNative: 'Telangana economy',
    titleEnglish: 'English',
    slug: 'telangana-economy-en',
    chapterCount: 20,
    icon: 'chart',
    available: true,
  },
  {
    titleNative: 'Telangana history',
    titleEnglish: 'English',
    slug: 'telangana-history-en',
    chapterCount: 0,
    icon: 'book',
    available: false,
  },
  {
    titleNative: 'తెలంగాణ ఆర్థిక వ్యవస్థ',
    titleEnglish: 'Telangana economy',
    slug: 'telangana-economy-te',
    chapterCount: 0,
    icon: 'chart',
    available: false,
  },
];

const iconMap = {
  book: 'ti-book',
  chart: 'ti-chart-bar',
};
---
<Layout title="StudyHelp - TSPSC and TS exam preparation" description="Study help for TSPSC and TS exams. Subject-wise FAQs, chapter by chapter.">

  <Header active="home" />

  <div class="content">

    <div class="hero-card">
      <h1 class="hero-title">Study help for TSPSC and TS exams</h1>
      <p class="hero-sub">Pick a subject to start reading FAQs, chapter by chapter</p>
      <p class="hero-note">Free to start, no login needed</p>
    </div>

    <p class="section-label">Subjects</p>

    <div class="subject-list">
      {subjects.map((s) => (
        s.available ? (
          <a href={`/${s.slug}/`} class="subject-card subject-card-live">
            <span class="avail-pill">Available</span>
            <div class="subject-icon">
              <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
            </div>
            <div class="subject-native">{s.titleNative}</div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count">{s.chapterCount} chapters</span>
          </a>
        ) : (
          <div class="subject-card subject-card-soon">
            <div class="subject-icon subject-icon-muted">
              <i class={`ti ${iconMap[s.icon]}`} aria-hidden="true"></i>
            </div>
            <div class="subject-native">{s.titleNative}</div>
            <div class="subject-english">{s.titleEnglish}</div>
            <span class="subject-count-muted">coming soon</span>
          </div>
        )
      ))}
    </div>

    <div id="login-banner" class="login-banner">
      <span class="login-banner-text">Already purchased a subject? Log in to continue reading, no limits.</span>
      <a href="/login/" class="login-banner-btn">Log in</a>
    </div>

  </div>

  <style>
    .hero-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 2.25rem 1.25rem;
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .hero-title { margin: 0 0 6px; font-size: 21px; }
    .hero-sub { color: var(--muted); font-size: 14px; margin: 0 0 4px; }
    .hero-note { color: var(--muted); font-size: 12px; margin: 0; opacity: 0.8; }

    .section-label {
      font-size: 14px;
      font-weight: 600;
      margin: 0 0 10px;
    }

    .subject-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 1.5rem;
    }
    .subject-card {
      display: block;
      background: var(--card);
      border-radius: 14px;
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      position: relative;
      transition: transform 0.12s ease;
    }
    .subject-card-live {
      border: 1px solid var(--accent);
    }
    .subject-card-live:active {
      transform: scale(0.98);
    }
    .subject-card-soon {
      border: 1px solid var(--border);
      opacity: 0.6;
    }
    .avail-pill {
      position: absolute;
      top: 14px;
      right: 14px;
      background: var(--success-bg);
      color: var(--success-text);
      font-size: 11px;
      font-weight: 500;
      padding: 3px 9px;
      border-radius: 20px;
    }
    .subject-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--accent-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }
    .subject-icon i { font-size: 18px; color: var(--accent); }
    .subject-icon-muted { background: var(--bg); }
    .subject-icon-muted i { color: var(--muted); }
    .subject-native { font-weight: 700; font-size: 15px; }
    .subject-english { font-size: 13px; color: var(--muted); margin: 2px 0 10px; }
    .subject-count { font-size: 12px; color: var(--accent); font-weight: 600; }
    .subject-count-muted { font-size: 12px; color: var(--muted); }

    .login-banner {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .login-banner-text {
      font-size: 13px;
      color: var(--muted);
    }
    .login-banner-btn {
      font-size: 13px;
      padding: 6px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      color: var(--text);
      white-space: nowrap;
    }
  </style>

  <script>
    // Real session check (replaces the old localStorage email placeholder).
    // Same cached /me pattern as Header.astro — this reads the cache Header
    // already populated on this page load rather than firing a second fetch.
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';
    const SESSION_CACHE_KEY = 'sh_session_cache';
    const SESSION_CACHE_TTL = 5 * 60 * 1000;

    function getCachedSession() {
      try {
        const raw = sessionStorage.getItem(SESSION_CACHE_KEY);
        if (!raw) return null;
        const cached = JSON.parse(raw);
        if (Date.now() - cached.ts > SESSION_CACHE_TTL) return null;
        return cached.data.logged_in ? cached.data : null;
      } catch (err) {
        return null;
      }
    }

    function getSession() {
      const cached = getCachedSession();
      if (cached) return Promise.resolve(cached);
      return fetch(`${WORKER_URL}/me`, { credentials: 'include' })
        .then((res) => res.json())
        .catch(() => ({ logged_in: false }));
    }

    getSession().then((data) => {
      if (data.logged_in) {
        const banner = document.getElementById('login-banner');
        if (banner) banner.style.display = 'none';
      }
    });
  </script>
</Layout>
