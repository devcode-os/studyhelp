---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---
<Layout title="Sign Up - StudyHelp" description="Create your StudyHelp account with just a phone number and passcode.">
  <Header active="signup" theme="premium" />

  <script is:inline>
    // Prevent the browser's own scroll-restoration from fighting the
    // instant-jump below — e.g. tapping back/forward on mobile can
    // otherwise snap the page to whatever scroll position it had before,
    // right after our script has already placed it at the heading.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
  </script>

  <div class="page-wide auth-page">
    <div class="auth-card">
      <div class="auth-icon"><i class="ti ti-user-plus"></i></div>
      <h1 id="signup-heading">Create your account</h1>
      <script is:inline>
        // On mobile, jump straight past the header/logo bar so the page
        // opens right at "Create your account" instead of showing the
        // header first — like an in-page anchor jump. Placed here, right
        // after the h1, deliberately — a script running any earlier in
        // source order executes before this element exists in the DOM,
        // so getElementById would silently return null and never scroll.
        function jumpToHeading() {
          if (!window.matchMedia('(max-width: 900px)').matches) return;
          var heading = document.getElementById('signup-heading');
          if (!heading) return;
          var y = heading.getBoundingClientRect().top + window.scrollY - 12;
          window.scrollTo(0, y);
        }
        jumpToHeading();
        // Reapply once everything (including the Telugu web font) has
        // finished loading — a late font swap can reflow the header and
        // shift the heading's position after our first, earlier jump.
        window.addEventListener('load', jumpToHeading);
      </script>
      <div id="purchase-context-banner" class="purchase-banner" style="display:none;">
        <div class="purchase-banner-row">
          <i class="ti ti-lock-open" aria-hidden="true"></i>
          <span id="purchase-context-lead"></span>
        </div>
        <div id="purchase-context-pill" class="purchase-subject-pill"></div>
        <p id="purchase-context-tail" class="purchase-banner-tail"></p>
      </div>

      <script is:inline>
        // No flash of the phone form: it stays hidden from the first paint until
        // /google-auth.js decides (Google button + "Sign up with phone number", or
        // the full form if Google can't run). 4s safety so the form can never stay
        // hidden if that script fails to load.
        document.documentElement.classList.add('shg-hold');
        setTimeout(function () { document.documentElement.classList.remove('shg-hold'); }, 4000);
      </script>
      <!-- Google sign-in: hidden until /google-auth.js confirms it can run here
           (browser, or an app build that includes the native plugin). Keeps the
           ?next= redirect, so guests buying from a subject/plan/CA page still land
           on payment afterwards. -->
      <div id="google-auth" class="shg-wrap" style="display:none;">
        <div id="google-auth-slot"></div>
        <div id="google-auth-error" class="error-msg" style="display:none; margin-top:10px;">
          <i class="ti ti-alert-circle"></i><span id="google-auth-error-text"></span>
        </div>
        <div class="shg-or"><span>or</span></div>
        <!-- Only shown (by /google-auth.js) together with the Google button: the phone
             form below is collapsed until this is tapped. Without Google the full
             form is simply visible, exactly as before. -->
        <button type="button" id="phone-signup-toggle" class="shg-btn shg-btn-alt" style="display:none;">
          <i class="ti ti-phone" aria-hidden="true"></i><span>Sign up with phone number</span>
        </button>
      </div>

      <form id="signup-form">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" />

        <label for="phone">Phone number</label>
        <div class="phone-input">
          <span class="phone-prefix">+91</span>
          <input type="tel" id="phone" name="phone" required inputmode="numeric" maxlength="10" autocomplete="tel" placeholder="10-digit mobile number" />
        </div>

        <label for="recovery_email">Recovery email</label>
        <input type="email" id="recovery_email" name="recovery_email" required autocomplete="email" placeholder="you@example.com" />
        <p class="hint"><i class="ti ti-info-circle"></i> If you forget your passcode, a reset code goes here.</p>

        <label for="passcode">6-digit passcode</label>
        <input type="text" id="passcode" name="passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

        <label for="confirm_passcode">Confirm passcode</label>
        <input type="text" id="confirm_passcode" name="confirm_passcode" required inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="code-input" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />

        <div id="error-msg" class="error-msg" style="display:none;">
          <i class="ti ti-alert-circle"></i><span id="error-text"></span>
        </div>

        <button type="submit" class="btn-block" id="submit-btn">
          <span class="btn-label">Create account</span>
          <i class="ti ti-loader-2 btn-spinner" style="display:none;"></i>
        </button>
      </form>

      <p class="alt-action">Already have an account? <a href="/login/" id="login-link">Log in</a></p>
    </div>
  </div>

  <style is:global>
    html.shg-hold #signup-form { display: none !important; }
    html.shg-hold #google-auth { display: block !important; visibility: hidden; min-height: 165px; }
    body.sh2-page { background: #EEEDF6; }
    html[data-theme="dark"] body.sh2-page { background: #121120; }

    .page-wide {
      --sh2-bg: #EEEDF6;
      --sh2-surface: #FFFFFF;
      --sh2-surface-2: #F6F5FC;
      --sh2-ink: #1C1A38;
      --sh2-indigo: #4B3FA0;
      --sh2-indigo-deep: #2E2570;
      --sh2-indigo-soft: #EEEAFB;
      --sh2-green: #26946A;
      --sh2-text: #211F38;
      --sh2-text-soft: #726F92;
      --sh2-line: #E7E4F5;
      --sh2-shadow: 0 1px 2px rgba(33,31,61,0.05), 0 14px 28px -14px rgba(46,37,112,0.22);
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    @media (min-width: 1200px) {
      .page-wide {
        max-width: 800px;
      }
    }
    html[data-theme="dark"] .page-wide {
      --sh2-bg: #121120;
      --sh2-surface: #1C1A30;
      --sh2-surface-2: #242138;
      --sh2-ink: #F3F1FC;
      --sh2-indigo: #A594F5;
      --sh2-indigo-deep: #7A6CD9;
      --sh2-indigo-soft: #2A2650;
      --sh2-green: #5FCB9B;
      --sh2-text: #EFEDFB;
      --sh2-text-soft: #9C97BE;
      --sh2-line: #302C4E;
      --sh2-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 14px 28px -14px rgba(0,0,0,0.55);
    }
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&display=swap');

    .auth-page {
      max-width: 440px !important;
      overflow-anchor: none;
    }
    @media (max-width: 900px) {
      .auth-page {
        padding: 16px 16px calc(64px + var(--tabbar-h, 58px) + env(safe-area-inset-bottom, 0px));
      }
    }

    .auth-card {
      width: 100%;
      box-sizing: border-box;
      background: var(--sh2-surface);
      border: 1px solid var(--sh2-line);
      border-radius: 20px;
      padding: 32px 28px;
      box-shadow: var(--sh2-shadow);
      animation: card-in 0.35s ease-out;
      color: var(--sh2-ink);
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .auth-icon {
      width: 48px; height: 48px; border-radius: 14px;
      background: linear-gradient(135deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 16px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
    }
    .auth-card h1 {
      font-family: 'Manrope', sans-serif;
      font-size: 1.4rem; margin-bottom: 20px; color: var(--sh2-ink); font-weight: 800;
    }
    .auth-card .sub { margin-bottom: 22px; color: var(--sh2-text-soft); font-size: 0.86rem; }

    /* Purchase-context banner: only shown when signup was reached via a
       "Buy now" redirect. Indigo tint instead of the live amber tint. */
    .purchase-banner {
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px;
      background: var(--sh2-indigo-soft);
      border: 1px solid rgba(75,63,160,0.3);
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 16px;
      animation: card-in 0.4s ease-out;
    }
    .purchase-banner-row { display: flex; align-items: center; justify-content: center; gap: 8px; }
    .purchase-banner-row i { font-size: 17px; color: var(--sh2-indigo); flex-shrink: 0; }
    .purchase-banner-row span { font-size: 0.84rem; color: var(--sh2-ink); }
    .purchase-subject-pill {
      display: inline-block;
      background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      border-radius: 8px; padding: 4px 12px; font-size: 0.94rem; font-weight: 700; color: #ffffff;
    }
    .purchase-banner-tail { font-size: 0.8rem; margin: 0; color: var(--sh2-text-soft); }

    .auth-card label {
      display: block; font-size: 0.78rem; font-weight: 700;
      color: var(--sh2-text-soft); margin: 16px 0 6px;
    }
    .auth-card input {
      margin-bottom: 0; width: 100%; box-sizing: border-box;
      padding: 11px 14px; border-radius: 12px; font-size: 0.95rem;
      background: var(--sh2-surface-2);
      border: 1.5px solid var(--sh2-line);
      color: var(--sh2-ink);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .auth-card input::placeholder { color: var(--sh2-text-soft); opacity: 0.7; }
    .auth-card input:focus {
      outline: none;
      border-color: var(--sh2-indigo);
      box-shadow: 0 0 0 3px rgba(75,63,160,0.15);
      background: var(--sh2-surface);
    }
    .phone-input {
      display: flex; align-items: stretch;
      border: 1.5px solid var(--sh2-line);
      border-radius: 12px; overflow: hidden;
      background: var(--sh2-surface-2);
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .phone-input:focus-within {
      border-color: var(--sh2-indigo);
      box-shadow: 0 0 0 3px rgba(75,63,160,0.15);
      background: var(--sh2-surface);
    }
    .phone-prefix {
      display: flex; align-items: center; padding: 0 12px;
      background: transparent; color: var(--sh2-text-soft); font-weight: 700; font-size: 0.95rem;
      border-right: 1.5px solid var(--sh2-line);
    }
    .phone-input input { border: none; border-radius: 0; background: transparent; flex: 1; min-width: 0; }
    .phone-input input:focus { box-shadow: none; background: transparent; }
    .code-input {
      font-size: clamp(18px, 5.5vw, 24px); font-weight: 700;
      letter-spacing: clamp(4px, 2.2vw, 10px); text-align: center;
      font-family: monospace; padding-left: 8px; padding-right: 8px;
    }
    .code-input::placeholder { letter-spacing: clamp(4px, 2.2vw, 10px); }
    .hint {
      display: flex; align-items: center; gap: 6px;
      font-size: 0.72rem; color: var(--sh2-text-soft); margin: 6px 0 0;
    }
    @media (max-width: 720px) {
      .hint { align-items: flex-start; line-height: 1.4; }
      .hint i, .hint svg { margin-top: 2px; flex-shrink: 0; }
    }
    .error-msg {
      display: flex; align-items: center; gap: 8px;
      background: rgba(198,40,40,0.08); color: #c0392b;
      border-left: 3px solid #c0392b; padding: 10px 12px; border-radius: 8px;
      font-size: 0.82rem; margin: 16px 0 0;
    }
    html[data-theme="dark"] .error-msg { background: rgba(198,40,40,0.15); color: #ff9b93; }
    .btn-block {
      width: 100%; box-sizing: border-box; margin-top: 24px; padding: 13px; font-size: 0.95rem; font-weight: 700;
      border-radius: 12px; border: none;
      background: linear-gradient(90deg, var(--sh2-indigo), var(--sh2-indigo-deep));
      color: #ffffff; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 8px 16px -8px rgba(75,63,160,0.5);
      transition: transform 0.1s, opacity 0.15s;
    }
    .btn-block:hover:not(:disabled) { transform: translateY(-1px); }
    .btn-block:active:not(:disabled) { transform: translateY(0); }
    .btn-block:disabled { opacity: 0.65; cursor: not-allowed; }
    .btn-success { background: var(--sh2-green) !important; opacity: 1 !important; }
    .btn-spinner { animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .alt-action { text-align: center; margin-top: 22px; font-size: 0.82rem; color: var(--sh2-text-soft); }
    .alt-action a { color: var(--sh2-indigo); font-weight: 700; text-decoration: underline; }

    @media (max-width: 720px) {
      .auth-card { padding: 22px 18px; border-radius: 18px; }
      .auth-icon { display: none; }
      .auth-card h1 { font-size: 1.15rem; margin-bottom: 10px; }
      .auth-card .sub { font-size: 0.78rem; line-height: 1.3; margin-bottom: 10px; }
      .auth-card label { margin: 10px 0 4px; font-size: 0.72rem; }
      .auth-card input:not(.code-input) { padding: 9px 12px; font-size: 0.88rem; }
      .phone-prefix { padding: 0 8px; font-size: 0.88rem; }
      .hint { font-size: 0.66rem; margin-top: 3px; line-height: 1.3; }
      .code-input { padding-top: 8px; padding-bottom: 8px; font-size: clamp(16px, 5vw, 20px) !important; }
      .btn-block { padding: 11px; font-size: 0.88rem; margin-top: 14px; }
      .alt-action { margin-top: 12px; font-size: 0.78rem; }
    }
    @media (max-width: 380px) {
      .auth-card { padding: 16px 14px; }
    }
  </style>

  <script>
    const WORKER_URL = 'https://api.studyhelp.fdaytalk.com';

    // Purchase-context banner: if this signup was reached via the "Buy now"
    // redirect from the Plans page (?next=/plans/?buy=SUBJECT_SLUG), show a
    // persistent on-page explanation instead of relying on a toast that's
    // easy to miss and gone before it's read. Falls back to a formatted
    // version of the slug if the live subject title can't be fetched, so
    // the banner never blocks on a slow/failed network call.
    (function initPurchaseContext() {
      const rawNext = new URLSearchParams(window.location.search).get('next');
      if (!rawNext) return;

      let buySlug = null;
      let isBundle = false;
      let bundleSlugs = [];
      let caBuy = null;
      try {
        // 'next' is itself a URL-encoded path+query string, e.g.
        // "/plans/?buy=telangana-economy-en" — parse it as one.
        const nextParams = new URLSearchParams(rawNext.split('?')[1] || '');
        buySlug = nextParams.get('buy');
        isBundle = nextParams.get('mode') === 'bundle';
        if (isBundle) {
          bundleSlugs = (nextParams.get('subjects') || '').split(',').filter(Boolean);
        }
        const caBuyRaw = nextParams.get('ca_buy');
        if (caBuyRaw) {
          caBuy = JSON.parse(atob(decodeURIComponent(caBuyRaw)));
        }
      } catch (err) {}

      // Current Affairs PDF purchase — same context-banner treatment as
      // the Subjects buy flow, just a CA-specific pill instead of a
      // subject name. The actual item_ids/kind survive the redirect
      // inside the ca_buy param itself (base64 JSON), decoded here only
      // for display — the CA page re-decodes it after login to actually
      // resume the purchase (this banner never triggers payment itself).
      //
      // Pill text is derived directly from the item_id(s) themselves —
      // no extra fetch needed, since CA item_ids already encode exactly
      // what was picked (e.g. "current-affairs-august-2026" or
      // "current-affairs-last3-jun-jul-aug-2026").
      const MONTH_NAMES = {
        jan: 'January', feb: 'February', mar: 'March', apr: 'April',
        may: 'May', jun: 'June', jul: 'July', aug: 'August',
        sep: 'September', oct: 'October', nov: 'November', dec: 'December',
      };
      function prettifyCaItemId(id) {
        // Combined bundle: current-affairs-last3-jun-jul-aug-2026
        const bundleMatch = id.match(/^current-affairs-last\d+-([a-z-]+)-(\d{4})$/);
        if (bundleMatch) {
          const monthAbbrevs = bundleMatch[1].split('-');
          const year = bundleMatch[2];
          const names = monthAbbrevs.map((abbr) => MONTH_NAMES[abbr] || abbr);
          return `${names.join(', ')} ${year}`;
        }
        // Single month: current-affairs-august-2026
        const monthMatch = id.match(/^current-affairs-([a-z]+)-(\d{4})$/);
        if (monthMatch) {
          const fullName = monthMatch[1].charAt(0).toUpperCase() + monthMatch[1].slice(1);
          return `${fullName} ${monthMatch[2]}`;
        }
        return null; // unrecognized shape — caller falls back to a generic label
      }

      if (caBuy && Array.isArray(caBuy.item_ids) && caBuy.item_ids.length) {
        const banner = document.getElementById('purchase-context-banner');
        const leadEl = document.getElementById('purchase-context-lead');
        const pillEl = document.getElementById('purchase-context-pill');
        const tailEl = document.getElementById('purchase-context-tail');
        const subEl = document.getElementById('signup-sub');
        if (banner && leadEl && pillEl && tailEl) {
          leadEl.textContent = "You're buying:";

          const prettyNames = caBuy.item_ids.map(prettifyCaItemId);
          const allResolved = prettyNames.every(Boolean);
          if (allResolved) {
            // Single item -> just that month/bundle range. Multiple items
            // (custom multi-month pick, or an "Individual" format bundle
            // granting several months) -> join them, e.g.
            // "June 2026, July 2026, August 2026".
            pillEl.textContent = prettyNames.length === 1
              ? `Current Affairs ${prettyNames[0]} PDF`
              : `Current Affairs ${prettyNames.join(', ')} PDF`;
          } else {
            pillEl.textContent = caBuy.item_ids.length === 1
              ? 'Current Affairs PDF'
              : `Current Affairs — ${caBuy.item_ids.length} months`;
          }

          tailEl.textContent = 'Sign up, then pay. Takes under a minute.';
          banner.style.display = 'flex';
          if (subEl) subEl.style.display = 'none';
        }
        return;
      }

      if (!buySlug && !isBundle) return;

      const banner = document.getElementById('purchase-context-banner');
      const leadEl = document.getElementById('purchase-context-lead');
      const pillEl = document.getElementById('purchase-context-pill');
      const tailEl = document.getElementById('purchase-context-tail');
      const subEl = document.getElementById('signup-sub');
      if (!banner || !leadEl || !pillEl || !tailEl) return;

      function showBanner(subjectName) {
        // Three separate text nodes (lead / pill / tail) instead of one
        // sentence — the subject name gets its own pill line so it's the
        // one thing that visually anchors the eye, not just a highlighted
        // word buried mid-sentence.
        leadEl.textContent = "You're buying:";
        pillEl.textContent = subjectName;
        tailEl.textContent = 'Sign up, then pay. Takes under a minute.';
        banner.style.display = 'flex';
        // In the buy flow, "no Gmail/OTP" reads as a throwaway technical
        // footnote right when the person needs momentum toward payment.
        // Swap it for a line that reinforces speed/trust instead — the
        // OTP-free detail still matters, so it's folded in rather than cut.
        if (subEl) subEl.style.display = 'none';
      }

      // Bundle path: unlike the single-subject case, the 3 subjects they
      // picked don't survive this full-page redirect (that selection lives
      // only in the Plans page's in-memory JS state), so this can't
      // honestly promise "straight to payment" — they'll need to re-pick
      // their 3 subjects once back on Plans. Said plainly rather than
      // overpromising.
      if (isBundle) {
        leadEl.textContent = "You're buying:";
        pillEl.textContent = `Bundle: 3 subjects for ₹399`;
        tailEl.textContent = 'Sign up, then continue to complete your purchase.';
        banner.style.display = 'flex';
        if (subEl) subEl.style.display = 'none';

        // Best-effort: swap the generic pill text for the 3 actual subject
        // names, same pattern as the single-subject path below. If this
        // fails or is slow, the generic "Bundle: 3 subjects for ₹399" pill
        // already shown is good enough — never blocks on this.
        if (bundleSlugs.length === 3) {
          fetch(`${WORKER_URL}/subjects/public`)
            .then((res) => res.json())
            .then((data) => {
              const all = data.subjects || [];
              const names = bundleSlugs.map((slug) => {
                const match = all.find((s) => s.id === slug);
                if (!match) return null;
                const niceName = match.title_native || match.name || match.title_english;
                return niceName
                  ? niceName.replace(/\b[a-zA-Z]+\b/g, (w) => w.charAt(0).toUpperCase() + w.slice(1))
                  : null;
              });
              if (names.every(Boolean)) {
                pillEl.textContent = `Bundle: ${names.join(', ')}`;
              }
            })
            .catch(() => {});
        }
        return;
      }

      const fallbackName = buySlug
        .replace(/-(en|te)$/, '')
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (c) => c.toUpperCase());

      // Best-effort: try to resolve the real title from the live subjects
      // list so the banner reads naturally ("తెలంగాణ చరిత్ర" instead of
      // a raw slug guess). If this fails or is slow, the slug-derived
      // fallback name is already good enough to show immediately.
      showBanner(fallbackName);
      fetch(`${WORKER_URL}/subjects/public`)
        .then((res) => res.json())
        .then((data) => {
          const match = (data.subjects || []).find((s) => s.id === buySlug);
          if (match) {
            // title_english on some subjects (esp. Telugu-only ones) holds
            // a generic language label like "Telugu Version", not the
            // actual subject name — that's not useful here. Prefer the
            // language that matches the slug's own suffix, since that's
            // the version the person is actually buying.
            // title_native always carries the real subject heading (e.g.
            // "Telangana economy" or "తెలంగాణ చరిత్ర") regardless of
            // language — subjectsMeta.js has no separate English-name
            // field, so title_english is always just a generic "English
            // Version" / "Telugu Version" placeholder label, never the
            // actual subject name. Prefer title_native for every subject.
            const niceName = match.title_native || match.name || match.title_english;
            // subjectsMeta.js stores headings in sentence case ("Telangana
            // economy") since that's used as-is elsewhere (page <h1>,
            // breadcrumbs). The banner pill wants title case instead
            // ("Telangana Economy") — capitalize each word here, only for
            // this display, without touching the shared heading data.
            // Only touches plain ASCII words, so Telugu-script names pass
            // through untouched (they have no case to change anyway).
            const titleCased = niceName
              ? niceName.replace(/\b[a-zA-Z]+\b/g, (w) => w.charAt(0).toUpperCase() + w.slice(1))
              : niceName;
            if (titleCased) showBanner(titleCased);
          }
        })
        .catch(() => {});
    })();
    const form = document.getElementById('signup-form');
    const errorMsg = document.getElementById('error-msg');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn');
    const btnLabel = submitBtn.querySelector('.btn-label');
    const btnSpinner = submitBtn.querySelector('.btn-spinner');

    // Strip non-digit characters as the user types (pattern/inputmode alone don't block typing on desktop)
    ['phone', 'passcode', 'confirm_passcode'].forEach((id) => {
      const el = document.getElementById(id);
      const maxLen = id === 'phone' ? 10 : 6;
      el.addEventListener('input', () => {
        el.value = el.value.replace(/\D/g, '').slice(0, maxLen);
        // Phone number complete — jump to Recovery email instead of making
        // the person tap it manually.
        if (id === 'phone' && el.value.length === maxLen) {
          document.getElementById('recovery_email').focus();
        }
        // Once the 6-digit passcode is fully entered, jump straight to
        // Confirm passcode instead of making the person tap it manually.
        if (id === 'passcode' && el.value.length === maxLen) {
          document.getElementById('confirm_passcode').focus();
        }
      });
    });

    // Name and Recovery email don't have a fixed length to auto-advance on,
    // so Enter/Return moves to the next field instead — completes the same
    // full Name -> Phone -> Recovery email -> Passcode -> Confirm passcode
    // chain without ever requiring a manual tap between fields.
    // Name has no reliable "done typing" signal — it could be one word
    // ("Sasi") or several ("Sasi Reddy Kumar"), so there's no safe point
    // to auto-advance away from it. Left as a normal manual field; the
    // auto-advance chain starts at Phone number instead, where a fixed
    // 10-digit length gives an unambiguous completion point.
    document.getElementById('recovery_email').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        document.getElementById('passcode').focus();
      }
    });

    function setLoading(isLoading, labelWhenIdle) {
      submitBtn.disabled = isLoading;
      btnLabel.textContent = isLoading ? 'Creating account...' : labelWhenIdle;
      btnSpinner.style.display = isLoading ? 'inline-block' : 'none';
    }

    function showError(msg) {
      errorText.textContent = msg;
      errorMsg.style.display = 'flex';
    }

    const params = new URLSearchParams(window.location.search);
    const nextUrl = params.get('next') || '/';

    // Someone who lands here mid-purchase but already has an account might
    // click "Log in" instead of filling this form out — without this, that
    // click drops the ?next= redirect entirely and they never make it back
    // to complete the purchase after logging in.
    const loginLink = document.getElementById('login-link');
    if (loginLink && params.get('next')) {
      loginLink.href = `/login/?next=${encodeURIComponent(params.get('next'))}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.style.display = 'none';
      setLoading(true, 'Create account');

      const payload = {
        name: form.name.value.trim(),
        phone: form.phone.value.trim(),
        recovery_email: form.recovery_email.value.trim(),
        passcode: form.passcode.value.trim(),
        confirm_passcode: form.confirm_passcode.value.trim(),
      };

      try {
        const res = await fetch(`${WORKER_URL}/signup`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          showError(data.error || 'Something went wrong. Please try again.');
          setLoading(false, 'Create account');
          return;
        }

        btnLabel.textContent = 'Account created!';
        btnSpinner.style.display = 'none';
        submitBtn.classList.add('btn-success');
        // Clear any stale cached session so the destination page re-checks fresh
        try { sessionStorage.removeItem('sh_session_cache'); } catch (err) {}
        setTimeout(() => { window.location.href = nextUrl; }, 700);
      } catch (err) {
        showError('Network error. Please check your connection and try again.');
        setLoading(false, 'Create account');
      }
    });
  </script>

  <script is:inline src="/google-auth.js" defer></script>

  <script is:inline>
    document.body.classList.add('sh2-page');
  </script>
</Layout>
